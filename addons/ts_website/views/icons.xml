<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Line icons for website 4, drawn on a 24 box in the Phosphor "regular" style (1.75 stroke, round caps).
         Usage: <t t-call="ts_website.icon" ico.f="arrow-left"/>. Decorative (aria-hidden); give the parent a label. -->
    <record id="tpl_icon" model="ir.ui.view">
        <field name="name">TS: icon</field>
        <field name="type">qweb</field>
        <field name="key">ts_website.icon</field>
        <field name="website_id" ref="website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_website.icon">
                <svg class="ts-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <t t-if="ico == 'arrow-left'"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></t>
                    <t t-elif="ico == 'arrow-right'"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></t>
                    <t t-elif="ico == 'arrow-down'"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></t>
                    <t t-elif="ico == 'arrow-up-left'"><path d="M17 17L7 7"/><path d="M7 15V7h8"/></t>
                    <t t-elif="ico == 'caret-left'"><path d="M15 6l-6 6 6 6"/></t>
                    <t t-elif="ico == 'check'"><path d="M5 12.5l4.5 4.5L19 7.5"/></t>
                    <t t-elif="ico == 'check-circle'"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".18"/><path d="M8.2 12.3l2.6 2.6 5-5.2"/></t>
                    <t t-elif="ico == 'moon'"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></t>
                    <t t-elif="ico == 'sun'"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></t>
                    <t t-elif="ico == 'list'"><path d="M4 7h16M4 12h16M4 17h16"/></t>
                    <t t-elif="ico == 'x'"><path d="M6 6l12 12M18 6L6 18"/></t>
                    <t t-elif="ico == 'plus'"><path d="M12 5v14M5 12h14"/></t>
                    <t t-elif="ico == 'minus'"><path d="M5 12h14"/></t>
                    <t t-elif="ico == 'qr-code'"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M14 14h2v2h-2zM18 14h2M14 18v2M18 18h2v2M16 16h2v2"/></t>
                    <t t-elif="ico == 'chart-bar'"><path d="M4 6h9M4 12h15M4 18h6"/><path d="M4 4v16"/></t>
                    <t t-elif="ico == 'users'"><circle cx="9" cy="9" r="3.5"/><path d="M3 19c.8-3.2 3.2-5 6-5s5.2 1.8 6 5"/><path d="M15.5 5.7a3.5 3.5 0 0 1 0 6.6M17.5 14.3c1.7.6 3 2.2 3.5 4.7"/></t>
                    <t t-elif="ico == 'id-card'"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><path d="M5.8 16c.6-1.4 1.8-2.2 3.2-2.2s2.6.8 3.2 2.2M14.5 10h4M14.5 13.5h3"/></t>
                    <t t-elif="ico == 'rocket'"><path d="M12 3c3.5 2 5 5.5 4.6 10.2L14 16h-4l-2.6-2.8C7 8.5 8.5 5 12 3z"/><circle cx="12" cy="9.5" r="1.6"/><path d="M8.6 13.4L6 15l1 4 3-2M15.4 13.4L18 15l-1 4-3-2M11 19.5l1 1.5 1-1.5"/></t>
                    <t t-elif="ico == 'tree'"><rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-4h12v4"/></t>
                    <t t-elif="ico == 'lifebuoy'"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.8"/><path d="M5.6 5.6l3.7 3.7M14.7 14.7l3.7 3.7M18.4 5.6l-3.7 3.7M9.3 14.7l-3.7 3.7"/></t>
                    <t t-elif="ico == 'plant'"><path d="M12 21v-9"/><path d="M12 12c0-4 2.5-7 7-7 0 4-2.5 7-7 7z"/><path d="M12 15c0-3-2-5.5-6-5.5 0 3 2 5.5 6 5.5z"/></t>
                    <t t-elif="ico == 'buildings'"><path d="M3 21h18"/><path d="M5 21V5l8-2v18"/><path d="M13 9l6 2v10"/><path d="M8 8h2M8 12h2M8 16h2M16 14h0"/></t>
                    <t t-elif="ico == 'question'"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.4a2.5 2.5 0 1 1 3.4 2.4c-.6.3-1 .8-1 1.5v.4"/><path d="M12 17h.01"/></t>
                    <t t-elif="ico == 'quotes'"><path d="M10 7H6a2 2 0 0 0-2 2v3h5v5H4v-5" fill="currentColor" fill-opacity=".25"/><path d="M20 7h-4a2 2 0 0 0-2 2v3h5v5h-5v-5" fill="currentColor" fill-opacity=".25"/></t>
                    <t t-elif="ico == 'flask'"><path d="M9 3h6M10 3v6l-5.5 9.2A1.9 1.9 0 0 0 6.1 21h11.8a1.9 1.9 0 0 0 1.6-2.8L14 9V3"/><path d="M7.3 15h9.4"/></t>
                    <t t-elif="ico == 'seal-check'"><path d="M12 3l2.1 1.6 2.6-.2.8 2.5 2.2 1.4-.8 2.5.8 2.5-2.2 1.4-.8 2.5-2.6-.2L12 21l-2.1-1.6-2.6.2-.8-2.5-2.2-1.4.8-2.5-.8-2.5 2.2-1.4.8-2.5 2.6.2z"/><path d="M9 12l2 2 4-4"/></t>
                    <t t-elif="ico == 'warning'"><path d="M12 4l9 16H3z"/><path d="M12 10v4M12 17h.01"/></t>
                    <t t-elif="ico == 'warning-circle'"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16h.01"/></t>
                    <t t-elif="ico == 'info'"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8h.01"/></t>
                    <t t-elif="ico == 'first-aid'"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/></t>
                    <t t-elif="ico == 'house'"><path d="M4 11l8-7 8 7v9H4z"/><path d="M10 20v-6h4v6"/></t>
                    <t t-elif="ico == 'envelope'"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/></t>
                    <t t-elif="ico == 'phone'"><path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5.5a2 2 0 0 1 2-2z"/></t>
                    <t t-elif="ico == 'bell'"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/></t>
                    <t t-elif="ico == 'user'"><circle cx="12" cy="8.5" r="4"/><path d="M4.5 20c1-3.6 4-5.5 7.5-5.5s6.5 1.9 7.5 5.5"/></t>
                    <t t-elif="ico == 'sign-out'"><path d="M10 4H5v16h5M14 8l4 4-4 4M18 12H9"/></t>
                    <t t-elif="ico == 'clipboard'"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM9 11h6M9 15h4"/></t>
                    <t t-elif="ico == 'lock'"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></t>
                    <t t-else=""><circle cx="12" cy="12" r="1.6"/><circle cx="5" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></t>
                </svg>
            </t>
        </field>
    </record>
</odoo>
