<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every view here carries website_id = website 4 (Talent Search), so eot.ir (website 1) never renders it.
         Priority 90 applies it after Odoo's own header / footer template views.
         Layout modes, decided from the path:
           marketing  public pages: full menu, theme toggle, full footer
           app        /my/*, /help/roles: a quiet bar (logo, participant links, account), slim footer
           focus      /take/*: logo only, no footer (the player keeps its own progress line)
           auth       /web/login, /web/signup, /web/reset_password, /signup*, /invite/*, /join/*, /c/*: logo only, slim footer
         Theme: light by default; the inline script below sets <html data-theme> before first paint from
         localStorage['ts-site-theme'] or prefers-color-scheme. The toggle (ts_nav.js) stores the choice. -->
    <record id="layout_ts" model="ir.ui.view">
        <field name="name">Talent Search layout (website 4)</field>
        <field name="type">qweb</field>
        <field name="key">ts_website.layout_ts</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_ts"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//head/meta[last()]" position="after">
                    <script>(function () { try { var t = localStorage.getItem('ts-site-theme'); if (t !== 'light' &amp;&amp; t !== 'dark') { t = (window.matchMedia &amp;&amp; window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light'; } document.documentElement.setAttribute('data-theme', t); } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); } })();</script>
                    <meta name="theme-color" content="#f4f5fb" media="(prefers-color-scheme: light)"/>
                    <meta name="theme-color" content="#161826" media="(prefers-color-scheme: dark)"/>
                    <link rel="preload" href="/ts_website/static/fonts/Vazirmatn-FD-Var.woff2" as="font" type="font/woff2" crossorigin=""/>
                    <link rel="preload" href="/ts_website/static/fonts/Estedad-FD-Var.woff2" as="font" type="font/woff2" crossorigin=""/>
                    <t t-call-assets="ts_website.assets_ts" t-js="false"/>
                    <t t-call-assets="ts_website.assets_ts_js" t-css="false"/>
                </xpath>
                <xpath expr="//a[hasclass('o_skip_to_content')]" position="replace">
                    <a class="o_skip_to_content ts-skip" href="#wrap" groups="!base.group_user">پرش به محتوا</a>
                </xpath>
                <xpath expr="//header[@id='top']" position="replace">
                    <t t-set="ts_path" t-value="request.httprequest.path"/>
                    <t t-set="ts_mode" t-value="'focus' if ts_path.startswith('/take/') else ('auth' if (ts_path.startswith('/web/login') or ts_path.startswith('/web/signup') or ts_path.startswith('/web/reset_password') or ts_path.startswith('/signup') or ts_path.startswith('/invite/') or ts_path.startswith('/join/') or ts_path.startswith('/c/')) else ('app' if (ts_path.startswith('/my') or ts_path.startswith('/help/roles')) else 'marketing'))"/>
                    <t t-set="ts_public" t-value="request.env.user._is_public()"/>
                    <!-- o_no_autohide_menu + .top_menu: Odoo's frontend menu-autohide script expects header#top .top_menu (null error otherwise) -->
                    <header id="top" t-attf-class="ts-header o_no_autohide_menu ts-header--#{ts_mode} #{'ts-header--app' if ts_mode != 'marketing' else ''}" data-anchor="true" t-att-data-ts-mode="ts_mode">
                        <div class="ts-container ts-header__bar">
                            <a href="/" class="ts-lockup" aria-label="تلنت سرچ، صفحهٔ اصلی">
                                <img src="/ts_website/static/img/talentsearch-logo.webp" width="40" height="40" alt=""/>
                                <span class="ts-lockup__text">
                                    <strong>تلنت سرچ</strong>
                                    <small>سنجش روان‌شناختی، از خانوادهٔ <bdi dir="ltr">EOT</bdi></small>
                                </span>
                            </a>
                            <t t-if="ts_mode == 'marketing'">
                                <t t-set="ts_menu" t-value="website.menu_id.child_id[:6]"/>
                                <nav class="ts-dnav" aria-label="اصلی">
                                    <ul class="ts-dnav__list top_menu">
                                        <li t-foreach="ts_menu" t-as="m"><a t-att-href="m.url" t-out="m.name" t-att-aria-current="'page' if ts_path == m.url else None"/></li>
                                    </ul>
                                </nav>
                                <div class="ts-header__end">
                                    <button type="button" class="ts-iconbtn ts-theme" aria-label="تغییر حالت روشن و تیره" title="حالت روشن یا تیره">
                                        <span class="ts-theme__moon"><t t-call="ts_website.icon" ico.f="moon"/></span>
                                        <span class="ts-theme__sun"><t t-call="ts_website.icon" ico.f="sun"/></span>
                                    </button>
                                    <div class="ts-header__wide ts-nav__actions">
                                        <a t-if="ts_public" href="/web/login" class="ts-btn ts-btn--quiet">ورود</a>
                                        <a t-else="" href="/my" class="ts-btn ts-btn--quiet">حساب من</a>
                                        <a href="/panel" class="ts-btn ts-btn--primary">ساخت پنل رایگان</a>
                                    </div>
                                    <button type="button" class="ts-nav__toggle" aria-expanded="false" aria-controls="ts-mnav">
                                        <span class="ts-nav__open"><t t-call="ts_website.icon" ico.f="list"/></span>
                                        <span class="ts-nav__close"><t t-call="ts_website.icon" ico.f="x"/></span>
                                        منو
                                    </button>
                                </div>
                                <nav id="ts-mnav" class="ts-nav__panel" aria-label="منوی اصلی" hidden="hidden">
                                    <ul class="ts-nav__list">
                                        <li t-foreach="ts_menu" t-as="m"><a t-att-href="m.url" t-out="m.name" t-att-aria-current="'page' if ts_path == m.url else None"/></li>
                                    </ul>
                                    <div class="ts-nav__actions">
                                        <a t-if="ts_public" href="/web/login" class="ts-btn ts-btn--outline">ورود</a>
                                        <a t-else="" href="/my" class="ts-btn ts-btn--outline">حساب من</a>
                                        <a href="/panel" class="ts-btn ts-btn--primary">ساخت پنل رایگان</a>
                                    </div>
                                </nav>
                            </t>
                            <ul t-if="ts_mode != 'marketing'" class="top_menu" hidden="hidden"/>
                            <nav t-if="ts_mode == 'app'" class="ts-appnav" id="ts-appnav" aria-label="حساب">
                                <a href="/my/assessments" t-att-aria-current="'page' if ts_path.startswith('/my/assessments') else None">
                                    <t t-call="ts_website.icon" ico.f="clipboard"/>
                                    <span>سنجه‌های من</span>
                                </a>
                                <a href="/my" t-att-aria-current="'page' if ts_path in ('/my', '/my/account') else None">
                                    <t t-call="ts_website.icon" ico.f="user"/>
                                    <span>حساب من</span>
                                </a>
                                <a href="/web/session/logout?redirect=/" rel="nofollow">
                                    <t t-call="ts_website.icon" ico.f="sign-out"/>
                                    <span>خروج</span>
                                </a>
                            </nav>
                            <button t-if="ts_mode != 'marketing'" type="button" t-attf-class="ts-iconbtn ts-theme #{'' if ts_mode == 'app' else 'ts-theme--end'}" aria-label="تغییر حالت روشن و تیره" title="حالت روشن یا تیره">
                                <span class="ts-theme__moon"><t t-call="ts_website.icon" ico.f="moon"/></span>
                                <span class="ts-theme__sun"><t t-call="ts_website.icon" ico.f="sun"/></span>
                            </button>
                            <a t-if="ts_mode == 'focus' and not ts_public" href="/my/assessments" class="ts-btn ts-btn--quiet ts-btn--sm">ذخیره و خروج</a>
                        </div>
                    </header>
                </xpath>
                <xpath expr="//footer[@id='bottom']" position="replace">
                    <t t-set="ts_path" t-value="request.httprequest.path"/>
                    <t t-set="ts_mode" t-value="'focus' if ts_path.startswith('/take/') else ('auth' if (ts_path.startswith('/web/login') or ts_path.startswith('/web/signup') or ts_path.startswith('/web/reset_password') or ts_path.startswith('/signup') or ts_path.startswith('/invite/') or ts_path.startswith('/join/') or ts_path.startswith('/c/')) else ('app' if (ts_path.startswith('/my') or ts_path.startswith('/help/roles')) else 'marketing'))"/>
                    <footer t-if="ts_mode == 'marketing'" id="bottom" class="ts-footer" data-anchor="true">
                        <div class="ts-container">
                            <div class="ts-footer__grid">
                                <div class="ts-footer__col">
                                    <span class="ts-footer__brand">تلنت سرچ، از خانوادهٔ <bdi dir="ltr">EOT</bdi></span>
                                    <p>سنجش استعداد برای مدرسه‌ها و مراکز مشاوره. تصمیم با انسان است، نه با نمره.</p>
                                    <a class="ts-footer__eot" href="https://www.eot.ir/" target="_blank" rel="noopener">بازگشت به <bdi dir="ltr">EOT</bdi></a>
                                </div>
                                <nav class="ts-footer__col" aria-label="تلنت سرچ">
                                    <h2>تلنت سرچ</h2>
                                    <ul>
                                        <li><a href="/schools">برای مدارس و مشاوران</a></li>
                                        <li><a href="/assessments">سنجه‌ها</a></li>
                                        <li><a href="/pricing">هزینه و پرسش‌ها</a></li>
                                    </ul>
                                </nav>
                                <nav class="ts-footer__col" aria-label="کمک">
                                    <h2>کمک</h2>
                                    <ul>
                                        <li><a href="/pricing#faq">پرسش‌های رایج</a></li>
                                        <li><a href="/contact">تماس با ما</a></li>
                                        <li><a href="/privacy">حریم خصوصی و رضایت</a></li>
                                    </ul>
                                </nav>
                                <div class="ts-footer__col">
                                    <h2>تماس</h2>
                                    <ul>
                                        <li><a href="mailto:info@eot.ir"><bdi dir="ltr">info@eot.ir</bdi></a></li>
                                        <li><a href="tel:+982188174100">۰۲۱-۸۸۱۷۴۱۰۰</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="ts-footer__legal">
                                <p>تلنت سرچ خدمت اورژانسی نیست. در شرایط اضطراری با ۱۱۵ تماس بگیرید.</p>
                                <p>© مؤسسهٔ <bdi dir="ltr">EOT</bdi></p>
                            </div>
                        </div>
                    </footer>
                    <footer t-elif="ts_mode != 'focus'" id="bottom" class="ts-footer ts-footer--slim" data-anchor="true">
                        <div class="ts-container ts-footer__row">
                            <ul>
                                <li><a href="/help/panel">راهنما</a></li>
                                <li><a href="/privacy">حریم خصوصی و رضایت</a></li>
                                <li><a href="/contact?topic=support">تماس با پشتیبانی</a></li>
                            </ul>
                            <p>© مؤسسهٔ <bdi dir="ltr">EOT</bdi> · تلنت سرچ خدمت اورژانسی نیست؛ در شرایط اضطراری با ۱۱۵ تماس بگیرید.</p>
                        </div>
                    </footer>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
