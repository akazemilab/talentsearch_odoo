<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sign-in page of website 4 in Persian (the stock form carries English placeholders and buttons). Priority 99 so the
         replacement runs after auth_signup / auth_passkey extended the stock form. Field names stay the same as the stock
         form (login, password, redirect, type) so /web/login handles the POST unchanged. -->
    <record id="login_ts" model="ir.ui.view">
        <field name="name">TS: sign-in form</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="web.login"/>
        <field name="website_id" ref="website_ts"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//t[@t-call='web.login_layout']" position="attributes">
                    <attribute name="additional_title.f">ورود</attribute>
                </xpath>
                <xpath expr="//h1[hasclass('visually-hidden')]" position="replace"/>
                <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
                <xpath expr="//form[hasclass('oe_login_form')]" position="replace">
                    <div class="ts-auth">
                        <div class="ts-auth__card">
                            <h1>ورود به تلنت سرچ</h1>
                            <p class="ts-hint" style="margin: 0">با ایمیل و گذرواژه وارد شوید. اگر با شمارهٔ موبایل ثبت‌نام کرده‌اید، <a href="/signup">ورود با کد پیامکی</a> را انتخاب کنید.</p>
                            <form class="oe_login_form ts-form" role="form" action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash" data-captcha="login">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="type" value="password"/>
                                <input type="hidden" name="redirect" t-att-value="redirect"/>
                                <div>
                                    <label for="login">ایمیل</label>
                                    <input type="email" name="login" t-att-value="login" id="login" class="ts-input" dir="ltr" required="required" autocapitalize="off" autocomplete="username" inputmode="email"/>
                                </div>
                                <div>
                                    <label for="password">گذرواژه</label>
                                    <input type="password" name="password" id="password" class="ts-input" dir="ltr" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                                </div>
                                <p class="ts-form__error" t-if="error" role="alert" t-out="error"/>
                                <p class="ts-notice" t-if="message" role="status" t-out="message"/>
                                <button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">ورود</button>
                                <div class="ts-auth__links">
                                    <a href="/web/reset_password">گذرواژه را فراموش کرده‌اید؟</a>
                                    <a href="/signup">حساب ندارید؟ ثبت‌نام با موبایل</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
