<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="crm_team_ts" model="crm.team">
            <field name="name">تلنت سرچ</field>
            <field name="use_leads" eval="True"/>
            <field name="use_opportunities" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <record id="crm_tag_ts" model="crm.tag">
            <field name="name">تلنت سرچ</field>
        </record>
    </data>
    <!-- Talent Search pipeline (brief: inquiry -> qualification -> demo ->
         proposal -> paid pilot -> contract -> onboarding -> renewal). Stages
         are bound to the Talent Search team only. -->
    <record id="stage_ts_inquiry" model="crm.stage"><field name="name">درخواست ورودی</field><field name="sequence">1</field><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_qualified" model="crm.stage"><field name="name">ارزیابی نیاز</field><field name="sequence">2</field><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_demo" model="crm.stage"><field name="name">جلسهٔ معرفی</field><field name="sequence">3</field><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_proposal" model="crm.stage"><field name="name">پیشنهاد و پیش‌فاکتور</field><field name="sequence">4</field><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_pilot" model="crm.stage"><field name="name">پایلوت پولی</field><field name="sequence">5</field><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_contract" model="crm.stage"><field name="name">قرارداد</field><field name="sequence">6</field><field name="is_won" eval="True"/><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_onboarding" model="crm.stage"><field name="name">راه‌اندازی</field><field name="sequence">7</field><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
    <record id="stage_ts_renewal" model="crm.stage"><field name="name">تمدید</field><field name="sequence">8</field><field name="fold" eval="True"/><field name="team_ids" eval="[(6, 0, [ref('crm_team_ts')])]"/></record>
</odoo>
