<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Redesign 2026-10: permanent redirects for retired website-4 URLs. Website-scoped (website 4 only); the
         ts_website ir_http override serves only website 4's own rewrites there, so eot.ir is unaffected. -->
    <record id="rw_how" model="website.rewrite">
        <field name="name">TS: /how-it-works → /#orgs</field>
        <field name="redirect_type">301</field>
        <field name="url_from">/how-it-works</field>
        <field name="url_to">/#orgs</field>
        <field name="website_id" ref="website_ts"/>
    </record>
