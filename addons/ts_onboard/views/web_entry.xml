<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- O3 entry points: the guest starter from the catalog and the detail page (site1 2026-10-14: the home hero is the
         career test, ts_website.home; it no longer carries the starter or the audience links). -->

    <!-- the catalog card of the starter opens its start screen (no sign-in first) -->
    <record id="catalog_guest_card" model="ir.ui.view">
        <field name="name">ts_onboard.catalog.guest</field>
        <field name="inherit_id" ref="ts_assessment.tpl_catalog"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('ts-inst')]" position="attributes">
                <attribute name="t-attf-href">#{'/start/' + inst.slug if inst.ts_guest_ready() else '/assessments/' + inst.slug}</attribute>
            </xpath>
            <xpath expr="//a[hasclass('ts-inst')]//span[hasclass('ts-card__link')]" position="replace">
                <span t-if="inst.ts_guest_ready()" class="ts-card__link">شروع بدون ثبت‌نام</span>
                <span t-else="" class="ts-card__link">جزئیات و شروع</span>
            </xpath>
        </field>
    </record>

    <!-- the detail page of a guest-ok instrument: «شروع سنجه» opens its start screen, no sign-in first -->
    <record id="detail_guest_start" model="ir.ui.view">
        <field name="name">ts_onboard.detail.guest</field>
        <field name="inherit_id" ref="ts_assessment.tpl_detail"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('ts-hero__actions')]" position="replace">
                <div class="ts-hero__actions">
                    <t t-set="open_attempt" t-value="mine.filtered(lambda a: a.state in ('consent', 'in_progress'))[:1]"/>
                    <a t-if="open_attempt" t-attf-href="/take/#{open_attempt.access_token}" class="ts-btn ts-btn--primary">ادامهٔ پاسخ‌دهی (<t t-out="fa(open_attempt.progress)"/>٪)</a>
                    <a t-elif="ts_guest_start" t-att-href="start_url" class="ts-btn ts-btn--primary" id="tso-detail-start">شروع سنجه</a>
                    <form t-else="" t-att-action="start_url" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="ts-btn ts-btn--primary">شروع سنجه</button>
                    </form>
                </div>
            </xpath>
            <!-- the sign-in hint is located by its link id (ts_talent switches its t-if for the «تو» inventory, take1) -->
            <xpath expr="//p[a[@id='ts-detail-signup']]" position="after">
                <p t-if="ts_guest_start and request.env.user._is_public()" class="ts-muted" id="tso-detail-note">بدون ثبت‌نام شروع می‌کنید؛ در پایان با شمارهٔ موبایل نتیجه را می‌بینید و نگه می‌دارید.</p>
            </xpath>
            <xpath expr="//p[a[@id='ts-detail-signup']]" position="attributes">
                <attribute name="t-if">request.env.user._is_public() and version.mode != 'matrix' and not ts_guest_start</attribute>
            </xpath>
        </field>
    </record>
</odoo>
