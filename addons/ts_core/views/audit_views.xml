<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ts_audit_event_view_list" model="ir.ui.view">
        <field name="name">ts.audit.event.list</field>
        <field name="model">ts.audit.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="زمان"/>
                <field name="event_type"/>
                <field name="actor_id"/>
                <field name="workspace_id"/>
                <field name="purpose" optional="show"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="outcome" optional="show"/>
                <field name="route" optional="hide"/>
                <field name="ip_hash" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ts_audit_event_view_form" model="ir.ui.view">
        <field name="name">ts.audit.event.form</field>
        <field name="model">ts.audit.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="زمان"/>
                            <field name="event_type"/>
                            <field name="actor_id"/>
                            <field name="ip_hash"/>
                            <field name="outcome"/>
                            <field name="route"/>
                            <field name="request_id"/>
                        </group>
                        <group>
                            <field name="workspace_id"/>
                            <field name="purpose"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <field name="detail"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ts_audit_event_view_search" model="ir.ui.view">
        <field name="name">ts.audit.event.search</field>
        <field name="model">ts.audit.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_type"/>
                <field name="actor_id"/>
                <field name="workspace_id"/>
                <group>
                    <filter name="by_type" string="نوع" context="{'group_by': 'event_type'}"/>
                    <filter name="by_ws" string="فضای کاری" context="{'group_by': 'workspace_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ts_audit_event_action" model="ir.actions.act_window">
        <field name="name">ممیزی</field>
        <field name="res_model">ts.audit.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
