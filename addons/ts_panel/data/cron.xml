<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_expire_invitations" model="ir.cron">
        <field name="name">Panel: mark expired invitations</field>
        <field name="model_id" ref="ts_org.model_ts_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_invitations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_run_jobs" model="ir.cron">
        <field name="name">Panel: run queued import/export jobs</field>
        <field name="model_id" ref="model_ts_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_expire_jobs" model="ir.cron">
        <field name="name">Panel: delete expired job files</field>
        <field name="model_id" ref="model_ts_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
