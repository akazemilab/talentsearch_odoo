<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_expire_invitations" model="ir.cron">
        <field name="name">Panel: mark expired invitations</field>
        <field name="model_id" ref="ts_org.model_ts_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_invitations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_run_jobs" model="ir.cron">
        <field name="name">Panel: run queued import/export jobs</field>
        <field name="model_id" ref="model_ts_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_expire_jobs" model="ir.cron">
        <field name="name">Panel: delete expired job files</field>
        <field name="model_id" ref="model_ts_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_reminders" model="ir.cron">
        <field name="name">Panel: one reminder per open invitation (10:00 Tehran)</field>
        <field name="model_id" ref="ts_org.model_ts_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=30, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="cron_flush_sms" model="ir.cron">
        <field name="name">Panel: send SMS that waited for the quiet hours to end</field>
        <field name="model_id" ref="model_ts_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_flush_sms()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_vacuum_notifications" model="ir.cron">
        <field name="name">Panel: delete old read notifications</field>
        <field name="model_id" ref="model_ts_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_vacuum()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_retention" model="ir.cron">
        <field name="name">Panel: retention (dry-run unless ts_panel.retention_enabled = 1)</field>
        <field name="model_id" ref="model_ts_retention_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
