<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header: one role-aware link for people who belong to a panel (03_ia_and_ux.md 1.1). Website 4 only. -->
    <record id="layout_ts_panel_link" model="ir.ui.view">
        <field name="name">TS panel: header links (panel, notifications)</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="ts_website.layout_ts"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <data>
                <!-- app bar: panel first, then notifications with the unread count -->
                <xpath expr="//nav[@id='ts-appnav']" position="inside">
                    <t t-set="ts_panel_url" t-value="request.env.user.ts_panel_home()"/>
                    <a t-if="ts_panel_url" t-att-href="ts_panel_url" t-att-aria-current="'page' if ts_path.startswith('/my/workspaces') else None">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 20V9"/></svg>
                        <span>پنل</span>
                    </a>
                    <t t-set="ts_unread" t-value="request.env.user._ts_unread_label()"/>
                    <a href="/my/notifications" t-att-aria-current="'page' if ts_path.startswith('/my/notifications') else None" t-att-aria-label="'اعلان‌ها' + ((' - ' + ts_unread + ' نخوانده') if ts_unread else '')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
                        <span>اعلان‌ها</span>
                        <b t-if="ts_unread" class="ts-appnav__badge" t-out="ts_unread"/>
                    </a>
                </xpath>
                <!-- marketing menus (desktop and phone): one role-aware link for members -->
                <xpath expr="(//div[hasclass('ts-nav__actions')])[1]" position="inside">
                    <t t-set="ts_panel_url" t-value="request.env.user.ts_panel_home()"/>
                    <a t-if="ts_panel_url" t-att-href="ts_panel_url" class="ts-btn ts-btn--outline">پنل من</a>
                </xpath>
                <xpath expr="(//div[hasclass('ts-nav__actions')])[2]" position="inside">
                    <t t-set="ts_panel_url2" t-value="request.env.user.ts_panel_home()"/>
                    <a t-if="ts_panel_url2" t-att-href="ts_panel_url2" class="ts-btn ts-btn--outline">پنل من</a>
                </xpath>
            </data>
        </field>
    </record>

    <!-- Old one-page panel stays until S6; a short notice points to the new pages -->
    <record id="tpl_workspace_notice" model="ir.ui.view">
        <field name="name">TS panel: notice on the old panel page</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="ts_org.tpl_workspace"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('ts-back')]" position="after">
                <p class="ts-notice" role="status">این صفحهٔ قدیمی پنل است و به‌زودی برداشته می‌شود. <a t-attf-href="/my/workspaces/#{ws.id}">رفتن به داشبورد</a></p>
            </xpath>
        </field>
    </record>

    <!-- The list of my panels enters the new dashboard -->
    <record id="tpl_workspaces_home_link" model="ir.ui.view">
        <field name="name">TS panel: panel list links to the dashboard</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="ts_org.tpl_workspaces"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//article[hasclass('ts-org-card')]//a[hasclass('ts-btn--primary')]" position="attributes">
                <attribute name="t-attf-href">/my/workspaces/#{r['ws'].id}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
