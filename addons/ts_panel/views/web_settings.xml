<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/settings (S2): مشخصات and تماس for panel:profile, شرایط استفاده for panel:settings (owner). -->
    <record id="tpl_settings" model="ir.ui.view">
        <field name="name">TS panel: settings</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.settings</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.settings">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">تنظیمات</h1>
                                    <p class="tsp-head__help">نام و لوگوی پنل، اطلاعات پنل و شرایط استفاده.</p>
                                </div>
                            </header>

                            <nav t-if="shell_flat" class="ts-card tsp-setlinks" id="tsp-setlinks" aria-label="بخش‌های تنظیمات">
                                <a t-if="member.has_perm('members:read')" t-attf-href="/my/workspaces/#{ws.id}/members">اعضا و دسترسی‌ها</a>
                                <a t-if="member.has_perm('audit:read')" t-attf-href="/my/workspaces/#{ws.id}/audit">دفتر ممیزی</a>
                                <a href="/help/panel">راهنما</a>
                            </nav>

                            <section class="ts-card" id="tsp-profile" aria-labelledby="tsp-profile-h">
                                <h2 id="tsp-profile-h" class="h5">مشخصات</h2>
                                <form t-attf-action="/my/workspaces/#{ws.id}/settings/save" method="post" enctype="multipart/form-data" class="tsp-form" data-tsp-once="1" data-ts-dirty="مشخصات">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="tsp-field">
                                        <label class="tsp-field__label" for="tsp_name">نام پنل</label>
                                        <p class="tsp-field__hint" id="tsp_name_h">این نام در پنل، صفحهٔ دعوت و گزارش‌های شرکت‌کنندگان دیده می‌شود. ۲ تا ۱۰۰ نویسه.</p>
                                        <input id="tsp_name" name="name" type="text" maxlength="100" required="required" t-att-value="ws.name" aria-describedby="tsp_name_h"/>
                                    </div>
                                    <div class="tsp-field" id="tsp-logo-field">
                                        <p t-if="has_logo" class="tsp-logo-now"><img t-att-src="image_data_uri(ws.partner_id.image_128)" alt="لوگوی فعلی" width="64" height="64"/>
                                            <span class="ts-hint">لوگوی فعلی؛ مگر فایل تازه‌ای انتخاب کنید یا آن را حذف کنید، همین می‌ماند.</span></p>
                                        <p t-if="has_logo" class="tsp-check"><label for="tsp_logo_rm"><input type="checkbox" id="tsp_logo_rm" name="remove_logo" value="1"/> حذف لوگو</label></p>
                                        <t t-call="ts_website.filefield" ff_name.f="logo" ff_id.f="tsp_logo" ff_label.f="لوگو" ff_accept.f="image/png,image/jpeg,image/webp" ff_hint.f="PNG، JPG یا WEBP، کمتر از ۵۰۰ کیلوبایت."/>
                                    </div>
                                    <p><button type="submit" class="ts-btn ts-btn--primary">ذخیره</button></p>
                                </form>
                            </section>

                            <section class="ts-card" id="tsp-contact" aria-labelledby="tsp-contact-h">
                                <h2 id="tsp-contact-h" class="h5">اطلاعات پنل</h2>
                                <dl class="ts-meta">
                                    <dt>نوع پنل</dt><dd t-out="purpose_label"/>
                                    <dt>مسئول داده</dt><dd t-out="contact or 'ثبت نشده'"/>
                                    <t t-if="escalation"><dt>مسئول پیگیری فوری</dt><dd t-out="escalation"/></t>
                                </dl>
                                <p class="ts-hint">این اطلاعات را تیم استعدادیاب ثبت می‌کند. برای ثبت یا تغییر آن <a t-attf-href="/contact?topic=support&amp;panel=#{ws.code}">به پشتیبانی پیام بدهید</a>.</p>
                            </section>

                            <section t-if="can_terms" class="ts-card" id="tsp-terms" aria-labelledby="tsp-terms-h">
                                <h2 id="tsp-terms-h" class="h5">شرایط استفاده</h2>
                                <p t-if="terms_version">
                                    نسخهٔ پذیرفته‌شده: <bdi dir="ltr" class="ts-bdi" t-out="terms_version"/>
                                    <t t-if="terms_on"> · <t t-out="jalali(terms_on, with_time=False)"/></t>
                                </p>
                                <p t-else="">برای این پنل پذیرش آنلاین شرایط ثبت نشده است؛ یعنی پنل پیش از فرم پذیرش آنلاین یا به دست تیم استعدادیاب ساخته شده است. از شما کاری لازم نیست. اگر پرسشی دارید، <a t-attf-href="/contact?topic=support&amp;panel=#{ws.code}">به پشتیبانی پیام بدهید</a>.</p>
                                <t t-if="terms_version and not terms_current">
                                    <p class="ts-notice ts-notice--warn" id="tsp-terms-new">نسخهٔ تازه‌ای از شرایط استفاده منتشر شده است. <a href="/panel/terms">متن تازه را بخوانید</a> و اگر می‌پذیرید، پذیرش را ثبت کنید.</p>
                                    <form t-attf-action="/my/workspaces/#{ws.id}/settings/terms" method="post" class="tsp-form" data-tsp-once="1">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="version" t-att-value="terms_latest"/>
                                        <p class="tsp-check"><label for="tsp_terms_ok"><input type="checkbox" id="tsp_terms_ok" name="terms" value="1" required="required"/> نسخهٔ تازهٔ شرایط استفاده را خوانده‌ام و از طرف پنل می‌پذیرم.</label></p>
                                        <p><button type="submit" class="ts-btn ts-btn--primary">ثبت پذیرش شرایط تازه</button></p>
                                    </form>
                                </t>
                                <p><a href="/panel/terms">متن شرایط استفاده</a></p>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
