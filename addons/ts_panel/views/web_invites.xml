<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/invites: list with the funnel (INV-2) -->
    <record id="tpl_invites" model="ir.ui.view">
        <field name="name">TS panel: invitations</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.invites</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.invites">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">دعوت‌ها</h1>
                                    <p class="tsp-head__help">هر دعوت یک نوبت سنجه برای یک نفر است. وضعیت‌ها را از فیلترهای زیر ببینید.</p>
                                </div>
                                <div class="tsp-head__actions">
                                    <a t-if="can_create" t-attf-href="/my/workspaces/#{ws.id}/invites/new?fresh=1" class="ts-btn ts-btn--primary">دعوت تازه</a>
                                </div>
                            </header>
                            <p t-if="filtered" class="ts-notice" role="status">نمایش فقط: <strong t-out="filtered"/> (<span class="ts-num" t-out="fa(total)"/> دعوت) — <a t-att-href="clear_url">نمایش همه</a></p>
                            <nav class="tsp-chips" aria-label="فیلتر وضعیت">
                                <a t-att-href="url(state='all', page=1)" t-attf-class="tsp-chip #{'is-on' if state == 'all' else ''}" t-att-aria-current="'true' if state == 'all' else None">همه <span class="ts-num" t-out="fa(all_total)"/></a>
                                <a t-foreach="state_order" t-as="k" t-att-href="url(state=k, page=1)" t-attf-class="tsp-chip #{'is-on' if state == k else ''}" t-att-aria-current="'true' if state == k else None"><t t-out="state_labels[k]"/> <span class="ts-num" t-out="fa(counts[k])"/></a>
                            </nav>
                            <p t-if="not rows" class="tsp-empty">
                                <t t-if="state == 'all'">هنوز دعوتی نساخته‌اید.<t t-if="can_create"> با «دعوت تازه» شروع کنید.</t></t>
                                <t t-else="">دعوتی در این وضعیت نیست.</t>
                            </p>
                            <div t-if="rows" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">فهرست دعوت‌ها</caption>
                                    <thead><tr><th scope="col">شرکت‌کننده</th><th scope="col">سنجه</th><th scope="col">وضعیت</th><th scope="col">ارسال</th><th scope="col">انقضا</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="a">
                                            <th scope="row" data-label="شرکت‌کننده"><a t-attf-href="/my/workspaces/#{ws.id}/invites/#{a.id}" t-out="a.invitee_name"/></th>
                                            <td data-label="سنجه" t-out="a.instrument_id.name"/>
                                            <td data-label="وضعیت"><span t-attf-class="ts-pill #{pill.get(a.state, '')}" t-out="state_labels.get(a.state, a.state)"/></td>
                                            <td data-label="ارسال" t-out="jalali(a.create_date)"/>
                                            <td data-label="انقضا"><t t-if="a.state in ('invited', 'opened', 'expired') and a.expires_at" t-out="jalali(a.expires_at)"/><t t-else="">—</t></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <nav t-if="pages &gt; 1" class="tsp-pager" aria-label="صفحه‌بندی">
                                <a t-if="page &gt; 1" t-att-href="url(page=page - 1)" rel="prev">صفحهٔ قبل</a>
                                <span aria-current="page">صفحهٔ <t t-out="fa(page)"/> از <t t-out="fa(pages)"/></span>
                                <a t-if="page &lt; pages" t-att-href="url(page=page + 1)" rel="next">صفحهٔ بعد</a>
                            </nav>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- W/invites/new: four steps (INV-1) -->
    <record id="tpl_invite_wizard" model="ir.ui.view">
        <field name="name">TS panel: invitation wizard</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.invite_wizard</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.invite_wizard">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">دعوت تازه</h1>
                                    <p class="tsp-head__help">در چهار گام: چه کسی، کدام سنجه، تنظیمات و مرور. چیزی پیش از گام آخر ارسال نمی‌شود.</p>
                                </div>
                            </header>
                            <ol class="tsp-steps" aria-label="مراحل دعوت">
                                <li t-foreach="steps" t-as="s" t-attf-class="tsp-steps__item #{'is-on' if s[0] == step else ''}" t-att-aria-current="'step' if s[0] == step else None"><span class="ts-num" t-out="fa(s[0])"/>. <t t-out="s[1]"/></li>
                            </ol>

                            <!-- 1: who -->
                            <t t-if="step == '1'">
                                <section class="ts-card" aria-labelledby="tsp-w1a">
                                    <h2 id="tsp-w1a" class="h5">شرکت‌کنندهٔ موجود</h2>
                                    <div t-if="client" class="ts-notice" role="status">
                                        انتخاب‌شده: <strong t-out="client.name"/>
                                        <form t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" class="tsp-inline" data-tsp-once="1">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="step" value="1"/>
                                            <input type="hidden" name="choose" t-att-value="client.id"/>
                                            <button type="submit" class="ts-btn ts-btn--primary">ادامه با این فرد</button>
                                        </form>
                                    </div>
                                    <form t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" class="tsp-search">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="step" value="1"/>
                                        <input type="hidden" name="search" value="1"/>
                                        <label class="tsp-sr" for="tsp_wq">جست‌وجوی شرکت‌کننده</label>
                                        <input id="tsp_wq" name="q" type="search" t-att-value="q or ''" maxlength="100" autocomplete="off" placeholder="نام، شناسه یا موبایل"/>
                                        <button type="submit" class="ts-btn ts-btn--outline">جست‌وجو</button>
                                    </form>
                                    <t t-if="searched">
                                        <p t-if="not found" class="tsp-empty">کسی پیدا نشد. می‌توانید او را در بخش «فرد تازه» بنویسید.</p>
                                        <form t-if="found" t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" data-tsp-once="1">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="step" value="1"/>
                                            <fieldset class="tsp-field">
                                                <legend class="tsp-field__label">یکی را برگزینید</legend>
                                                <label t-foreach="found" t-as="c" class="tsp-radio"><input type="radio" name="choose" t-att-value="c.id" required="required"/><span t-out="c.name"/></label>
                                            </fieldset>
                                            <p><button type="submit" class="ts-btn ts-btn--primary">ادامه</button></p>
                                        </form>
                                    </t>
                                </section>
                                <form t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" class="tsp-form ts-card" data-tsp-once="1" aria-labelledby="tsp-w1b">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="step" value="1"/>
                                    <h2 id="tsp-w1b" class="h5">فرد تازه</h2>
                                    <label class="tsp-field"><span class="tsp-field__label">نام</span><input type="text" name="new_name" maxlength="120" class="form-control"/></label>
                                    <label class="tsp-field"><span class="tsp-field__label">موبایل (اختیاری)</span><input type="tel" name="new_phone" maxlength="20" dir="ltr" inputmode="tel" class="form-control"/></label>
                                    <label class="tsp-field"><span class="tsp-field__label">ایمیل (اختیاری)</span><input type="email" name="new_email" maxlength="200" dir="ltr" class="form-control"/></label>
                                    <p class="ts-hint">اگر موبایل یا ایمیل با یکی از شرکت‌کنندگان فعلی یکی باشد، دعوت برای همان ردیف ثبت می‌شود.</p>
                                    <p><button type="submit" class="ts-btn ts-btn--primary">ادامه</button></p>
                                </form>
                            </t>

                            <!-- 2: instrument -->
                            <form t-if="step == '2'" t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" class="tsp-form ts-card" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="step" value="2"/>
                                <fieldset class="tsp-field">
                                    <legend class="tsp-field__label">سنجه</legend>
                                    <label t-foreach="instruments" t-as="i" class="tsp-radio"><input type="radio" name="instrument_id" t-att-value="i.id" required="required" t-att-checked="'checked' if inst == i else None"/><span t-out="i.name"/></label>
                                </fieldset>
                                <p><button type="submit" class="ts-btn ts-btn--primary">ادامه</button> <a t-attf-href="/my/workspaces/#{ws.id}/invites/new?step=1" class="ts-btn ts-btn--quiet">قبلی</a></p>
                            </form>

                            <!-- 3: options -->
                            <form t-if="step == '3'" t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" class="tsp-form ts-card" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="step" value="3"/>
                                <label class="tsp-field"><span class="tsp-field__label">مهلت (اختیاری)</span><input type="date" name="deadline" t-att-value="draft.get('deadline')" class="form-control"/>
                                    <span class="tsp-field__hint">بدون مهلت، دعوت ۳۰ روز اعتبار دارد.</span></label>
                                <label class="tsp-field"><span class="tsp-field__label">یادداشت برای شرکت‌کننده (اختیاری)</span><input type="text" name="note" maxlength="300" t-att-value="draft.get('note')" class="form-control"/></label>
                                <fieldset t-if="sms_ok and ((client and client.phone) or draft.get('new_phone'))" class="tsp-field">
                                    <legend class="tsp-field__label">پیامک</legend>
                                    <label class="tsp-check"><input type="checkbox" name="sms" value="1" t-att-checked="'checked' if draft.get('sms') else None"/><span>پیوند دعوت را با پیامک هم بفرست</span></label>
                                    <label class="tsp-check"><input type="checkbox" name="attest" value="1" t-att-checked="'checked' if draft.get('sms') else None"/><span>تأیید می‌کنم که شرکت‌کننده (یا سرپرست قانونی او) با دریافت پیامک موافق است؛ این تأیید شامل یک پیامک دعوت و یک یادآوری است.</span></label>
                                </fieldset>
                                <p t-else="" class="ts-hint">پیامک فقط وقتی ممکن است که شمارهٔ موبایل ثبت شده باشد. پیوند را خودتان هم می‌توانید بفرستید.</p>
                                <p><button type="submit" class="ts-btn ts-btn--primary">ادامه</button> <a t-attf-href="/my/workspaces/#{ws.id}/invites/new?step=2" class="ts-btn ts-btn--quiet">قبلی</a></p>
                            </form>

                            <!-- 4: review -->
                            <form t-if="step == '4'" t-attf-action="/my/workspaces/#{ws.id}/invites/new" method="post" class="tsp-form ts-card" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="step" value="4"/>
                                <h2 class="h5">مرور و ساخت</h2>
                                <dl class="tsp-dl">
                                    <dt>شرکت‌کننده</dt><dd t-out="client.name if client else draft.get('new_name')"/>
                                    <dt>سنجه</dt><dd t-out="inst.name"/>
                                    <dt>مهلت</dt><dd><t t-if="draft.get('deadline')" t-out="deadline_fa"/><t t-else="">۳۰ روز اعتبار</t></dd>
                                    <dt t-if="draft.get('note')">یادداشت</dt><dd t-if="draft.get('note')" t-out="draft['note']"/>
                                    <dt>پیامک</dt><dd><t t-if="draft.get('sms')">بله، با تأیید رضایت</t><t t-else="">نه؛ پیوند را خودتان می‌فرستید</t></dd>
                                </dl>
                                <p t-if="dups" class="ts-notice" role="status">این مشخصات با «<t t-out="', '.join(dups.mapped('name'))"/>» یکی است؛ دعوت برای همان ردیف ثبت می‌شود.</p>
                                <p t-if="needs_guardian" class="ts-notice" id="ts-guardian-box"><label><input type="checkbox" name="guardian_ok" value="1"/> رضایت ولی یا سرپرست قانونی این شرکت‌کننده را گرفته‌ایم و نزد ما محفوظ است.</label></p>
                                <p><button type="submit" class="ts-btn ts-btn--primary">ساخت دعوت</button> <a t-attf-href="/my/workspaces/#{ws.id}/invites/new?step=3" class="ts-btn ts-btn--quiet">قبلی</a></p>
                            </form>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- W/invites/<id>: the invitation, its link and QR (INV-1 done page, INV-3, INV-4) -->
    <record id="tpl_invite" model="ir.ui.view">
        <field name="name">TS panel: invitation page</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.invite</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.invite">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">دعوت <t t-out="a.invitee_name"/></h1>
                                    <p class="tsp-head__help"><span t-attf-class="ts-pill #{pill.get(a.state, '')}" t-out="state_labels.get(a.state, a.state)"/> · <t t-out="a.instrument_id.name"/> · <a t-attf-href="/my/workspaces/#{ws.id}/clients/#{c.id}">صفحهٔ شرکت‌کننده</a></p>
                                </div>
                                <a t-attf-href="/my/workspaces/#{ws.id}/invites" class="ts-btn ts-btn--quiet">همهٔ دعوت‌ها</a>
                            </header>
                            <section t-if="is_new" class="ts-notice" role="status">
                                دعوت ساخته شد.
                                <t t-if="a.sms_sent_at">پیامک دعوت ارسال شد.</t>
                                <t t-elif="a.sms_consent and a.sms_error">پیامک ارسال نشد (<t t-out="a.sms_error"/>)؛ پیوند را خودتان بفرستید.</t>
                                <t t-else="">تلنت سرچ پیامکی نفرستاده است؛ این پیوند را خودتان برای شرکت‌کننده بفرستید.</t>
                            </section>
                            <section t-if="open_link" class="ts-card" aria-labelledby="tsp-i-link">
                                <h2 id="tsp-i-link" class="h5">پیوند دعوت</h2>
                                <p class="tsp-inline">
                                    <input id="tsp_invite_url" type="text" readonly="readonly" class="ts-copy" dir="ltr" t-att-value="url" aria-label="پیوند دعوت"/>
                                    <button type="button" class="ts-btn ts-btn--outline" data-tsp-copy="tsp_invite_url" hidden="hidden">رونوشت پیوند</button>
                                    <span class="tsp-field__hint" role="status" data-tsp-copied="1"></span>
                                </p>
                                <img t-attf-src="/my/workspaces/#{ws.id}/invites/#{a.id}/qr.png" width="200" height="200" alt="کد QR پیوند دعوت برای اسکن با گوشی" class="tsp-qr"/>
                            </section>
                            <section class="ts-card" aria-labelledby="tsp-i-det">
                                <h2 id="tsp-i-det" class="h5">جزئیات</h2>
                                <dl class="tsp-dl">
                                    <dt>ارسال</dt><dd t-out="jalali(a.create_date)"/>
                                    <dt>کانال</dt><dd t-out="channel_label"/>
                                    <dt>انقضا</dt><dd><t t-if="a.expires_at" t-out="jalali(a.expires_at)"/><t t-else="">—</t></dd>
                                    <dt t-if="a.opened_at">نخستین بازشدن</dt><dd t-if="a.opened_at" t-out="jalali(a.opened_at)"/>
                                    <dt t-if="a.note">یادداشت</dt><dd t-if="a.note" t-out="a.note"/>
                                    <dt>مهلت</dt><dd><t t-if="deadline_fa" t-out="deadline_fa"/><t t-else="">—</t></dd>
                                    <dt t-if="a.sms_consent">پیامک دعوت</dt><dd t-if="a.sms_consent"><t t-if="a.sms_sent_at">ارسال شد</t><t t-elif="a.sms_error">نرسید</t><t t-else="">ارسال نشده</t></dd>
                                    <dt t-if="a.reminder_count">یادآوری‌ها</dt><dd t-if="a.reminder_count"><t t-out="fa(a.reminder_count)"/> بار، آخرین: <t t-out="jalali(a.last_reminder_at)"/></dd>
                                </dl>
                                <p t-if="level != 'none' and a.attempt_id"><a t-attf-href="/my/workspaces/#{ws.id}/clients/#{a.client_id.id}/r/#{a.attempt_id.id}" class="ts-btn ts-btn--outline">دیدن نتیجه</a></p>
                            </section>
                            <section t-if="can_manage and a.state in ('invited', 'opened', 'accepted', 'in_progress')" class="ts-card" aria-labelledby="tsp-i-rem">
                                <h2 id="tsp-i-rem" class="h5">یادآوری</h2>
                                <p class="ts-hint">به شرکت‌کننده‌ای که حساب دارد یا با پیامکِ موافقت‌شده، یک یادآوری می‌فرستد. در هر ۲۴ ساعت یکی و در کل حداکثر ۳ تا؛ در ساعت‌های ۲۱ تا ۸ فرستاده نمی‌شود.</p>
                                <form t-attf-action="/my/workspaces/#{ws.id}/invites/#{a.id}/remind" method="post" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="ts-btn ts-btn--outline">فرستادن یادآوری</button>
                                </form>
                            </section>
                            <section t-if="can_manage" class="ts-card" aria-labelledby="tsp-i-ext">
                                <h2 id="tsp-i-ext" class="h5">تمدید</h2>
                                <form t-attf-action="/my/workspaces/#{ws.id}/invites/#{a.id}/extend" method="post" class="tsp-inline" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <label for="tsp_days">مدت</label>
                                    <select id="tsp_days" name="days"><option t-foreach="days_options" t-as="d" t-att-value="d" t-att-selected="'selected' if d == 30 else None"><t t-out="fa(d)"/> روز از امروز</option></select>
                                    <button type="submit" class="ts-btn ts-btn--outline">تمدید دعوت</button>
                                </form>
                            </section>
                            <section t-if="can_withdraw" class="ts-card" aria-labelledby="tsp-i-wd">
                                <h2 id="tsp-i-wd" class="h5">لغو دعوت</h2>
                                <form t-attf-action="/my/workspaces/#{ws.id}/invites/#{a.id}/withdraw" method="post" class="tsp-form" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p class="ts-hint">پیوند از کار می‌افتد. اگر شرکت‌کننده شروع کرده باشد، پاسخ‌هایش دست‌نخورده می‌ماند.</p>
                                    <label class="tsp-check"><input type="checkbox" name="confirm" value="1"/><span>مطمئنم، این دعوت لغو شود</span></label>
                                    <p><button type="submit" class="ts-btn ts-btn--outline">لغو دعوت</button></p>
                                </form>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
