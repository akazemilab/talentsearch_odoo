<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/campaigns: list (INV-5, INV-6) -->
    <record id="tpl_campaigns" model="ir.ui.view">
        <field name="name">TS panel: campaigns</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.campaigns</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.campaigns">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">دعوت گروهی</h1>
                                    <p class="tsp-head__help">یک سنجه را برای همهٔ اعضای یک <t t-out="group_word"/> بفرستید (فهرست)، یا یک «پیوند باز» بسازید که هر کس آن را داشته باشد تا سقفی که تعیین می‌کنید بپیوندد.</p>
                                </div>
                                <div class="tsp-head__actions">
                                    <a t-attf-href="/my/workspaces/#{ws.id}/campaigns/new" class="ts-btn ts-btn--primary">دعوت گروهی تازه</a>
                                </div>
                            </header>
                            <p t-if="not rows" class="tsp-empty">برای دعوت یک <t t-out="group_word"/>، دعوت گروهی بسازید.</p>
                            <div t-if="rows" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">فهرست دعوت‌های گروهی</caption>
                                    <thead><tr><th scope="col">عنوان</th><th scope="col">نوع</th><th scope="col">سنجه</th><th scope="col">پیشرفت</th><th scope="col">وضعیت</th><th scope="col">ساخته‌شده</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="c">
                                            <th scope="row" data-label="عنوان"><a t-attf-href="/my/workspaces/#{ws.id}/campaigns/#{c.id}"><bdi t-out="c.name"/></a></th>
                                            <td data-label="نوع" t-out="kind_labels[c.kind]"/>
                                            <td data-label="سنجه" t-out="c.instrument_id.ts_title()"/>
                                            <td data-label="پیشرفت">
                                                <t t-set="tot" t-value="joined.get(c.id, 0)"/>
                                                <t t-if="c.kind == 'open_link'">پیوسته <t t-out="fa(tot)"/> از <t t-out="fa(c.open_max)"/><t t-call="ts_website.sep"/></t>
                                                <t t-out="fa(done.get(c.id, 0))"/> از <t t-out="fa(tot)"/> تکمیل
                                                <span t-if="tot" class="tsp-progress" aria-hidden="true"><span t-attf-style="inline-size: #{round(100.0 * done.get(c.id, 0) / tot)}%"></span></span>
                                            </td>
                                            <td data-label="وضعیت"><span class="ts-pill" t-out="state_c[c.state]"/></td>
                                            <td data-label="ساخته‌شده" t-out="jalali(c.create_date)"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <nav t-if="pages &gt; 1" class="tsp-pager" aria-label="صفحه‌بندی">
                                <a t-if="page &gt; 1" t-attf-href="/my/workspaces/#{ws.id}/campaigns?page=#{page - 1}" rel="prev">صفحهٔ قبل</a>
                                <span aria-current="page">صفحهٔ <t t-out="fa(page)"/> از <t t-out="fa(pages)"/></span>
                                <a t-if="page &lt; pages" t-attf-href="/my/workspaces/#{ws.id}/campaigns?page=#{page + 1}" rel="next">صفحهٔ بعد</a>
                            </nav>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- W/campaigns/new: one form, then a review -->
    <record id="tpl_campaign_form" model="ir.ui.view">
        <field name="name">TS panel: campaign form</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.campaign_form</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.campaign_form">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">دعوت گروهی تازه</h1>
                                    <p class="tsp-head__help">پس از این فرم یک صفحهٔ مرور می‌بینید؛ تا آن‌جا چیزی ساخته یا فرستاده نمی‌شود.</p>
                                </div>
                            </header>
                            <form t-attf-action="/my/workspaces/#{ws.id}/campaigns/new" method="post" class="tsp-form ts-card" data-tsp-once="1" id="tsp-c-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="step" value="review"/>
                                <fieldset class="tsp-field">
                                    <legend class="tsp-field__label">چه کسانی دعوت شوند؟</legend>
                                    <!-- without groups the list cannot succeed: the open link is the default (G6-P2-1); the list option
                                         says what to do first. The list label follows the panel's people (G6-P2-2). -->
                                    <t t-set="kind_now" t-value="draft.get('kind') or default_kind"/>
                                    <label class="tsp-radio"><input type="radio" name="kind" value="open_link" t-att-checked="'checked' if kind_now == 'open_link' else None"/><span><strong>پیوند باز</strong>: هر کس که پیوند را داشته باشد می‌پیوندد، تا سقفی که می‌گذارید</span></label>
                                    <label class="tsp-radio"><input type="radio" name="kind" value="list" t-att-checked="'checked' if kind_now == 'list' else None"/><span><strong t-out="kind_labels['list']"/>: برای همهٔ اعضای گروه‌های انتخابی دعوت جداگانه ساخته می‌شود<t t-if="not groups"><span class="tsp-field__hint tsp-radio__blurb">اول یک گروه بسازید: <a t-attf-href="/my/workspaces/#{ws.id}/groups">گروه‌ها</a></span></t></span></label>
                                </fieldset>
                                <label class="tsp-field"><span class="tsp-field__label">عنوان</span><input type="text" name="name" maxlength="80" required="required" t-att-value="draft.get('name')" class="form-control"/></label>
                                <!-- a long catalog gets a filter box (G7-P5-3), the same one as step 2 of the invitation wizard -->
                                <div class="tsp-field tsp-pickfilter" data-tsp-pickfilter="tsp-c-form" hidden="hidden">
                                    <label class="tsp-field__label" for="tsp_c_pick_q">جست‌وجو در سنجه‌ها</label>
                                    <input id="tsp_c_pick_q" type="search" class="form-control" autocomplete="off" aria-controls="tsp-c-form" aria-describedby="tsp_c_pick_n"/>
                                    <p id="tsp_c_pick_n" class="tsp-field__hint" role="status"></p>
                                </div>
                                <fieldset class="tsp-field">
                                    <legend class="tsp-field__label">سنجه</legend>
                                    <label t-foreach="instruments" t-as="i" class="tsp-radio"><input type="radio" name="instrument_id" t-att-value="i.id" required="required" t-att-checked="'checked' if (draft.get('instrument_id') == i.id or len(instruments) == 1) else None"/><span t-out="i.ts_title()"/></label>
                                </fieldset>
                                <fieldset class="tsp-field tsp-kind-box" data-ts-show="kind=list">
                                    <legend class="tsp-field__label">فقط برای فهرست: گروه‌ها</legend>
                                    <p t-if="not groups" class="ts-hint">هنوز گروهی نساخته‌اید. <a t-attf-href="/my/workspaces/#{ws.id}/groups">گروه بسازید</a>.</p>
                                    <label t-foreach="groups" t-as="g" t-attf-class="tsp-check #{'is-disabled' if not g.client_count else ''}"><input type="checkbox" name="group_ids" t-att-value="g.id" t-att-checked="'checked' if g.id in draft.get('group_ids', []) and g.client_count else None" t-att-disabled="'disabled' if not g.client_count else None"/><span><bdi t-out="g.name"/> (<t t-if="g.client_count"><t t-out="fa(g.client_count)"/> نفر</t><t t-else="">بدون عضو</t>)</span></label>
                                    <fieldset t-if="sms_ok" class="tsp-field">
                                        <legend class="tsp-field__label">پیامک</legend>
                                        <label class="tsp-check"><input type="checkbox" name="sms" value="1" t-att-checked="'checked' if draft.get('sms') else None"/><span>پیوند دعوت را با پیامک هم بفرست (فقط برای کسانی که موبایل ثبت‌شده دارند)</span></label>
                                        <div class="tsp-check-sub" data-ts-show="sms=1">
                                            <label class="tsp-check"><input type="checkbox" name="attest" value="1" t-att-checked="'checked' if draft.get('sms') else None"/><span>تأیید می‌کنم که شرکت‌کنندگان (یا ولی آنان) با دریافت پیامک موافق‌اند؛ این تأیید شامل یک پیامک دعوت و یک یادآوری است.</span></label>
                                            <label class="tsp-check"><input type="checkbox" name="remind" value="1" t-att-checked="'checked' if draft.get('remind', True) else None"/><span>یک یادآوری پیامکی هم فرستاده شود</span></label>
                                        </div>
                                    </fieldset>
                                </fieldset>
                                <fieldset class="tsp-field tsp-kind-box" data-ts-show="kind=open_link">
                                    <legend class="tsp-field__label">فقط برای پیوند باز</legend>
                                    <label class="tsp-field"><span class="tsp-field__label">بیشترین تعداد نفرات (۱ تا ۵۰۰)</span><input type="text" name="open_max" inputmode="numeric" maxlength="3" t-att-value="fa(draft.get('open_max') or open_default)" class="form-control"/></label>
                                    <label class="tsp-field"><span class="tsp-field__label">پیوند تا چند روز باز بماند</span>
                                        <select name="open_days" class="form-select"><option value="7" t-att-selected="'selected' if draft.get('open_days') == 7 else None">۷ روز</option><option value="14" t-att-selected="'selected' if draft.get('open_days', 14) == 14 else None">۱۴ روز</option><option value="30" t-att-selected="'selected' if draft.get('open_days') == 30 else None">۳۰ روز</option></select></label>
                                </fieldset>
                                <div class="tsp-field">
                                    <t t-call="ts_website.jdate" jd_name.f="deadline" jd_id.f="tsp_c_deadline" jd_label.f="مهلت پاسخ (اختیاری)" jd_value="draft.get('deadline') or False"/>
                                </div>
                                <label class="tsp-field"><span class="tsp-field__label">یادداشت برای <t t-out="people"/> (اختیاری)</span><input type="text" name="note" maxlength="300" t-att-value="draft.get('note')" class="form-control"/></label>
                                <div class="tsp-actions">
                                    <button type="submit" class="ts-btn ts-btn--primary">مرور</button>
                                    <a t-attf-href="/my/workspaces/#{ws.id}/campaigns" class="ts-btn ts-btn--quiet tsp-actions__end">انصراف</a>
                                </div>
                            </form>
                            <t t-call="ts_org.reveal_js"/>
                            <t t-call="ts_panel.daily_js"/>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_campaign_review" model="ir.ui.view">
        <field name="name">TS panel: campaign review</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.campaign_review</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.campaign_review">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">مرور پیش از ساخت</h1>
                                    <p class="tsp-head__help">اگر درست است «ساخت» را بزنید؛ در غیر این صورت برگردید و فرم را اصلاح کنید.</p>
                                </div>
                            </header>
                            <form t-attf-action="/my/workspaces/#{ws.id}/campaigns/new" method="post" class="tsp-form ts-card" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="step" value="create"/>
                                <dl class="tsp-dl">
                                    <dt>عنوان</dt><dd t-out="draft['name']"/>
                                    <dt>نوع</dt><dd t-out="kind_labels[draft['kind']]"/>
                                    <dt>سنجه</dt><dd t-out="inst.name"/>
                                    <dt t-if="draft.get('deadline')">مهلت</dt><dd t-if="draft.get('deadline')" t-out="deadline_fa"/>
                                    <dt t-if="draft.get('note')">یادداشت</dt><dd t-if="draft.get('note')" t-out="draft['note']"/>
                                    <t t-if="draft['kind'] == 'list'">
                                        <dt>گروه‌ها</dt><dd t-out="'، '.join(groups.mapped('name'))"/>
                                        <dt>دعوت می‌شوند</dt><dd><strong t-out="fa(len(to_invite))"/> نفر از <t t-out="fa(len(clients))"/> نفر</dd>
                                        <dt>پیامک</dt><dd><t t-if="draft.get('sms')">بله، با تأیید رضایت</t><t t-else="">نه؛ پیوندها را خودتان می‌فرستید</t></dd>
                                    </t>
                                    <t t-else="">
                                        <dt>بیشترین تعداد نفرات</dt><dd t-out="fa(draft['open_max'])"/>
                                        <dt>پیوند باز می‌ماند</dt><dd><t t-out="fa(draft.get('open_days', 14))"/> روز</dd>
                                    </t>
                                </dl>
                                <t t-if="draft['kind'] == 'list'">
                                    <t t-foreach="skipped.items()" t-as="kv">
                                        <p t-if="kv[1]" class="ts-notice" role="status"><t t-out="fa(len(kv[1]))"/> نفر کنار گذاشته می‌شوند چون <t t-out="skip_labels[kv[0]]"/>: <t t-out="'، '.join(kv[1][:10].mapped('name'))"/><t t-if="len(kv[1]) &gt; 10"> و …</t></p>
                                    </t>
                                    <p t-if="not to_invite" class="ts-notice" role="alert">کسی برای دعوت نمانده است.</p>
                                    <p t-if="minors" class="ts-notice" id="ts-guardian-box"><label class="tsp-check"><input type="checkbox" name="guardian_ok" value="1" required="required"/><span>رضایت ولی (پدر، مادر یا سرپرست قانونی) <t t-out="fa(len(minors))"/> شرکت‌کنندهٔ زیر ۱۸ سال را گرفته‌ایم و نزد ما محفوظ است.</span></label> <a class="tsp-what" href="/help/panel#minors">این چیست؟</a></p>
                                </t>
                                <div class="tsp-actions">
                                    <a t-attf-href="/my/workspaces/#{ws.id}/campaigns/new?keep=1" class="ts-btn ts-btn--quiet tsp-prev">برگشت به فرم</a>
                                    <button t-if="draft['kind'] != 'list' or to_invite" type="submit" class="ts-btn ts-btn--primary">ساخت دعوت گروهی</button>
                                    <a t-attf-href="/my/workspaces/#{ws.id}/campaigns" class="ts-btn ts-btn--quiet tsp-actions__end">انصراف</a>
                                </div>
                            </form>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- W/campaigns/<id>: counts, link, list (INV-9) -->
    <record id="tpl_campaign" model="ir.ui.view">
        <field name="name">TS panel: campaign page</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.campaign</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.campaign">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <t t-set="empty_list" t-value="c.kind == 'list' and not total"/>
                            <a t-attf-href="/my/workspaces/#{ws.id}/campaigns" class="ts-backlink">دعوت گروهی</a>
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title"><bdi t-out="c.name"/></h1>
                                    <p class="tsp-head__help"><span class="ts-pill" t-out="state_c[c.state]"/><t t-call="ts_website.sep"/><t t-out="kind_labels[c.kind]"/><t t-call="ts_website.sep"/><t t-out="c.instrument_id.name"/><t t-if="deadline_fa"><t t-call="ts_website.sep"/>مهلت پاسخ تا <t t-out="deadline_fa"/></t></p>
                                </div>
                                <!-- an open link prints from its own card, under the QR (G6-P3-1) -->
                                <div t-if="not empty_list and c.kind != 'open_link'" class="tsp-head__actions">
                                    <a t-attf-href="/my/workspaces/#{ws.id}/campaigns/#{c.id}/sheet" class="ts-btn ts-btn--outline">برگهٔ چاپی</a>
                                </div>
                            </header>
                            <section t-if="c.kind == 'open_link'" class="ts-card" aria-labelledby="tsp-c-link">
                                <h2 id="tsp-c-link" class="h5">پیوند باز</h2>
                                <p t-if="open_state == 'ok'" class="tsp-inline">
                                    <input id="tsp_campaign_url" type="text" readonly="readonly" class="ts-copy" dir="ltr" t-att-value="url" aria-label="پیوند باز"/>
                                    <button type="button" class="ts-btn ts-btn--primary" data-tsp-copy="tsp_campaign_url" hidden="hidden">رونوشت پیوند</button>
                                    <button type="button" class="ts-btn ts-btn--outline" data-tsp-share="tsp_campaign_url" t-att-data-tsp-share-title="c.name" hidden="hidden">هم‌رسانی پیوند</button>
                                    <span class="tsp-field__hint" role="status" data-tsp-copied="1"></span>
                                </p>
                                <p t-if="open_state != 'ok'" class="ts-notice" role="status">
                                    <t t-if="open_state == 'full'">ظرفیت تکمیل شد؛ کسی دیگر نمی‌پیوندد.</t>
                                    <t t-elif="open_state == 'expired'">مهلت پیوند به پایان رسید.</t>
                                    <t t-else="">این دعوت گروهی پایان یافته است.</t>
                                </p>
                                <a t-if="open_state == 'ok'" t-attf-href="/my/workspaces/#{ws.id}/campaigns/#{c.id}/sheet" class="tsp-qr-link">
                                    <img t-attf-src="/my/workspaces/#{ws.id}/campaigns/#{c.id}/qr.png" width="200" height="200" alt="کد QR پیوند باز؛ برای نمایش بزرگ بزنید" class="tsp-qr"/>
                                    <span>نمایش بزرگ برای اسکن</span>
                                </a>
                                <p class="tsp-row-actions"><a t-attf-href="/my/workspaces/#{ws.id}/campaigns/#{c.id}/sheet" class="ts-btn ts-btn--outline">برگهٔ چاپی</a></p>
                                <dl class="tsp-dl">
                                    <dt>پیوسته‌اند</dt><dd><t t-out="fa(joined)"/> از <t t-out="fa(c.open_max)"/></dd>
                                    <dt>پیوند باز است تا</dt><dd><t t-if="c.open_expires_at" t-out="jalali(c.open_expires_at)"/><t t-else="">تعیین نشده</t></dd>
                                </dl>
                            </section>
                            <ul t-if="total" class="tsp-counts" aria-label="شمار دعوت‌ها بر اساس وضعیت">
                                <li t-foreach="state_order" t-as="k" t-attf-class="#{'is-zero' if not counts[k] else ''}"><span t-out="state_labels[k]"/> <strong class="ts-num" t-out="fa(counts[k])"/></li>
                            </ul>
                            <div t-if="empty_list" class="tsp-empty">
                                <p>هنوز دعوتی در این دعوت گروهی ساخته نشده است؛ گروه انتخاب‌شده هنگام ساخت عضوی نداشت که بتوان دعوتش کرد.</p>
                                <p t-if="groups" class="tsp-row-actions">
                                    <a t-foreach="groups" t-as="g" t-attf-href="/my/workspaces/#{ws.id}/groups/#{g.id}" class="ts-btn ts-btn--outline">گروه «<bdi t-out="g.name"/>»</a>
                                </p>
                                <p class="ts-hint">افراد را به گروه اضافه کنید و یک دعوت گروهی تازه بسازید.</p>
                            </div>
                            <p t-elif="not rows" class="tsp-empty">هنوز کسی با این پیوند نپیوسته است.</p>
                            <div t-if="rows" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">دعوت‌های این دعوت گروهی</caption>
                                    <thead><tr><th scope="col">شرکت‌کننده</th><th scope="col">وضعیت</th><th scope="col">ساخته‌شده</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="a">
                                            <th scope="row" data-label="شرکت‌کننده"><a t-attf-href="/my/workspaces/#{ws.id}/invites/#{a.id}"><bdi t-out="a.invitee_name"/></a></th>
                                            <td data-label="وضعیت"><span t-attf-class="ts-pill #{pill.get(a.state, '')}" t-out="state_labels.get(a.state, a.state)"/></td>
                                            <td data-label="ساخته‌شده" t-out="jalali(a.create_date)"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <p t-if="total &gt; len(rows)" class="ts-hint">صد دعوت نخست نشان داده شد؛ فهرست کامل در صفحهٔ <a t-attf-href="/my/workspaces/#{ws.id}/invites">دعوت‌ها</a> است.</p>
                            <section t-if="can_close" class="ts-card" aria-labelledby="tsp-c-close">
                                <h2 id="tsp-c-close" class="h5">پایان دادن به این دعوت گروهی</h2>
                                <form t-attf-action="/my/workspaces/#{ws.id}/campaigns/#{c.id}/close" method="post" class="ts-confirm" data-tsp-once="1" role="group" aria-labelledby="tsp-c-close-t">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p class="ts-confirm__title" id="tsp-c-close-t">پایان «<bdi t-out="c.name"/>»</p>
                                    <p class="ts-confirm__consequence">پس از پایان، کسی دیگر نمی‌پیوندد و یادآوری فرستاده نمی‌شود. دعوت‌هایی که ساخته شده‌اند لغو نمی‌شوند و هنوز می‌توان به آن‌ها پاسخ داد. این کار برگشت ندارد.</p>
                                    <label class="ts-check"><input type="checkbox" name="confirm" value="1" required="required"/><span>مطمئنم، این دعوت گروهی پایان یابد</span></label>
                                    <div class="ts-confirm__actions"><button type="submit" class="ts-btn ts-btn--danger-outline">پایان دعوت گروهی</button></div>
                                </form>
                            </section>
                            <t t-call="ts_panel.daily_js"/>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- printable sheet of links and QR codes -->
    <record id="tpl_campaign_sheet" model="ir.ui.view">
        <field name="name">TS panel: campaign sheet</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.campaign_sheet</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.campaign_sheet">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <a t-attf-href="/my/workspaces/#{ws.id}/campaigns/#{c.id}" class="ts-backlink tsp-noprint"><bdi t-out="c.name"/></a>
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title"><bdi t-out="c.name"/></h1>
                                    <p class="tsp-head__help">هر کس با اسکن کد یا باز کردن پیوند وارد می‌شود.<span class="tsp-noprint"> اگر دکمهٔ چاپ کار نکرد، از منوی مرورگر «چاپ» را بزنید.</span></p>
                                </div>
                                <div class="tsp-head__actions tsp-noprint">
                                    <button type="button" class="ts-btn ts-btn--primary" data-tsp-print="1" hidden="hidden">چاپ برگه</button>
                                </div>
                            </header>
                            <section t-if="c.kind == 'open_link'" class="ts-card">
                                <p t-if="not open_ok" class="ts-notice" role="status">این پیوند دیگر باز نیست.</p>
                                <t t-if="open_ok">
                                    <img t-attf-src="/my/workspaces/#{ws.id}/campaigns/#{c.id}/qr.png" width="240" height="240" alt="کد QR پیوند باز" class="tsp-qr tsp-qr--big"/>
                                    <p dir="ltr" class="ts-copy" t-out="url"/>
                                </t>
                            </section>
                            <div t-if="c.kind == 'list' and not invs" class="tsp-empty">
                                <p>این دعوت گروهی هنوز دعوتی ندارد که چاپ شود. ابتدا افراد را به گروه اضافه کنید.</p>
                                <p t-if="groups" class="tsp-row-actions"><a t-foreach="groups" t-as="g" t-attf-href="/my/workspaces/#{ws.id}/groups/#{g.id}" class="ts-btn ts-btn--outline">گروه «<bdi t-out="g.name"/>»</a></p>
                            </div>
                            <section t-foreach="invs" t-as="a" class="ts-card">
                                <h2 class="h5"><bdi t-out="a.invitee_name"/></h2>
                                <img t-attf-src="/my/workspaces/#{ws.id}/invites/#{a.id}/qr.png" width="160" height="160" alt="کد QR دعوت" class="tsp-qr"/>
                                <p dir="ltr" class="ts-copy" t-out="a.invite_url()"/>
                            </section>
                            <t t-call="ts_panel.daily_js"/>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- /c/<token>: the open link, participant side. UX T7: who invites, size and time (ts_org effort_facts), the
         instant-result promise and the button on the first phone screen; «what the panel sees» folded after it; a closed,
         expired or full link is a ts_website.state_card with a next step. -->
    <record id="tpl_campaign_join" model="ir.ui.view">
        <field name="name">TS panel: open link</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.campaign_join</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.campaign_join">
                <t t-call="website.layout" additional_title.f="دعوت به سنجه">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-narrow ts-invite">
                                <t t-set="student" t-value="ws.purpose == 'education'"/>
                                <t t-set="matrix" t-value="inst.code == 'TALENT-INV-15'"/>
                                <t t-set="open_ok" t-value="state == 'ok' or mine"/>
                                <t t-set="inv_verb" t-value="'دعوت کرده است' if open_ok else 'دعوت کرده بود'"/>
                                <div class="ts-section__head">
                                    <p class="ts-tag">دعوت به سنجه</p>
                                    <h1 t-out="inst.title"/>
                                    <p t-if="student"><strong t-out="ws.ts_public_name()"/> تو را به پاسخ‌دادن به این سنجه <t t-out="inv_verb"/>.</p>
                                    <p t-else=""><strong t-out="ws.ts_public_name()"/> شما را به پاسخ‌دادن به این سنجه <t t-out="inv_verb"/>.</p>
                                    <p t-if="open_ok" class="ts-invite__facts" id="ts-invite-facts"><t t-out="facts['size']"/><t t-call="ts_website.sep"/><t t-out="facts['time']"/><t t-call="ts_website.sep"/>نتیجه بلافاصله پس از پایان آماده است.</p>
                                </div>
                                <p t-if="flash" class="ts-notice" role="alert" t-out="flash"/>
                                <t t-if="not open_ok">
                                    <t t-call="ts_website.state_card" sc_title="card['title']" sc_text="card['text']" sc_note="card['note']" sc_public="public"/>
                                </t>
                                <t t-else="">
                                    <dl t-if="c.note" class="ts-meta">
                                        <dt>یادداشت پنل</dt><dd t-out="c.note"/>
                                    </dl>
                                    <div class="ts-invite__act" id="ts-invite-act">
                                        <t t-if="public">
                                            <p t-if="student">برای شروع وارد حسابت شو یا حساب تازه بساز. گزارش نتیجه در حسابت می‌ماند.</p>
                                            <p t-else="">برای شروع وارد حساب خود شوید یا حساب تازه بسازید. گزارش نتیجه در حساب شما نگه داشته می‌شود.</p>
                                            <t t-call="ts_website.auth_choices" phone_url="phone_url" login_url="login_url" signup_url="signup_url"/>
                                        </t>
                                        <form t-else="" t-attf-action="/c/#{c.open_token}/join" method="post" class="ts-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <label class="ts-field"><span>نام و نام خانوادگی</span><input type="text" name="name" required="required" minlength="2" maxlength="120" t-att-value="user_name" class="form-control" autocomplete="name" aria-describedby="ts-c-name-h"/></label>
                                            <!-- who sees the name (W52) -->
                                            <p id="ts-c-name-h" class="ts-hint">«<bdi t-out="ws.ts_public_name()"/>» <t t-if="student">تو را با این نام می‌شناسد.</t><t t-else="">شما را با این نام می‌شناسد.</t></p>
                                            <button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">ادامه</button>
                                            <!-- the next screen is the invitation (tick + accept), then consent (audit P11-1, interim copy) -->
                                            <p class="ts-hint" id="ts-invite-next"><t t-if="student">بعد از «ادامه»، دعوت را می‌پذیری و صفحهٔ کوتاه رضایت را می‌بینی؛ بعد پرسش‌ها شروع می‌شود.</t><t t-else="">بعد از «ادامه»، دعوت را می‌پذیرید و صفحهٔ کوتاه رضایت را می‌بینید؛ بعد پرسش‌ها شروع می‌شود.</t></p>
                                        </form>
                                    </div>
                                    <t t-call="ts_org.share_box" share_ws="ws" share_student="student"/>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
