<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The two SMS kinds of S10 ship switched OFF; the owner turns them on after reading the texts (NOT-5b). -->
    <record id="res_config_settings_view_form_ts_panel_notify" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ts.panel.notify</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ts_sms.res_config_settings_view_form_ts_sms"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ts_sms_otp']/.." position="after">
                <div><field name="ts_sms_reminder"/> <label for="ts_sms_reminder"/></div>
                <div><field name="ts_sms_staff"/> <label for="ts_sms_staff"/></div>
            </xpath>
        </field>
    </record>
</odoo>
