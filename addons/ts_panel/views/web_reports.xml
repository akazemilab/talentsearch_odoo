<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/clients/<cid>/r/<attempt>: one result, by level (REP-1, REP-2); W/reports: entry; W/reports/group: counts (REP-4, REP-5) -->
    <record id="tpl_result_bands" model="ir.ui.view">
        <field name="name">TS panel: result by level</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.result_bands</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.result_bands">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page" t-att-data-tsp-autoprint="1 if autoprint else None">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title"><t t-out="inst.ts_title()"/> — <t t-out="client.name"/></h1>
                                    <p class="tsp-head__help"><span class="ts-pill" t-out="kind"/><t t-if="when"><t t-call="ts_website.sep"/><t t-out="jalali(when, with_time=False)"/></t></p>
                                </div>
                                <form t-if="level != 'status'" method="post" t-att-action="print_url" class="tsp-inline tsp-noprint">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="ts-btn ts-btn--quiet">چاپ همین صفحه</button>
                                </form>
                            </header>
                            <t t-call="ts_panel.result_bands_body"/>
                            <t t-if="level != 'status'">
                                <section t-if="viewers is not None" class="ts-card tsp-noprint" aria-labelledby="tsp-r-v">
                                    <h2 id="tsp-r-v" class="h5">چه کسانی این نتیجه را دیده‌اند</h2>
                                    <p t-if="not viewers" class="ts-hint">هنوز کسی این نتیجه را باز نکرده است.</p>
                                    <ul t-if="viewers"><li t-foreach="viewers" t-as="v"><t t-out="v[1]"/> · <t t-out="v[0]"/></li></ul>
                                </section>
                                <section class="ts-card">
                                    <h2 class="h5">محدودیت‌ها</h2>
                                    <p t-out="inst.limitations"/>
                                    <p class="ts-hint">مشاهدهٔ این صفحه ثبت می‌شود. شناسهٔ گزارش <bdi dir="ltr" t-out="attempt.name"/></p>
                                </section>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- The level-dependent part of one result (status note, band table, counselor guide at level clinical). Called by
         ts_panel.result_bands and by ts_battery's panel battery page (one call per instrument, same level for all).
         Params: level, results; optional blk_id (heading id prefix), blk_sub (headings one level lower). -->
    <record id="tpl_result_bands_body" model="ir.ui.view">
        <field name="name">TS panel: result body by level</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.result_bands_body</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.result_bands_body">
                            <section t-if="level == 'status'" class="ts-card">
                                <!-- A5b (kept in onb1, privacy not approval): a counseling-center owner who does not counsel sees status only; say why -->
                                <p t-if="member and member.role == 'owner' and member.workspace_id.purpose == 'clinical' and not member.owner_practices">شما مالک این مرکز هستید و خودتان مشاوره نمی‌دهید؛ برای حفظ حریم مراجعان، گزارش را فقط مشاوران مرکز می‌خوانند و شما وضعیت دعوت‌ها را می‌بینید. اگر خودتان هم مشاوره می‌دهید، در صفحهٔ عضویت خود «خودم هم مسئول مراجعان هستم» را روشن کنید.</p>
                                <p t-else="">این سنجه تکمیل شده، اما نتیجه‌اش برای نقش شما قابل نمایش نیست یا شرکت‌کننده آن را به اشتراک نگذاشته است. فقط وضعیت دعوت در دسترس است.</p>
                            </section>
                            <t t-if="level != 'status'">
                                <section class="ts-card" t-att-aria-labelledby="(blk_id or 'tsp-r') + '-1'">
                                    <h3 t-if="blk_sub" t-att-id="(blk_id or 'tsp-r') + '-1'" class="h6">خلاصهٔ نتیجه‌ها</h3>
                                    <h2 t-else="" t-att-id="(blk_id or 'tsp-r') + '-1'" class="h5">خلاصهٔ نتیجه‌ها</h2>
                                    <p t-if="level in ('summary', 'education')" class="ts-hint">فقط سطح هر عامل نمایش داده می‌شود. نمره‌ها، پاسخ‌ها و متن‌های تفسیری شخصی نزد شرکت‌کننده می‌ماند. این نتیجه به‌تنهایی مبنای تصمیم نیست.</p>
                                    <p t-else="" class="ts-hint">نمرهٔ هر عامل میانگین پاسخ‌ها از ۱ تا ۵ است.</p>
                                    <table class="ts-table tsp-table">
                                        <caption class="tsp-sr">نتیجهٔ هر عامل</caption>
                                        <thead><tr><th scope="col">عامل</th><th t-if="level == 'clinical'" scope="col">نمره (۱ تا ۵)</th><th scope="col">سطح</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="results" t-as="r">
                                                <th scope="row" t-out="r.factor_id.name"/>
                                                <td t-if="level == 'clinical'" t-out="r.score_fa()"/>
                                                <td><span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </section>
                                <section t-if="level == 'clinical'" t-foreach="results" t-as="r" class="ts-card">
                                    <h3 t-if="blk_sub" class="h6" t-out="r.factor_id.name"/>
                                    <h2 t-else="" class="h5" t-out="r.factor_id.name"/>
                                    <t t-foreach="r.therapist_sections()" t-as="sec">
                                        <t t-if="sec[0]">
                                            <h4 t-if="blk_sub" class="h6" t-out="sec[0]"/>
                                            <h3 t-else="" class="h6" t-out="sec[0]"/>
                                        </t>
                                        <div t-out="sec[1]"/>
                                    </t>
                                </section>
                            </t>
            </t>
        </field>
    </record>

    <record id="tpl_reports" model="ir.ui.view">
        <field name="name">TS panel: reports entry</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.reports</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.reports">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">گزارش‌ها</h1>
                                    <p class="tsp-head__help"><t t-out="fa(max_rows)"/> نتیجهٔ آخری که می‌توانید ببینید. نتیجهٔ هر نفر از صفحهٔ خود او هم باز می‌شود.</p>
                                </div>
                                <a t-if="can_group" t-attf-href="/my/workspaces/#{ws.id}/reports/group" class="ts-btn ts-btn--outline">گزارش گروهی</a>
                            </header>
                            <form t-if="groups or instruments" method="get" class="ts-card tsp-form tsp-filters tsp-filters--grid" aria-label="پالایه‌های نتیجه‌ها">
                                <label t-if="groups" class="tsp-field"><span class="tsp-field__label">گروه</span>
                                    <select name="group_id" class="form-select"><option value="">همهٔ گروه‌ها</option>
                                        <option t-foreach="groups" t-as="g" t-att-value="g.id" t-att-selected="'selected' if params.get('group_id') == str(g.id) else None" t-out="fa(g.name)"/>
                                    </select></label>
                                <label class="tsp-field"><span class="tsp-field__label">سنجه</span>
                                    <select name="instrument_id" class="form-select"><option value="">همهٔ سنجه‌ها</option>
                                        <option t-foreach="instruments" t-as="i" t-att-value="i.id" t-att-selected="'selected' if params.get('instrument_id') == str(i.id) else None" t-out="i.ts_title()"/>
                                    </select></label>
                                <p class="tsp-field--wide"><button type="submit" class="ts-btn ts-btn--outline">نمایش</button>
                                    <a t-if="params" t-attf-href="/my/workspaces/#{ws.id}/reports" class="ts-btn ts-btn--quiet">حذف پالایه‌ها</a></p>
                            </form>
                            <section class="ts-card" aria-labelledby="tsp-rp-1">
                                <h2 id="tsp-rp-1" class="h5">نتیجه‌های اخیر <small class="ts-hint">(<t t-out="fa(len(rows))"/> مورد، حداکثر <t t-out="fa(max_rows)"/>)</small></h2>
                                <p t-if="not rows" class="ts-hint"><t t-if="params">با این پالایه نتیجه‌ای پیدا نشد.</t><t t-else="">هنوز نتیجه‌ای که بتوانید ببینید وجود ندارد.</t></p>
                                <div t-if="rows" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr"><t t-out="fa(max_rows)"/> نتیجهٔ آخر</caption>
                                    <thead><tr><th scope="col">شرکت‌کننده</th><th scope="col">سنجه</th><th scope="col">نوع گزارش</th><th scope="col">تاریخ</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="row">
                                            <th scope="row" data-label="شرکت‌کننده"><a t-attf-href="#{url(ws.id, row[0].client_id.id, row[0].id)}" t-out="row[0].client_id.name"/></th>
                                            <td data-label="سنجه" t-out="row[0].instrument_id.ts_title()"/>
                                            <td data-label="نوع گزارش" t-out="kinds.get(row[1], row[1])"/>
                                            <td data-label="تاریخ" t-out="jalali(row[0].submitted_at, with_time=False)"/>
                                        </tr>
                                    </tbody>
                                </table>
                                </div>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_group_report_next" model="ir.ui.view">
        <field name="name">TS panel: group report, how to get more results</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.group_report_next</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.group_report_next">
                <t t-if="can_invite"><a t-attf-href="/my/workspaces/#{ws.id}/campaigns/new" class="ts-btn ts-btn--outline ts-btn--sm">دعوت گروهی</a> </t>
                <a t-if="can_invite1" t-attf-href="/my/workspaces/#{ws.id}/invites" class="ts-btn ts-btn--quiet ts-btn--sm">دعوت‌ها</a>
                <span class="ts-hint">هر نتیجه‌ای که شرکت‌کننده با پنل به اشتراک بگذارد این‌جا شمرده می‌شود.</span>
            </t>
        </field>
    </record>

    <record id="tpl_group_report" model="ir.ui.view">
        <field name="name">TS panel: group report</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.group_report</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.group_report">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">گزارش گروهی</h1>
                                    <p class="tsp-head__help">فقط تعداد افراد در هر بازه؛ نتیجهٔ هیچ فردی دیده نمی‌شود. خانه‌های کمتر از <t t-out="fa(rep['k'])"/> نفر پنهان می‌شوند.</p>
                                </div>
                            </header>
                            <form method="get" class="ts-card tsp-form tsp-filters tsp-filters--grid" aria-label="پالایه‌ها">
                                <label class="tsp-field"><span class="tsp-field__label">گروه</span>
                                    <select name="group_id" class="form-select"><option value="">همه</option>
                                        <option t-foreach="groups" t-as="g" t-att-value="g.id" t-att-selected="'selected' if params.get('group_id') == str(g.id) else None" t-out="fa(g.name)"/>
                                    </select></label>
                                <label class="tsp-field"><span class="tsp-field__label">دعوت گروهی</span>
                                    <select name="campaign_id" class="form-select"><option value="">همه</option>
                                        <option t-foreach="campaigns" t-as="c" t-att-value="c.id" t-att-selected="'selected' if params.get('campaign_id') == str(c.id) else None" t-out="fa(c.name)"/>
                                    </select></label>
                                <label class="tsp-field"><span class="tsp-field__label">سنجه</span>
                                    <select name="instrument_id" class="form-select"><option value="">همه</option>
                                        <option t-foreach="instruments" t-as="i" t-att-value="i.id" t-att-selected="'selected' if params.get('instrument_id') == str(i.id) else None" t-out="i.ts_title()"/>
                                    </select></label>
                                <label class="tsp-field"><span class="tsp-field__label">بازهٔ زمانی</span>
                                    <select name="period" class="form-select">
                                        <option t-foreach="periods" t-as="p" t-att-value="p[0]" t-att-selected="'selected' if params.get('period', '0') == str(p[0]) else None" t-out="p[1]"/>
                                    </select></label>
                                <p class="tsp-field--wide"><button type="submit" class="ts-btn ts-btn--outline">نمایش</button></p>
                            </form>
                            <p t-if="rep['imported']" class="ts-hint">شامل نتیجه‌های واردشده از فایل</p>
                            <section t-if="not rep['instruments']" class="ts-card ts-card--soft tsp-empty-state">
                                <h2 class="h5">هنوز نتیجهٔ کافی نیست</h2>
                                <p t-out="rep['text']"/>
                                <p><t t-call="ts_panel.group_report_next"/></p>
                            </section>
                            <section t-foreach="rep['instruments']" t-as="ins" class="ts-card">
                                <h2 class="h5" t-out="ins['name']"/>
                                <p class="ts-hint"><t t-out="fa(ins['n'])"/> از <t t-out="fa(ins['m'])"/> نفر نتیجه را با پنل به اشتراک گذاشته‌اند.</p>
                                <div t-if="not ins['ok']" class="tsp-empty-state">
                                    <p><strong>هنوز نتیجهٔ کافی نیست.</strong> <t t-out="rep['text']"/> <t t-out="fa(rep['k'] - ins['n'])"/> نتیجهٔ دیگر لازم است.</p>
                                    <p><t t-call="ts_panel.group_report_next"/></p>
                                </div>
                                <table t-if="ins['factors']" class="ts-table tsp-table">
                                    <caption class="tsp-sr">تعداد افراد در هر سطح</caption>
                                    <thead><tr><th scope="col">عامل</th><th scope="col">کم</th><th scope="col">متوسط</th><th scope="col">زیاد</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="ins['factors']" t-as="f">
                                            <th scope="row" t-out="f['name']"/>
                                            <td t-foreach="['low', 'mid', 'high']" t-as="b"><t t-if="f['cells'][b] is None">—</t><t t-else="" t-out="fa(f['cells'][b])"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <t t-if="ins['talent']">
                                    <p class="ts-hint">میانگین گروه در هر مقیاس (۲۰ تا ۱۰۰) و تعداد افرادی که آن مقیاس برایشان بالاترین است.</p>
                                    <table class="ts-table tsp-table">
                                        <caption class="tsp-sr">مقیاس‌های نیمرخ استعداد</caption>
                                        <thead><tr><th scope="col">مقیاس</th><th scope="col">میانگین</th><th scope="col">بالاترین برای</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="['ANA', 'EXP', 'ACA', 'NOV', 'DUT']" t-as="s">
                                                <th scope="row" t-out="names[s]"/>
                                                <td t-out="fa(ins['talent']['means'][s])"/>
                                                <td><t t-if="ins['talent']['top'][s] is None">—</t><t t-else="" t-out="fa(ins['talent']['top'][s])"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
