<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/clients/<cid>/r/<attempt>: one result, by level (REP-1, REP-2); W/reports: entry; W/reports/group: counts (REP-4, REP-5) -->
    <record id="tpl_result_bands" model="ir.ui.view">
        <field name="name">TS panel: result by level</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.result_bands</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.result_bands">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page" t-att-data-tsp-autoprint="1 if autoprint else None">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <p class="tsp-noprint"><a t-att-href="back_url">بازگشت به شرکت‌کننده</a></p>
                                    <h1 class="tsp-head__title"><t t-out="inst.name"/> — <t t-out="client.name"/></h1>
                                    <p class="tsp-head__help"><span class="ts-pill" t-out="kind"/> <t t-if="when">· <t t-out="jalali(when, with_time=False)"/></t></p>
                                </div>
                                <form t-if="level != 'status'" method="post" t-att-action="print_url" class="tsp-inline tsp-noprint">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="ts-btn ts-btn--outline">چاپ یا ذخیره به‌صورت PDF</button>
                                </form>
                            </header>
                            <section t-if="level == 'status'" class="ts-card">
                                <p>این سنجه تکمیل شده، اما نتیجه‌اش برای نقش شما قابل نمایش نیست یا شرکت‌کننده آن را به اشتراک نگذاشته است. فقط وضعیت دعوت در دسترس است.</p>
                            </section>
                            <t t-if="level != 'status'">
                                <section class="ts-card" aria-labelledby="tsp-r-1">
                                    <h2 id="tsp-r-1" class="h5">خلاصهٔ نتایج</h2>
                                    <p t-if="level in ('summary', 'education')" class="ts-hint">فقط بازهٔ هر بُعد نمایش داده می‌شود. نمره‌ها، پاسخ‌ها و متن‌های تفسیری شخصی نزد شرکت‌کننده می‌ماند. این نتیجه به‌تنهایی مبنای تصمیم نیست.</p>
                                    <p t-else="" class="ts-hint">نمرهٔ هر بُعد میانگین پاسخ‌ها روی مقیاس ۱ تا ۵ است.</p>
                                    <table class="ts-table tsp-table">
                                        <caption class="tsp-sr">نتیجهٔ هر بُعد</caption>
                                        <thead><tr><th scope="col">بُعد</th><th t-if="level == 'clinical'" scope="col">نمره (۱ تا ۵)</th><th scope="col">بازه</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="results" t-as="r">
                                                <th scope="row" t-out="r.factor_id.name"/>
                                                <td t-if="level == 'clinical'" t-out="r.score_fa()"/>
                                                <td><span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </section>
                                <section t-if="level == 'clinical'" t-foreach="results" t-as="r" class="ts-card">
                                    <h2 class="h5" t-out="r.factor_id.name"/>
                                    <t t-foreach="r.therapist_sections()" t-as="sec">
                                        <h3 t-if="sec[0]" class="h6" t-out="sec[0]"/>
                                        <div t-out="sec[1]"/>
                                    </t>
                                </section>
                                <section class="ts-card">
                                    <h2 class="h5">محدودیت‌ها</h2>
                                    <p t-out="inst.limitations"/>
                                    <p class="ts-hint">مشاهدهٔ این صفحه ثبت می‌شود. شناسهٔ گزارش <bdi dir="ltr" t-out="attempt.name"/></p>
                                </section>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_reports" model="ir.ui.view">
        <field name="name">TS panel: reports entry</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.reports</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.reports">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">گزارش‌ها</h1>
                                    <p class="tsp-head__help">تازه‌ترین نتیجه‌هایی که می‌توانید ببینید. نتیجهٔ هر نفر از صفحهٔ خود او هم باز می‌شود.</p>
                                </div>
                                <a t-if="can_group" t-attf-href="/my/workspaces/#{ws.id}/reports/group" class="ts-btn ts-btn--outline">گزارش گروهی</a>
                            </header>
                            <section class="ts-card" aria-labelledby="tsp-rp-1">
                                <h2 id="tsp-rp-1" class="h5">نتیجه‌های اخیر</h2>
                                <p t-if="not rows" class="ts-hint">هنوز نتیجه‌ای که بتوانید ببینید وجود ندارد.</p>
                                <table t-if="rows" class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">نتیجه‌های اخیر</caption>
                                    <thead><tr><th scope="col">شرکت‌کننده</th><th scope="col">سنجه</th><th scope="col">سطح</th><th scope="col">تاریخ</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="row">
                                            <th scope="row" data-label="شرکت‌کننده"><a t-attf-href="#{url(ws.id, row[0].client_id.id, row[0].id)}" t-out="row[0].client_id.name"/></th>
                                            <td data-label="سنجه" t-out="row[0].instrument_id.name"/>
                                            <td data-label="سطح" t-out="kinds.get(row[1], row[1])"/>
                                            <td data-label="تاریخ" t-out="jalali(row[0].submitted_at, with_time=False)"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_group_report" model="ir.ui.view">
        <field name="name">TS panel: group report</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.group_report</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.group_report">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">گزارش گروهی</h1>
                                    <p class="tsp-head__help">فقط تعداد افراد در هر بازه؛ نتیجهٔ هیچ فردی دیده نمی‌شود. خانه‌های کمتر از <t t-out="fa(rep['k'])"/> نفر پنهان می‌شوند.</p>
                                </div>
                            </header>
                            <form method="get" class="ts-card tsp-filters" aria-label="پالایه‌ها">
                                <label>گروه
                                    <select name="group_id"><option value="">همه</option>
                                        <option t-foreach="groups" t-as="g" t-att-value="g.id" t-att-selected="'selected' if params.get('group_id') == str(g.id) else None" t-out="g.name"/>
                                    </select></label>
                                <label>دعوت گروهی
                                    <select name="campaign_id"><option value="">همه</option>
                                        <option t-foreach="campaigns" t-as="c" t-att-value="c.id" t-att-selected="'selected' if params.get('campaign_id') == str(c.id) else None" t-out="c.name"/>
                                    </select></label>
                                <label>سنجه
                                    <select name="instrument_id"><option value="">همه</option>
                                        <option t-foreach="instruments" t-as="i" t-att-value="i.id" t-att-selected="'selected' if params.get('instrument_id') == str(i.id) else None" t-out="i.name"/>
                                    </select></label>
                                <label>بازهٔ زمانی
                                    <select name="period">
                                        <option t-foreach="periods" t-as="p" t-att-value="p[0]" t-att-selected="'selected' if params.get('period', '0') == str(p[0]) else None" t-out="p[1]"/>
                                    </select></label>
                                <button type="submit" class="ts-btn ts-btn--outline">اعمال</button>
                            </form>
                            <p t-if="rep['imported']" class="ts-hint">شامل نتایج واردشده</p>
                            <p t-if="not rep['instruments']" class="ts-card ts-hint" t-out="rep['text']"/>
                            <section t-foreach="rep['instruments']" t-as="ins" class="ts-card">
                                <h2 class="h5" t-out="ins['name']"/>
                                <p class="ts-hint"><t t-out="fa(ins['n'])"/> از <t t-out="fa(ins['m'])"/> نفر</p>
                                <p t-if="not ins['ok']" t-out="rep['text']"/>
                                <table t-if="ins['factors']" class="ts-table tsp-table">
                                    <caption class="tsp-sr">تعداد افراد در هر بازه</caption>
                                    <thead><tr><th scope="col">بُعد</th><th scope="col">کم</th><th scope="col">متوسط</th><th scope="col">زیاد</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="ins['factors']" t-as="f">
                                            <th scope="row" t-out="f['name']"/>
                                            <td t-foreach="['low', 'mid', 'high']" t-as="b"><t t-if="f['cells'][b] is None">—</t><t t-else="" t-out="fa(f['cells'][b])"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <t t-if="ins['talent']">
                                    <p class="ts-hint">میانگین گروه در هر مقیاس (۲۰ تا ۱۰۰) و تعداد افرادی که آن مقیاس برایشان بالاترین است.</p>
                                    <table class="ts-table tsp-table">
                                        <caption class="tsp-sr">مقیاس‌های نیمرخ استعداد</caption>
                                        <thead><tr><th scope="col">مقیاس</th><th scope="col">میانگین</th><th scope="col">بالاترین برای</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="['ANA', 'EXP', 'ACA', 'NOV', 'DUT']" t-as="s">
                                                <th scope="row" t-out="names[s]"/>
                                                <td t-out="fa(ins['talent']['means'][s])"/>
                                                <td><t t-if="ins['talent']['top'][s] is None">—</t><t t-else="" t-out="fa(ins['talent']['top'][s])"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
