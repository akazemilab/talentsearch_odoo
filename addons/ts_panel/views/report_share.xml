<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- G30 / UX audit G2 P3-5, P3-9: the matrix report's sharing UI is now one block, ts_panel.who_sees (web_my.xml:
         who sees it, what they see, revoke via the confirm page). «ارسال برای مشاورم» lives in the report's «قدم بعدی»
         section (#tt-sec-next, ctx can_share), so the former #ts-share-counselor section is gone. -->

    <!-- G31: the share-by-code page said the counselor sees only bands. For the talent inventory
         the counselor sees the whole profile report (without answers): say so. -->
    <record id="tpl_share_form_matrix" model="ir.ui.view">
        <field name="name">TS panel: share form wording per instrument kind</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="ts_org.tpl_share_form"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('ts-section__head')]/p" position="replace">
                <p t-if="attempt.ts_is_matrix()">مشاور شما یک «کد پنل» دارد. با وارد کردن آن، گزارش نیمرخ شما (نمرهٔ هر زمینه و توانایی‌ها) برای مشاور دیده می‌شود. پاسخ‌های خام دیده نمی‌شوند و هر زمان بخواهید اشتراک را لغو می‌کنید.</p>
                <p t-else="">مشاور شما یک «کد پنل» دارد. با وارد کردن آن، فقط بازهٔ هر زمینه در نتیجهٔ شما برای مشاور دیده می‌شود. پاسخ‌های خام دیده نمی‌شوند و هر زمان بخواهید اشتراک را لغو می‌کنید.</p>
            </xpath>
        </field>
    </record>
</odoo>
