<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One step indicator for the three import pages (UX audit G4 P13-2): ۱ الگو · ۲ بارگذاری · ۳ تطبیق · ۴ مرور -->
    <record id="tpl_import_steps" model="ir.ui.view">
        <field name="name">TS panel: import steps</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.import_steps</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.import_steps">
                <ol class="tsp-steps" aria-label="گام‌های ورود از فایل">
                    <t t-foreach="[(1, 'الگو'), (2, 'بارگذاری'), (3, 'تطبیق ستون‌ها'), (4, 'مرور و ورود')]" t-as="st">
                        <li t-attf-class="tsp-steps__item #{'is-on' if st[0] == step else ('is-done' if st[0] &lt; step else '')}" t-att-aria-current="'step' if st[0] == step else None">
                            <t t-out="fa(st[0])"/>. <t t-out="st[1]"/><span t-if="st[0] &lt; step" class="tsp-sr"> (انجام شد)</span>
                        </li>
                    </t>
                </ol>
            </t>
        </field>
    </record>

    <!-- W/import: step 1, template and upload (IMP-1) -->
    <record id="tpl_import_start" model="ir.ui.view">
        <field name="name">TS panel: import start</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.import_start</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.import_start">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">ورود از فایل</h1>
                                    <p class="tsp-head__help">فهرست شرکت‌کنندگان را یک‌جا وارد کنید. پیش از گام آخر چیزی ثبت نمی‌شود.</p>
                                </div>
                            </header>
                            <t t-call="ts_panel.import_steps" step="1"/>
                            <section class="ts-card" aria-labelledby="tsp-im-1">
                                <h2 id="tsp-im-1" class="h5">۱. الگو</h2>
                                <p>فایل شما باید این ستون‌ها را داشته باشد (فقط «نام» الزامی است): <t t-out="'، '.join(headers)"/>.</p>
                                <p><a t-attf-href="/my/workspaces/#{ws.id}/import/template.xlsx" class="ts-btn ts-btn--outline">دریافت الگو (اکسل)</a>
                                    <a t-attf-href="/my/workspaces/#{ws.id}/import/template.csv" class="ts-btn ts-btn--quiet">الگو به شکل csv</a></p>
                            </section>
                            <section class="ts-card" aria-labelledby="tsp-im-2">
                                <h2 id="tsp-im-2" class="h5">۲. بارگذاری</h2>
                                <p class="ts-hint">فایل csv یا xlsx، حداکثر <t t-out="fa(max_mb)"/> مگابایت و <t t-out="fa(max_rows)"/> ردیف. اگر فهرست بزرگ‌تر است، آن را به چند فایل تقسیم کنید. فایل شما پس از پایان کار از سامانه پاک می‌شود.</p>
                                <form t-attf-action="/my/workspaces/#{ws.id}/import/upload" method="post" enctype="multipart/form-data" class="tsp-form" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <t t-call="ts_website.filefield" ff_name.f="file" ff_id.f="tsp_import_file" ff_label.f="فایل فهرست" ff_accept.f=".csv,.xlsx" ff_hint.f="فایل اکسل (xlsx) یا csv"/>
                                    <p class="ts-hint">اگر شمارهٔ موبایل در اکسل بدون صفر اول ذخیره شده باشد، ما صفر را اضافه می‌کنیم. رقم‌های فارسی هم پذیرفته می‌شوند.</p>
                                    <p><button type="submit" class="ts-btn ts-btn--primary">بارگذاری و ادامه</button></p>
                                </form>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_import_map" model="ir.ui.view">
        <field name="name">TS panel: import mapping</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.import_map</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.import_map">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">تطبیق ستون‌ها</h1>
                                    <p class="tsp-head__help">برای هر ستون فایل بگویید چه چیزی است. زیر هر ستون دو نمونه از مقدارهای فایل آمده تا مطمئن شوید. ستون‌هایی که لازم نیست را «نادیده بگیر» بگذارید.</p>
                                </div>
                            </header>
                            <t t-call="ts_panel.import_steps" step="3"/>
                            <form t-attf-action="/my/workspaces/#{ws.id}/import/#{job.id}/map" method="post" class="tsp-form ts-card" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div t-foreach="range(len(headers))" t-as="i" class="tsp-field">
                                    <label t-attf-for="tsp_col_#{i}" class="tsp-field__label"><t t-out="headers[i] or ('ستون ' + fa(i + 1))"/></label>
                                    <p t-attf-id="tsp_col_h_#{i}" class="tsp-field__hint"><t t-if="samples.get(i)">نمونه: <t t-foreach="samples[i]" t-as="v"><bdi t-out="v"/><t t-if="not v_last">، </t></t></t><t t-else="">این ستون در فایل خالی است.</t></p>
                                    <select t-attf-id="tsp_col_#{i}" t-attf-name="col_#{i}" class="form-select" t-attf-aria-describedby="tsp_col_h_#{i}">
                                        <option value="">نادیده بگیر</option>
                                        <option t-foreach="fields" t-as="f" t-att-value="f[0]" t-att-selected="'selected' if mapping.get(i) == f[0] else None"><t t-out="f[1]"/></option>
                                    </select>
                                </div>
                                <p><button type="submit" class="ts-btn ts-btn--primary">ادامه به مرور</button> <a t-attf-href="/my/workspaces/#{ws.id}/import" class="ts-btn ts-btn--quiet">انتخاب فایل دیگر (این فایل کنار گذاشته می‌شود)</a></p>
                            </form>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_import_review" model="ir.ui.view">
        <field name="name">TS panel: import review</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.import_review</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.import_review">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">مرور پیش از ورود</h1>
                                    <p class="tsp-head__help">اگر فهرست زیر درست است، دکمهٔ «وارد کردن» را بزنید. ورود برگشت‌پذیر نیست. ردیف‌های دارای ایراد وارد نمی‌شوند و گزارششان را پس از ورود می‌گیرید.</p>
                                </div>
                            </header>
                            <t t-call="ts_panel.import_steps" step="4"/>
                            <section class="ts-card">
                                <dl class="tsp-dl tsp-dl--grid">
                                    <dt>ردیف‌های فایل</dt><dd t-out="fa(total)"/>
                                    <dt>شرکت‌کنندهٔ تازه</dt><dd t-out="fa(counts['create'])"/>
                                    <dt>به‌روزرسانی</dt><dd t-out="fa(counts['update'])"/>
                                    <dt>بدون تغییر</dt><dd t-out="fa(counts['same'])"/>
                                    <dt>دارای ایراد</dt><dd><span t-if="counts['error']" class="ts-pill ts-pill--warn" t-out="fa(counts['error'])"/><t t-else="" t-out="fa(0)"/></dd>
                                </dl>
                                <section t-if="details['updates']" class="tsp-import-list" aria-labelledby="tsp-imp-upd">
                                    <h2 id="tsp-imp-upd" class="h6">این شرکت‌کنندگان به‌روزرسانی می‌شوند</h2>
                                    <ul class="tsp-list tsp-rows">
                                        <li t-foreach="details['updates']" t-as="u">
                                            <div class="tsp-rows__text">
                                                <strong><bdi t-out="u['name']"/><t t-if="u['code']"> · <bdi dir="ltr" t-out="u['code']"/></t></strong>
                                                <span class="ts-hint">ردیف <t t-out="fa(u['n'])"/>:
                                                    <t t-foreach="u['changes']" t-as="c"><t t-out="c['field']"/> <bdi t-out="c['old']"/> ← <bdi t-out="c['new']"/><t t-if="not c_last">؛ </t></t></span>
                                            </div>
                                        </li>
                                    </ul>
                                    <p t-if="counts['update'] &gt; len(details['updates'])" class="ts-hint"><t t-out="fa(len(details['updates']))"/> مورد نخست از <t t-out="fa(counts['update'])"/> به‌روزرسانی نشان داده شد.</p>
                                </section>
                                <section t-if="details['creates']" class="tsp-import-list" aria-labelledby="tsp-imp-new">
                                    <h2 id="tsp-imp-new" class="h6">این شرکت‌کنندگان تازه ساخته می‌شوند</h2>
                                    <ul class="tsp-list tsp-mini">
                                        <li t-foreach="details['creates']" t-as="c"><bdi t-out="c['name']"/><t t-if="c['code']"> · <bdi dir="ltr" t-out="c['code']"/></t> <span class="ts-hint">(ردیف <t t-out="fa(c['n'])"/>)</span></li>
                                    </ul>
                                    <p t-if="counts['create'] &gt; len(details['creates'])" class="ts-hint"><t t-out="fa(len(details['creates']))"/> نفر نخست از <t t-out="fa(counts['create'])"/> نفر نشان داده شد.</p>
                                </section>
                                <ul t-if="errs" class="tsp-list">
                                    <li t-foreach="errs" t-as="e">ردیف <t t-out="fa(e['n'])"/>: <t t-out="errors_text.get(e['err'], e['err'])"/></li>
                                </ul>
                                <p t-if="counts['error'] &gt; len(errs)" class="ts-hint">بیست ایراد نخست نشان داده شد؛ فهرست کامل در گزارش پس از ورود است.</p>
                                <form t-attf-action="/my/workspaces/#{ws.id}/import/#{job.id}/start" method="post" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p>
                                        <button t-if="counts['create'] or counts['update']" type="submit" class="ts-btn ts-btn--primary">وارد کردن<t t-if="counts['create']"> <t t-out="fa(counts['create'])"/> شرکت‌کنندهٔ تازه</t><t t-if="counts['create'] and counts['update']"> و</t><t t-if="counts['update']"> به‌روزرسانی <t t-out="fa(counts['update'])"/> شرکت‌کننده</t></button>
                                        <a t-attf-href="/my/workspaces/#{ws.id}/import/#{job.id}/map" class="ts-btn ts-btn--quiet">برگشت به تطبیق ستون‌ها</a>
                                    </p>
                                    <p t-if="not (counts['create'] or counts['update'])" class="ts-notice" role="status">چیزی برای وارد کردن نیست.</p>
                                </form>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- job page: state, counts, error report -->
    <record id="tpl_job" model="ir.ui.view">
        <field name="name">TS panel: job page</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.job</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.job">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title" t-out="kind_label.get(job.kind, '')"/>
                                    <p class="tsp-head__help" id="tsp-job-pill"><span t-attf-class="ts-pill #{pill.get(job.state, '')}" t-out="state_label.get(job.state, job.state)"/></p>
                                </div>
                            </header>
                            <section class="ts-card" role="status" id="tsp-job-status" t-att-data-tsp-poll="'1' if refresh else None">
                                <t t-if="job.state in ('queued', 'running')">
                                    <p t-if="job.kind == 'import_clients'">فایل شما در حال ورود است. وضعیت همین‌جا به‌روز می‌شود؛ لازم نیست صفحه را ترک کنید.</p>
                                    <p t-else="">فایل شما در حال ساخت است. وضعیت همین‌جا به‌روز می‌شود؛ لازم نیست صفحه را ترک کنید.</p>
                                    <p><a t-attf-href="/my/workspaces/#{ws.id}/jobs/#{job.id}" class="ts-btn ts-btn--outline ts-btn--sm">تازه‌سازی</a></p>
                                </t>
                                <t t-if="job.state == 'done' and job.kind.startswith('export_')">
                                    <p>فایل آماده است: <t t-out="fa(s.get('rows', 0))"/> ردیف.</p>
                                    <p t-if="can_download"><a t-attf-href="/my/workspaces/#{ws.id}/jobs/#{job.id}/download" class="ts-btn ts-btn--primary">دریافت فایل</a></p>
                                    <p class="ts-hint">فایل تا <t t-out="jalali(job.expires_at)"/> در دسترس است؛ هنگام دریافت دوباره هویت شما را می‌پرسیم.</p>
                                    <p><a t-attf-href="/my/workspaces/#{ws.id}/exports" class="ts-backlink">خروجی‌ها</a></p>
                                </t>
                                <t t-if="job.state == 'done' and job.kind == 'import_clients'">
                                    <dl class="tsp-dl">
                                        <dt>شرکت‌کنندهٔ تازه</dt><dd t-out="fa(s.get('create', 0))"/>
                                        <dt>به‌روزرسانی‌شده</dt><dd t-out="fa(s.get('update', 0))"/>
                                        <dt>بدون تغییر</dt><dd t-out="fa(s.get('same', 0))"/>
                                        <dt>ردشده</dt><dd t-out="fa(s.get('error', 0))"/>
                                    </dl>
                                    <p t-if="can_download"><a t-attf-href="/my/workspaces/#{ws.id}/jobs/#{job.id}/download" class="ts-btn ts-btn--outline">دریافت گزارش ردیف‌های ردشده</a></p>
                                    <p class="ts-hint">گزارش تا <t t-out="jalali(job.expires_at)"/> در دسترس است و فایل بارگذاری‌شده پاک شده است.</p>
                                    <p>
                                        <a t-attf-href="/my/workspaces/#{ws.id}/clients" class="ts-btn ts-btn--primary">دیدن شرکت‌کنندگان</a>
                                        <a t-if="can_campaign and groups" t-attf-href="/my/workspaces/#{ws.id}/campaigns/new" class="ts-btn ts-btn--outline">دعوت یک گروه</a>
                                    </p>
                                </t>
                                <p t-if="job.state == 'failed'" class="ts-notice" role="alert" t-out="err_text"/>
                                <p t-if="job.state == 'expired'">مهلت این کار به پایان رسیده است.</p>
                                <p t-if="job.state == 'draft'"><a t-attf-href="/my/workspaces/#{ws.id}/import/#{job.id}/map" class="ts-btn ts-btn--primary">ادامهٔ ورود</a></p>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
