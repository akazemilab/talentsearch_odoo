<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/groups and W/groups/<id> (S5, GRP-1..3) -->
    <record id="tpl_groups" model="ir.ui.view">
        <field name="name">TS panel: groups</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.groups</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.groups">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">گروه‌ها</h1>
                                    <p class="tsp-head__help">کلاس، تیم یا برچسب برای دسته‌بندی شرکت‌کنندگان. برای افزودن افراد، در <a t-attf-href="/my/workspaces/#{ws.id}/clients">فهرست شرکت‌کنندگان</a> آن‌ها را انتخاب و «افزودن به گروه» را بزنید. گروه‌ها دسترسی کسی را بیشتر نمی‌کنند؛ هر کس فقط شرکت‌کنندگانی را که می‌تواند ببیند در گروه می‌بیند.</p>
                                </div>
                                <div class="tsp-head__actions">
                                    <a href="#new-group" class="ts-btn ts-btn--primary">گروه تازه</a>
                                </div>
                            </header>
                            <p t-if="not groups" class="tsp-empty">هنوز گروهی نساخته‌اید. با فرم «گروه تازه» یک کلاس یا تیم بسازید.</p>
                            <div t-if="groups" class="ts-table-wrap tsp-groups-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">گروه‌های پنل</caption>
                                    <thead><tr><th scope="col">نام</th><th scope="col">نوع</th><th scope="col"><t t-if="see_all">تعداد افراد</t><t t-else="">افراد قابل‌دیدن برای شما</t></th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="groups" t-as="g">
                                            <th scope="row" data-label="نام"><a t-attf-href="/my/workspaces/#{ws.id}/groups/#{g.id}"><bdi t-out="g.name"/></a></th>
                                            <td data-label="نوع" t-out="kind_label[g.kind]"/>
                                            <td t-att-data-label="'تعداد افراد' if see_all else 'افراد قابل‌دیدن برای شما'" class="ts-num" t-out="fa(sizes.get(g.id, 0))"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <form id="new-group" t-attf-action="/my/workspaces/#{ws.id}/groups/new" method="post" class="tsp-form ts-card" data-tsp-once="1" tabindex="-1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <h2 class="h5">گروه تازه</h2>
                                <label class="tsp-field"><span class="tsp-field__label">نام</span>
                                    <input type="text" name="name" required="required" maxlength="60" class="form-control"/></label>
                                <label class="tsp-field"><span class="tsp-field__label">نوع</span>
                                    <select name="kind" class="form-select">
                                        <option t-foreach="kinds" t-as="k" t-att-value="k[0]" t-out="k[1]"/>
                                    </select></label>
                                <p><button type="submit" class="ts-btn ts-btn--primary">ساخت گروه</button></p>
                            </form>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_group" model="ir.ui.view">
        <field name="name">TS panel: group</field>
        <field name="type">qweb</field>
        <field name="key">ts_panel.group</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_panel.group">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <a t-attf-href="/my/workspaces/#{ws.id}/groups" class="ts-backlink">گروه‌ها</a>
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title"><bdi t-out="g.name"/></h1>
                                    <p class="tsp-head__help"><t t-out="kind_label[g.kind]"/> · <t t-out="fa(len(people))"/> نفر<t t-if="hidden"> (<t t-out="fa(hidden)"/> نفر دیگر را شما نمی‌بینید)</t></p>
                                </div>
                                <div class="tsp-head__actions">
                                    <a t-if="can_campaign and people" t-attf-href="/my/workspaces/#{ws.id}/campaigns/new?group=#{g.id}" class="ts-btn ts-btn--primary">دعوت گروهی این گروه</a>
                                    <a t-elif="not people" t-attf-href="/my/workspaces/#{ws.id}/clients" class="ts-btn ts-btn--primary">افزودن شرکت‌کننده از فهرست</a>
                                </div>
                            </header>
                            <div t-if="not people" class="tsp-empty">
                                <p>این گروه هنوز عضوی ندارد<t t-if="hidden"> که شما بتوانید ببینید</t>. در <a t-attf-href="/my/workspaces/#{ws.id}/clients">فهرست شرکت‌کنندگان</a> چند نفر را انتخاب کنید و «افزودن به گروه» را بزنید.</p>
                                <p t-if="can_campaign" class="ts-hint">دعوت گروهی برای این گروه وقتی ممکن می‌شود که عضو داشته باشد.</p>
                            </div>
                            <div t-if="people" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">اعضای گروه</caption>
                                    <thead><tr><th scope="col">نام</th><th scope="col"><span class="tsp-sr">عملیات</span></th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="people" t-as="c">
                                            <th scope="row" data-label="نام"><a t-attf-href="/my/workspaces/#{ws.id}/clients/#{c.id}"><bdi t-out="c.name"/></a></th>
                                            <td class="tsp-row-actions">
                                                <form t-attf-action="/my/workspaces/#{ws.id}/groups/#{g.id}/remove" method="post" class="tsp-inline">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="client" t-att-value="c.id"/>
                                                    <button type="submit" class="ts-btn ts-btn--quiet">برداشتن از گروه</button>
                                                </form>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <form t-attf-action="/my/workspaces/#{ws.id}/groups/#{g.id}/rename" method="post" class="tsp-form ts-card" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <label class="tsp-field"><span class="tsp-field__label">نام گروه</span>
                                    <input type="text" name="name" t-att-value="g.name" required="required" maxlength="60" class="form-control"/></label>
                                <p><button type="submit" class="ts-btn ts-btn--outline">ذخیرهٔ نام</button></p>
                            </form>
                            <section class="ts-card" aria-labelledby="tsp-g-arch">
                                <h2 id="tsp-g-arch" class="h5">بایگانی گروه</h2>
                                <form t-attf-action="/my/workspaces/#{ws.id}/groups/#{g.id}/archive" method="post" class="ts-confirm" data-tsp-once="1" role="group" aria-labelledby="tsp-g-arch-t">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p class="ts-confirm__title" id="tsp-g-arch-t">بایگانی «<bdi t-out="g.name"/>»</p>
                                    <p class="ts-confirm__consequence">گروه از فهرست گروه‌ها و از فرم دعوت گروهی بیرون می‌رود. بایگانی گروه، شرکت‌کنندگانش را حذف نمی‌کند و دعوت‌های ساخته‌شده سر جایشان می‌مانند.</p>
                                    <label class="ts-check"><input type="checkbox" name="confirm" value="1" required="required"/><span>مطمئنم، این گروه بایگانی شود</span></label>
                                    <div class="ts-confirm__actions"><button type="submit" class="ts-btn ts-btn--danger-outline">بایگانی گروه</button></div>
                                </form>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
