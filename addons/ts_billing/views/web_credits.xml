<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- W/credits of a prepaid panel (docs/clinic/04_billing_brief.md 6). Free panels keep ts_panel.credits. Amounts in تومان. -->
    <record id="tpl_credits_prepaid" model="ir.ui.view">
        <field name="name">TS billing: credits (prepaid)</field>
        <field name="type">qweb</field>
        <field name="key">ts_billing.credits_prepaid</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_billing.credits_prepaid">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">اعتبار و مصرف</h1>
                                    <p class="tsp-head__help">هر دعوت هزینهٔ سنجه یا مجموعه را از اعتبار پنل رزرو می‌کند. با تکمیل، همان مبلغ کسر می‌شود؛ اگر دعوت لغو یا رد شود یا مهلتش بگذرد، رزرو آزاد می‌شود.</p>
                                </div>
                            </header>
                            <ul class="tsp-stats tsb-stats" aria-label="خلاصهٔ اعتبار">
                                <li><div class="tsp-stat"><strong class="ts-num" t-out="toman(st['available'])"/><span>موجودی قابل استفاده</span></div></li>
                                <li><div class="tsp-stat"><strong class="ts-num" t-out="toman(st['held'])"/><span>رزروشده برای دعوت‌های باز</span></div></li>
                                <li><div class="tsp-stat"><strong class="ts-num" t-out="toman(st['month'])"/><span>مصرف این ماه</span></div></li>
                            </ul>
                            <p t-if="threshold and st['available'] &lt; threshold" class="ts-notice ts-notice--warn" role="status">اعتبار پنل از آستانهٔ هشدار (<t t-out="toman(threshold)"/>) کمتر است. برای شارژ اعتبار با تیم استعدادیاب تماس بگیرید؛ فاکتور شارژ در همین صفحه دیده می‌شود.</p>

                            <section class="ts-card" id="tsb-usage" aria-labelledby="tsb-usage-h">
                                <h2 id="tsb-usage-h" class="h5">مصرف این ماه به تفکیک مشاور</h2>
                                <p t-if="not by_member" class="ts-hint">این ماه هنوز دعوتی با هزینه فرستاده نشده است.</p>
                                <div t-if="by_member" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">مصرف این ماه به تفکیک مشاور</caption>
                                    <thead><tr><th scope="col">عضو</th><th scope="col">دعوت‌ها</th><th scope="col">مبلغ</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="by_member" t-as="row">
                                            <th scope="row" data-label="عضو"><bdi t-out="row[0].name"/></th>
                                            <td data-label="دعوت‌ها" t-out="fa(row[1])"/>
                                            <td data-label="مبلغ" t-out="toman(row[2])"/>
                                        </tr>
                                    </tbody>
                                </table>
                                </div>
                            </section>

                            <section t-if="capped" class="ts-card" id="tsb-caps" aria-labelledby="tsb-caps-h">
                                <h2 id="tsb-caps-h" class="h5">سقف ماهانهٔ مشاوران</h2>
                                <p class="ts-hint">سقف، هزینهٔ دعوت‌هایی است که هر مشاور در یک ماه شمسی می‌فرستد. ۰ یعنی بدون سقف. برای مالک، هماهنگ‌کننده و مدیران سقفی تعیین نمی‌شود.</p>
                                <div class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">سقف ماهانهٔ مشاوران</caption>
                                    <thead><tr><th scope="col">عضو</th><th scope="col">مصرف این ماه</th><th scope="col">سقف (تومان)</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="capped" t-as="cm">
                                            <th scope="row" data-label="عضو"><bdi t-out="cm.user_id.name"/></th>
                                            <td data-label="مصرف این ماه" t-out="toman(wallet.ts_month_spend(cm))"/>
                                            <td data-label="سقف (تومان)">
                                                <form t-if="can_manage" t-attf-action="/my/workspaces/#{ws.id}/credits/cap" method="post" class="tsb-inline" data-tsp-once="1">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="member_id" t-att-value="cm.id"/>
                                                    <label class="tsp-sr" t-attf-for="tsb_cap_#{cm.id}">سقف ماهانهٔ <t t-out="cm.user_id.name"/> به تومان</label>
                                                    <input t-attf-id="tsb_cap_#{cm.id}" type="text" name="cap" inputmode="numeric" maxlength="16" dir="ltr" class="form-control tsb-money" t-att-value="ws.ts_fa_num(int(cm.monthly_cap or 0) // 10)"/>
                                                    <button type="submit" class="ts-btn ts-btn--outline">ذخیره</button>
                                                </form>
                                                <t t-elif="cm.monthly_cap" t-out="toman(cm.monthly_cap)"/>
                                                <t t-else="">بدون سقف</t>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                </div>
                            </section>

                            <section t-if="can_manage" class="ts-card" id="tsb-alert" aria-labelledby="tsb-alert-h">
                                <h2 id="tsb-alert-h" class="h5">هشدار کم شدن اعتبار</h2>
                                <form t-attf-action="/my/workspaces/#{ws.id}/credits/threshold" method="post" class="tsp-form" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="tsp-field">
                                        <label class="tsp-field__label" for="tsb_threshold">وقتی موجودی کمتر از این مبلغ شد خبرم کن (تومان)</label>
                                        <p class="tsp-field__hint" id="tsb_threshold_h">در روز حداکثر یک اعلان به مالک و مدیران پنل می‌رسد. ۰ یعنی خاموش.</p>
                                        <input id="tsb_threshold" type="text" name="threshold" inputmode="numeric" maxlength="16" dir="ltr" class="form-control tsb-money" aria-describedby="tsb_threshold_h" t-att-value="ws.ts_fa_num(threshold // 10)"/>
                                    </div>
                                    <p><button type="submit" class="ts-btn ts-btn--primary">ذخیرهٔ آستانه</button></p>
                                </form>
                            </section>

                            <t t-call="ts_billing.price_list"/>

                            <section class="ts-card" id="tsb-invoices" aria-labelledby="tsb-inv-h">
                                <h2 id="tsb-inv-h" class="h5">فاکتورهای شارژ اعتبار</h2>
                                <p t-if="not invoices" class="ts-hint">هنوز فاکتوری برای این پنل صادر نشده است. برای شارژ اعتبار با تیم استعدادیاب تماس بگیرید.</p>
                                <div t-if="invoices" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">فاکتورها</caption>
                                    <thead><tr><th scope="col">شماره</th><th scope="col">تاریخ</th><th scope="col">مبلغ</th><th scope="col">وضعیت</th><th scope="col"><span class="tsp-sr">فاکتور</span></th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="invoices" t-as="inv">
                                            <th scope="row" data-label="شماره"><bdi dir="ltr" t-out="inv['name']"/></th>
                                            <td data-label="تاریخ" t-out="inv['date']"/>
                                            <td data-label="مبلغ" t-out="toman(inv['amount'])"/>
                                            <td data-label="وضعیت"><span t-if="inv['paid']" class="ts-pill ts-pill--ok">پرداخت‌شده</span><span t-else="" class="ts-pill ts-pill--warn">در انتظار پرداخت</span></td>
                                            <td><a t-att-href="inv['url']">دیدن فاکتور</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                                </div>
                            </section>

                            <section class="ts-card" aria-labelledby="tsb-hist-h">
                                <h2 id="tsb-hist-h" class="h5">تاریخچه</h2>
                                <p t-if="not rows" class="ts-hint">هنوز ردیفی در دفتر اعتبار نیست.</p>
                                <div t-if="rows" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">تاریخچهٔ اعتبار</caption>
                                    <thead><tr><th scope="col">تاریخ</th><th scope="col">نوع</th><th scope="col">مبلغ</th><th scope="col">موجودی پس از آن</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="r">
                                            <th scope="row" data-label="تاریخ" t-out="jalali(r.txn_date)"/>
                                            <td data-label="نوع"><t t-out="type_labels.get(r.type, r.type)"/><span t-if="r.reason_code" class="ts-hint"> · <t t-out="reason_labels.get(r.reason_code, '')"/></span></td>
                                            <td data-label="مبلغ" t-out="toman(r.amount)"/>
                                            <td data-label="موجودی پس از آن" t-out="toman(r.balance_after)"/>
                                        </tr>
                                    </tbody>
                                </table>
                                </div>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- A capped role without credits:read (clinician, counselor, ...): own cap and own month, plus the prices -->
    <record id="tpl_credits_own" model="ir.ui.view">
        <field name="name">TS billing: credits (own cap)</field>
        <field name="type">qweb</field>
        <field name="key">ts_billing.credits_own</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_billing.credits_own">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">هزینهٔ دعوت‌های شما</h1>
                                    <p class="tsp-head__help">هزینهٔ هر دعوت هنگام فرستادن رزرو و با تکمیل کسر می‌شود. موجودی پنل را مدیر پنل می‌بیند.</p>
                                </div>
                            </header>
                            <ul class="tsp-stats tsb-stats" aria-label="مصرف شما">
                                <li><div class="tsp-stat"><strong class="ts-num" t-out="toman(st['spent'])"/><span>مصرف این ماه</span></div></li>
                                <li><div class="tsp-stat"><strong class="ts-num"><t t-if="st['capped']" t-out="toman(st['cap'])"/><t t-else="">بدون سقف</t></strong><span>سقف ماهانه</span></div></li>
                            </ul>
                            <t t-if="st['capped']" t-call="ts_billing.cap_bar"/>
                            <t t-call="ts_billing.price_list"/>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Shared blocks. price_list params: prices [(kind, name, rial)], toman. cap_bar params: st, toman. -->
    <record id="tpl_price_list" model="ir.ui.view">
        <field name="name">TS billing: price list</field>
        <field name="type">qweb</field>
        <field name="key">ts_billing.price_list</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_billing.price_list">
                <section class="ts-card" id="tsb-prices" aria-labelledby="tsb-prices-h">
                    <h2 id="tsb-prices-h" class="h5">فهرست قیمت این پنل</h2>
                    <p t-if="not prices" class="ts-hint">هنوز سنجه یا مجموعه‌ای برای دعوت در اختیار شما نیست.</p>
                    <div t-if="prices" class="ts-table-wrap">
                    <table class="ts-table tsp-table tsp-table--cards">
                        <caption class="tsp-sr">فهرست قیمت</caption>
                        <thead><tr><th scope="col">مورد</th><th scope="col">نوع</th><th scope="col">هزینهٔ هر دعوت</th></tr></thead>
                        <tbody>
                            <tr t-foreach="prices" t-as="p">
                                <th scope="row" data-label="مورد" t-out="p[1]"/>
                                <td data-label="نوع" t-out="p[0]"/>
                                <td data-label="هزینهٔ هر دعوت"><t t-if="p[2]" t-out="toman(p[2])"/><t t-else="">بدون هزینه</t></td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </section>
            </t>
        </field>
    </record>
    <record id="tpl_cap_bar" model="ir.ui.view">
        <field name="name">TS billing: cap bar</field>
        <field name="type">qweb</field>
        <field name="key">ts_billing.cap_bar</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_billing.cap_bar">
                <div class="tsb-cap" role="group" aria-label="سقف ماهانهٔ شما">
                    <p class="tsb-cap__text">مصرف این ماه: <span class="ts-num" t-out="toman(st['spent'])"/> از <span class="ts-num" t-out="toman(st['cap'])"/></p>
                    <div class="tsb-cap__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="st['cap_pct']" t-attf-aria-valuetext="#{st['cap_pct']} درصد">
                        <span t-attf-class="tsb-cap__fill #{'tsb-cap__fill--full' if st['cap_pct'] &gt;= 90 else ''}" t-attf-style="width: #{st['cap_pct']}%"/>
                    </div>
                </div>
            </t>
        </field>
    </record>
</odoo>
