<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clinic phase 4 (prepaid billing), back office. Each xpath names an anchor of its parent view. -->

    <!-- ===================================================== panel form: mode, invoices, wallet, caps -->
    <record id="ts_workspace_view_form_billing" model="ir.ui.view">
        <field name="name">ts.workspace.form.billing</field>
        <field name="model">ts.workspace</field>
        <field name="inherit_id" ref="ts_core.ts_workspace_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ts_topup_invoice" type="object" string="صدور فاکتور اعتبار" invisible="billing_mode != 'prepaid'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ts_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        groups="account.group_account_invoice" invisible="billing_mode != 'prepaid' and not ts_invoice_count">
                    <field name="ts_invoice_count" widget="statinfo" string="فاکتورها"/>
                </button>
                <button name="action_ts_wallet" type="object" class="oe_stat_button" icon="fa-money" string="کیف اعتبار"
                        groups="ts_core.group_ts_manager"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="billing_mode" widget="radio"/>
            </xpath>
            <xpath expr="//field[@name='member_ids']/list/field[@name='license_number']" position="after">
                <field name="currency_id" column_invisible="1"/>
                <field name="monthly_cap" optional="show" groups="ts_core.group_ts_manager"
                       readonly="role not in ('clinician', 'counselor', 'hiring_manager', 'reviewer')"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== instrument and battery: base price + product -->
    <record id="ts_instrument_view_form_billing" model="ir.ui.view">
        <field name="name">ts.instrument.form.billing</field>
        <field name="model">ts.instrument</field>
        <field name="inherit_id" ref="ts_assessment.ts_instrument_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_ts_open_product" type="object" class="oe_stat_button" icon="fa-tag" string="محصول"
                            invisible="not product_id" groups="ts_core.group_ts_manager"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='duration_minutes']" position="after">
                <field name="product_id" readonly="1" groups="ts_core.group_ts_manager"/>
                <field name="ts_list_price" invisible="not product_id" groups="ts_core.group_ts_manager"/>
            </xpath>
        </field>
    </record>
    <record id="ts_battery_view_form_billing" model="ir.ui.view">
        <field name="name">ts.battery.form.billing</field>
        <field name="model">ts.battery</field>
        <field name="inherit_id" ref="ts_battery.ts_battery_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_ts_open_product" type="object" class="oe_stat_button" icon="fa-tag" string="محصول"
                            invisible="not product_id" groups="ts_core.group_ts_manager"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="ts_list_price" invisible="not product_id" groups="ts_core.group_ts_manager"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== customer invoice: the panel it credits -->
    <record id="view_move_form_ts_workspace" model="ir.ui.view">
        <field name="name">account.move.form.ts_workspace</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="ts_workspace_id" groups="ts_core.group_ts_user" invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'" options="{'no_create': True}"
                       domain="[('partner_id', 'parent_of', partner_id)]"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== wallets and ledger: money columns -->
    <record id="view_ts_wallet_list_billing" model="ir.ui.view">
        <field name="name">ts.wallet.list.billing</field>
        <field name="model">ts.wallet</field>
        <field name="inherit_id" ref="ts_panel.view_ts_wallet_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="before">
                <field name="currency_id" column_invisible="1"/>
                <field name="billing_mode"/>
            </xpath>
            <xpath expr="//field[@name='balance']" position="after">
                <field name="held"/>
            </xpath>
        </field>
    </record>
    <record id="view_ts_wallet_form" model="ir.ui.view">
        <field name="name">ts.wallet.form</field>
        <field name="model">ts.wallet</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_ts_grant_wizard" type="object" string="اعتبار هدیه یا اصلاح" class="btn-primary"
                            groups="ts_core.group_ts_manager"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="workspace_id" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="billing_mode"/>
                            <field name="balance"/>
                            <field name="held"/>
                            <field name="units_used"/>
                        </group>
                        <group>
                            <field name="low_threshold"/>
                            <field name="low_alert_sent_on"/>
                        </group>
                    </group>
                    <field name="txn_ids" readonly="1">
                        <list>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="txn_date"/>
                            <field name="type"/>
                            <field name="reason_code"/>
                            <field name="assignment_id" optional="show"/>
                            <field name="move_id" optional="show"/>
                            <field name="units"/>
                            <field name="amount" sum="جمع"/>
                            <field name="balance_after"/>
                            <field name="free" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ts_wallet_txn_list_billing" model="ir.ui.view">
        <field name="name">ts.wallet.txn.list.billing</field>
        <field name="model">ts.wallet.txn</field>
        <field name="inherit_id" ref="ts_panel.view_ts_wallet_txn_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="before">
                <field name="currency_id" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='actor_id']" position="after">
                <field name="assignment_id" optional="hide"/>
                <field name="move_id" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_ts_wallet_grant_wizard_form" model="ir.ui.view">
        <field name="name">ts.wallet.grant.wizard.form</field>
        <field name="model">ts.wallet.grant.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="wallet_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="kind" widget="radio"/>
                    <field name="amount"/>
                    <field name="reason"/>
                </group>
                <p class="text-muted">مبلغ به ریال و مضربی از ۱۰ است. ردیف دفتر اعتبار پس از ثبت ویرایش یا حذف نمی‌شود.</p>
                <footer>
                    <button name="action_confirm" type="object" string="ثبت در دفتر اعتبار" class="btn-primary"/>
                    <button special="cancel" string="انصراف"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================== void of an attempt: what is given back -->
    <record id="view_ts_attempt_void_wizard_form" model="ir.ui.view">
        <field name="name">ts.attempt.void.wizard.form</field>
        <field name="model">ts.attempt.void.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="attempt_id" readonly="1"/>
                    <field name="reason"/>
                    <field name="refund_text" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="ابطال اجرا" class="btn-primary"/>
                    <button special="cancel" string="انصراف"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ts_attempt_view_form_void" model="ir.ui.view">
        <field name="name">ts.attempt.form.void</field>
        <field name="model">ts.attempt</field>
        <field name="inherit_id" ref="ts_assessment.ts_attempt_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_ts_void_dialog" type="object" string="ابطال اجرا" groups="ts_core.group_ts_manager"
                            invisible="state != 'done' or not workspace_id or voided"/>
                    <field name="voided" invisible="1"/>
                    <field name="workspace_id" invisible="1"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
