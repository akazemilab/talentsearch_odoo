<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_entry_workspaces" model="portal.entry">
        <field name="name">پنل‌های من</field>
        <field name="description">دعوت شرکت‌کنندگان، پیگیری وضعیت و مشاهدهٔ نتایجی که با شما به اشتراک گذاشته شده است</field>
        <field name="url">/my/workspaces</field>
        <field name="sequence">2</field>
        <field name="placeholder_count">ts_workspace_count</field>
        <field name="website_id" ref="ts_website.website_ts"/>
    </record>

    <!-- ============================================================ list -->
    <record id="tpl_workspaces" model="ir.ui.view">
        <field name="name">TS: my workspaces</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.workspaces</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.workspaces">
                <t t-call="website.layout" additional_title.f="پنل‌های من">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head">
                                    <h1>پنل‌های من</h1>
                                    <p>پنل‌هایی که عضو آن‌ها هستید. هر پنل فقط یک هدف دارد و داده‌ها هرگز بین پنل‌ها جابه‌جا نمی‌شوند.</p>
                                </div>
                                <div t-if="not rows" class="ts-card ts-card--soft">
                                    <h2 class="h4">عضو هیچ پنلی نیستید</h2>
                                    <p>اگر همکاری شما را دعوت کرده، پیوند دعوت را باز کنید. یا پنل خودتان را بسازید.</p>
                                    <p><a href="/my/workspaces/new" class="ts-btn ts-btn--primary">ساخت پنل تازه</a></p>
                                </div>
                                <div t-else="" class="ts-grid ts-org-grid">
                                    <t t-foreach="rows" t-as="r">
                                        <article class="ts-card ts-org-card">
                                            <p class="ts-org-card__top">
                                                <span class="ts-tag" t-out="r['purpose']"/>
                                                <span t-attf-class="ts-pill #{r['pill'][1]}" t-out="r['pill'][0]"/>
                                            </p>
                                            <h2 class="h4"><bdi t-out="r['ws'].name"/></h2>
                                            <dl class="ts-meta ts-meta--card">
                                                <dt>نقش شما</dt><dd t-out="dict(r['member']._fields['role'].selection).get(r['member'].role)"/>
                                                <dt>کد پنل</dt><dd><bdi dir="ltr" t-out="r['ws'].code"/></dd>
                                                <dt>دعوت‌ها</dt><dd><t t-out="fa(r['total'])"/> دعوت · <t t-out="fa(r['counts']['done'])"/> تکمیل‌شده</dd>
                                            </dl>
                                            <p t-if="r['unseen']" class="ts-org-card__new"><strong t-out="fa(r['unseen'])"/> نتیجهٔ تازه که هنوز باز نکرده‌اید</p>
                                            <a t-if="r['usable']" t-attf-href="/my/workspaces/#{r['ws'].id}" class="ts-btn ts-btn--primary ts-org-card__go">ورود به پنل <span class="visually-hidden" t-out="r['ws'].name"/></a>
                                            <p t-elif="r['ws'].state == 'suspended'" class="ts-notice ts-notice--warn">این پنل تعلیق شده است.</p>
                                            <p t-elif="r['member'].verification_state == 'pending'" class="ts-notice ts-notice--warn">احراز صلاحیت حرفه‌ای شما در حال بررسی است.</p>
                                            <p t-else="" class="ts-notice ts-notice--warn">این پنل هنوز فعال نشده است.</p>
                                        </article>
                                    </t>
                                </div>
                                <p t-if="rows" class="ts-org-new"><a href="/my/workspaces/new" class="ts-btn ts-btn--outline">ساخت پنل تازه</a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= dashboard -->
    <record id="tpl_workspace" model="ir.ui.view">
        <field name="name">TS: workspace dashboard</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.workspace</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.workspace">
                <t t-call="website.layout" additional_title.f="صفحهٔ قدیمی پنل">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <a href="/my/workspaces" class="ts-back">پنل‌های من</a>
                                <nav t-if="others" class="ts-stats" aria-label="پنل‌های من">
                                    <span class="ts-hint">تغییر پنل:</span>
                                    <a t-foreach="others" t-as="o" t-attf-href="/my/workspaces/#{o.workspace_id.id}" class="ts-stat"><strong t-out="o.workspace_id.name"/><span t-out="dict(o._fields['role'].selection).get(o.role)"/></a>
                                </nav>
                                <p t-if="others" class="ts-hint">داده‌های هر پنل کاملاً جداست؛ کارشناسی که پنل یک‌نفرهٔ خودش را هم دارد، شرکت‌کنندگان آن پنل را هرگز در این پنل نمی‌بیند.</p>
                                <div class="ts-section__head">
                                    <p class="ts-tag" t-out="dict(ws._fields['purpose'].selection).get(ws.purpose)"/>
                                    <h1 t-out="ws.name"/>
                                    <p t-if="ws.purpose == 'employment'">این پنل فقط وضعیت دعوت و، در صورت رضایت شرکت‌کننده، سطح هر عامل را می‌بیند. پاسخ‌ها و متن‌های تفسیری هرگز نمایش داده نمی‌شوند.</p>
                                    <p t-elif="ws.purpose == 'education'">مشاور مدرسه گزارش شرکت‌کنندگان را می‌بیند؛ پاسخ‌های خام هرگز نمایش داده نمی‌شوند. نتیجه‌های واردشده از نرم‌افزار قبلی فقط برای اعضای همین پنل دیده می‌شوند و برای خود شرکت‌کننده منتشر نشده‌اند.</p>
                                    <p t-elif="ws.purpose == 'clinical'">گزارش کامل، از جمله راهنمای مشاور، فقط به مشاور تأییدشدهٔ همین پنل و فقط با رضایت شرکت‌کننده نمایش داده می‌شود.</p>
                                </div>

                                <p t-if="created" class="ts-notice" role="status">
                                    دعوت برای <strong t-out="created.invitee_name"/> ساخته شد. این پیوند را برای او بفرستید:
                                    <input type="text" readonly="readonly" class="ts-copy" t-att-value="created.invite_url()" aria-label="پیوند دعوت" dir="ltr"/>
                                </p>
                                <p t-if="error == 'form'" class="ts-notice ts-notice--warn" role="alert">نام شرکت‌کننده و سنجه را انتخاب کنید.</p>
                                <p t-if="error == 'rule'" class="ts-notice ts-notice--warn" role="alert">این دعوت با قواعد این پنل سازگار نیست.</p>
                                <p t-if="error == 'pending'" class="ts-notice ts-notice--warn" role="alert">تا تأیید پنل، دعوت شرکت‌کنندهٔ واقعی ممکن نیست.</p>
                                <p t-if="flash" class="ts-notice ts-notice--warn" role="alert" t-out="flash"/>
                                <p t-if="is_new" class="ts-notice" role="status">پنل ساخته شد.</p>
                                <section t-if="ws.gated" class="ts-notice ts-notice--warn" id="ts-pending" role="status">
                                    <strong>پنل در انتظار تأیید است.</strong>
                                    <t t-if="ws.state == 'pilot'"> می‌توانید پنل را کامل کنید و همکارانتان را دعوت کنید؛ دعوت شرکت‌کنندهٔ واقعی و دریافت نتیجه پس از تأیید تیم استعدادیاب باز می‌شود.</t>
                                    <t t-if="ws.rejected_on"><br/>درخواست رد شد<t t-if="ws.rejection_note">: <span t-out="ws.rejection_note"/></t>. می‌توانید اطلاعات پنل را اصلاح کنید و با پشتیبانی تماس بگیرید.</t>
                                </section>
                                <section t-if="checklist" class="ts-card ts-card--soft" id="ts-checklist">
                                    <h2 class="h5">گام‌های راه‌اندازی</h2>
                                    <ol class="ts-checklist">
                                        <li t-foreach="checklist" t-as="c" t-attf-class="#{'is-done' if c[1] else ''}">
                                            <span t-out="'✓ ' if c[1] else '○ '"/><a t-if="c[2] and not c[1]" t-att-href="c[2]" t-out="c[0]"/><t t-else=""><t t-out="c[0]"/></t>
                                        </li>
                                    </ol>
                                </section>

                                <nav class="ts-stats" aria-label="وضعیت دعوت‌ها">
                                    <a t-attf-class="ts-stat #{'is-active' if not state_filter else ''}" href="?"><strong t-out="fa(total)"/><span>همه</span></a>
                                    <a t-attf-class="ts-stat #{'is-active' if state_filter == 'invited' else ''}" href="?state=invited"><strong t-out="fa(counts['invited'])"/><span>دعوت‌شده</span></a>
                                    <a t-attf-class="ts-stat #{'is-active' if state_filter == 'in_progress' else ''}" href="?state=in_progress"><strong t-out="fa(counts['in_progress'] + counts['accepted'])"/><span>در حال پاسخ</span></a>
                                    <a t-attf-class="ts-stat #{'is-active' if state_filter == 'done' else ''}" href="?state=done"><strong t-out="fa(counts['done'])"/><span>تکمیل‌شده</span></a>
                                    <a t-attf-class="ts-stat #{'is-active' if state_filter == 'declined' else ''}" href="?state=declined"><strong t-out="fa(counts['declined'] + counts['withdrawn'])"/><span>رد یا لغو</span></a>
                                    <a t-if="show_unassigned" t-attf-class="ts-stat #{'is-active' if resp_filter == 'none' else ''}" href="?resp=none"><strong t-out="fa(unassigned_count)"/><span>بدون کارشناس</span></a>
                                    <a t-attf-class="ts-stat #{'is-active' if resp_filter == 'mine' else ''}" href="?resp=mine"><strong t-out="fa(mine_count)"/><span>مسئولیت من</span></a>
                                </nav>

                                <section t-if="ws.purpose == 'education'" class="ts-card ts-card--soft" id="ts-imports">
                                    <h2 class="h5">نتیجه‌های واردشده <span class="ts-hint">(<t t-out="fa(len(imports))"/>)</span></h2>
                                    <nav class="ts-stats" aria-label="منبع">
                                        <a t-attf-class="ts-stat #{'is-active' if not src_filter else ''}" href="?">همه</a>
                                        <a t-attf-class="ts-stat #{'is-active' if src_filter == 'import' else ''}" href="?src=import">واردشده از نرم‌افزار قبلی</a>
                                        <a t-attf-class="ts-stat #{'is-active' if src_filter == 'invite' else ''}" href="?src=invite">دعوت‌های وب</a>
                                    </nav>
                                    <p t-if="not imports" class="ts-muted">نتیجهٔ واردشده‌ای در این فهرست نیست.</p>
                                    <div t-else="" class="ts-table-wrap">
                                        <table class="ts-table tsp-table--cards">
                                            <thead><tr><th scope="col">شرکت‌کننده</th><th scope="col">منبع</th><th scope="col">زمینه‌ها</th><th scope="col">تاریخ</th><th scope="col">کارشناس مسئول</th><th scope="col">دسترسی شرکت‌کننده</th><th scope="col"><span class="visually-hidden">اقدام</span></th></tr></thead>
                                            <tbody>
                                                <tr t-foreach="imports" t-as="p">
                                                    <td data-label="شرکت‌کننده"><strong t-out="p.person_id.name"/></td>
                                                    <td data-label="منبع">واردشده</td>
                                                    <td data-label="زمینه‌ها" t-out="fa(len(p.field_ids))"/>
                                                    <td data-label="تاریخ" t-out="p.jalali(p.submitted_at, False)"/>
                                                    <td data-label="کارشناس مسئول">
                                                        <form t-if="can_assign" t-attf-action="/my/workspaces/#{ws.id}/p/#{p.id}/responsible" method="post" class="ts-inline-form">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <select name="responsible_id" aria-label="کارشناس مسئول">
                                                                <option value="">بدون کارشناس</option>
                                                                <t t-foreach="assignable" t-as="rm"><option t-att-value="rm.id" t-att-selected="'selected' if p.responsible_id == rm else None" t-out="rm.user_id.name"/></t>
                                                            </select>
                                                            <button type="submit" class="ts-btn ts-btn--outline ts-btn--sm">ثبت</button>
                                                        </form>
                                                        <t t-else=""><t t-out="p.responsible_id.user_id.name or 'بدون کارشناس'"/></t>
                                                    </td>
                                                    <td data-label="دسترسی شرکت‌کننده"><span class="ts-pill" t-out="'منتشرشده' if p.released else 'منتشر نشده'"/></td>
                                                    <td><a t-attf-href="/my/workspaces/#{ws.id}/p/#{p.id}" class="ts-btn ts-btn--outline ts-btn--sm">پرونده</a></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </section>

                                <div class="ts-org-layout">
                                    <div class="ts-table-wrap">
                                        <p t-if="not assignments" class="ts-muted">دعوتی در این فهرست نیست.</p>
                                        <table t-else="" class="ts-table tsp-table--cards">
                                            <thead><tr><th scope="col">شرکت‌کننده</th><th scope="col">سنجه</th><th scope="col">وضعیت</th><th scope="col">کارشناس مسئول</th><th scope="col">اشتراک</th><th scope="col"><span class="visually-hidden">اقدام</span></th></tr></thead>
                                            <tbody>
                                                <tr t-foreach="assignments" t-as="a">
                                                    <td data-label="شرکت‌کننده"><strong t-out="a.invitee_name"/><div class="ts-hint"><bdi dir="ltr" t-out="a.name"/></div></td>
                                                    <td data-label="سنجه" t-out="a.instrument_id.title"/>
                                                    <td data-label="وضعیت"><span t-attf-class="ts-pill #{'ts-pill--ok' if a.state == 'done' else ('ts-pill--warn' if a.state in ('declined', 'withdrawn') else '')}" t-out="dict(a._fields['state'].selection).get(a.state)"/></td>
                                                    <td data-label="کارشناس مسئول">
                                                        <form t-if="can_assign" t-attf-action="/my/workspaces/#{ws.id}/a/#{a.id}/responsible" method="post" class="ts-inline-form">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <select name="responsible_id" aria-label="کارشناس مسئول">
                                                                <option value="">بدون کارشناس</option>
                                                                <t t-foreach="assignable" t-as="rm"><option t-att-value="rm.id" t-att-selected="'selected' if a.responsible_id == rm else None" t-out="rm.user_id.name"/></t>
                                                            </select>
                                                            <button type="submit" class="ts-btn ts-btn--outline ts-btn--sm">ثبت</button>
                                                        </form>
                                                        <t t-else=""><t t-out="a.responsible_id.user_id.name or 'بدون کارشناس'"/></t>
                                                    </td>
                                                    <td data-label="اشتراک" t-out="'دارد' if a.share_level != 'none' else ('—' if a.state == 'invited' else 'ندارد')"/>
                                                    <td><a t-attf-href="/my/workspaces/#{ws.id}/a/#{a.id}" class="ts-btn ts-btn--outline ts-btn--sm">جزئیات</a></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <aside t-if="can_invite_participants" id="ts-invite" class="ts-card ts-card--soft ts-org-invite">
                                        <h2 class="h5">دعوت شرکت‌کنندهٔ تازه</h2>
                                        <form t-attf-action="/my/workspaces/#{ws.id}/invite" method="post" class="ts-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <label for="ts_inv_name">نام و نام خانوادگی</label>
                                            <input id="ts_inv_name" name="invitee_name" type="text" required="required" maxlength="120" autocomplete="off"/>
                                            <label for="ts_inv_email">ایمیل (اختیاری)</label>
                                            <input id="ts_inv_email" name="invitee_email" type="email" dir="ltr" maxlength="200" autocomplete="off"/>
                                            <label for="ts_inv_inst">سنجه</label>
                                            <select id="ts_inv_inst" name="instrument_id" required="required">
                                                <option value="">انتخاب کنید</option>
                                                <t t-foreach="instruments" t-as="i"><option t-att-value="i.id"><t t-out="i.title"/> · <t t-if="i.code == 'TALENT-INV-15'">۱۵ جمله برای هر زمینه</t><t t-else=""><t t-out="fa(i.active_item_count)"/> پرسش</t></option></t>
                                            </select>
                                            <label for="ts_inv_note">یادداشت برای شرکت‌کننده (اختیاری)</label>
                                            <input id="ts_inv_note" name="note" type="text" maxlength="300"/>
                                            <button type="submit" class="ts-btn ts-btn--primary">ساخت پیوند دعوت</button>
                                            <p class="ts-hint">استعدادیاب ایمیل یا پیامک نمی‌فرستد؛ پیوند دعوت را خودتان برای شرکت‌کننده بفرستید.</p>
                                        </form>
                                    </aside>
                                </div>

                                <section t-if="member.has_perm('members:invite')" id="ts-members" class="ts-card ts-card--soft">
                                    <h2 class="h5">اعضای پنل</h2>
                                    <ul>
                                        <li t-foreach="members" t-as="m"><strong t-out="m.user_id.name"/> · <t t-out="dict(m._fields['role'].selection).get(m.role)"/></li>
                                    </ul>
                                    <div t-if="new_invite" class="ts-notice" role="status">
                                        پیوند دعوت ساخته شد. آن را برای همکارتان بفرستید؛ فقط با همان موبایل یا ایمیل کار می‌کند و ۷ روز اعتبار دارد:
                                        <input type="text" readonly="readonly" class="ts-copy" t-att-value="new_invite.invite_url()" aria-label="پیوند دعوت" dir="ltr"/>
                                    </div>
                                    <div t-if="pending_invites">
                                        <h3 class="h6">دعوت‌های در انتظار</h3>
                                        <ul>
                                            <li t-foreach="pending_invites" t-as="pi">
                                                <bdi dir="ltr" t-out="pi.phone or pi.email"/> · <t t-out="dict(pi._fields['role'].selection).get(pi.role)"/>
                                                <form t-attf-action="/my/workspaces/#{ws.id}/members/revoke/#{pi.id}" method="post" class="ts-inline-form">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="ts-btn ts-btn--outline ts-btn--sm">لغو</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                    <form t-attf-action="/my/workspaces/#{ws.id}/members/invite" method="post" class="ts-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <h3 class="h6">دعوت همکار</h3>
                                        <label for="ts_m_role">نقش</label>
                                        <select id="ts_m_role" name="role" required="required">
                                            <t t-foreach="role_choices" t-as="rc"><option t-att-value="rc[0]" t-out="rc[1]"/></t>
                                        </select>
                                        <label for="ts_m_phone">موبایل همکار</label>
                                        <input id="ts_m_phone" name="phone" type="tel" dir="ltr" maxlength="20" autocomplete="off"/>
                                        <label for="ts_m_email">یا ایمیل</label>
                                        <input id="ts_m_email" name="email" type="email" dir="ltr" maxlength="200" autocomplete="off"/>
                                        <button type="submit" class="ts-btn ts-btn--primary">ساخت پیوند دعوت</button>
                                        <p class="ts-hint">استعدادیاب برای همکاران پیامک یا ایمیل نمی‌فرستد؛ پیوند را خودتان بفرستید.</p>
                                    </form>
                                </section>

                                <section t-if="member.has_perm('panel:profile')" id="ts-settings" class="ts-card ts-card--soft">
                                    <h2 class="h5">نام و لوگو</h2>
                                    <form t-attf-action="/my/workspaces/#{ws.id}/settings" method="post" enctype="multipart/form-data" class="ts-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <label for="ts_s_name">نام پنل</label>
                                        <input id="ts_s_name" name="name" type="text" maxlength="100" t-att-value="ws.name"/>
                                        <t t-call="ts_website.filefield" ff_name.f="logo" ff_id.f="ts_s_logo" ff_label.f="لوگو" ff_accept.f="image/png,image/jpeg,image/webp" ff_hint.f="PNG، JPG یا WEBP، کمتر از ۵۰۰ کیلوبایت."/>
                                        <button type="submit" class="ts-btn ts-btn--outline">ذخیره</button>
                                    </form>
                                </section>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ====================================================== assignment -->
    <record id="tpl_assignment" model="ir.ui.view">
        <field name="name">TS: workspace assignment</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.assignment</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.assignment">
                <t t-call="website.layout" additional_title="a.invitee_name + ' · ' + inst.title">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section ts-report-page">
                            <div class="ts-container ts-report-wrap">
                                <div class="ts-report-actions ts-noprint">
                                    <a t-attf-href="/my/workspaces/#{ws.id}" class="ts-back" t-out="ws.name"/>
                                    <button t-if="level != 'none'" type="button" class="ts-btn ts-btn--quiet ts-js-print">چاپ همین صفحه</button>
                                </div>
                                <article class="ts-doc">
                                    <header class="ts-doc__head">
                                        <div class="ts-doc__brand">
                                            <img src="/ts_website/static/img/talentsearch-logo.webp" width="40" height="40" alt=""/>
                                            <div><strong>استعدادیاب</strong><small>از خانوادهٔ <bdi dir="ltr">EOT</bdi></small></div>
                                        </div>
                                        <div class="ts-doc__kind" t-out="'گزارش ویژهٔ مشاور' if level == 'clinical' else ('خلاصهٔ نتیجه برای پنل' if level == 'summary' else 'وضعیت دعوت')"/>
                                    </header>
                                    <h1 class="ts-doc__title" t-out="inst.title"/>
                                    <dl class="ts-meta ts-doc__meta">
                                        <dt>شرکت‌کننده</dt><dd t-out="a.invitee_name"/>
                                        <dt>وضعیت</dt><dd t-out="dict(a._fields['state'].selection).get(a.state)"/>
                                        <dt>شناسهٔ دعوت</dt><dd><bdi dir="ltr" t-out="a.name"/></dd>
                                        <dt>دعوت‌کننده</dt><dd t-out="a.invited_by_id.name"/>
                                        <dt>کارشناس مسئول</dt><dd t-out="a.responsible_id.user_id.name or 'بدون کارشناس'"/>
                                        <t t-if="attempt and attempt.submitted_at"><dt>تاریخ تکمیل</dt><dd t-out="attempt.jalali(attempt.submitted_at)"/></t>
                                        <dt>اشتراک نتیجه</dt><dd t-out="dict(a._fields['share_level'].selection).get(a.share_level)"/>
                                    </dl>

                                    <section t-if="a.state in ('invited', 'accepted', 'in_progress')" class="ts-doc__sec ts-noprint">
                                        <h2>پیوند دعوت</h2>
                                        <input type="text" readonly="readonly" class="ts-copy" t-att-value="a.invite_url()" aria-label="پیوند دعوت" dir="ltr"/>
                                        <form t-if="member.can_invite()" t-attf-action="/my/workspaces/#{ws.id}/a/#{a.id}/withdraw" method="post" class="ts-confirm">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <p class="ts-hint">پیوند از کار می‌افتد. اگر شرکت‌کننده شروع کرده باشد، پاسخ‌هایش دست‌نخورده می‌ماند.</p>
                                            <label class="ts-check"><input type="checkbox" name="confirm" value="1" required="required"/><span>مطمئنم، این دعوت لغو شود</span></label>
                                            <button type="submit" class="ts-btn ts-btn--danger ts-btn--sm">لغو این دعوت</button>
                                        </form>
                                    </section>

                                    <section t-if="a.state == 'done' and level == 'none'" class="ts-doc__sec">
                                        <h2>نتیجه</h2>
                                        <p t-if="a.share_level == 'none'">شرکت‌کننده سنجه را کامل کرده اما نتیجه را با این پنل به اشتراک نگذاشته است.</p>
                                        <p t-elif="ws.purpose == 'clinical'">گزارش ویژهٔ مشاور فقط برای مشاور تأییدشدهٔ این پنل نمایش داده می‌شود.</p>
                                        <p t-else="">نقش شما امکان مشاهدهٔ نتیجه را ندارد.</p>
                                    </section>

                                    <t t-if="level != 'none'">
                                        <section class="ts-doc__sec">
                                            <h2>خلاصهٔ نتیجه‌ها</h2>
                                            <p t-if="level == 'summary'" class="ts-hint">فقط سطح هر عامل نمایش داده می‌شود. نمره‌ها، پاسخ‌ها و متن‌های تفسیری شخصی نزد شرکت‌کننده می‌ماند. این نتیجه به‌تنهایی مبنای تصمیم استخدامی نیست.</p>
                                            <p t-else="" class="ts-hint">نمرهٔ هر عامل میانگین پاسخ‌ها از ۱ تا ۵ است.</p>
                                            <table class="ts-table ts-summary">
                                                <thead><tr><th scope="col">عامل</th><th t-if="level == 'clinical'" scope="col">نمره (۱ تا ۵)</th><th scope="col">سطح</th></tr></thead>
                                                <tbody>
                                                    <tr t-foreach="results" t-as="r">
                                                        <td t-out="r.factor_id.name"/>
                                                        <td t-if="level == 'clinical'" class="ts-num" t-out="r.score_fa()"/>
                                                        <td><span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </section>
                                        <t t-if="level == 'clinical'">
                                            <section t-foreach="results" t-as="r" class="ts-doc__sec ts-factor">
                                                <div class="ts-factor__head">
                                                    <h2 t-out="r.factor_id.name"/>
                                                    <div class="ts-factor__score"><span class="ts-num" t-out="r.score_fa()"/> <span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></div>
                                                </div>
                                                <h3>راهنمای مشاور</h3>
                                                <t t-foreach="r.therapist_sections()" t-as="sec">
                                                    <h4 t-if="sec[0]" t-out="sec[0]"/>
                                                    <div class="ts-doc__text" t-out="sec[1]"/>
                                                </t>
                                                <details class="ts-noprint-open">
                                                    <summary>متنی که شرکت‌کننده دیده است</summary>
                                                    <t t-foreach="r.client_sections()" t-as="sec">
                                                        <h4 t-if="sec[0]" t-out="sec[0]"/>
                                                        <div class="ts-doc__text" t-out="sec[1]"/>
                                                    </t>
                                                </details>
                                            </section>
                                        </t>
                                        <section class="ts-doc__sec ts-doc__foot">
                                            <h2>محدودیت‌ها</h2>
                                            <p t-out="inst.limitations"/>
                                            <p class="ts-hint">مشاهدهٔ این صفحه ثبت می‌شود. شناسهٔ گزارش <bdi dir="ltr" t-out="attempt.name"/> · اثر نتیجه <bdi dir="ltr" t-out="(attempt.output_hash or '')[:12]"/></p>
                                        </section>
                                    </t>
                                </article>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ========================================================== invite -->
    <record id="tpl_invite" model="ir.ui.view">
        <field name="name">TS: invitation</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.invite</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.invite">
                <t t-call="website.layout" additional_title.f="دعوت به سنجه">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-narrow">
                                <t t-set="matrix" t-value="inst.code == 'TALENT-INV-15'"/>
                                <div class="ts-section__head">
                                    <p class="ts-tag">دعوت به سنجه</p>
                                    <h1 t-out="inst.title"/>
                                    <p t-if="student"><strong t-out="ws.ts_public_name()"/> تو را به پاسخ‌دادن به این سنجه دعوت کرده است.</p>
                                    <p t-else=""><strong t-out="ws.ts_public_name()"/> شما را به پاسخ‌دادن به این سنجه دعوت کرده است.</p>
                                    <p t-if="matrix and student">زمینه‌هایی را که دوست داری می‌نویسی و می‌بینی در کدام‌ها توانایی بیشتری حس می‌کنی.</p>
                                    <p t-elif="matrix">زمینه‌هایی را که دوست دارید می‌نویسید و می‌بینید در کدام‌ها توانایی بیشتری حس می‌کنید.</p>
                                </div>
                                <div t-if="inv_state != 'ok'" class="ts-card ts-card--soft" role="status">
                                    <h2 class="h5" t-out="inv_msg[inv_state][0]"/>
                                    <p t-out="inv_msg[inv_state][1]"/>
                                </div>
                                <t t-else="">
                                    <div t-if="user_name" t-attf-class="ts-notice #{'ts-notice--warn' if mismatch else ''}" t-att-role="'alert' if mismatch else 'status'" id="ts-invite-account">
                                        <t t-if="student">با حساب «<bdi t-out="user_name"/>» وارد شده‌ای.</t>
                                        <t t-else="">با حساب «<bdi t-out="user_name"/>» وارد شده‌اید.</t>
                                        <t t-if="mismatch">
                                            این دعوت برای «<bdi t-out="(a.invitee_name or '').strip()"/>» است.
                                            <t t-if="student">اگر این دعوت مال تو نیست، از حساب خارج شو و با حساب درست وارد شو.</t>
                                            <t t-else="">اگر این دعوت برای شما نیست، از حساب خارج شوید و با حساب درست وارد شوید.</t>
                                            <a t-att-href="logout_url">خروج از این حساب</a>
                                        </t>
                                    </div>
                                    <dl class="ts-meta">
                                        <dt>دعوت برای</dt><dd><bdi t-out="(a.invitee_name or '').strip()"/></dd>
                                        <t t-if="matrix">
                                            <dt>اندازهٔ کار</dt><dd><t t-if="student">۱۵ جمله برای هر زمینه؛ ۲ تا ۸ زمینه را خودت می‌نویسی</t><t t-else="">۱۵ جمله برای هر زمینه؛ ۲ تا ۸ زمینه را خودتان می‌نویسید</t></dd>
                                            <dt>زمان تقریبی</dt><dd>حدود ۲ دقیقه برای هر زمینه</dd>
                                        </t>
                                        <t t-else="">
                                            <dt>تعداد پرسش</dt><dd t-out="fa(inst.active_item_count)"/>
                                            <dt>زمان تقریبی</dt><dd><t t-out="fa(inst.duration_minutes)"/> دقیقه</dd>
                                        </t>
                                        <t t-if="a.note"><dt>یادداشت پنل</dt><dd t-out="a.note"/></t>
                                    </dl>
                                    <t t-call="ts_org.share_box" share_ws="ws" share_student="student"/>
                                    <t t-if="public">
                                        <p t-if="student">برای شروع وارد حسابت شو یا حساب تازه بساز. گزارش نتیجه در حسابت می‌ماند.</p>
                                        <p t-else="">برای شروع وارد حساب خود شوید یا حساب تازه بسازید. گزارش نتیجه در حساب شما نگه داشته می‌شود.</p>
                                        <t t-call="ts_website.auth_choices" phone_url="phone_url" login_url="login_url" signup_url="signup_url"/>
                                    </t>
                                    <t t-else="">
                                        <form t-attf-action="/invite/#{a.token}/accept" method="post" class="ts-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <label class="ts-check">
                                                <input type="checkbox" name="share" value="1" checked="checked" aria-describedby="ts_share_note"/>
                                                <span t-if="ws.purpose == 'education'">اجازه می‌دهم مدرسه و مشاورم گزارش نتیجه‌ام را در پنل «<bdi t-out="ws.ts_public_name()"/>» ببینند.</span>
                                                <span t-elif="ws.purpose == 'employment'">اجازه می‌دهم سطح هر عامل با پنل «<bdi t-out="ws.ts_public_name()"/>» به اشتراک گذاشته شود.</span>
                                                <span t-else="">اجازه می‌دهم گزارش کامل با مشاور تأییدشدهٔ پنل «<bdi t-out="ws.ts_public_name()"/>» به اشتراک گذاشته شود.</span>
                                            </label>
                                            <p id="ts_share_note" class="ts-hint"><t t-if="student">اگر تیک را برداری هم می‌توانی سنجه را انجام بدهی؛ آن وقت نتیجه فقط برای خودت می‌ماند.</t><t t-else="">اگر تیک را بردارید هم می‌توانید سنجه را انجام دهید؛ آن وقت نتیجه فقط برای خودتان می‌ماند.</t></p>
                                            <button type="submit" class="ts-btn ts-btn--primary">پذیرفتن دعوت و ادامه</button>
                                        </form>
                                        <section t-if="ask_decline" class="ts-confirm" id="ts-decline" aria-labelledby="ts-decline-h">
                                            <h2 class="h6" id="ts-decline-h"><t t-if="student">دعوت را نمی‌پذیری؟</t><t t-else="">دعوت را نمی‌پذیرید؟</t></h2>
                                            <p t-if="student">پنل می‌بیند که دعوت را نپذیرفتی. اگر نظرت عوض شد، از مشاورت دعوت تازه بخواه.</p>
                                            <p t-else="">پنل می‌بیند که دعوت را نپذیرفتید. اگر نظرتان عوض شد، از دعوت‌کننده دعوت تازه بخواهید.</p>
                                            <form t-attf-action="/invite/#{a.token}/decline" method="post" class="ts-inline-form">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="ts-btn ts-btn--danger ts-btn--sm">بله، دعوت را نمی‌پذیرم</button>
                                                <a t-attf-href="/invite/#{a.token}" class="ts-btn ts-btn--quiet ts-btn--sm">انصراف</a>
                                            </form>
                                        </section>
                                        <p t-else=""><a t-attf-href="/invite/#{a.token}?decline=1#ts-decline" class="ts-btn ts-btn--quiet ts-btn--sm">نمی‌خواهم شرکت کنم</a></p>
                                    </t>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- What the panel will see: shown on /invite and on the open link /c (presentation only; consent stays the legal step).
         Params: share_ws (ts.workspace), share_student (True: «تو» register). -->
    <record id="tpl_share_box" model="ir.ui.view">
        <field name="name">TS: what the panel sees</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.share_box</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.share_box">
                <div class="ts-card ts-card--soft ts-share-box">
                    <h2 class="h5">چه چیزی با پنل «<bdi t-out="share_ws.ts_public_name()"/>» دیده می‌شود؟</h2>
                    <ul class="ts-list-check" t-if="share_ws.purpose == 'education' and share_student">
                        <li>مدرسه و مشاور مسئولت گزارش نتیجه‌ات را می‌بینند.</li>
                        <li>پاسخ‌های خامت را هرگز نمی‌بینند.</li>
                        <li>هر وقت بخواهی می‌توانی اشتراک‌گذاری را از صفحهٔ گزارش قطع کنی.</li>
                    </ul>
                    <ul class="ts-list-check" t-elif="share_ws.purpose == 'education'">
                        <li>مدرسه و مشاور مسئول شما گزارش نتیجه را می‌بینند.</li>
                        <li>پاسخ‌های خام شما را هرگز نمی‌بینند.</li>
                        <li>هر زمان بخواهید می‌توانید اشتراک‌گذاری را از صفحهٔ گزارش قطع کنید.</li>
                    </ul>
                    <ul class="ts-list-check" t-elif="share_ws.purpose == 'employment'">
                        <li>پنل وضعیت دعوت (شروع‌شده یا تکمیل‌شده) را می‌بیند.</li>
                        <li>اگر اجازه دهید، فقط سطح هر عامل (کم، متوسط یا زیاد) را می‌بیند.</li>
                        <li>پاسخ‌های شما، نمره‌ها و متن‌های تفسیری فقط برای شما نمایش داده می‌شود.</li>
                        <li>هر زمان بخواهید می‌توانید اشتراک‌گذاری را از صفحهٔ گزارش قطع کنید.</li>
                    </ul>
                    <ul class="ts-list-check" t-else="">
                        <li>مرکز مشاوره وضعیت دعوت را می‌بیند.</li>
                        <li>اگر اجازه دهید، گزارش کامل همراه با راهنمای مشاور فقط به مشاور تأییدشدهٔ این مرکز مشاوره نمایش داده می‌شود.</li>
                        <li>هر زمان بخواهید می‌توانید اشتراک‌گذاری را از صفحهٔ گزارش قطع کنید.</li>
                    </ul>
                </div>
            </t>
        </field>
    </record>

    <!-- Former sign-in choice of ts_org: now a thin alias of the one shared template, ts_website.auth_choices
         (views/components.xml). Kept only so an old caller does not break; call ts_website.auth_choices directly. -->
    <record id="tpl_auth_choices" model="ir.ui.view">
        <field name="name">TS: sign-in choices (alias)</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.auth_choices</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.auth_choices">
                <t t-call="ts_website.auth_choices" phone_url="phone_url" login_url="login_url" signup_url="signup_url" only="only"/>
            </t>
        </field>
    </record>

    <!-- Participant's own report: show and revoke workspace sharing. -->
    <record id="tpl_report_share" model="ir.ui.view">
        <field name="name">TS: report sharing note</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="ts_assessment.tpl_report"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('ts-doc__foot')]" position="before">
                <t t-set="ts_share" t-value="attempt.ts_org_assignment()"/>
                <section t-if="not ts_share and attempt.state == 'done' and not attempt.workspace_id and attempt.source != 'import'" class="ts-doc__sec ts-noprint" id="ts-share-counselor">
                    <h2>ارسال نتیجه برای مشاورم</h2>
                    <p>اگر مشاور دارید، می‌توانید با «کد پنل» او فقط بازهٔ هر زمینه را برایش بفرستید. پاسخ‌های شما دیده نمی‌شود و هر زمان می‌توانید اشتراک را لغو کنید.</p>
                    <a t-attf-href="/my/assessments/#{attempt.id}/share" class="ts-btn ts-btn--outline ts-btn--sm">ارسال برای مشاورم</a>
                </section>
                <section t-if="ts_share" class="ts-doc__sec ts-noprint">
                    <h2>اشتراک‌گذاری با پنل</h2>
                    <p t-if="ts_share.invited_by_id == attempt.user_id">این نتیجه را شما برای <strong t-out="ts_share.workspace_id.ts_public_name()"/> فرستاده‌اید.</p>
                    <p t-else="">این سنجه به دعوت <strong t-out="ts_share.workspace_id.ts_public_name()"/> انجام شد.</p>
                    <p>
                        <t t-if="ts_share.share_level == 'summary'">پنل فقط سطح هر زمینه یا عامل را می‌بیند.</t>
                        <t t-elif="ts_share.share_level == 'clinical'">گزارش کامل برای مشاور تأییدشدهٔ این مرکز مشاوره قابل مشاهده است.</t>
                        <t t-else="">نتیجه با پنل به اشتراک گذاشته نشده است.</t>
                    </p>
                    <form t-if="ts_share.share_level != 'none'" t-attf-action="/my/assessments/#{attempt.id}/unshare" method="post" class="ts-confirm">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <p class="ts-hint">پس از لغو، پنل دیگر این نتیجه را نمی‌بیند. برای اشتراک دوباره باید دعوت تازه یا کد پنل داشته باشید.</p>
                        <label class="ts-check"><input type="checkbox" name="confirm" value="1" required="required"/><span>مطمئنم، اشتراک لغو شود</span></label>
                        <button type="submit" class="ts-btn ts-btn--danger ts-btn--sm">لغو اشتراک</button>
                    </form>
                </section>
            </xpath>
        </field>
    </record>
</odoo>
