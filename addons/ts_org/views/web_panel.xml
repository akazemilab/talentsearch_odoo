<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= landing -->
    <record id="tpl_panel_landing" model="ir.ui.view">
        <field name="name">TS: panel landing</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_landing</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_landing">
                <t t-call="website.layout" additional_title.f="ساخت پنل رایگان">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head">
                                    <h1>پنل مرکز خود را رایگان بسازید</h1>
                                    <p>یک پنل، فضای کار شما برای دعوت شرکت‌کننده‌ها، دیدن گزارش‌هایی است که خودشان با شما به اشتراک می‌گذارند، و هم‌کاری با همکارانتان. ساخت پنل در این فصل رایگان است.</p>
                                </div>
                                <div class="ts-grid ts-panel-kinds">
                                    <article class="ts-card ts-panel-kind">
                                        <h2 class="h4">مدرسه یا مرکز مشاوره</h2>
                                        <p>بلافاصله فعال می‌شود. مشاورها را دعوت کنید و برای هر دانش‌آموز یک مشاور مسئول تعیین کنید.</p>
                                        <a t-attf-href="#{cta_url}?kind=school" class="ts-btn ts-btn--primary">ساخت پنل مدرسه</a>
                                    </article>
                                    <article class="ts-card ts-panel-kind">
                                        <h2 class="h4">سازمان</h2>
                                        <p>پنل را بسازید و همکارانتان را دعوت کنید. دعوت شرکت‌کنندهٔ واقعی پس از بررسی و تأیید تیم تلنت سرچ باز می‌شود.</p>
                                        <a t-attf-href="#{cta_url}?kind=org" class="ts-btn ts-btn--outline">ساخت پنل سازمان</a>
                                    </article>
                                    <article class="ts-card ts-panel-kind">
                                        <h2 class="h4">کلینیک روان‌شناسی و مشاوره</h2>
                                        <p>پنل را بسازید و متخصص‌ها را دعوت کنید. دعوت شرکت‌کنندهٔ واقعی پس از بررسی و تأیید تیم تلنت سرچ باز می‌شود.</p>
                                        <a t-attf-href="#{cta_url}?kind=clinic" class="ts-btn ts-btn--outline">ساخت پنل کلینیک</a>
                                    </article>
                                    <article class="ts-card ts-panel-kind">
                                        <h2 class="h4">کار مستقل</h2>
                                        <p>اگر تنها کار می‌کنید، یک پنل یک‌نفره بسازید؛ بعداً می‌توانید همکار اضافه کنید.</p>
                                        <a t-attf-href="#{cta_url}?kind=solo" class="ts-btn ts-btn--outline">ساخت پنل یک‌نفره</a>
                                    </article>
                                </div>
                                <p class="ts-hint ts-panel-steps">اول با شمارهٔ موبایل وارد می‌شوید، بعد نام و نوع پنل را می‌نویسید. پنل مدرسه بلافاصله فعال است؛ پنل سازمان و کلینیک تا بررسی تیم تلنت سرچ «در انتظار تأیید» می‌ماند و در این مدت می‌توانید پنل را کامل کنید و همکارانتان را دعوت کنید.</p>
                                <p><a href="/panel/terms">شرایط استفاده از پنل</a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= terms -->
    <record id="tpl_panel_terms" model="ir.ui.view">
        <field name="name">TS: panel terms</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_terms</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_terms">
                <t t-call="website.layout" additional_title.f="شرایط استفاده از پنل">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-prose">
                                <h1>شرایط استفاده از پنل</h1>
                                <p class="ts-hint"><t t-out="version_label"/> (<bdi dir="ltr" t-out="version"/>)</p>
                                <h2 class="h4">قیمت</h2>
                                <p>ساخت و استفاده از پنل در این فصل رایگان است. تعداد سنجه‌های تکمیل‌شده ثبت می‌شود، اما چیزی کسر یا مسدود نمی‌شود. اگر بعداً تعرفه‌ای تعیین شود، پیش از اعمال به شما اطلاع داده می‌شود.</p>
                                <h2 class="h4">پنل سازمان و کلینیک</h2>
                                <p>این پنل‌ها ابتدا «در انتظار تأیید» ساخته می‌شوند: می‌توانید پنل را بسازید و همکاران را دعوت کنید، اما دعوت شرکت‌کنندهٔ واقعی و دریافت نتیجه پس از بررسی و تأیید تیم تلنت سرچ امکان‌پذیر می‌شود. تیم تلنت سرچ می‌تواند درخواست را رد کند یا پنلی را تعلیق کند.</p>
                                <h2 class="h4">حریم خصوصی شرکت‌کننده</h2>
                                <p>شرکت‌کننده تصمیم می‌گیرد چه چیزی با پنل به اشتراک گذاشته شود. پاسخ‌های خام هرگز نمایش داده نمی‌شوند. شما متعهد می‌شوید از نتایج فقط برای هدفی که پنل برای آن ساخته شده استفاده کنید.</p>
                                <h2 class="h4">مسئولیت شما</h2>
                                <p>هر دعوتی که از پنل فرستاده می‌شود به نام شما و پنل شما ثبت می‌شود. اعضای پنل فقط آنچه را که به آن‌ها سپرده‌اید می‌بینند. نتایج ابزار سنجش، تشخیص یا تصمیم نهایی نیستند.</p>
                                <h2 class="h4">پنل بالینی</h2>
                                <p>مالک پنل بالینی می‌پذیرد که اگر شرکت‌کننده‌ای نشانهٔ خطر یا نیاز به پاسخ فوری بالینی نشان دهد، پاسخ‌گویی فوری با متخصص همان پنل است و تلنت سرچ خدمات اورژانسی ارائه نمی‌کند.</p>
                                <h2 class="h4" id="transfer">وقتی عضوی از پنل می‌رود، و انتقال شرکت‌کنندگان</h2>
                                <p>اگر عضوی از پنل جدا شود یا نقشش تغییر کند، شرکت‌کنندگان و نتیجه‌هایی که به او سپرده شده بود به صف «بدون کارشناس» برمی‌گردند: دسترسی او تمام می‌شود، هیچ نتیجه‌ای ناپدید نمی‌شود، و مالک پنل هر کدام را به عضو دیگری می‌سپارد. هر تغییر در دفتر ممیزی ثبت می‌شود.</p>
                                <p>اگر عضوی که پنل یک‌نفرهٔ خودش را دارد کار را رها کند، انتقال خودکار شرکت‌کنندگان به پنل دیگر فعلاً وجود ندارد. داده‌ها بین پنل‌ها جابه‌جا نمی‌شوند. شرکت‌کنندگان فقط وقتی نتیجه‌شان در پنل تازه دیده می‌شود که خودشان آن را دوباره برای آن پنل بفرستند یا دعوت آن پنل را بپذیرند.</p>
                                <h2 class="h4">دسترسی اضطراری (پنل بالینی)</h2>
                                <p>اگر برای رساندن کمک به شرکت‌کننده‌ای در خطر لازم باشد، مدیر پلتفرم می‌تواند با ثبت دلیل، برای ۲۴ ساعت به نتایج یک پنل بالینی دسترسی اضطراری بگیرد. مالک پنل از بازشدن آن مطلع می‌شود و هر مشاهده در دفتر ممیزی ثبت می‌شود.</p>
                                <p><a href="/panel" class="ts-backlink">ساخت پنل رایگان</a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= create -->
    <record id="tpl_panel_new" model="ir.ui.view">
        <field name="name">TS: new panel</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_new</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_new">
                <t t-call="website.layout" additional_title.f="ساخت پنل رایگان">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <a href="/my/workspaces" class="ts-backlink">پنل‌های من</a>
                                <div class="ts-section__head"><h1>ساخت پنل</h1></div>
                                <p t-if="error" class="ts-notice ts-notice--warn" role="alert" t-out="error"/>
                                <form action="/my/workspaces/new/create" method="post" class="ts-form ts-panel-new">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <label for="ts_p_name">نام پنل</label>
                                    <input id="ts_p_name" name="name" type="text" required="required" minlength="2" maxlength="100" t-att-value="vals.get('name')"/>
                                    <fieldset class="ts-fieldset" aria-describedby="ts_p_kind_h">
                                        <legend>نوع پنل</legend>
                                        <p id="ts_p_kind_h" class="ts-hint">پنل مدرسه بلافاصله فعال می‌شود. پنل سازمان و کلینیک تا بررسی تیم تلنت سرچ «در انتظار تأیید» است؛ در این مدت می‌توانید پنل را کامل کنید و همکاران را دعوت کنید.</p>
                                        <label class="ts-check"><input type="radio" name="kind" value="school" required="required" t-att-checked="'checked' if vals.get('kind') == 'school' else None"/><span>مدرسه یا مرکز مشاوره</span></label>
                                        <label class="ts-check"><input type="radio" name="kind" value="org" t-att-checked="'checked' if vals.get('kind') == 'org' else None"/><span>سازمان <span class="ts-hint">(نیاز به تأیید)</span></span></label>
                                        <label class="ts-check"><input type="radio" name="kind" value="clinic" t-att-checked="'checked' if vals.get('kind') == 'clinic' else None"/><span>کلینیک روان‌شناسی و مشاوره <span class="ts-hint">(نیاز به تأیید)</span></span></label>
                                        <label class="ts-check"><input type="radio" name="kind" value="solo" t-att-checked="'checked' if vals.get('kind') == 'solo' else None"/><span>کار مستقل (پنل یک‌نفره)</span></label>
                                    </fieldset>
                                    <div class="ts-reveal" data-ts-show="kind=solo">
                                        <label for="ts_p_solo">در پنل یک‌نفره چه کاری می‌کنید؟</label>
                                        <select id="ts_p_solo" name="solo_as">
                                            <option value="">—</option>
                                            <option value="counselor" t-att-selected="'selected' if vals.get('solo_as') == 'counselor' else None">مشاور تحصیلی یا شغلی</option>
                                            <option value="psychologist" t-att-selected="'selected' if vals.get('solo_as') == 'psychologist' else None">روان‌شناس یا متخصص بالینی (نیاز به تأیید)</option>
                                            <option value="hr" t-att-selected="'selected' if vals.get('solo_as') == 'hr' else None">منابع انسانی (نیاز به تأیید)</option>
                                        </select>
                                    </div>
                                    <div class="ts-reveal" data-ts-show="kind=solo;solo_as=psychologist">
                                        <label for="ts_p_lic">شمارهٔ پروانه یا نظام حرفه‌ای (برای روان‌شناس یا متخصص بالینی)</label>
                                        <input id="ts_p_lic" name="license_number" type="text" maxlength="60" dir="ltr"/>
                                    </div>
                                    <div class="ts-reveal" data-ts-show="kind=clinic|solo">
                                        <label class="ts-check"><input type="checkbox" name="escalation_ok" value="1"/><span>می‌پذیرم که پاسخ‌گویی فوری به نشانهٔ خطر بالینی با من است (برای پنل بالینی).</span></label>
                                    </div>
                                    <label class="ts-check"><input type="checkbox" name="terms" value="1" required="required"/><span><a href="/panel/terms">شرایط استفاده</a> را خوانده‌ام و می‌پذیرم.</span></label>
                                    <button type="submit" class="ts-btn ts-btn--primary">ساخت پنل</button>
                                </form>
                                <t t-call="ts_org.reveal_js"/>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Progressive disclosure: an element with data-ts-show="name=v1|v2;other=v" is shown only while every named control
         of its form has one of the values. Without JavaScript everything stays visible (labels say when a field applies). -->
    <record id="tpl_reveal_js" model="ir.ui.view">
        <field name="name">TS: reveal dependent fields</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.reveal_js</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.reveal_js">
                <script>(function () {
    function run() {
        var nodes = Array.prototype.slice.call(document.querySelectorAll('[data-ts-show]'));
        if (!nodes.length) { return; }
        function values(scope, name) {
            var out = [];
            scope.querySelectorAll('[name="' + name + '"]').forEach(function (el) {
                if (el.type === 'radio' || el.type === 'checkbox') { if (el.checked) { out.push(el.value); } } else { out.push(el.value); }
            });
            return out;
        }
        function update() {
            nodes.forEach(function (n) {
                var scope = n.closest('form') || document;
                var ok = n.getAttribute('data-ts-show').split(';').every(function (rule) {
                    var kv = rule.split('='), want = (kv[1] || '').split('|');
                    return values(scope, kv[0]).some(function (v) { return want.indexOf(v) !== -1; });
                });
                n.hidden = !ok;
            });
        }
        document.addEventListener('change', update);
        update();
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', run); } else { run(); }
})();</script>
            </t>
        </field>
    </record>

    <!-- ======================================================= join -->
    <record id="tpl_panel_join" model="ir.ui.view">
        <field name="name">TS: join panel</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_join</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_join">
                <t t-call="website.layout" additional_title.f="دعوت به پنل">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head"><h1>دعوت به پنل</h1></div>
                                <p t-if="error" class="ts-notice ts-notice--warn" role="alert" t-out="error"/>
                                <t t-if="state != 'ok'">
                                    <p class="ts-notice ts-notice--warn" role="alert">این دعوت دیگر معتبر نیست. از مالک پنل بخواهید دعوت تازه بفرستد.</p>
                                </t>
                                <t t-else="">
                                    <p>شما به پنل «<strong><bdi t-out="inv.workspace_id.name"/></strong>» با نقش «<strong t-out="role_label"/>» دعوت شده‌اید.</p>
                                    <dl class="ts-meta">
                                        <dt t-if="inviter">دعوت‌کننده</dt><dd t-if="inviter"><bdi t-out="inviter"/></dd>
                                        <dt>مهلت پذیرش</dt><dd>تا <t t-out="expires_fa"/></dd>
                                        <dt t-if="bound_to">برای</dt><dd t-if="bound_to"><bdi dir="ltr" t-out="bound_to"/></dd>
                                    </dl>
                                    <p><a href="/help/roles">این نقش چه چیزهایی را می‌بیند</a></p>
                                    <t t-if="not signed">
                                        <p t-if="by_phone">این دعوت برای شمارهٔ <bdi dir="ltr" t-out="bound_to"/> صادر شده است. برای پذیرفتن، با همین شماره وارد شوید.</p>
                                        <p t-else="">این دعوت برای ایمیل <bdi dir="ltr" t-out="bound_to"/> صادر شده است. برای پذیرفتن، با همین ایمیل وارد شوید یا حساب بسازید.</p>
                                        <p class="ts-hero__actions">
                                            <t t-if="by_phone">
                                                <a t-if="urls.get('phone_url')" t-att-href="urls['phone_url']" class="ts-btn ts-btn--primary">ورود با کد تأیید پیامکی</a>
                                                <a t-else="" t-att-href="urls['login_url']" class="ts-btn ts-btn--primary">ورود</a>
                                            </t>
                                            <t t-else="">
                                                <a t-att-href="urls['login_url']" class="ts-btn ts-btn--primary">ورود با ایمیل</a>
                                                <a t-att-href="urls['signup_url']" class="ts-btn ts-btn--outline">ساخت حساب با همین ایمیل</a>
                                            </t>
                                        </p>
                                    </t>
                                    <t t-elif="not fits">
                                        <p class="ts-notice ts-notice--warn" role="alert">با حساب «<bdi t-out="user_name"/>» وارد شده‌اید. این دعوت برای شمارهٔ موبایل یا ایمیل دیگری (<bdi dir="ltr" t-out="bound_to"/>) صادر شده است. با حسابی که دعوت برایش صادر شده وارد شوید. <a t-attf-href="/web/session/logout?redirect=/join/#{inv.token}">خروج از این حساب</a></p>
                                    </t>
                                    <form t-else="" t-attf-action="/join/#{inv.token}/accept" method="post" class="ts-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <t t-if="inv.role in ('clinician', 'clinic_director')">
                                            <label for="ts_j_lic">شمارهٔ پروانه یا نظام حرفه‌ای</label>
                                            <input id="ts_j_lic" name="license_number" type="text" required="required" maxlength="60" dir="ltr"/>
                                            <p class="ts-hint">شمارهٔ پروانه توسط تیم تلنت سرچ بررسی می‌شود.</p>
                                        </t>
                                        <button type="submit" class="ts-btn ts-btn--primary">پذیرفتن دعوت</button>
                                    </form>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= share with my counselor -->
    <record id="tpl_share_form" model="ir.ui.view">
        <field name="name">TS: share result with my counselor</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.share_form</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.share_form">
                <t t-call="website.layout" additional_title.f="ارسال برای مشاورم">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <a t-attf-href="/my/assessments/#{attempt.id}" class="ts-backlink">نتیجهٔ این سنجه</a>
                                <div class="ts-section__head">
                                    <h1>ارسال برای مشاورم</h1>
                                    <p>مشاور شما یک «کد پنل» دارد. با وارد کردن آن، فقط بازهٔ هر زمینه در نتیجهٔ شما برای مشاور دیده می‌شود. پاسخ‌های خام هرگز دیده نمی‌شوند و هر زمان بخواهید اشتراک را لغو می‌کنید.</p>
                                </div>
                                <p t-if="error" class="ts-notice ts-notice--warn" role="alert" t-out="error"/>
                                <div t-if="owned_by" class="ts-card ts-card--soft" role="status">
                                    <h2 class="h5">این نتیجه از قبل به یک پنل رسیده است</h2>
                                    <p t-if="owned_by">این سنجه به دعوت پنل «<bdi t-out="owned_by.name"/>» انجام شده و همان پنل، طبق اجازه‌ای که داده‌اید، آن را می‌بیند. ارسال دوباره با کد پنل لازم نیست.</p>
                                    <p><a href="/my/sharing" class="ts-btn ts-btn--outline">دیدن یا لغو اشتراک در «چه کسی می‌بیند»</a></p>
                                </div>
                                <t t-else="">
                                    <div t-if="shares" class="ts-notice" role="status">
                                        این نتیجه هم‌اکنون با این پنل‌ها به اشتراک گذاشته شده است:
                                        <strong><bdi t-out="'، '.join(shares.mapped('workspace_id.name'))"/></strong>.
                                        <a href="/my/sharing">مدیریت اشتراک‌ها</a>
                                    </div>
                                    <form t-if="not ws" t-attf-action="/my/assessments/#{attempt.id}/share" method="get" class="ts-form">
                                        <label for="ts_sh_code">کد پنل</label>
                                        <p id="ts_sh_hint" class="ts-hint">کد را از مشاورتان بگیرید؛ چند حرف و عدد انگلیسی است، مثل <bdi dir="ltr">TSW-0005</bdi>.</p>
                                        <input id="ts_sh_code" name="code" type="text" dir="ltr" required="required" maxlength="30" autocomplete="off" t-att-value="code" aria-describedby="ts_sh_hint"/>
                                        <button type="submit" class="ts-btn ts-btn--primary">ادامه</button>
                                    </form>
                                    <form t-else="" t-attf-action="/my/assessments/#{attempt.id}/share/confirm" method="post" class="ts-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="code" t-att-value="ws.code"/>
                                        <p>نتیجه برای پنل «<strong><bdi t-out="ws.name"/></strong>» ارسال شود؟</p>
                                        <button type="submit" class="ts-btn ts-btn--primary">بله، ارسال شود</button>
                                        <a t-attf-href="/my/assessments/#{attempt.id}/share" class="ts-btn ts-btn--outline">نه، کد دیگری وارد می‌کنم</a>
                                    </form>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
