<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= landing (onb3: one question, four kinds) -->
    <record id="tpl_panel_landing" model="ir.ui.view">
        <field name="name">TS: panel landing</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_landing</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_landing">
                <t t-call="website.layout" additional_title.f="ساخت پنل رایگان">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head">
                                    <h1>پنل خود را رایگان بسازید</h1>
                                    <p>بگویید برای چه کاری از استعدادیاب استفاده می‌کنید. پنل همان لحظه فعال است و با یک سنجهٔ آماده برای همان کار شروع می‌شود.</p>
                                </div>
                                <ul class="ts-grid ts-panel-kinds" aria-label="نوع پنل">
                                    <li t-foreach="[('clinic', 'مرکز مشاوره', 'مراجع پیش از جلسه سنجه را در خانه پر می‌کند؛ شما با گزارش وارد جلسه می‌شوید.'),
                                                    ('solo', 'مشاور یا روان‌شناس مستقل', 'گزارش علمی با نام و نشان خودتان، روی موبایل مراجع.'),
                                                    ('school', 'مدرسه', 'یک پیوند برای کل کلاس؛ تصویر کلاس و گزارش هر دانش‌آموز.'),
                                                    ('org', 'استخدام و منابع انسانی', 'داوطلب‌ها را بر پایهٔ نیازهای همان شغل ببینید، نه فقط رزومه.')]"
                                        t-as="k" class="ts-card ts-panel-kind">
                                        <h2 class="h4" t-out="k[1]"/>
                                        <p t-out="k[2]"/>
                                        <a t-attf-href="#{cta_url}?kind=#{k[0]}" class="ts-panel-kind__go" t-att-aria-label="'ساخت پنل: ' + k[1]">ساخت پنل<t t-call="ts_website.icon" ico.f="arrow-left"/></a>
                                    </li>
                                </ul>
                                <p class="ts-hint ts-panel-steps">در دورهٔ آزمایشی رایگان است. اول با شمارهٔ موبایل وارد می‌شوید، بعد نام پنل و نام خودتان را می‌نویسید؛ همین.</p>
                                <p><a href="/panel/terms">شرایط استفاده از پنل</a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= terms -->
    <record id="tpl_panel_terms" model="ir.ui.view">
        <field name="name">TS: panel terms</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_terms</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_terms">
                <t t-call="website.layout" additional_title.f="شرایط استفاده از پنل">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-prose">
                                <h1>شرایط استفاده از پنل</h1>
                                <p class="ts-hint"><t t-out="version_label"/> (<bdi dir="ltr" t-out="version"/>)</p>
                                <h2 class="h4">قیمت</h2>
                                <p>ساخت و استفاده از پنل در دورهٔ آزمایشی رایگان است. تعداد نتیجه‌های تکمیل‌شده ثبت می‌شود، اما چیزی کسر یا مسدود نمی‌شود. اگر بعداً تعرفه‌ای تعیین شود، پیش از اعمال به شما اطلاع داده می‌شود. پیش‌نمایشی که خودتان انجام می‌دهید و گزارش نمونه هیچ‌وقت هزینه ندارد.</p>
                                <h2 class="h4">فعال‌شدن پنل و هفتهٔ اول</h2>
                                <p>هر پنل، از هر نوع، همان لحظهٔ ساخت فعال است. پنلی که خودتان می‌سازید در هفت روز اول در هر ۲۴ ساعت تا ۵۰ دعوت شرکت‌کننده می‌فرستد؛ پیوستن با پیوند کلاس یا پیوند باز در این شمار نیست. اگر زودتر به دعوت بیشتری نیاز دارید، با پشتیبانی تماس بگیرید.</p>
                                <h2 class="h4">توقف موقت پنل</h2>
                                <p>اگر از پنلی برخلاف این شرایط استفاده شود، تیم استعدادیاب می‌تواند آن را موقتاً متوقف کند. در این مدت دعوت یا پاسخ‌دهی تازه شروع نمی‌شود، ولی هر شرکت‌کننده نتیجهٔ سنجه‌هایی را که تمام کرده همچنان در حساب خود می‌بیند.</p>
                                <h2 class="h4">حریم خصوصی شرکت‌کننده</h2>
                                <p>شرکت‌کننده تصمیم می‌گیرد چه چیزی با پنل به اشتراک گذاشته شود. پاسخ‌های خام هرگز نمایش داده نمی‌شوند. شما متعهد می‌شوید از نتایج فقط برای هدفی که پنل برای آن ساخته شده استفاده کنید.</p>
                                <h2 class="h4">مسئولیت شما</h2>
                                <p>هر دعوتی که از پنل فرستاده می‌شود به نام شما و پنل شما ثبت می‌شود. اعضای پنل فقط آنچه را که به آن‌ها سپرده‌اید می‌بینند. نتایج ابزار سنجش، تشخیص یا تصمیم نهایی نیستند.</p>
                                <h2 class="h4">پنل مرکز مشاوره</h2>
                                <p>پیش از نخستین دعوت مراجع، یکی از اعضای پنل مرکز مشاوره می‌پذیرد که اگر مراجعی نشانهٔ خطر یا نیاز به پیگیری فوری نشان دهد، پیگیری فوری با مشاوران همان پنل است و استعدادیاب خدمات اورژانسی ارائه نمی‌کند. بدون این پذیرش، دعوتی برای مراجع فرستاده نمی‌شود.</p>
                                <h2 class="h4" id="transfer">وقتی عضوی از پنل می‌رود، و انتقال شرکت‌کنندگان</h2>
                                <p>اگر عضوی از پنل جدا شود یا نقشش تغییر کند، شرکت‌کنندگان و نتیجه‌هایی که به او سپرده شده بود به صف «بدون کارشناس» برمی‌گردند: دسترسی او تمام می‌شود، هیچ نتیجه‌ای ناپدید نمی‌شود، و مالک پنل هر کدام را به عضو دیگری می‌سپارد. هر تغییر در دفتر ممیزی ثبت می‌شود.</p>
                                <p>اگر عضوی که پنل یک‌نفرهٔ خودش را دارد کار را رها کند، انتقال خودکار شرکت‌کنندگان به پنل دیگر فعلاً وجود ندارد. داده‌ها بین پنل‌ها جابه‌جا نمی‌شوند. شرکت‌کنندگان فقط وقتی نتیجه‌شان در پنل تازه دیده می‌شود که خودشان آن را دوباره برای آن پنل بفرستند یا دعوت آن پنل را بپذیرند.</p>
                                <h2 class="h4">دسترسی اضطراری (پنل مرکز مشاوره)</h2>
                                <p>اگر برای رساندن کمک به شرکت‌کننده‌ای در خطر لازم باشد، مدیر پلتفرم می‌تواند با ثبت دلیل، برای ۲۴ ساعت به نتایج یک پنل مرکز مشاوره دسترسی اضطراری بگیرد. مالک پنل از بازشدن آن مطلع می‌شود و هر مشاهده در دفتر ممیزی ثبت می‌شود.</p>
                                <p><a href="/panel" class="ts-backlink">ساخت پنل رایگان</a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= create (onb3: one form - kind, panel name, «نام شما») -->
    <record id="tpl_panel_new" model="ir.ui.view">
        <field name="name">TS: new panel</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_new</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_new">
                <t t-call="website.layout" additional_title.f="ساخت پنل رایگان">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-panel-form">
                                <a href="/my/workspaces" class="ts-backlink">پنل‌های من</a>
                                <div class="ts-section__head"><h1>ساخت پنل</h1></div>
                                <p t-if="error" class="ts-notice ts-notice--warn" role="alert" t-out="error"/>
                                <form action="/my/workspaces/new/create" method="post" class="ts-form ts-panel-new">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <fieldset class="ts-fieldset ts-kind-pick">
                                        <legend>برای چه کاری از استعدادیاب استفاده می‌کنید؟</legend>
                                        <label t-foreach="[('clinic', 'مرکز مشاوره', 'مراجعان مرکز را پیش از جلسه می‌سنجید.'),
                                                           ('solo', 'مشاور یا روان‌شناس مستقل', 'تنها کار می‌کنید و گزارش با نام شما می‌آید.'),
                                                           ('school', 'مدرسه', 'کلاس یا دانش‌آموزان را می‌سنجید.'),
                                                           ('org', 'استخدام و منابع انسانی', 'داوطلب‌های یک شغل را ارزیابی می‌کنید.')]"
                                               t-as="k" class="ts-kind-opt">
                                            <input type="radio" name="kind" t-att-value="k[0]" required="required" t-att-checked="'checked' if vals.get('kind') == k[0] else None"/>
                                            <span><strong t-out="k[1]"/><small t-out="k[2]"/></span>
                                        </label>
                                    </fieldset>
                                    <label for="ts_p_name">نام پنل</label>
                                    <input id="ts_p_name" name="name" type="text" required="required" minlength="2" maxlength="100" aria-describedby="ts_p_name_h" t-att-value="vals.get('name')"/>
                                    <p id="ts_p_name_h" class="ts-hint">همان نامی که مراجعان و همکاران می‌بینند؛ مثلاً نام مرکز، مدرسه یا شرکت.</p>
                                    <label for="ts_p_own">نام شما</label>
                                    <input id="ts_p_own" name="own_name" type="text" t-att-required="'required' if need_name else None" minlength="2" maxlength="80" autocomplete="name" aria-describedby="ts_p_own_h" t-att-value="vals.get('own_name')"/>
                                    <p id="ts_p_own_h" class="ts-hint">همکاران و مراجعان این نام را کنار پنل می‌بینند.</p>
                                    <button type="submit" name="accept" value="1" class="ts-btn ts-btn--primary ts-btn--lg">ساخت پنل</button>
                                    <p class="ts-hint">با ساخت پنل، <a href="/panel/terms">شرایط استفاده</a> را می‌پذیرید. در دورهٔ آزمایشی رایگان است.</p>
                                </form>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Progressive disclosure: an element with data-ts-show="name=v1|v2;other=v" is shown only while every named control
         of its form has one of the values; a control inside it marked data-ts-req is required only while it is shown. Without
         JavaScript everything stays visible and nothing is required by the browser (labels say when a field applies). -->
    <record id="tpl_reveal_js" model="ir.ui.view">
        <field name="name">TS: reveal dependent fields</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.reveal_js</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.reveal_js">
                <script>(function () {
    function run() {
        var nodes = Array.prototype.slice.call(document.querySelectorAll('[data-ts-show]'));
        if (!nodes.length) { return; }
        function values(scope, name) {
            var out = [];
            scope.querySelectorAll('[name="' + name + '"]').forEach(function (el) {
                if (el.type === 'radio' || el.type === 'checkbox') { if (el.checked) { out.push(el.value); } } else { out.push(el.value); }
            });
            return out;
        }
        function update() {
            nodes.forEach(function (n) {
                var scope = n.closest('form') || document;
                var ok = n.getAttribute('data-ts-show').split(';').every(function (rule) {
                    var kv = rule.split('='), want = (kv[1] || '').split('|');
                    return values(scope, kv[0]).some(function (v) { return want.indexOf(v) !== -1; });
                });
                n.hidden = !ok;
                n.querySelectorAll('[data-ts-req]').forEach(function (el) { el.required = ok; });
            });
        }
        document.addEventListener('change', update);
        update();
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', run); } else { run(); }
})();</script>
            </t>
        </field>
    </record>

    <!-- ======================================================= join -->
    <record id="tpl_panel_join" model="ir.ui.view">
        <field name="name">TS: join panel</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.panel_join</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.panel_join">
                <t t-call="website.layout" additional_title.f="دعوت به پنل">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head"><h1>دعوت به پنل</h1></div>
                                <p t-if="error" class="ts-notice ts-notice--warn" role="alert" t-out="error"/>
                                <!-- another account is signed in: the warning and the way out come first (UX T7 P10) -->
                                <div t-if="state == 'ok' and signed and not fits" class="ts-notice ts-notice--warn ts-acct" role="alert" id="ts-join-account">
                                    <div class="ts-acct__body">
                                        <p><t t-if="account['kind'] == 'name'">با حساب «<bdi t-out="account['label']"/>» وارد شده‌اید.</t><t t-elif="account['kind'] == 'phone'">با شمارهٔ <bdi dir="ltr" t-out="account['label']"/> وارد شده‌اید.</t><t t-elif="account['label']">با حساب <bdi dir="ltr" t-out="account['label']"/> وارد شده‌اید.</t><t t-else="">با حساب دیگری وارد شده‌اید.</t>
                                            این دعوت برای شمارهٔ موبایل یا ایمیل دیگری (<bdi dir="ltr" t-out="bound_to"/>) صادر شده است. با حسابی که دعوت برایش صادر شده وارد شوید.</p>
                                        <form t-attf-action="/web/session/logout?redirect=/join/#{inv.token}" method="post" class="ts-acct__out"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">خروج از این حساب</button></form>
                                    </div>
                                </div>
                                <t t-if="state != 'ok'">
                                    <!-- one dead-end card with a next step (UX T7 X1) -->
                                    <t t-call="ts_website.state_card" sc_title.f="این دعوت دیگر معتبر نیست" sc_text.f="از مالک پنل بخواهید دعوت تازه بفرستد." sc_public="not signed" sc_login="urls.get('phone_url') or urls.get('login_url')" sc_href.f="/my" sc_label.f="کارهای من"/>
                                </t>
                                <t t-else="">
                                    <p>شما به پنل «<strong><bdi t-out="inv.workspace_id.name"/></strong>» با نقش «<strong t-out="role_label"/>» دعوت شده‌اید.</p>
                                    <dl class="ts-meta">
                                        <dt t-if="inviter">دعوت‌کننده</dt><dd t-if="inviter"><bdi t-out="inviter"/></dd>
                                        <dt>مهلت پذیرش</dt><dd>تا <t t-out="expires_fa"/></dd>
                                        <dt t-if="bound_to">برای</dt><dd t-if="bound_to"><bdi dir="ltr" t-out="bound_to"/></dd>
                                    </dl>
                                    <p><a href="/help/roles">این نقش چه چیزهایی را می‌بیند</a></p>
                                    <t t-if="not signed">
                                        <p t-if="by_phone">این دعوت برای شمارهٔ <bdi dir="ltr" t-out="bound_to"/> صادر شده است. برای پذیرفتن، با همین شماره وارد شوید.</p>
                                        <p t-else="">این دعوت برای ایمیل <bdi dir="ltr" t-out="bound_to"/> صادر شده است. برای پذیرفتن، با همین ایمیل وارد شوید یا حساب بسازید.</p>
                                        <p class="ts-hero__actions">
                                            <t t-if="by_phone">
                                                <a t-if="urls.get('phone_url')" t-att-href="urls['phone_url']" class="ts-btn ts-btn--primary">ورود یا ثبت‌نام با موبایل</a>
                                                <a t-else="" t-att-href="urls['login_url']" class="ts-btn ts-btn--primary">ورود</a>
                                            </t>
                                            <t t-else="">
                                                <a t-att-href="urls['login_url']" class="ts-btn ts-btn--primary">ورود با ایمیل</a>
                                                <a t-att-href="urls['signup_url']" class="ts-btn ts-btn--outline">ساخت حساب با همین ایمیل</a>
                                            </t>
                                        </p>
                                    </t>
                                    <t t-elif="not fits">
                                        <p class="ts-hint">پذیرفتن این دعوت فقط با همان شماره یا ایمیلی ممکن است که دعوت برایش صادر شده.</p>
                                    </t>
                                    <form t-else="" t-attf-action="/join/#{inv.token}/accept" method="post" class="ts-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <t t-if="need_name">
                                        <label for="ts_j_own">نام شما</label>
                                        <input id="ts_j_own" name="own_name" type="text" required="required" minlength="2" maxlength="80" autocomplete="name" aria-describedby="ts_j_own_h"/>
                                        <p id="ts_j_own_h" class="ts-hint">همکاران پنل شما را با این نام می‌شناسند.</p>
                                        </t>
                                        <p t-if="inv.role in ('clinician', 'clinic_director')" class="ts-hint">شمارهٔ پروانه را بعد از پیوستن، هر وقت خواستید، در «هویت شما در گزارش‌ها» بنویسید؛ کار شما منتظر آن نمی‌ماند.</p>
                                        <button type="submit" class="ts-btn ts-btn--primary">پذیرفتن دعوت</button>
                                    </form>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ======================================================= share with my counselor -->
    <record id="tpl_share_form" model="ir.ui.view">
        <field name="name">TS: share result with my counselor</field>
        <field name="type">qweb</field>
        <field name="key">ts_org.share_form</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_org.share_form">
                <t t-call="website.layout" additional_title.f="ارسال برای مشاورم">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <a t-attf-href="/my/assessments/#{attempt.id}" class="ts-backlink">نتیجهٔ این سنجه</a>
                                <div class="ts-section__head">
                                    <h1>ارسال برای مشاورم</h1>
                                    <p>مشاور شما یک «کد پنل» دارد. با وارد کردن آن، فقط بازهٔ هر زمینه در نتیجهٔ شما برای مشاور دیده می‌شود. پاسخ‌های خام هرگز دیده نمی‌شوند و هر زمان بخواهید اشتراک‌گذاری را قطع می‌کنید.</p>
                                </div>
                                <p t-if="error" class="ts-notice ts-notice--warn" role="alert" t-out="error"/>
                                <div t-if="owned_by" class="ts-card ts-card--soft" role="status">
                                    <h2 class="h5">این نتیجه از قبل به یک پنل رسیده است</h2>
                                    <p t-if="owned_by">این سنجه به دعوت پنل «<bdi t-out="owned_by.ts_public_name()"/>» انجام شده و همان پنل، طبق اجازه‌ای که داده‌اید، آن را می‌بیند. ارسال دوباره با کد پنل لازم نیست.</p>
                                    <p><a href="/my/sharing" class="ts-btn ts-btn--outline">دیدن یا قطع اشتراک‌گذاری در «چه کسی می‌بیند»</a></p>
                                </div>
                                <t t-else="">
                                    <div t-if="shares" class="ts-notice" role="status">
                                        این نتیجه هم‌اکنون با این پنل‌ها به اشتراک گذاشته شده است:
                                        <strong><bdi t-out="'، '.join(w.ts_public_name() for w in shares.workspace_id)"/></strong>.
                                        <a href="/my/sharing">مدیریت اشتراک‌گذاری‌ها</a>
                                    </div>
                                    <form t-if="not ws" t-attf-action="/my/assessments/#{attempt.id}/share" method="get" class="ts-form">
                                        <label for="ts_sh_code">کد پنل</label>
                                        <p id="ts_sh_hint" class="ts-hint">کد را از مشاورتان بگیرید؛ چند حرف و عدد انگلیسی است، مثل <bdi dir="ltr">TSW-0005</bdi>.</p>
                                        <input id="ts_sh_code" name="code" type="text" dir="ltr" required="required" maxlength="30" autocomplete="off" t-att-value="code" aria-describedby="ts_sh_hint"/>
                                        <button type="submit" class="ts-btn ts-btn--primary">ادامه</button>
                                    </form>
                                    <form t-else="" t-attf-action="/my/assessments/#{attempt.id}/share/confirm" method="post" class="ts-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="code" t-att-value="ws.code"/>
                                        <p>نتیجه برای پنل «<strong><bdi t-out="ws.ts_public_name()"/></strong>» ارسال شود؟</p>
                                        <t t-if="need_name">
                                        <label for="ts_sh_own">نام شما</label>
                                        <input id="ts_sh_own" name="own_name" type="text" required="required" minlength="2" maxlength="80" autocomplete="name" aria-describedby="ts_sh_own_h"/>
                                        <p id="ts_sh_own_h" class="ts-hint">مشاورتان نتیجه را با این نام می‌بیند.</p>
                                        </t>
                                        <button type="submit" class="ts-btn ts-btn--primary">بله، ارسال شود</button>
                                        <a t-attf-href="/my/assessments/#{attempt.id}/share" class="ts-btn ts-btn--outline">نه، کد دیگری وارد می‌کنم</a>
                                    </form>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
