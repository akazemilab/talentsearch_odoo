<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Career reminders (models/nudge.py). Texts follow docs/clinic/05_sms_texts.md: no test or result named, Persian
         digits, the short link last. The EOT team may edit them in Settings -> SMS templates (noupdate). -->
    <data noupdate="1">
        <record id="sms_ip_stall" model="sms.template">
            <field name="name">استعدادیاب: آزمون شغلی نیمه‌کاره (یادآوری)</field>
            <field name="model_id" ref="model_ts_career_nudge"/>
            <field name="body">استعدادیاب
{{ ctx.get('left') }} سؤال تا نتیجهٔ شما مانده است؛ پاسخ‌های قبلی ذخیره شده‌اند.
{{ ctx.get('link') }}</field>
        </record>
        <record id="sms_bg_stall" model="sms.template">
            <field name="name">استعدادیاب: دو پرسش تا نتیجه (یادآوری)</field>
            <field name="model_id" ref="model_ts_career_nudge"/>
            <field name="body">استعدادیاب
فقط دو سؤال کوتاه تا دیدن نتیجه‌تان مانده است.
{{ ctx.get('link') }}</field>
        </record>
        <record id="sms_l2_invite" model="sms.template">
            <field name="name">استعدادیاب: دعوت به بخش دوم آزمون شغلی (یادآوری)</field>
            <field name="model_id" ref="model_ts_career_nudge"/>
            <field name="body">استعدادیاب
با یک بخش کوتاه دیگر، نتیجهٔ شما دقیق‌تر می‌شود. هر جا خواستید مکث کنید؛ پاسخ‌ها ذخیره می‌شوند.
{{ ctx.get('link') }}</field>
        </record>
        <record id="sms_l2_stall" model="sms.template">
            <field name="name">استعدادیاب: بخش دوم نیمه‌کاره (یادآوری)</field>
            <field name="model_id" ref="model_ts_career_nudge"/>
            <field name="body">استعدادیاب
{{ ctx.get('left') }} جمله تا کامل شدن بخش دوم نتیجه‌تان مانده است؛ از همان‌جا ادامه دهید.
{{ ctx.get('link') }}</field>
        </record>
        <record id="cron_career_nudges" model="ir.cron">
            <field name="name">استعدادیاب: یادآوری پیامکی آزمون شغلی (هر ساعت)</field>
            <field name="model_id" ref="model_ts_career_nudge"/>
            <field name="state">code</field>
            <field name="code">model._cron_career_nudges()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
