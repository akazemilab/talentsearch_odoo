<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Free career match (ts_career). Mobile first, one primary action per screen, «شما» register, Persian digits,
         levels not verdicts (docs/ux_writing/voice.md). -->
    <record id="tpl_notice" model="ir.ui.view">
        <field name="name">TS career: O*NET notice</field>
        <field name="type">qweb</field>
        <field name="key">ts_career.notice</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_career.notice">بخش علایق ترجمه و اقتباسی از <bdi dir="ltr">O*NET Interest Profiler</bdi> است. وزارت کار آمریکا (<bdi dir="ltr">USDOL/ETA</bdi>) این تغییرات را تأیید یا آزمایش نکرده است. داده‌های شغلی از <bdi dir="ltr">O*NET 31.0</bdi> با مجوز <bdi dir="ltr">CC BY 4.0</bdi>.</t>
        </field>
    </record>

    <record id="tpl_home" model="ir.ui.view">
        <field name="name">TS career: start</field>
        <field name="type">qweb</field>
        <field name="key">ts_career.home</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_career.home">
                <t t-call="website.layout" additional_title.f="شغل‌های هم‌خوان با علایق شما">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section tsc-home">
                            <div class="ts-container ts-narrow">
                                <p class="ts-tag">رایگان<t t-call="ts_website.sep"/>نسخهٔ آزمایشی</p>
                                <h1>کدام شغل‌ها با علایق شما هم‌خوان‌اند؟</h1>
                                <p class="ts-lead">به ۶۰ کار کوتاه بگویید چقدر دوست دارید انجامشان دهید. از میان ۹۲۳ شغل، آن‌هایی را می‌بینید که با علایق شما هم‌خوان‌اند.</p>
                                <p class="tsc-meta">حدود ۸ دقیقه<t t-call="ts_website.sep"/>روی گوشی<t t-call="ts_website.sep"/>نتیجه فقط برای خودتان</p>
                                <ol class="tsc-steps">
                                    <li><strong>علایق</strong>: ۶۰ کار، برای هر کدام یک انتخاب.</li>
                                    <li><strong>دو پرسش</strong>: تحصیلات و سابقهٔ کار.</li>
                                    <li><strong>نتیجه</strong>: فهرست شغل‌های هم‌خوان، با دلیل هر کدام.</li>
                                </ol>
                                <t t-if="full">
                                    <div class="tsc-note" role="status" id="tsc-full">
                                        <p><strong>ظرفیت رایگان امروز پر شده است.</strong> فردا دوباره سر بزنید.</p>
                                    </div>
                                </t>
                                <t t-elif="run and run.ts_state()['ip_done']">
                                    <a href="/career/r" class="ts-btn ts-btn--primary ts-btn--lg" id="tsc-see">دیدن نتیجهٔ من<t t-call="ts_website.icon" ico.f="arrow-left"/></a>
                                </t>
                                <t t-else="">
                                    <a href="/career/start" class="ts-btn ts-btn--primary ts-btn--lg" id="tsc-start">شروع رایگان<t t-call="ts_website.icon" ico.f="arrow-left"/></a>
                                    <p t-if="public" class="ts-hint">برای نگه‌داشتن نتیجه، با شمارهٔ همراه وارد می‌شوید.</p>
                                </t>
                                <p class="tsc-small">این فهرست برای خودشناسی شغلی است، نه تصمیم استخدام. <t t-call="ts_career.notice"/></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_background" model="ir.ui.view">
        <field name="name">TS career: education and experience</field>
        <field name="type">qweb</field>
        <field name="key">ts_career.background</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_career.background">
                <t t-call="website.layout" additional_title.f="تحصیلات و سابقهٔ کار">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-narrow">
                                <p class="ts-tag">یک قدم تا نتیجه</p>
                                <h1>تحصیلات و سابقهٔ کار</h1>
                                <p class="ts-lead">با این دو پاسخ، کنار هر شغل می‌بینید چقدر برای آن آماده‌اید.</p>
                                <div t-if="error" class="ts-error-summary" role="alert" id="tsc-bg-error">
                                    <p>به هر دو پرسش پاسخ دهید.</p>
                                </div>
                                <form action="/career/r" method="post" class="ts-form" id="tsc-bg">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <fieldset class="tsc-q">
                                        <legend>بالاترین مدرک تحصیلی شما</legend>
                                        <div class="tsc-choices">
                                            <label t-foreach="edu" t-as="o" class="tsc-choice">
                                                <input type="radio" name="edu" t-att-value="o[0]" required="required"
                                                       t-att-checked="run.edu == o[0] and 'checked' or None"/>
                                                <span t-out="o[1]"/>
                                            </label>
                                        </div>
                                    </fieldset>
                                    <fieldset class="tsc-q">
                                        <legend>سابقهٔ کار مرتبط</legend>
                                        <div class="tsc-choices">
                                            <label t-foreach="exp" t-as="o" class="tsc-choice">
                                                <input type="radio" name="exp" t-att-value="o[0]" required="required"
                                                       t-att-checked="run.exp == o[0] and 'checked' or None"/>
                                                <span t-out="o[1]"/>
                                            </label>
                                        </div>
                                    </fieldset>
                                    <button type="submit" class="ts-btn ts-btn--primary ts-btn--lg" id="tsc-bg-go">دیدن شغل‌های هم‌خوان</button>
                                </form>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_result" model="ir.ui.view">
        <field name="name">TS career: results</field>
        <field name="type">qweb</field>
        <field name="key">ts_career.result</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_career.result">
                <t t-call="website.layout" additional_title.f="شغل‌های هم‌خوان با شما">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section tsc-result">
                            <div class="ts-container ts-narrow">
                                <p class="ts-tag">نتیجهٔ مسیر شغلی<t t-call="ts_website.sep"/>نسخهٔ آزمایشی</p>
                                <t t-if="full_list">
                                    <h1>فهرست کامل شغل‌ها به ترتیب هم‌خوانی</h1>
                                    <p><a href="/career/r" class="tsc-back">بازگشت به شغل‌های برگزیده</a></p>
                                </t>
                                <t t-else="">
                                    <h1><t t-out="fa(n_short)"/> شغلی که بیشترین هم‌خوانی را با شما دارند</h1>
                                    <p class="ts-lead" id="tsc-basis">از میان <t t-out="fa(n_all)"/> شغل، بر پایهٔ <t t-if="tier == 'quick'">علایق شما</t><t t-elif="st['tasks_done']">علایق، سبک کاری و توانایی‌های شما</t><t t-else="">علایق و سبک کاری شما</t>.</p>
                                </t>

                                <section class="tsc-profile" aria-labelledby="tsc-prof-h">
                                    <h2 id="tsc-prof-h">سه علاقهٔ پررنگ‌تر شما</h2>
                                    <ul class="tsc-bars">
                                        <li t-foreach="profile" t-as="p">
                                            <span class="tsc-bars__name" t-out="p['name']"/>
                                            <span class="tsc-bars__track" aria-hidden="true"><span class="tsc-bars__fill" t-attf-style="width: #{p['w']}%"/></span>
                                            <span class="tsc-bars__gloss" t-out="p['gloss']"/>
                                        </li>
                                    </ul>
                                </section>

                                <section t-if="not st['hex_done'] or st['tasks_done'] &lt; st['tasks_total']" class="tsc-next" aria-labelledby="tsc-ref-h">
                                    <h2 id="tsc-ref-h">فهرست را دقیق‌تر کنید <span class="tsc-opt">اختیاری</span></h2>
                                    <form t-if="not st['hex_done']" action="/career/more/personality" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <p>با ۱۲۰ جملهٔ کوتاه دربارهٔ شیوهٔ کارتان، فهرست بر پایهٔ علایق و سبک کاری شما چیده می‌شود. حدود ۱۵ دقیقه، روی گوشی.</p>
                                        <button type="submit" class="ts-btn ts-btn--primary" id="tsc-go-personality"><t t-if="st['hex']">ادامهٔ سبک‌های کاری</t><t t-else="">افزودن سبک‌های کاری</t></button>
                                        <p class="tsc-consent">با شروع، رضایتی که در آغاز دادید برای این بخش هم ثبت می‌شود.</p>
                                    </form>
                                    <form t-else="" action="/career/more/abilities" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <p>با ۳ بخش زمان‌دار کوتاه، توانایی‌های شما هم در فهرست اثر می‌گذارد. حدود ۲۳ دقیقه؛ روی رایانه راحت‌تر است.<t t-if="st['tasks_done']"> <t t-out="fa(st['tasks_done'])"/> از <t t-out="fa(st['tasks_total'])"/> بخش انجام شد.</t></p>
                                        <button type="submit" class="ts-btn ts-btn--primary" id="tsc-go-abilities"><t t-if="st['tasks_done']">ادامهٔ توانایی‌ها</t><t t-else="">افزودن توانایی‌ها</t></button>
                                        <p class="tsc-consent">با شروع، رضایتی که در آغاز دادید برای این بخش هم ثبت می‌شود.</p>
                                    </form>
                                </section>
                                <t t-if="not full_list">
                                    <p t-if="not groups" class="tsc-note" id="tsc-empty">پاسخ‌های شما به همهٔ کارها یکسان بود و نمی‌شود علایقتان را از هم جدا کرد. اگر بخواهید، دوباره پاسخ دهید.</p>
                                    <section t-foreach="groups" t-as="g" class="tsc-area">
                                        <h2 class="tsc-area__h" t-out="g['name']"/>
                                        <ol class="tsc-jobs">
                                            <li t-foreach="g['rows']" t-as="j" class="tsc-job">
                                                <a t-attf-href="/career/job/#{j['code']}" class="tsc-job__link">
                                                    <span class="tsc-job__title"><span class="tsc-job__rank" t-out="fa(j['n'])"/> <t t-out="j['fa']"/></span>
                                                    <span t-if="j['types_fa']" class="tsc-job__why">بیشتر <t t-out="j['types_fa']"/></span>
                                                    <span t-attf-class="tsc-pill tsc-pill--#{j['ready'].lower()}">آمادگی: <t t-out="j['ready_fa']"/></span>
                                                    <span class="tsc-job__go" aria-hidden="true"><t t-call="ts_website.icon" ico.f="arrow-left"/></span>
                                                </a>
                                            </li>
                                        </ol>
                                    </section>
                                    <a href="/career/r?all=1" class="ts-btn ts-btn--quiet" id="tsc-all">دیدن فهرست کامل</a>
                                </t>
                                <t t-else="">
                                <nav class="tsc-filter" aria-label="فیلتر فهرست">
                                    <a t-attf-href="/career/r?all=1" t-att-aria-current="'page' if not ready_only else None" class="tsc-chip">همهٔ شغل‌ها</a>
                                    <a t-attf-href="/career/r?all=1&amp;ready=1" t-att-aria-current="'page' if ready_only else None" class="tsc-chip">شغل‌هایی که برایشان آماده‌اید</a>
                                </nav>

                                <p t-if="not rows" class="tsc-note" id="tsc-empty">
                                    <t t-if="ready_only">با تحصیلات و سابقه‌ای که وارد کردید، در این فهرست شغلی آماده پیدا نشد. «همهٔ شغل‌ها» را ببینید.</t>
                                    <t t-else="">پاسخ‌های شما به همهٔ کارها یکسان بود و نمی‌شود علایقتان را از هم جدا کرد. اگر بخواهید، دوباره پاسخ دهید.</t>
                                </p>
                                <ol class="tsc-jobs" id="tsc-jobs">
                                    <li t-foreach="rows" t-as="j" class="tsc-job">
                                        <a t-attf-href="/career/job/#{j['code']}" class="tsc-job__link">
                                            <span class="tsc-job__title"><span class="tsc-job__rank" t-out="fa(j['rank'])"/> <t t-out="j['fa']"/></span>
                                            <span t-if="j['types_fa']" class="tsc-job__why">بیشتر <t t-out="j['types_fa']"/></span>
                                            <span t-attf-class="tsc-pill tsc-pill--#{j['ready'].lower()}">آمادگی: <t t-out="j['ready_fa']"/></span>
                                            <span class="tsc-job__go" aria-hidden="true"><t t-call="ts_website.icon" ico.f="arrow-left"/></span>
                                        </a>
                                    </li>
                                </ol>
                                <a t-if="more" t-attf-href="/career/r?all=1&amp;n=#{n + 20}#{'&amp;ready=1' if ready_only else ''}" class="ts-btn ts-btn--quiet" id="tsc-more-rows">نمایش ۲۰ شغل دیگر</a>
                                </t>


                                <p class="tsc-small"><a href="/career/r?edit=1">ویرایش تحصیلات و سابقه</a></p>
                                <p class="tsc-small">این فهرست برای خودشناسی شغلی است، نه تصمیم استخدام. <t t-call="ts_career.notice"/></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_job" model="ir.ui.view">
        <field name="name">TS career: one occupation</field>
        <field name="type">qweb</field>
        <field name="key">ts_career.job</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_career.job">
                <t t-call="website.layout" additional_title="j['fa']">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section tsc-jobpage">
                            <div class="ts-container ts-narrow">
                                <p><a href="/career/r" class="tsc-back">بازگشت به فهرست</a></p>
                                <p class="ts-tag">رتبهٔ <t t-out="fa(j['rank'])"/> در فهرست شما</p>
                                <h1 t-out="j['fa']"/>
                                <p class="tsc-job__en"><bdi dir="ltr" t-out="j['en']"/></p>
                                <p t-if="j['desc']" class="ts-lead" t-out="j['desc']"/>

                                <section class="tsc-panel" aria-labelledby="tsc-p1">
                                    <h2 id="tsc-p1">تناسب</h2>
                                    <p><span t-attf-class="tsc-pill tsc-pill--#{j['level']}" t-out="j['level_fa']"/></p>
                                    <ul t-if="j['why']" class="ts-list-check"><li t-foreach="j['why']" t-as="w" t-out="w"/></ul>
                                </section>
                                <section class="tsc-panel" aria-labelledby="tsc-p2">
                                    <h2 id="tsc-p2">آمادگی</h2>
                                    <p><span t-attf-class="tsc-pill tsc-pill--#{j['ready'].lower()}" t-out="j['ready_fa']"/></p>
                                    <p t-if="j['jz']">سطح آمادگی این شغل: <t t-out="fa(j['jz'])"/> از ۵ (۵ بیشترین). <t t-out="j['jz_fa']"/>.</p>
                                </section>
                                <section t-if="j['clinic_fa']" class="tsc-panel" aria-labelledby="tsc-p3">
                                    <h2 id="tsc-p3">معاینات شغلی</h2>
                                    <p>این شغل به این توانایی‌های جسمی و حسی تکیه دارد. استعدادیاب آن‌ها را نمی‌سنجد؛ در صورت نیاز، پزشک طب کار بررسی می‌کند.</p>
                                    <ul class="tsc-watch"><li t-foreach="j['clinic_fa']" t-as="c" t-out="c"/></ul>
                                </section>
                                <section class="tsc-panel" aria-labelledby="tsc-p4">
                                    <h2 id="tsc-p4">دلایل و عدم‌قطعیت</h2>
                                    <ul t-if="j['watch']" class="tsc-watch"><li t-foreach="j['watch']" t-as="w" t-out="w"/></ul>
                                    <ul t-if="missing" class="tsc-watch"><li t-foreach="missing" t-as="m" t-out="m"/></ul>
                                    <p class="tsc-small">هم‌خوانی بر پایهٔ داده‌های شغلی O*NET (آمریکا) است و بازار کار ایران ممکن است فرق داشته باشد. <t t-call="ts_career.notice"/></p>
                                </section>
                                <form t-if="not st['hex_done']" action="/career/more/personality" method="post" class="tsc-jobnext">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p>برای دقیق‌تر شدن این تصویر، سبک‌های کاری‌تان را هم اضافه کنید (حدود ۱۵ دقیقه).</p>
                                    <button type="submit" class="ts-btn ts-btn--primary">افزودن سبک‌های کاری</button>
                                    <p class="tsc-consent">با شروع، رضایتی که در آغاز دادید برای این بخش هم ثبت می‌شود.</p>
                                </form>
                                <form t-elif="st['tasks_done'] &lt; st['tasks_total']" action="/career/more/abilities" method="post" class="tsc-jobnext">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <p>با ۳ بخش زمان‌دار کوتاه، توانایی‌هایتان هم در تناسب اثر می‌گذارد (حدود ۲۳ دقیقه).</p>
                                    <button type="submit" class="ts-btn ts-btn--primary">افزودن توانایی‌ها</button>
                                    <p class="tsc-consent">با شروع، رضایتی که در آغاز دادید برای این بخش هم ثبت می‌شود.</p>
                                </form>
                                <a href="/career/r" class="ts-btn ts-btn--quiet">بازگشت به فهرست</a>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- the interest module asks «how much would you like to do this», not «how true is this about you» -->
    <record id="player_help_ip" model="ir.ui.view">
        <field name="name">TS career: interest prompt</field>
        <field name="inherit_id" ref="ts_assessment.tpl_player"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//p[hasclass('ts-scale-help')][1]" position="before">
                <p class="ts-scale-help" t-if="inst.code == 'CAREER-IP-60'">چقدر دوست دارید این کار را انجام دهید؟ به آموزش لازم یا درآمد فکر نکنید.</p>
            </xpath>
            <xpath expr="//p[hasclass('ts-scale-help')][2]" position="attributes">
                <attribute name="t-if">inst.audience == 'child' and inst.code != 'CAREER-IP-60'</attribute>
            </xpath>
            <xpath expr="//p[hasclass('ts-scale-help')][3]" position="attributes">
                <attribute name="t-elif">tu and inst.code != 'CAREER-IP-60'</attribute>
            </xpath>
            <xpath expr="//p[hasclass('ts-scale-help')][4]" position="attributes">
                <attribute name="t-elif">inst.code != 'CAREER-IP-60'</attribute>
                <attribute name="t-else"/>
            </xpath>
        </field>
    </record>

</odoo>
