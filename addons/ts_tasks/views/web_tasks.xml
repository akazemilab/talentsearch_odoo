<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Timed task player (website 2 only). The script renders the blocks inside .tst-stage. -->
    <record id="tpl_task_player" model="ir.ui.view">
        <field name="name">TS tasks: player</field>
        <field name="type">qweb</field>
        <field name="key">ts_tasks.player</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_tasks.player">
                <t t-call="website.layout" additional_title="inst.title">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section tst-player" t-att-data-token="attempt.access_token"
                                 t-att-data-csrf="request.csrf_token()" t-att-data-config="cfg_json" t-att-data-org="hire_org or None">
                            <div class="ts-container ts-narrow">
                                <p class="ts-hero__kicker">آزمون زمان‌دار</p>
                                <h1 class="tst-title" t-out="inst.title"/>
                                <p class="ts-lead" t-out="cfg['intro']"/>
                                <!-- hiring battery (ts_hire passes hire_org): who asked for the test and what that organisation sees.
                                     verify T7: the same sentence as the invitation and consent (ts_panel.who_sees_line, with
                                     ts_hire.who_sees_position), plus what «نشانه‌های دقت پاسخ‌دهی» means on this page -->
                                <p class="ts-hint tst-who" t-if="hire_org">این آزمون را <strong t-out="hire_org"/> خواسته است.
                                    <t t-call="ts_panel.who_sees_line"/>
                                    <t t-if="hire_shared"> «نشانه‌های دقت پاسخ‌دهی» یعنی مثلاً بیرون رفتن از صفحه در میانهٔ یک بخش.</t></p>
                                <p class="ts-hint" t-if="cfg['accom'] and cfg['accom'] &gt; 1">برای شما زمان بیشتری در نظر گرفته شده است.</p>
                                <div class="tst-stage" aria-live="off">
                                    <noscript><p class="ts-notice ts-notice--warn">این آزمون بدون جاوااسکریپت اجرا نمی‌شود؛ آن را در تنظیمات مرورگر روشن کنید.</p></noscript>
                                    <p class="tst-wait">در حال بارگذاری…</p>
                                </div>
                                <p class="tst-live visually-hidden" aria-live="assertive"/>
                                <p class="ts-hint tst-foot">زمان هر بخش از لحظهٔ شروع می‌گذرد، حتی اگر صفحه را ببندید؛ پس هر بخش را یک‌جا تمام کنید. نتیجه پس از پایان همهٔ بخش‌ها آماده است.</p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!-- CONSENT v5 (owner 2026-10-13): on a timed task's consent page, «stop any time» says what the player footer says:
         the clock of a started section keeps running (task.py: deadline = start + limit), so a section is done in one go.
         A correction of what the page said vs what the code does; every v4 fact stays. -->
    <record id="consent_task" model="ir.ui.view">
        <field name="name">ts_tasks.consent</field>
        <field name="inherit_id" ref="ts_assessment.tpl_consent"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">45</field>
        <field name="arch" type="xml">
            <xpath expr="//dd[@id='ts-sum-stop']" position="inside">
                <t t-if="inst.ts_is_task_inst()"><t t-if="tu"> اما زمان هر بخش از لحظهٔ شروع می‌گذرد، حتی اگر صفحه را ببندی؛ پس هر بخش را یک‌جا تمام کن.</t><t t-else=""> اما زمان هر بخش از لحظهٔ شروع می‌گذرد، حتی اگر صفحه را ببندید؛ پس هر بخش را یک‌جا تمام کنید.</t></t>
            </xpath>
            <xpath expr="//dd[@id='ts-full-save']" position="inside">
                <t t-if="inst.ts_is_task_inst()"><t t-if="tu"> زمان هر بخش از لحظهٔ شروع می‌گذرد، حتی اگر صفحه را ببندی.</t><t t-else=""> زمان هر بخش از لحظهٔ شروع می‌گذرد، حتی اگر صفحه را ببندید.</t></t>
            </xpath>
        </field>
    </record>
    <!-- Report blocks: task results are percentiles 0-100 (not means on 1-5). Hint, column and meter follow.
         The questionnaire hint stays the ts_assessment one (with its «تو» branch); only task reports get their own. -->
    <record id="report_blocks_task" model="ir.ui.view">
        <field name="name">ts_tasks.report_blocks</field>
        <field name="inherit_id" ref="ts_assessment.tpl_report_blocks"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//section[1]/p[hasclass('ts-hint')]" position="before">
                <p class="ts-hint" t-if="results and results[0].attempt_id.version_id.mode == 'task'">برای هر توانایی، جایگاه شما در مقایسه با دیگر شرکت‌کنندگان (صدک) نشان داده می‌شود؛ تا جمع شدن داده‌های کافی، این جایگاه برآورد موقت است. بازه‌ها: کم، متوسط و زیاد.</p>
            </xpath>
            <xpath expr="//section[1]/p[hasclass('ts-hint')][not(@t-if)]" position="attributes">
                <attribute name="t-if">not (results and results[0].attempt_id.version_id.mode == 'task')</attribute>
            </xpath>
            <xpath expr="//section[1]//thead/tr/th[2]" position="replace">
                <!-- verify T7: the column name never breaks inside its range («(۱ تا | ۵)» at 390) -->
                <th scope="col" class="ts-nowrap" t-if="results and results[0].attempt_id.version_id.mode == 'task'">صدک (۰ تا ۱۰۰)</th>
                <th scope="col" class="ts-nowrap" t-else="">نمره (۱ تا ۵)</th>
            </xpath>
            <xpath expr="//section[1]//span[contains(@t-attf-class, 'ts-meter__seg')]" position="attributes">
                <attribute name="t-attf-style">width: #{b.ts_seg_pct()}%</attribute>
            </xpath>
            <xpath expr="//section[1]//div[hasclass('ts-meter')]" position="attributes">
                <attribute name="t-att-aria-label">r.ts_meter_label()</attribute>
            </xpath>
        </field>
    </record>
</odoo>
