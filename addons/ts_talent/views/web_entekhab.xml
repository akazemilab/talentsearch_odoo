<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Landing for the post-Konkur selection window (website 4 only). Copy follows
         talent-assessment/decision-entekhab-reshteh-1405.md: self-knowledge, no "best major" claims. -->
    <record id="page_er_view" model="ir.ui.view">
        <field name="name">TS talent: entekhab-reshteh landing</field>
        <field name="type">qweb</field>
        <field name="key">ts_talent.page_er</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_talent.page_er">
                <t t-call="website.layout" additional_title.f="پیش از انتخاب رشته">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_website.page_hero" kicker.f="انتخاب رشتهٔ ۱۴۰۵" title.f="پیش از پر کردن فرم انتخاب رشته، زمینه‌های خودتان را کنار هم ببینید" lead.f="فهرست تعاملی استعداد از شما می‌خواهد چند زمینهٔ مدنظرتان را بنویسید و هر کدام را با همان ۱۵ جمله بسنجید؛ سپس همان زمینه‌ها را کنار هم می‌گذارد. این ابزار رشتهٔ «بهتر» را تعیین نمی‌کند؛ گفتگو با خودتان و مشاورتان را دقیق‌تر می‌کند."/>
                        <section class="ts-section">
                            <div class="ts-container ts-prose">
                                <h2>چطور کار می‌کند</h2>
                                <ol>
                                    <li>چهار زمینه یا رشته‌ای را که به آن فکر می‌کنید بنویسید (دست‌کم دو و حداکثر هشت زمینه).</li>
                                    <li>برای هر زمینه ۱۵ جمله را با مقیاس پنج‌درجه‌ای از «بسیار کم» تا «بسیار زیاد» پاسخ دهید؛ پاسخ‌ها خودکار ذخیره می‌شوند.</li>
                                    <li>گزارشی می‌گیرید که زمینه‌ها را در پنج توانایی کنار هم می‌گذارد و می‌توانید آن را چاپ یا با مشاورتان مرور کنید.</li>
                                </ol>
                                <p><a class="ts-btn ts-btn--primary" href="/assessments/فهرست-تعاملی-استعداد">شروع سنجه</a>
                                    <a class="ts-btn ts-btn--outline" href="/entekhab-reshteh/sample">نمونهٔ گزارش (ساختگی)</a></p>

                                <h2>چه چیزی می‌بینید</h2>
                                <ul class="ts-list-check">
                                    <li>برای هر توانایی، نمرهٔ هر زمینه کنار زمینه‌های دیگر و برچسب «برجسته» یا «نزدیک».</li>
                                    <li>میانگین هر زمینه، بیشترین و کمترین توانایی‌اش.</li>
                                    <li>تفسیر هفت‌سطحی کتاب، جدول کامل و برنامه‌های پیشنهادی کتاب.</li>
                                </ul>

                                <h2>چه چیزی نمی‌بینید</h2>
                                <p>این گزارش پیش‌بینی نمرهٔ کنکور، رتبه یا موفقیت در یک رشته نیست و جایگزین مشاورهٔ تحصیلی نیست. نمره‌ها برداشت خودِ شما از خودتان‌اند و فقط زمینه‌های خودِ شما با هم مقایسه می‌شوند، نه با دیگران. اختلاف‌های کوچک (حدود ۱۰ نمره) را معنادار نگیرید.</p>

                                <h2>برای مشاوران و مؤسسه‌ها</h2>
                                <p>مشاور می‌تواند گزارش شرکت‌کنندگانِ مؤسسه را بدون پاسخ‌های خام ببیند و با نام مؤسسه چاپ کند. شرکت‌کننده تا خودش نتیجه را ندیده یا منتشر نکرده، مؤسسه بدون اجازه به آن دسترسی ندارد، مگر نتیجه‌هایی که از پیش برای همان مؤسسه ثبت شده‌اند. برای هماهنگی: <a href="/contact?topic=demo">درخواست جلسهٔ معرفی</a>.</p>

                                <h2>هزینه</h2>
                                <p>در فصل انتخاب رشتهٔ ۱۴۰۵ سنجه برای شرکت‌کنندگان رایگان است.</p>
                                <p class="ts-hint">داده‌های شما فقط برای همین سنجش و با رضایت شما نگه‌داری می‌شود؛ جزئیات در <a href="/privacy">حریم خصوصی</a>.</p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="page_er" model="website.page">
        <field name="url">/entekhab-reshteh</field>
        <field name="view_id" ref="page_er_view"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="website_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>

    <record id="tpl_er_sample" model="ir.ui.view">
        <field name="name">TS talent: entekhab-reshteh sample report</field>
        <field name="type">qweb</field>
        <field name="key">ts_talent.er_sample</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_talent.er_sample">
                <t t-call="website.layout" additional_title.f="نمونهٔ گزارش انتخاب رشته">
                    <div id="wrap" class="ts-page tt-page">
                        <section class="ts-section ts-report-page">
                            <div class="ts-container ts-report-wrap">
                                <div class="ts-report-actions ts-noprint"><a href="/entekhab-reshteh" class="ts-back">بازگشت</a></div>
                                <article class="ts-doc tt-report">
                                    <p class="tt-cobrand"><strong>نمونهٔ ساختگی</strong> — نام، زمینه‌ها و نمره‌ها واقعی نیستند و فقط شکل گزارش را نشان می‌دهند.</p>
                                    <h1 class="ts-doc__title">زمینه‌ها کنار هم</h1>
                                    <p class="tt-lead">شرکت‌کنندهٔ فرضی چهار زمینه نوشته است: <t t-out="joinfa(names, True)"/>.</p>
                                    <section class="ts-doc__sec tt-compare">
                                        <p class="tt-mini">هر ردیف یک توانایی است و هر نوار یک زمینه؛ طول نوار از ۲۰ (کمترین ممکن) تا ۱۰۰ (بیشترین ممکن). «برجسته» یعنی بالاترین نمره در آن ردیف و «نزدیک» یعنی حداکثر <t t-out="fa(gap)"/> نمره کمتر از آن.</p>
                                        <div class="tt-cmp">
                                            <div t-foreach="cmp_rows" t-as="r" t-attf-class="tt-cmp__row #{'is-total' if r['total'] else ''}">
                                                <h3 t-out="r['name']"/>
                                                <ul>
                                                    <li t-foreach="r['cells']" t-as="c" t-attf-class="tt-cmp__cell tt-m-#{c['mark'] or 'none'}">
                                                        <span class="tt-cmp__lab" t-out="c['label']"/>
                                                        <span class="tt-cmp__bar" aria-hidden="true"><i t-attf-class="tt-f#{c_index + 1}" t-attf-style="width: #{c['pct']}%"/></span>
                                                        <b t-out="fmt(c['score'])"/>
                                                        <em t-if="c['mark'] == 'best'">برجسته</em>
                                                        <em t-elif="c['mark'] == 'near'">نزدیک</em>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="tt-cards">
                                            <div t-foreach="cmp_cards" t-as="k" class="tt-card">
                                                <h3><i t-attf-class="tt-f#{k['idx']}"/><t t-out="k['label']"/><span>میانگین <t t-out="fmt(k['tot'])"/></span></h3>
                                                <p>بیشترین: <t t-out="joinfa(k['high'])"/> (<t t-out="fmt(k['high_score'])"/>)</p>
                                                <p>کمترین: <t t-out="joinfa(k['low'])"/> (<t t-out="fmt(k['low_score'])"/>)</p>
                                                <p t-if="k['caution']" class="tt-flag">این زمینه با احتیاط خوانده شود (پاسخ یکسان یا بسیار سریع).</p>
                                            </div>
                                        </div>
                                        <p>این ترتیب توصیهٔ انتخاب یا حذف رشته نیست؛ برای تصمیم، آن را با نمره‌ها، علاقه و مشورت بسنجید.</p>
                                    </section>
                                    <p><a class="ts-btn ts-btn--primary ts-noprint" href="/assessments/فهرست-تعاملی-استعداد">شروع سنجهٔ واقعی</a></p>
                                </article>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
