<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clinic phase 3: the battery in pages of other modules (website 2 only). Each xpath names an anchor of its parent. -->

    <!-- ===================================================== consent (first attempt of a battery) -->
    <record id="consent_battery_assessment" model="ir.ui.view">
        <field name="name">ts_battery.consent.assessment</field>
        <field name="inherit_id" ref="ts_assessment.tpl_consent"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//span[hasclass('ts-hero__kicker')]" position="replace">
                <t t-set="bat_info" t-value="attempt.ts_battery_info()"/>
                <span t-if="bat_info" class="ts-hero__kicker">مجموعهٔ سنجه‌ها</span>
                <span t-else="" class="ts-hero__kicker" t-out="inst.category"/>
            </xpath>
            <xpath expr="//h1" position="replace">
                <h1 t-if="bat_info" t-out="bat_info['name']"/>
                <h1 t-else="" t-out="inst.title"/>
            </xpath>
            <!-- T7: the error summary stays right under the H1; the battery card comes just before the key facts -->
            <xpath expr="//dl[@id='ts-consent-key']" position="before">
                <t t-call="ts_battery.consent_battery_block"/>
            </xpath>
            <xpath expr="//dt[text()='هدف']/following-sibling::dd[1]" position="replace">
                <dd t-if="bat_info" t-out="bat_info['description'] or inst.ts_intended_use()"/>
                <dd t-else="" t-out="inst.ts_intended_use()"/>
            </xpath>
            <xpath expr="//dt[text()='زمان تقریبی']/following-sibling::dd[1]" position="replace">
                <!-- T7: counts from ts_org effort_facts / the instrument's labels (never «۰ پرسش» for a timed task, W20) -->
                <dd t-if="bat_info"><t t-out="bat_info['size']"/>؛ <t t-out="bat_info['time']"/> برای همهٔ مجموعه</dd>
                <dd t-else=""><t t-out="inst.ts_effort_label()"/>، <t t-out="inst.ts_duration_label()"/></dd>
            </xpath>
            <!-- one battery-level limitation, not the first instrument's (CONSENT_VERSION v4, G6-P12-1) -->
            <xpath expr="//dt[text()='محدودیت']/following-sibling::dd[1]" position="replace">
                <t t-if="bat_info">
                    <dd t-if="attempt.ts_informal()">نتیجه توصیف پاسخ‌های تو در همین سنجه‌هاست، نه تشخیص. برای تصمیم‌های مهم با مشاورت گفت‌وگو کن.</dd>
                    <dd t-else="">نتیجه توصیف پاسخ‌های شما در همین سنجه‌هاست، نه تشخیص. برای تصمیم‌های مهم با مشاورتان گفت‌وگو کنید.</dd>
                </t>
                <dd t-else="" t-out="inst.limitations"/>
            </xpath>
        </field>
    </record>
    <record id="consent_battery_talent" model="ir.ui.view">
        <field name="name">ts_battery.consent.talent</field>
        <field name="inherit_id" ref="ts_talent.tpl_consent"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//dl[hasclass('tt-dl')]" position="before">
                <t t-set="bat_info" t-value="attempt.ts_battery_info()"/>
                <t t-call="ts_battery.consent_battery_block"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== player: «مجموعهٔ X، سنجهٔ ۲ از ۵» -->
    <record id="player_battery_label" model="ir.ui.view">
        <field name="name">ts_battery.player.label</field>
        <field name="inherit_id" ref="ts_assessment.tpl_player"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <!-- honest progress per battery and per instrument (B22-1): «مجموعهٔ X، سنجهٔ ۲ از ۴، حدود ۴ دقیقه تا پایان این سنجه» -->
            <xpath expr="//h1[hasclass('ts-player__title')]" position="before">
                <p t-if="attempt.ts_battery()" class="tsb-label"><t t-out="attempt.ts_battery_label()"/><t t-if="minutes_left">، حدود <t t-out="fa(minutes_left)"/> دقیقه تا پایان این سنجه</t></p>
            </xpath>
        </field>
    </record>
    <record id="review_battery_label" model="ir.ui.view">
        <field name="name">ts_battery.review.label</field>
        <field name="inherit_id" ref="ts_assessment.tpl_review"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//span[hasclass('ts-hero__kicker')]" position="before">
                <p t-if="attempt.ts_battery()" class="tsb-label" t-out="attempt.ts_battery_label()"/>
            </xpath>
            <xpath expr="//form[hasclass('ts-submit-form')]/button[@type='submit']" position="replace">
                <button t-if="attempt.ts_battery() and len(attempt.ts_battery_siblings().filtered(lambda t: t.state != 'done')) &gt; 1" type="submit" class="ts-btn ts-btn--primary ts-btn--lg">ارسال و رفتن به سنجهٔ بعدی</button>
                <button t-else="" type="submit" class="ts-btn ts-btn--primary ts-btn--lg">ارسال و دیدن نتیجه</button>
            </xpath>
        </field>
    </record>
    <record id="talent_shell_battery_label" model="ir.ui.view">
        <field name="name">ts_battery.talent.shell.label</field>
        <field name="inherit_id" ref="ts_talent.tpl_shell"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('tt-bar')]" position="inside">
                <span t-if="attempt and attempt.ts_battery()" class="tt-counter tsb-bar" t-out="attempt.ts_battery_label()"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== participant lists: a battery is one row -->
    <record id="my_list_battery" model="ir.ui.view">
        <field name="name">ts_battery.my_list</field>
        <field name="inherit_id" ref="ts_assessment.tpl_my_list"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//section[@id='ts-list-going']" position="attributes">
                <attribute name="t-if">going or batteries_going</attribute>
            </xpath>
            <xpath expr="//section[@id='ts-list-going']/ul" position="inside">
                <li t-foreach="batteries_going or []" t-as="br" class="tsb-row">
                    <div class="tsp-rows__text">
                        <strong>مجموعهٔ <t t-out="br['name']"/></strong>
                        <span class="ts-hint">به دعوت <t t-out="br['org']"/></span>
                        <span class="ts-hint tsb-progress"><t t-out="fa(br['done'])"/> از <t t-out="fa(br['total'])"/> سنجه انجام شده<t t-if="br.get('next_name')"><t t-call="ts_website.sep"/>بعدی: <t t-out="br['next_name']"/></t><t t-if="br.get('minutes_left')"><t t-call="ts_website.sep"/>حدود <t t-out="fa(br['minutes_left'])"/> دقیقه مانده</t></span>
                    </div>
                    <a t-att-href="br['url']" class="ts-btn ts-btn--primary ts-btn--sm"><t t-if="br['fresh'] and not br['done']">شروع</t><t t-else="">ادامه</t><span class="visually-hidden"> «مجموعهٔ <t t-out="br['name']"/>»</span></a>
                </li>
            </xpath>
            <xpath expr="//section[@id='ts-list-results']" position="attributes">
                <attribute name="t-if">groups or batteries_done</attribute>
            </xpath>
            <xpath expr="//section[@id='ts-list-results']/h2" position="after">
                <div t-if="batteries_done" class="ts-list-group" id="ts-list-batteries">
                    <h3>مجموعه‌ها</h3>
                    <ul class="tsp-list tsp-rows">
                        <li t-foreach="batteries_done" t-as="br" class="tsb-row">
                            <div class="tsp-rows__text">
                                <strong>مجموعهٔ <t t-out="br['name']"/></strong>
                                <span class="ts-hint"><t t-out="br['when']"/><t t-call="ts_website.sep"/>به دعوت <t t-out="br['org']"/><t t-call="ts_website.sep"/><t t-out="fa(br['total'])"/> سنجه<t t-call="ts_website.sep"/><t t-if="br['shared']">با پنل به اشتراک گذاشته شده</t><t t-elif="tu">فقط تو می‌بینی</t><t t-else="">فقط شما می‌بینید</t></span>
                            </div>
                            <a t-att-href="br['url']" class="ts-btn ts-btn--outline ts-btn--sm">گزارش مجموعه<span class="visually-hidden"> «<t t-out="br['name']"/>»</span></a>
                        </li>
                    </ul>
                </div>
            </xpath>
            <!-- an unfinished invited battery is the task: no catalog link pulling away from it (G6-P15-2) -->
            <xpath expr="//p[@id='ts-list-catalog']" position="attributes">
                <attribute name="t-if">attempts and not batteries_going</attribute>
            </xpath>
        </field>
    </record>

    <record id="my_home_battery" model="ir.ui.view">
        <field name="name">ts_battery.my_home</field>
        <field name="inherit_id" ref="ts_panel.tpl_my_home"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='ts-home-invites']//strong[@t-out='inv.instrument_id.title']" position="replace">
                <strong t-out="('مجموعهٔ ' + inv.battery_id.ts_title()) if inv.battery_id else inv.instrument_id.title"/>
            </xpath>
            <xpath expr="//div[@id='ts-home-going']//strong[@t-out='a.instrument_id.title']" position="replace">
                <strong t-out="a.ts_battery_label() or a.instrument_id.title"/>
            </xpath>
            <xpath expr="//p[@id='ts-next-h']/t[@t-elif=&quot;next_action['kind'] == 'resume' and next_action['progress']&quot;]" position="before">
                <t t-elif="next_action['kind'] == 'resume' and next_action.get('battery')"><t t-if="next_action['progress']">یک مجموعهٔ نیمه‌تمام</t><t t-else="">یک مجموعه منتظر</t> <t t-if="tu and next_action['progress']">داری</t><t t-elif="next_action['progress']">دارید</t><t t-elif="tu">توست</t><t t-else="">شماست</t></t>
            </xpath>
            <xpath expr="//p[hasclass('tsp-next__meta')]/t[@t-elif=&quot;next_action['kind'] == 'resume' and next_action['progress']&quot;]" position="before">
                <!-- T7 (B25-2): two short lines, the next instrument with its place, then time left and the last save -->
                <t t-elif="next_action['kind'] == 'resume' and next_action.get('battery') and next_action['progress']">سنجهٔ بعدی: <t t-out="next_action['battery_next']"/> (<t t-out="next_action.get('battery_place')"/>)<br/><t t-out="next_action['battery_progress']"/><t t-if="next_action.get('battery_minutes_left')"><t t-call="ts_website.sep"/>حدود <t t-out="fa(next_action['battery_minutes_left'])"/> دقیقه تا پایان</t><t t-call="ts_website.sep"/>آخرین ذخیره <t t-out="next_action['when']"/></t>
            </xpath>
            <xpath expr="//div[@id='ts-home-results']" position="attributes">
                <attribute name="t-if">done or done_batteries</attribute>
            </xpath>
            <xpath expr="//div[@id='ts-home-results']/ul" position="inside">
                <li t-foreach="done_batteries or []" t-as="br" class="tsb-row">
                    <div class="tsp-rows__text">
                        <strong>مجموعهٔ <t t-out="br['name']"/></strong>
                        <span class="ts-hint"><t t-out="br['when']"/><t t-call="ts_website.sep"/><t t-if="br['shared']">با پنل به اشتراک گذاشته شده</t><t t-elif="tu">فقط تو می‌بینی</t><t t-else="">فقط شما می‌بینید</t></span>
                    </div>
                    <a t-att-href="br['url']" class="ts-btn ts-btn--outline ts-btn--sm">دیدن نتیجه<span class="visually-hidden"> «مجموعهٔ <t t-out="br['name']"/>»</span></a>
                </li>
            </xpath>
            <xpath expr="//t[@t-if='not next_action and not invites and not going and not done']" position="attributes">
                <attribute name="t-if">not next_action and not invites and not going and not done and not done_batteries</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== the invitation link names the battery -->
    <record id="invite_battery" model="ir.ui.view">
        <field name="name">ts_battery.invite</field>
        <field name="inherit_id" ref="ts_org.tpl_invite"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <!-- the tab title names the battery (G6-P11-5) -->
            <xpath expr="//t[@t-call='website.layout']" position="attributes">
                <attribute name="additional_title.f"/>
                <attribute name="additional_title">('دعوت به مجموعهٔ ' + a.battery_id.name) if a.battery_id else 'دعوت به سنجه'</attribute>
            </xpath>
            <xpath expr="//div[hasclass('ts-section__head')]/p[hasclass('ts-tag')]" position="replace">
                <p class="ts-tag"><t t-if="a.battery_id">دعوت به مجموعهٔ سنجه‌ها</t><t t-else="">دعوت به سنجه</t></p>
            </xpath>
            <xpath expr="//div[hasclass('ts-section__head')]/h1" position="replace">
                <h1 t-if="a.battery_id">مجموعهٔ <t t-out="a.battery_id.ts_title()"/></h1>
                <h1 t-else="" t-out="inst.title"/>
            </xpath>
            <xpath expr="//div[hasclass('ts-section__head')]/p[@t-if='student']" position="replace">
                <p t-if="a.battery_id and student"><strong t-out="ws.ts_public_name()"/> تو را به پاسخ‌دادن به سنجه‌های این مجموعه <t t-out="inv_verb"/>.</p>
                <p t-elif="a.battery_id"><strong t-out="ws.ts_public_name()"/> شما را به پاسخ‌دادن به سنجه‌های این مجموعه <t t-out="inv_verb"/>.</p>
                <p t-elif="student"><strong t-out="ws.ts_public_name()"/> تو را به پاسخ‌دادن به این سنجه <t t-out="inv_verb"/>.</p>
            </xpath>
            <!-- the sharing tick stays ticked (owner decision 2026-10-12); for a battery it says that one tick covers every
                 instrument's report (G6-P11-1) -->
            <xpath expr="//p[@id='ts_share_note']" position="replace">
                <p id="ts_share_note" class="ts-hint"><t t-if="a.battery_id"><t t-if="student">این تیک برای گزارش همهٔ سنجه‌های این مجموعه است. </t><t t-else="">این تیک برای گزارش همهٔ سنجه‌های این مجموعه است<t t-if="ws.purpose == 'clinical'">، همراه با راهنمای مشاور</t>. </t></t><t t-if="student">اگر تیک را برداری هم می‌توانی <t t-if="a.battery_id">به سنجه‌های مجموعه پاسخ بدهی</t><t t-else="">سنجه را انجام بدهی</t>؛ آن وقت نتیجه فقط برای خودت می‌ماند.</t><t t-else="">اگر تیک را بردارید هم می‌توانید <t t-if="a.battery_id">به سنجه‌های مجموعه پاسخ دهید</t><t t-else="">سنجه را انجام دهید</t>؛ آن وقت نتیجه فقط برای خودتان می‌ماند.</t></p>
            </xpath>
            <!-- UX T7: the instruments come after the action (the first phone screen keeps the button); size and time per
                 instrument from its own labels (a timed task says «۳ بخش زمان‌دار», never «۰ پرسش»; P26-2, W20). The
                 description never repeats minutes (effort_facts strips them) and a job application already has its own card. -->
            <xpath expr="//t[@t-call='ts_org.share_box']" position="after">
                <div t-if="a.battery_id" class="ts-card tsb-invite" id="tsb-invite">
                    <p t-if="facts['description'] and not ('position_id' in a._fields and a.position_id)" t-out="facts['description']"/>
                    <p><strong>سنجه‌های این مجموعه</strong> (یکی پس از دیگری، با یک بار موافقت برای همه):</p>
                    <ol class="tsb-list">
                        <li t-foreach="facts['lines']" t-as="ln"><span t-out="ln['name']"/><t t-call="ts_website.sep"/><span class="ts-hint"><t t-out="ln['size']"/><t t-call="ts_website.sep"/><t t-out="ln['time']"/></span></li>
                    </ol>
                    <p t-if="ws.purpose != 'employment'" class="ts-hint">این مجموعه برای کمک به گفت‌وگوی مشاوره است، نه تشخیص.</p>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== panel: member page (catalog:assign) -->
    <record id="member_catalog_section" model="ir.ui.view">
        <field name="name">ts_battery.member.catalog</field>
        <field name="inherit_id" ref="ts_panel.tpl_member"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//section[@id='tsp-role']" position="after">
                <t t-call="ts_battery.member_catalog"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== panel: participant page and invitation lists -->
    <record id="client_battery_rows" model="ir.ui.view">
        <field name="name">ts_battery.client.rows</field>
        <field name="inherit_id" ref="ts_panel.tpl_client"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//tr[@t-foreach='assignments']/th" position="replace">
                <th scope="row" data-label="سنجه">
                    <t t-if="a.battery_id">مجموعهٔ <t t-out="a.battery_id.ts_title()"/> <span class="ts-hint">(<t t-out="fa(a.ts_battery_progress()[0])"/> از <t t-out="fa(a.ts_battery_progress()[1])"/> سنجه)</span></t>
                    <t t-else="" t-out="a.instrument_id.ts_title()"/>
                </th>
            </xpath>
            <xpath expr="//tr[@t-foreach='assignments']/td[last()]" position="replace">
                <td>
                    <!-- 44 px buttons, not one-line text links (G6-P6-4) -->
                    <t t-if="a.battery_id"><a t-if="a.attempt_ids.filtered(lambda t: t.state == 'done') and level(a) != 'none'" t-attf-href="/my/workspaces/#{ws.id}/clients/#{c.id}/b/#{a.id}" class="ts-btn ts-btn--outline ts-btn--sm tsb-rowbtn">نتیجهٔ مجموعه</a></t>
                    <a t-elif="a.state == 'done' and level(a) != 'none'" t-attf-href="/my/workspaces/#{ws.id}/clients/#{c.id}/r/#{a.attempt_id.id}" class="ts-btn ts-btn--outline ts-btn--sm tsb-rowbtn">نتیجه</a>
                </td>
            </xpath>
        </field>
    </record>
    <record id="invites_battery_name" model="ir.ui.view">
        <field name="name">ts_battery.invites.name</field>
        <field name="inherit_id" ref="ts_panel.tpl_invites"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//td[@data-label='سنجه']" position="replace">
                <td data-label="سنجه" t-out="a.ts_item_name()"/>
            </xpath>
        </field>
    </record>
    <record id="invite_page_battery_name" model="ir.ui.view">
        <field name="name">ts_battery.invite_page.name</field>
        <field name="inherit_id" ref="ts_panel.tpl_invite"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//p[hasclass('tsp-head__help')]/t[@t-out='a.instrument_id.name']" position="attributes">
                <attribute name="t-out">a.ts_item_name()</attribute>
            </xpath>
            <!-- how far the battery is (G6-P8-2) -->
            <xpath expr="//p[hasclass('tsp-head__help')]/t[@t-out='a.ts_item_name()']" position="after">
                <t t-if="a.battery_id"><t t-call="ts_website.sep"/><t t-out="a.ts_battery_progress_text()"/></t>
            </xpath>
            <!-- a partly done battery: an outline button that says which part (G6-P8-1; the controller sets result only
                 when at least one instrument is done) -->
            <xpath expr="//a[@t-att-href='result']" position="attributes">
                <attribute name="class"/>
                <attribute name="t-attf-class">ts-btn #{'ts-btn--outline' if result_partial else 'ts-btn--primary'}</attribute>
                <attribute name="t-out">result_label or 'دیدن نتیجه'</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== panel: invitation wizard, step 2 -->
    <record id="invite_wizard_battery" model="ir.ui.view">
        <field name="name">ts_battery.invite_wizard</field>
        <field name="inherit_id" ref="ts_panel.tpl_invite_wizard"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//p[hasclass('tsp-head__help')][contains(text(), 'در چهار گام')]" position="replace">
                <!-- the step list below already names the steps (G6-P4-2) -->
                <p class="tsp-head__help">چیزی پیش از گام آخر ارسال نمی‌شود.</p>
            </xpath>
            <xpath expr="//form[@t-if=&quot;step == '2'&quot;]/fieldset" position="attributes">
                <attribute name="t-if">not batteries</attribute>
            </xpath>
            <xpath expr="//form[@t-if=&quot;step == '2'&quot;]/fieldset" position="before">
                <p t-if="cat_note and not batteries" class="ts-hint tsb-catnote" t-out="cat_note"/>
            </xpath>
            <xpath expr="//form[@t-if=&quot;step == '2'&quot;]/fieldset" position="after">
                <t t-if="batteries" t-call="ts_battery.item_picker" pick_inst_id="inst.id if (inst and not bat) else 0"/>
            </xpath>
            <xpath expr="//dt[text()='سنجه']" position="replace">
                <dt t-if="bat">مجموعه</dt>
                <dt t-else="">سنجه</dt>
            </xpath>
            <xpath expr="//dd[@t-out='inst.name']" position="replace">
                <dd t-if="bat"><t t-out="bat.ts_title()"/> (<t t-out="fa(len(bat.line_ids))"/> سنجه، حدود <t t-out="bat.ts_minutes_text()"/> دقیقه)</dd>
                <dd t-else="" t-out="inst.ts_title()"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== panel: group invitations -->
    <record id="campaign_form_battery" model="ir.ui.view">
        <field name="name">ts_battery.campaign_form</field>
        <field name="inherit_id" ref="ts_panel.tpl_campaign_form"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//fieldset[legend[text()='سنجه']]" position="attributes">
                <attribute name="t-if">not batteries</attribute>
            </xpath>
            <xpath expr="//fieldset[legend[text()='سنجه']]" position="before">
                <p t-if="cat_note and not batteries" class="ts-hint tsb-catnote" t-out="cat_note"/>
            </xpath>
            <xpath expr="//fieldset[legend[text()='سنجه']]" position="after">
                <t t-if="batteries" t-call="ts_battery.item_picker" pick_inst_id="draft.get('instrument_id') if not draft.get('battery_id') else 0"/>
            </xpath>
        </field>
    </record>
    <record id="campaign_review_battery" model="ir.ui.view">
        <field name="name">ts_battery.campaign_review</field>
        <field name="inherit_id" ref="ts_panel.tpl_campaign_review"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//dt[text()='سنجه']" position="replace">
                <dt t-if="bat">مجموعه</dt>
                <dt t-else="">سنجه</dt>
            </xpath>
            <xpath expr="//dd[@t-out='inst.name']" position="replace">
                <dd t-if="bat"><t t-out="bat.ts_title()"/> (<t t-out="fa(len(bat.line_ids))"/> سنجه)</dd>
                <dd t-else="" t-out="inst.ts_title()"/>
            </xpath>
        </field>
    </record>
    <record id="campaigns_battery_name" model="ir.ui.view">
        <field name="name">ts_battery.campaigns.name</field>
        <field name="inherit_id" ref="ts_panel.tpl_campaigns"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//td[@data-label='سنجه']" position="replace">
                <td data-label="سنجه" t-out="c.ts_item_name()"/>
            </xpath>
        </field>
    </record>
    <record id="campaign_battery_name" model="ir.ui.view">
        <field name="name">ts_battery.campaign.name</field>
        <field name="inherit_id" ref="ts_panel.tpl_campaign"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//p[hasclass('tsp-head__help')]/t[@t-out='c.instrument_id.name']" position="attributes">
                <attribute name="t-out">c.ts_item_name()</attribute>
            </xpath>
            <!-- what the client is asked for (G6-P3-2) -->
            <xpath expr="//p[hasclass('tsp-head__help')]" position="after">
                <p t-if="c.battery_id" class="tsp-head__help tsb-facts" t-out="c.battery_id.ts_facts()"/>
            </xpath>
        </field>
    </record>
    <record id="campaign_join_battery" model="ir.ui.view">
        <field name="name">ts_battery.campaign_join</field>
        <field name="inherit_id" ref="ts_panel.tpl_campaign_join"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='website.layout']" position="attributes">
                <attribute name="additional_title.f"/>
                <attribute name="additional_title">('دعوت به مجموعهٔ ' + c.battery_id.ts_title()) if c.battery_id else 'دعوت به سنجه'</attribute>
            </xpath>
            <xpath expr="//h1[@t-out='inst.title']" position="replace">
                <h1 t-if="c.battery_id">مجموعهٔ <t t-out="c.battery_id.ts_title()"/></h1>
                <h1 t-else="" t-out="inst.title"/>
            </xpath>
            <xpath expr="//div[hasclass('ts-section__head')]/p[hasclass('ts-tag')]" position="replace">
                <p class="ts-tag"><t t-if="c.battery_id">دعوت به مجموعهٔ سنجه‌ها</t><t t-else="">دعوت به سنجه</t></p>
            </xpath>
            <xpath expr="//div[hasclass('ts-section__head')]/p[@t-if='student']" position="replace">
                <p t-if="c.battery_id and student"><strong t-out="ws.ts_public_name()"/> تو را به پاسخ‌دادن به سنجه‌های این مجموعه <t t-out="inv_verb"/>.</p>
                <p t-elif="c.battery_id"><strong t-out="ws.ts_public_name()"/> شما را به پاسخ‌دادن به سنجه‌های این مجموعه <t t-out="inv_verb"/>.</p>
                <p t-elif="student"><strong t-out="ws.ts_public_name()"/> تو را به پاسخ‌دادن به این سنجه <t t-out="inv_verb"/>.</p>
            </xpath>
            <!-- size and time of a battery come from ts_org effort_facts (the facts line of the base page; UX T7 X5) -->
        </field>
    </record>
</odoo>
