<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clinic phase 3: battery run pages (website 2 only). Copy: counseling words, «شما» for adults, «تو» only where the
         participant is a student (tu); voice.md section 6 checks. -->

    <!-- /take/<token>/next: one instrument of the battery is done; the next one, continue now or later -->
    <record id="tpl_transition" model="ir.ui.view">
        <field name="name">TS battery: next instrument</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.transition</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.transition">
                <t t-call="website.layout" additional_title.f="سنجهٔ بعدی">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section tsb-page">
                            <div class="ts-container ts-narrow">
                                <p class="ts-hero__kicker">مجموعهٔ <t t-out="battery.ts_title()"/></p>
                                <ol class="tsb-dots" aria-hidden="true">
                                    <li t-foreach="range(1, total + 1)" t-as="k" t-attf-class="tsb-dots__i #{'is-done' if k &lt;= done_count else ''}"/>
                                </ol>
                                <h1 class="tsb-title">سنجهٔ <t t-out="fa(n_done)"/> از <t t-out="fa(total)"/> تمام شد</h1>
                                <p t-if="tu" class="ts-lead">پاسخ‌هایت ذخیره و قفل شد.</p>
                                <p t-else="" class="ts-lead">پاسخ‌های شما ذخیره و قفل شد.</p>
                                <!-- T7 (B23-1, R10): the result is the motivator at the riskiest moment -->
                                <p t-if="attempt.released" class="tsb-ready" id="tsb-ready">نتیجهٔ این سنجه آماده است و در گزارش مجموعه می‌ماند؛ گزارش با هر سنجه کامل‌تر می‌شود. <a t-attf-href="/my/assessments/battery/#{attempt.sudo().assignment_id.id}">دیدن گزارش تا اینجا</a></p>
                                <section class="ts-card tsb-next" aria-labelledby="tsb-next-h">
                                    <h2 id="tsb-next-h" class="tsb-next__k">سنجهٔ بعدی (<t t-out="fa(nxt.ts_battery_index())"/> از <t t-out="fa(total)"/>)</h2>
                                    <p class="tsb-next__name" t-out="inst.ts_title()"/>
                                    <p class="ts-hint">
                                        <!-- the instrument's own labels: a timed task says «۳ بخش زمان‌دار», never «۰ پرسش» (T7) -->
                                        <t t-out="inst.ts_effort_label()"/>، <t t-out="inst.ts_duration_label()"/>
                                    </p>
                                    <!-- the whole remaining battery, only when it is more than the next instrument (G6-P14-2) -->
                                    <p t-if="rest_count &gt; 1" class="ts-hint tsb-rest">تا پایان مجموعه: <t t-out="fa(rest_count)"/> سنجه<t t-if="rest_items">، <t t-out="fa(rest_items)"/> پرسش، حدود <t t-out="fa(rest_minutes)"/> دقیقه</t></p>
                                </section>
                                <div class="tsb-actions">
                                    <a t-attf-href="/take/#{nxt.access_token}" class="ts-btn ts-btn--primary ts-btn--lg">شروع سنجهٔ بعدی</a>
                                    <a href="/my" class="ts-btn ts-btn--quiet">بعداً ادامه می‌دهم</a>
                                </div>
                                <p t-if="tu" class="ts-hint">هر وقت برگردی، از همین سنجه ادامه می‌دهی؛ پاسخ‌ها خودکار ذخیره می‌شوند.</p>
                                <p t-else="" class="ts-hint">هر وقت برگردید، از همین سنجه ادامه می‌دهید؛ پاسخ‌ها خودکار ذخیره می‌شوند.</p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Consent page of the first attempt of a battery: names the battery, lists its instruments, total size and time.
         Sentence added with CONSENT_VERSION v3; v4 (G6-P12-2): «نه تشخیص» only once, in «محدودیت»; what the invitation's
         sharing covers. v5 (owner 2026-10-13, plain language; copy W23): one subject per verb, «موافقت» for the person's
         own click (glossary), «تو» where the page speaks «تو»; same facts. The card now opens the folded full text; the
         summary above names the battery (web_battery_inherit). -->
    <record id="consent_battery_block" model="ir.ui.view">
        <field name="name">TS battery: block on the consent page</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.consent_battery_block</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.consent_battery_block">
            <section t-if="bat_info" class="ts-card tsb-consent" aria-labelledby="tsb-consent-h">
                <h2 id="tsb-consent-h" class="h5">این دعوت یک مجموعه است</h2>
                <p t-if="tu">با یک بار موافقت در همین صفحه، به همهٔ سنجه‌های این مجموعه پاسخ می‌دهی. موافقتت برای هر سنجه جدا ثبت می‌شود و پاسخ هر سنجه هم جدا ذخیره می‌شود. هر جا خواستی دست نگه دار؛ بعداً از همان‌جا ادامه می‌دهی.</p>
                <p t-else="">با یک بار موافقت در همین صفحه، به همهٔ سنجه‌های این مجموعه پاسخ می‌دهید. موافقت شما برای هر سنجه جدا ثبت می‌شود و پاسخ هر سنجه هم جدا ذخیره می‌شود. هر جا خواستید دست نگه دارید؛ بعداً از همان‌جا ادامه می‌دهید.</p>
                <ol class="tsb-list">
                    <li t-foreach="bat_info['lines']" t-as="ln"><span t-out="ln['name']"/><t t-call="ts_website.sep"/><span class="ts-hint"><t t-if="ln.get('effort')"><t t-out="ln['effort']"/>، <t t-out="ln['duration']"/></t><t t-else=""><t t-out="fa(ln['items'])"/> پرسش، حدود <t t-out="fa(ln['minutes'])"/> دقیقه</t></span></li>
                </ol>
                <p class="tsb-total">روی هم <t t-out="bat_info['size']"/>، <t t-out="bat_info['time']"/>.</p>
                <t t-if="bat_info.get('shared')">
                    <p t-if="tu" class="ts-hint">اشتراک‌گذاری‌ای که در صفحهٔ دعوت پذیرفتی، برای گزارش همهٔ سنجه‌های این مجموعه است و از صفحهٔ گزارش مجموعه قطع می‌شود.</p>
                    <p t-else="" class="ts-hint">اشتراک‌گذاری‌ای که در صفحهٔ دعوت پذیرفتید، برای گزارش همهٔ سنجه‌های این مجموعه است و از صفحهٔ گزارش مجموعه قطع می‌شود.</p>
                </t>
            </section>
            </t>
        </field>
    </record>

    <!-- Step «what is invited» of the invitation wizard and of group invitations, when the member has batteries.
         Params: instruments, batteries, bat_cards, item_kind, pick_inst_id, cat_note (the member's catalog is restricted:
         who chose it, G6-P5-1). No `required` on the radios: the hidden group would block the form; the server checks
         the choice. The «نه تشخیص» limit is said once, under the legend «مجموعه» (G6-PT9). -->
    <record id="item_picker" model="ir.ui.view">
        <field name="name">TS battery: instrument or battery picker</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.item_picker</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.item_picker">
            <p t-if="cat_note" class="ts-hint tsb-catnote" id="tsb-catnote" t-out="cat_note"/>
            <t t-if="instruments">
                <fieldset class="tsp-field">
                    <legend class="tsp-field__label">چه چیزی بفرستید؟</legend>
                    <label class="tsp-radio"><input type="radio" name="item_kind" value="single" t-att-checked="'checked' if item_kind != 'battery' else None"/><span><strong>یک سنجه</strong><span class="tsp-field__hint tsp-radio__blurb">یک دعوت به یک سنجه، با یک گزارش</span></span></label>
                    <label class="tsp-radio"><input type="radio" name="item_kind" value="battery" t-att-checked="'checked' if item_kind == 'battery' else None"/><span><strong>یک مجموعه</strong><span class="tsp-field__hint tsp-radio__blurb">چند سنجه با یک دعوت، یک بار رضایت و یک گزارش یکجا</span></span></label>
                </fieldset>
                <fieldset class="tsp-field" data-ts-show="item_kind=single">
                    <legend class="tsp-field__label">سنجه</legend>
                    <label t-foreach="instruments" t-as="i" class="tsp-radio"><input type="radio" name="instrument_id" t-att-value="i.id" t-att-checked="'checked' if (i.id == pick_inst_id or (len(instruments) == 1 and item_kind != 'battery')) else None"/><span t-out="i.ts_title()"/></label>
                </fieldset>
            </t>
            <input t-else="" type="hidden" name="item_kind" value="battery"/>
            <fieldset class="tsp-field tsb-cards" t-att-data-ts-show="'item_kind=battery' if instruments else None">
                <legend class="tsp-field__label">مجموعه</legend>
                <p class="tsp-field__hint tsb-limit">هر مجموعه برای کمک به گفت‌وگوی مشاوره است، نه تشخیص.</p>
                <label t-foreach="batteries" t-as="b" class="tsb-card">
                    <t t-set="card" t-value="bat_cards[b.id]"/>
                    <input type="radio" name="battery_id" t-att-value="b.id" t-att-checked="'checked' if (bat == b or (len(batteries) == 1 and item_kind == 'battery')) else None"/>
                    <span class="tsb-card__body">
                        <strong class="tsb-card__name" t-out="card['name']"/>
                        <span class="tsb-card__facts"><t t-out="fa(card['count'])"/> سنجه، <t t-out="fa(card['items'])"/> پرسش، حدود <t t-out="fa(card['minutes'])"/> دقیقه</span>
                        <span t-if="card['description']" class="tsb-card__desc" t-out="card['description']"/>
                        <span class="tsb-card__list"><t t-out="'، '.join(ln['name'] for ln in card['lines'])"/></span>
                    </span>
                </label>
            </fieldset>
            </t>
        </field>
    </record>

    <!-- Panel member page: which of the panel's instruments and batteries this member may use (catalog:assign) -->
    <record id="member_catalog" model="ir.ui.view">
        <field name="name">TS battery: member catalog section</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.member_catalog</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.member_catalog">
            <section t-if="can_catalog" class="ts-card" id="tsp-catalog" aria-labelledby="tsp-catalog-h">
                <h2 id="tsp-catalog-h" class="h5">سنجه‌ها و مجموعه‌های مجاز برای این عضو</h2>
                <p class="ts-hint">از میان سنجه‌ها و مجموعه‌هایی که برای این پنل فعال است، انتخاب کنید این عضو به کدام‌ها دعوت بفرستد. دعوت‌ها و نتیجه‌های قبلی دست نمی‌خورد.</p>
                <!-- what is allowed now, by name (G6-P1-3); static text, not a live region -->
                <p class="tsb-now"><strong>اکنون:</strong>
                    <t t-if="not cat_restricted">همهٔ موارد پنل</t>
                    <t t-elif="cat_now" t-out="cat_now"/>
                    <t t-else="">هیچ موردی انتخاب نشده؛ این عضو فعلاً نمی‌تواند دعوت بفرستد</t>
                </p>
                <form t-attf-action="/my/workspaces/#{ws.id}/members/#{m.id}/catalog" method="post" class="tsp-form" data-tsp-once="1" data-ts-dirty="سنجه‌ها و مجموعه‌های مجاز">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <fieldset class="tsp-field">
                        <legend class="tsp-field__label">دسترسی این عضو</legend>
                        <label class="tsp-radio"><input type="radio" name="catalog_mode" value="all" t-att-checked="'checked' if not cat_restricted else None"/><span><strong>همهٔ موارد پنل</strong><span class="tsp-field__hint tsp-radio__blurb">هر سنجه یا مجموعه‌ای که برای پنل فعال است یا بعداً فعال می‌شود</span></span></label>
                        <label class="tsp-radio"><input type="radio" name="catalog_mode" value="list" t-att-checked="'checked' if cat_restricted else None"/><span><strong>فقط موارد انتخاب‌شده</strong><span class="tsp-field__hint tsp-radio__blurb">این عضو فقط به مواردی که تیک می‌زنید دعوت می‌فرستد</span></span></label>
                    </fieldset>
                    <fieldset t-if="panel_bats" class="tsp-field" data-ts-show="catalog_mode=list">
                        <legend class="tsp-field__label">مجموعه‌ها</legend>
                        <label t-foreach="panel_bats" t-as="b" class="tsp-check"><input type="checkbox" name="battery_ids" t-att-value="b.id" t-att-checked="'checked' if b.id in cat_bats else None"/><span><t t-out="b.ts_title()"/> <span class="ts-hint">(<t t-out="fa(len(b.line_ids))"/> سنجه)</span></span></label>
                    </fieldset>
                    <fieldset t-if="panel_insts" class="tsp-field" data-ts-show="catalog_mode=list">
                        <legend class="tsp-field__label">سنجه‌های تکی</legend>
                        <label t-foreach="panel_insts" t-as="i" class="tsp-check"><input type="checkbox" name="instrument_ids" t-att-value="i.id" t-att-checked="'checked' if i.id in cat_insts else None"/><span t-out="i.ts_title()"/></label>
                    </fieldset>
                    <p t-if="not panel_insts and not panel_bats" class="ts-hint">هنوز سنجه‌ای برای این پنل فعال نیست.</p>
                    <p><button type="submit" class="ts-btn ts-btn--primary">ذخیرهٔ سنجه‌ها و مجموعه‌های مجاز</button></p>
                </form>
                <t t-call="ts_org.reveal_js"/>
            </section>
            </t>
        </field>
    </record>

    <!-- Overview of a battery result (UX audit 2026-10-12, G6-PT2): one table «سنجه / عامل / سطح» (+ «نمره» when show_score)
         for every instrument, right after the meta; each instrument links to its section below. Params: sections (from the
         controller's _sections), show_score (bool), ov_id (heading id). -->
    <record id="tpl_overview" model="ir.ui.view">
        <field name="name">TS battery: overview</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.overview</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.overview">
                <div class="tsb-ov" t-att-id="ov_id">
                    <h2 class="h5" t-att-id="ov_id + '-h'">نمای کلی مجموعه</h2>
                    <div class="ts-table-wrap">
                        <table class="ts-table tsb-ov__table">
                            <caption class="ts-sr">سطح هر عامل در همهٔ سنجه‌های این مجموعه</caption>
                            <thead><tr><th scope="col">سنجه</th><th scope="col">عامل</th><th scope="col">سطح</th><th t-if="show_score" scope="col">نمره (۱ تا ۵)</th></tr></thead>
                            <t t-foreach="sections" t-as="bs">
                                <tbody>
                                    <t t-if="bs['results']">
                                        <tr t-foreach="bs['results']" t-as="r">
                                            <th t-if="r_first" scope="rowgroup" t-att-rowspan="len(bs['results'])"><a t-att-href="'#' + bs['sec_id']" t-out="bs['inst'].ts_title()"/></th>
                                            <td t-out="r.factor_id.name"/>
                                            <td><span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></td>
                                            <td t-if="show_score" class="ts-num" t-out="r.score_fa()"/>
                                        </tr>
                                    </t>
                                    <tr t-else="">
                                        <th scope="row"><a t-att-href="'#' + bs['sec_id']" t-out="bs['inst'].ts_title()"/></th>
                                        <td t-att-colspan="3 if show_score else 2" class="ts-hint">
                                            <t t-if="bs['at'].state != 'done'">هنوز پاسخ داده نشده</t>
                                            <t t-elif="bs['matrix']">گزارش جداگانه دارد</t>
                                            <t t-else="">نتیجه در این گزارش نمایش داده نمی‌شود</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </t>
                        </table>
                    </div>
                </div>
            </t>
        </field>
    </record>

    <!-- /my/assessments/battery/<assignment>: the participant's battery result, one section per instrument -->
    <record id="tpl_my_battery" model="ir.ui.view">
        <field name="name">TS battery: participant battery report</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.my_battery</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.my_battery">
                <t t-call="website.layout" additional_title="'گزارش ' + battery.name">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section ts-report-page tsb-page">
                            <div class="ts-container ts-report-wrap">
                                <div class="ts-report-actions ts-noprint">
                                    <a href="/my/assessments" class="ts-back">سنجه‌ها و نتیجه‌ها</a>
                                    <!-- the PDF file is the one button (ts_brand adds it); browser printing is a quiet action (G6-PT5) -->
                                    <button type="button" class="ts-btn ts-btn--quiet ts-js-print">چاپ همین صفحه</button>
                                </div>
                                <section t-if="submitted" class="ts-received ts-noprint" role="status" aria-labelledby="tsb-received-h">
                                    <h2 id="tsb-received-h" t-if="tu">پاسخ‌هایت ثبت شد</h2>
                                    <h2 id="tsb-received-h" t-else="">پاسخ‌های شما ثبت شد</h2>
                                    <p t-if="tu">همهٔ سنجه‌های این مجموعه انجام شد و نتیجه همین‌جا می‌ماند. پاسخ‌ها پس از ارسال قفل شده‌اند.</p>
                                    <p t-else="">همهٔ سنجه‌های این مجموعه انجام شد و نتیجه همین‌جا می‌ماند. پاسخ‌ها پس از ارسال قفل شده‌اند.</p>
                                    <p t-if="sections"><strong>چه کسی این نتیجه را می‌بیند:</strong> <t t-call="ts_panel.who_sees_line" attempt="sections[0]['at']"/></p>
                                    <p class="ts-received__actions"><a href="#tsb-ov" class="ts-btn ts-btn--primary">خواندن نتیجه</a> <a href="/my" class="ts-btn ts-btn--quiet">بازگشت به کارهای من</a></p>
                                </section>
                                <!-- T7 (B24-1): an unfinished battery opens with the way to go on, not with metadata -->
                                <section t-if="nxt" class="ts-card tsb-continue ts-noprint" id="tsb-continue" aria-labelledby="tsb-continue-h">
                                    <h2 id="tsb-continue-h" class="h5"><t t-out="fa(done)"/> از <t t-out="fa(total)"/> سنجه انجام شده</h2>
                                    <p>بعدی: <strong t-out="nxt.instrument_id.ts_title()"/><t t-call="ts_website.sep"/><t t-out="nxt.instrument_id.ts_effort_label()"/>، <t t-out="nxt.instrument_id.ts_duration_label()"/></p>
                                    <p><a t-attf-href="/take/#{nxt.access_token}" class="ts-btn ts-btn--primary ts-btn--lg">ادامهٔ مجموعه</a></p>
                                </section>
                                <article class="ts-doc tsb-doc">
                                    <header class="ts-doc__head">
                                        <div class="ts-doc__brand">
                                            <img src="/ts_website/static/img/talentsearch-logo.webp" width="40" height="40" alt=""/>
                                            <div><strong>استعدادیاب</strong><small>از خانوادهٔ هیجان اندیشه (<bdi dir="ltr">EOT</bdi>)</small></div>
                                        </div>
                                        <div class="ts-doc__kind">گزارش مجموعهٔ سنجه‌ها</div>
                                    </header>
                                    <h1 class="ts-doc__title" t-out="battery.ts_title()"/>
                                    <p class="ts-doc__lead">نتیجهٔ <t t-out="a.user_id.partner_id.ts_known_name() or 'شما'"/><t t-call="ts_website.sep"/><t t-out="when"/></p>
                                    <dl class="ts-meta ts-doc__meta tsb-meta">
                                        <dt>به دعوت</dt><dd t-out="org"/>
                                        <t t-if="counselor"><dt>مشاور</dt><dd><bdi t-out="counselor"/></dd></t>
                                        <dt>سنجه‌های انجام‌شده</dt><dd><t t-out="fa(done)"/> از <t t-out="fa(total)"/></dd>
                                        <dt>شناسهٔ دعوت</dt><dd><bdi dir="ltr" class="ts-bdi" t-out="a.name"/></dd>
                                    </dl>
                                    <p class="tsb-note" role="note" t-out="limit_note"/>
                                    <t t-call="ts_battery.overview" sections="sections" show_score="False" ov_id="'tsb-ov'"/>
                                    <nav class="tsb-jump tt-jump ts-noprint" id="tsb-jump" aria-label="سنجه‌های این مجموعه">
                                        <ol>
                                            <li t-foreach="sections" t-as="bs"><a t-att-href="'#' + bs['sec_id']" t-out="bs['inst'].ts_title()"/>
                                                <span t-if="bs['at'].state != 'done'" class="ts-hint"><t t-call="ts_website.sep"/>هنوز پاسخ داده نشده</span></li>
                                        </ol>
                                    </nav>
                                    <!-- the first instrument stays open on the phone; the others start closed (G6-P9-1) -->
                                    <t t-foreach="sections" t-as="bs">
                                        <t t-call="ts_talent.sec" sec_id="bs['sec_id']" title="bs['inst'].ts_title()" collapse="None if bs_first else 'phone'" cls="'tsb-sec'">
                                            <t t-if="bs['results']">
                                                <t t-call="ts_assessment.report_blocks" results="bs['results']" blk_sum_id="bs['sec_id'] + '-sum'" blk_sub="True"/>
                                            </t>
                                            <p t-elif="bs['matrix'] and bs['at'].state == 'done'"><a t-attf-href="/my/assessments/#{bs['at'].id}" class="ts-btn ts-btn--outline ts-btn--sm">دیدن گزارش این سنجه</a></p>
                                            <p t-elif="bs['at'].state == 'done'" class="ts-hint">نتیجهٔ این سنجه در دسترس نیست.</p>
                                            <p t-else="" class="ts-hint">هنوز به این سنجه پاسخ داده نشده است. <a t-attf-href="/take/#{bs['at'].access_token}">شروع این سنجه</a></p>
                                        </t>
                                    </t>
                                    <section class="ts-doc__sec ts-noprint" id="tsb-who-sees">
                                        <h2>چه کسی این نتیجه را می‌بیند؟</h2>
                                        <t t-if="a.share_level != 'none'">
                                            <p><strong t-out="a.workspace_id.ts_public_name()"/> — <t t-out="a.ts_level_word()"/>، برای همهٔ سنجه‌های این مجموعه. پاسخ‌های خام <t t-if="tu">تو</t><t t-else="">شما</t> را هیچ پنلی نمی‌بیند.</p>
                                            <p><a t-attf-href="/my/sharing/#{a.id}/revoke">قطع اشتراک‌گذاری با این پنل</a><t t-call="ts_website.sep"/><a href="/my/sharing">همهٔ اشتراک‌گذاری‌ها</a></p>
                                        </t>
                                        <p t-elif="tu">فقط تو. پنل فقط وضعیت انجام را می‌بیند، چون اشتراک‌گذاری نتیجه را نپذیرفته‌ای.</p>
                                        <p t-else="">فقط شما. پنل فقط وضعیت انجام را می‌بیند، چون اشتراک‌گذاری نتیجه را نپذیرفته‌اید.</p>
                                    </section>
                                    <section class="ts-doc__sec ts-doc__foot">
                                        <h2>محدودیت‌ها و گام بعدی</h2>
                                        <t t-if="tu">
                                            <p>هر سنجه تصویری از پاسخ‌های تو در همان روز است. این نتیجه‌ها را با مشاورت مرور کن؛ به‌تنهایی مبنای تصمیم نیستند.</p>
                                            <p>استعدادیاب خدمت اورژانسی نیست؛ اگر حالت خوب نیست، منتظر نمان: اورژانس اجتماعی ۱۲۳ یا صدای مشاور ۱۴۸۰.</p>
                                        </t>
                                        <t t-else="">
                                            <p>هر سنجه تصویری از پاسخ‌های شما در همان روز است. این نتیجه‌ها را با مشاورتان مرور کنید؛ به‌تنهایی مبنای تصمیم نیستند.</p>
                                            <p>استعدادیاب خدمت اورژانسی نیست؛ اگر حالتان خوب نیست، منتظر نمانید: اورژانس اجتماعی ۱۲۳ یا صدای مشاور ۱۴۸۰.</p>
                                        </t>
                                    </section>
                                </article>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- W/clients/<cid>/b/<assignment>: the battery inside the panel shell; every section at the invitation's level -->
    <record id="tpl_panel_battery" model="ir.ui.view">
        <field name="name">TS battery: panel battery report</field>
        <field name="type">qweb</field>
        <field name="key">ts_battery.panel_battery</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_battery.panel_battery">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page tsb-page" t-att-data-tsp-autoprint="1 if autoprint else None">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">مجموعهٔ <t t-out="battery.ts_title()"/> — <t t-out="client.name"/></h1>
                                    <p class="tsp-head__help"><span class="ts-pill" t-out="kind"/><t t-call="ts_website.sep"/><bdi t-out="jalali(when, with_time=False)"/><t t-call="ts_website.sep"/><bdi><t t-out="fa(done)"/> از <t t-out="fa(total)"/> سنجه انجام شده</bdi></p>
                                </div>
                                <!-- the PDF file is the one button (ts_brand adds it after this form); printing is quiet (G6-PT5) -->
                                <form t-if="level != 'status'" method="post" t-att-action="print_url" class="tsp-inline tsp-noprint">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="ts-btn ts-btn--quiet">چاپ همین صفحه</button>
                                </form>
                            </header>
                            <section class="ts-card" aria-labelledby="tsb-p-head">
                                <h2 id="tsb-p-head" class="tsp-sr">مشخصات مجموعه</h2>
                                <dl class="tsp-dl">
                                    <dt>مرکز</dt><dd t-out="org"/>
                                    <t t-if="counselor"><dt>کارشناس مسئول</dt><dd><bdi t-out="counselor"/></dd></t>
                                    <dt>شناسهٔ دعوت</dt><dd><bdi dir="ltr" t-out="a.name"/></dd>
                                </dl>
                                <p class="tsb-note" role="note" t-out="limit_note"/>
                            </section>
                            <section t-if="level != 'status'" class="ts-card" aria-labelledby="tsb-pov-h">
                                <t t-call="ts_battery.overview" sections="sections" show_score="level == 'clinical'" ov_id="'tsb-pov'"/>
                            </section>
                            <t t-if="level == 'status'">
                                <section class="ts-card">
                                    <p>این مجموعه برای نقش شما فقط با وضعیت انجام نمایش داده می‌شود، یا شرکت‌کننده نتیجه را به اشتراک نگذاشته است.</p>
                                    <ul class="tsb-status">
                                        <li t-foreach="sections" t-as="bs"><t t-out="bs['inst'].ts_title()"/><t t-call="ts_website.sep"/><t t-if="bs['at'].state == 'done'">تکمیل‌شده</t><t t-else="">هنوز پاسخ داده نشده</t></li>
                                    </ul>
                                </section>
                            </t>
                            <t t-else="">
                                <nav class="ts-card tsb-jump tt-jump tsp-noprint" aria-label="سنجه‌های این مجموعه">
                                    <ol>
                                        <li t-foreach="sections" t-as="bs"><a t-att-href="'#' + bs['sec_id']" t-out="bs['inst'].ts_title()"/>
                                            <span t-if="bs['at'].state != 'done'" class="ts-hint"><t t-call="ts_website.sep"/>هنوز پاسخ داده نشده</span></li>
                                    </ol>
                                </nav>
                                <t t-foreach="sections" t-as="bs">
                                    <t t-call="ts_talent.sec" sec_id="bs['sec_id']" title="bs['inst'].ts_title()" collapse="None if bs_first else 'phone'" cls="'tsb-sec ts-card'">
                                        <p t-if="bs['matrix'] and bs['at'].state == 'done'"><a t-att-href="result_url(bs['at'])" class="ts-btn ts-btn--outline ts-btn--sm">دیدن گزارش این سنجه</a></p>
                                        <p t-elif="bs['at'].state != 'done'" class="ts-hint">هنوز به این سنجه پاسخ داده نشده است.</p>
                                        <t t-else=""><t t-call="ts_panel.result_bands_body" level="bs['level']" results="bs['results']" blk_id="bs['sec_id']" blk_sub="True"/></t>
                                    </t>
                                </t>
                                <section class="ts-card">
                                    <h2 class="h5">محدودیت‌ها</h2>
                                    <p>هر سنجه تصویری از پاسخ‌های شرکت‌کننده در همان روز است و به‌تنهایی مبنای تصمیم نیست.</p>
                                    <p class="ts-hint">مشاهده و چاپ این صفحه در دفتر ممیزی ثبت می‌شود.</p>
                                </section>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
