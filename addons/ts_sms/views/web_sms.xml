<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_entry_phone" model="portal.entry">
        <field name="name">شمارهٔ موبایل و پیامک</field>
        <field name="description">تأیید شمارهٔ موبایل و انتخاب اینکه هنگام آماده‌شدن نتیجه پیامک بگیرید یا نه</field>
        <field name="url">/my/phone</field>
        <field name="sequence">3</field>
        <field name="website_id" ref="ts_website.website_ts"/>
    </record>

    <!-- Invitation form: optional mobile + consent; replaces the "we never send SMS" hint -->
    <record id="tpl_workspace_sms" model="ir.ui.view">
        <field name="name">TS: workspace invite with SMS</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="ts_org.tpl_workspace"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//input[@id='ts_inv_email']" position="after">
                <t t-set="ts_sms_on" t-value="request.env.company.sudo().kv_enabled and request.env.company.sudo().ts_sms_invite"/>
                <t t-if="ts_sms_on">
                    <label for="ts_inv_phone">موبایل (اختیاری، برای ارسال پیامک دعوت)</label>
                    <input id="ts_inv_phone" name="invitee_phone" type="tel" dir="ltr" inputmode="numeric" maxlength="20" autocomplete="off" placeholder="09123456789"/>
                    <label class="ts-check"><input type="checkbox" name="sms_consent" value="1"/> تأیید می‌کنم شرکت‌کننده با دریافت این پیامک موافق است</label>
                </t>
            </xpath>
            <xpath expr="//p[@t-if='created']" position="after">
                <p t-if="created and created.sms_sent_at" class="ts-notice" role="status">پیامک دعوت ارسال شد.</p>
                <p t-if="created and created.sms_error" class="ts-notice ts-notice--warn" role="alert">
                    پیامک ارسال نشد (<t t-out="created.sms_error"/>). پیوند بالا را خودتان برای شرکت‌کننده بفرستید.
                </p>
            </xpath>
            <xpath expr="//p[hasclass('ts-hint')][contains(., 'ایمیل یا پیامک نمی')]" position="replace">
                <p class="ts-hint">
                    <t t-if="request.env.company.sudo().kv_enabled and request.env.company.sudo().ts_sms_invite">پیامک فقط وقتی فرستاده می‌شود که موبایل را وارد کنید و موافقت شرکت‌کننده را تأیید کنید. پیوند دعوت همیشه در دسترس شماست و می‌توانید خودتان هم بفرستید.</t>
                    <t t-else="">استعدادیاب ایمیل یا پیامک نمی‌فرستد؛ پیوند دعوت را خودتان برای شرکت‌کننده بفرستید.</t>
                </p>
            </xpath>
        </field>
    </record>

    <!-- /my/phone. UX audit 2026-10-11: heading order (G2-P9-1), visible format hint (P9-2, G4-P26-2), way back to the
         account (P9-3), a confirmation step before removing the number (X6; the POST contract is unchanged). -->
    <record id="tpl_phone" model="ir.ui.view">
        <field name="name">TS: my phone</field>
        <field name="type">qweb</field>
        <field name="key">ts_sms.phone</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_sms.phone">
                <t t-call="website.layout" additional_title.f="شمارهٔ موبایل و پیامک">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-narrow">
                                <a href="/my/account" class="ts-back ts-backlink">حساب</a>
                                <div class="ts-section__head" id="ts-phone-head">
                                    <h1 class="tsp-head__title">شمارهٔ موبایل و پیامک</h1>
                                    <p>شماره فقط برای تأیید حساب و پیامک «نتیجه آماده است» به کار می‌رود. متن نتیجه هرگز پیامک نمی‌شود و هر وقت بخواهید می‌توانید شماره را حذف کنید.</p>
                                </div>
                                <p t-if="msg" t-attf-class="ts-notice #{'ts-notice--warn' if msg[0] == 'warn' else ''}" role="status" t-out="msg[1]"/>
                                <div t-if="not enabled" class="ts-card ts-card--soft">
                                    <h2 class="h5">هنوز فعال نشده است</h2>
                                    <p>تأیید شمارهٔ موبایل پس از راه‌اندازی سرویس پیامک در دسترس خواهد بود.</p>
                                </div>
                                <t t-elif="verified">
                                    <div t-if="confirm_remove" class="ts-card ts-confirm" role="alertdialog" aria-labelledby="ts-phone-rm-h" aria-describedby="ts-phone-rm-d">
                                        <h2 id="ts-phone-rm-h" class="h5">شمارهٔ <bdi dir="ltr" class="ts-bdi" t-out="masked"/> حذف شود؟</h2>
                                        <ul id="ts-phone-rm-d">
                                            <li>پیامک «نتیجه آماده است» دیگر فرستاده نمی‌شود.</li>
                                            <li>با این شماره دیگر نمی‌شود با کد پیامکی وارد این حساب شد، تا وقتی دوباره آن را تأیید کنید.</li>
                                        </ul>
                                        <form action="/my/phone/remove" method="post" class="ts-confirm__actions">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="ts-btn ts-btn--danger">بله، شماره را حذف کن</button>
                                            <a href="/my/phone" class="ts-btn ts-btn--outline">انصراف</a>
                                        </form>
                                    </div>
                                    <div t-else="" class="ts-card">
                                        <h2 class="h5">شمارهٔ تأییدشده</h2>
                                        <p><bdi dir="ltr" class="ts-bdi" t-out="masked"/></p>
                                        <form action="/my/phone/prefs" method="post" class="ts-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <label class="ts-check"><input type="checkbox" name="results" value="1" t-att-checked="'checked' if opt_results else None"/> <span>وقتی نتیجهٔ سنجه آماده شد پیامک بگیرم</span></label>
                                            <div><button type="submit" class="ts-btn ts-btn--primary ts-btn--sm">ذخیره</button></div>
                                        </form>
                                        <p><a href="/my/phone?confirm=remove" class="ts-btn ts-btn--outline ts-btn--sm">حذف شماره…</a></p>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="ts-card">
                                        <h2 class="h5">تأیید شمارهٔ موبایل</h2>
                                        <form action="/my/phone/send" method="post" class="ts-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <label for="ts_phone_no">شمارهٔ موبایل</label>
                                            <input id="ts_phone_no" name="phone" type="tel" dir="ltr" inputmode="tel" required="required" maxlength="20" autocomplete="tel" aria-describedby="ts_phone_no_hint"/>
                                            <p id="ts_phone_no_hint" class="ts-hint">۱۱ رقم، مثل ۰۹۱۲۳۴۵۶۷۸۹؛ رقم فارسی هم پذیرفته می‌شود.</p>
                                            <div><button type="submit" class="ts-btn ts-btn--primary">ارسال کد تأیید</button></div>
                                        </form>
                                        <form t-if="pending" action="/my/phone/verify" method="post" class="ts-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <label for="ts_phone_code">کد ۶ رقمی پیامک‌شده</label>
                                            <input id="ts_phone_code" name="code" type="text" dir="ltr" inputmode="numeric" required="required" maxlength="6" pattern="[0-9۰-۹]{6}" autocomplete="one-time-code"/>
                                            <div><button type="submit" class="ts-btn ts-btn--primary">تأیید</button></div>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- S-AUTH (onb1): the one sign-in of talentsearch.ir, /signup (alias /login; /web/login shows it to visitors too).
         Two states on one page: number, then code. Works as plain forms without JavaScript; ts_sms/static/src/js/signin.js
         switches state in place, counts down the resend, submits at 6 digits and listens for WebOTP. Return path `next`
         is kept everywhere. -->
    <record id="tpl_signup" model="ir.ui.view">
        <field name="name">TS: sign in by mobile</field>
        <field name="type">qweb</field>
        <field name="key">ts_sms.signup</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_sms.signup">
                <t t-call="website.layout" additional_title.f="ورود یا ثبت‌نام">
                    <div id="wrap" class="ts-page">
                        <div class="ts-auth">
                            <div class="ts-auth__card tsa" id="ts-auth" t-att-data-tsa-state="'code' if step == 'code' else 'phone'"
                                 t-att-data-tsa-wait="wait" t-att-data-tsa-resends="resends" t-att-data-tsa-help="help_after">
                                <h1>ورود یا ثبت‌نام</h1>
                                <p class="ts-hint ts-auth__intro">با شمارهٔ موبایل و یک کد پیامکی وارد می‌شوید؛ رمز عبور لازم نیست. اگر حساب ندارید، همین‌جا ساخته می‌شود.</p>
                                <p t-if="why" class="ts-notice ts-notice--info" role="note" id="ts-signup-why"><t t-out="why"/></p>
                                <p id="tsa-msg" role="status" aria-live="polite" t-att-hidden="None if msg else 'hidden'"
                                   t-attf-class="ts-notice tsa-msg #{'ts-notice--warn' if msg and msg[0] == 'warn' else ''}"><t t-if="msg" t-out="msg[1]"/></p>
                                <div t-if="not enabled" class="ts-card ts-card--soft">
                                    <h2 class="h5">ورود با موبایل فعلاً در دسترس نیست</h2>
                                    <p>فعلاً می‌توانید <a t-att-href="email_url">با ایمیل و رمز عبور وارد شوید</a>.</p>
                                </div>
                                <t t-else="">
                                    <!-- state 1: the number -->
                                    <form action="/signup/send" method="post" class="ts-form tsa-step" id="tsa-phone" data-tsa-step="phone"
                                          t-att-hidden="'hidden' if step == 'code' else None" novalidate="novalidate">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="next" t-att-value="next"/>
                                        <input type="hidden" name="personal_shown" value="1"/>
                                        <!-- onb2: a number the server holds is shown masked and sent as known=1; nothing is typed -->
                                        <p t-if="known_fa" class="tsa-known" id="tsa-known">کد ورود را به <bdi dir="ltr" class="ts-bdi" t-out="known_fa"/> می‌فرستیم.
                                            <input type="hidden" name="known" value="1"/><input type="hidden" name="phone" value=""/>
                                            <a class="tsa-edit" id="tsa-other" t-attf-href="/signup?other=1&amp;next=#{next_q}">شمارهٔ دیگری دارم</a></p>
                                        <div t-else="">
                                            <label for="tsa_phone">شمارهٔ موبایل</label>
                                            <input id="tsa_phone" name="phone" type="tel" dir="ltr" inputmode="numeric" autocomplete="tel"
                                                   required="required" maxlength="20" placeholder="۰۹۱۲ ۳۴۵ ۶۷۸۹" class="ts-input tsa-num"
                                                   t-att-value="phone_prefill or None" t-att-autofocus="None if step == 'code' else 'autofocus'"
                                                   aria-describedby="tsa_phone_h" t-att-aria-invalid="'true' if msg_key == 'format' else None"/>
                                            <p id="tsa_phone_h" class="ts-hint">مثل ۰۹۱۲۳۴۵۶۷۸۹؛ با ۹۸+ یا رقم فارسی هم درست است.</p>
                                        </div>
                                        <label class="ts-check tsa-personal"><input type="checkbox" name="personal" value="1" t-att-checked="'checked' if personal else None" aria-describedby="tsa_personal_h"/>
                                            <span>این دستگاه شخصی من است</span></label>
                                        <p id="tsa_personal_h" class="ts-hint tsa-personal__hint">تا ۳۰ روز وارد می‌مانید. روی رایانه یا گوشی مشترک تیک را بردارید تا با بستن مرورگر از حساب خارج شوید.</p>
                                        <button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">دریافت کد</button>
                                        <p class="ts-hint tsa-terms">با ادامه، <a href="/privacy">حریم خصوصی و شرایط استفاده</a> را می‌پذیرید.</p>
                                    </form>

                                    <!-- state 2: the code -->
                                    <form action="/signup/verify" method="post" class="ts-form tsa-step" id="tsa-code" data-tsa-step="code"
                                          t-att-hidden="None if step == 'code' else 'hidden'" novalidate="novalidate">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="next" t-att-value="next"/>
                                        <p class="tsa-sent"><t t-if="known_fa and phone_fa == known_fa">برای ادامه، کدی به</t><t t-else="">کد ۶ رقمی را به</t> <bdi dir="ltr" class="ts-bdi tsa-sent__num" t-out="phone_fa"/> فرستادیم.
                                            <a t-if="not (known_fa and phone_fa == known_fa)" class="tsa-edit" t-attf-href="/signup?edit=1&amp;next=#{next_q}" data-tsa-edit="1">ویرایش شماره</a>
                                            <a t-else="" class="tsa-edit" id="tsa-other" t-attf-href="/signup?other=1&amp;next=#{next_q}">شمارهٔ دیگری دارم</a></p>
                                        <div>
                                            <label for="tsa_code">کد ۶ رقمی</label>
                                            <input id="tsa_code" name="code" type="text" dir="ltr" inputmode="numeric" autocomplete="one-time-code"
                                                   maxlength="6" pattern="[0-9۰-۹٠-٩]{6}" required="required" class="ts-input tsa-num tsa-code"
                                                   t-att-autofocus="'autofocus' if step == 'code' else None" aria-describedby="tsa_code_h"
                                                   t-att-aria-invalid="'true' if msg_key in ('short', 'wrong', 'expired', 'attempts') else None"/>
                                            <p id="tsa_code_h" class="ts-hint">کد پیامک‌شده را بنویسید یا بچسبانید؛ با شش رقم خودبه‌خود ادامه می‌دهیم.</p>
                                        </div>
                                        <button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">ورود</button>
                                    </form>
                                    <form action="/signup/send" method="post" class="tsa-resend" id="tsa-resend"
                                          t-att-hidden="None if step == 'code' else 'hidden'">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="next" t-att-value="next"/>
                                        <input type="hidden" name="resend" value="1"/>
                                        <p class="ts-hint tsa-count" data-tsa-count="1" hidden="hidden" aria-live="off"></p>
                                        <button type="submit" class="ts-btn ts-btn--quiet tsa-resend__btn">ارسال دوباره کد</button>
                                    </form>
                                    <details class="tsa-help" id="tsa-help" t-att-hidden="None if (step == 'code' and resends &gt;= help_after) else 'hidden'">
                                        <summary>کد نمی‌رسد؟</summary>
                                        <ul>
                                            <li t-if="not known_fa">شماره را دوباره ببینید؛ اگر اشتباه است «ویرایش شماره» را بزنید.</li>
                                            <li t-else="">کد به شماره‌ای می‌رود که دعوت برایش فرستاده شده است؛ اگر آن شماره دیگر مال شما نیست، از دعوت‌کننده دعوت تازه بخواهید.</li>
                                            <li>پیامک کد از خط خدماتی می‌آید؛ اگر پیامک‌های تبلیغاتی را بسته‌اید، صندوق پیامک‌های مسدود را هم ببینید.</li>
                                            <li>گاهی پیامک یکی‌دو دقیقه دیر می‌رسد. اگر باز هم نرسید، <a href="/contact?topic=support">به پشتیبانی پیام بدهید</a>.</li>
                                        </ul>
                                    </details>
                                    <p class="ts-auth__alt"><a t-att-href="email_url">با ایمیل ثبت‌نام کرده بودید؟</a></p>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
