<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_entry_assessments" model="portal.entry">
        <field name="name">سنجه‌ها و نتیجه‌ها</field>
        <field name="description">پاسخ‌دهی، ادامهٔ سنجه‌های نیمه‌تمام و گزارش نتایج</field>
        <field name="url">/my/assessments</field>
        <field name="sequence">1</field>
        <field name="website_id" ref="ts_website.website_ts"/>
    </record>

    <record id="tpl_my_list" model="ir.ui.view">
        <field name="name">TS: my assessments</field>
        <field name="type">qweb</field>
        <field name="key">ts_assessment.my_list</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_assessment.my_list">
                <t t-call="website.layout" additional_title.f="سنجه‌ها و نتیجه‌ها">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head">
                                    <h1>سنجه‌ها و نتیجه‌ها</h1>
                                    <p t-if="tu">سنجه‌های نیمه‌تمام را ادامه بده و گزارش نتیجه‌ها را ببین.</p>
                                    <p t-else="">سنجه‌های نیمه‌تمام را ادامه دهید و گزارش نتیجه‌ها را ببینید.</p>
                                </div>
                                <t t-if="not attempts">
                                    <div class="ts-card ts-card--soft">
                                        <h2 t-if="tu">هنوز سنجه‌ای انجام نداده‌ای</h2>
                                        <h2 t-else="">هنوز سنجه‌ای انجام نداده‌اید</h2>
                                        <p t-if="tu">از فهرست سنجه‌ها یکی را انتخاب کن.</p>
                                        <p t-else="">از فهرست سنجه‌ها یکی را انتخاب کنید.</p>
                                        <a href="/assessments" class="ts-btn ts-btn--primary">دیدن سنجه‌ها</a>
                                    </div>
                                </t>
                                <t t-else="">
                                    <section t-if="going" class="ts-card ts-list-card" id="ts-list-going" aria-labelledby="ts-list-going-h">
                                        <h2 id="ts-list-going-h">نیمه‌تمام</h2>
                                        <ul class="tsp-list tsp-rows">
                                            <li t-foreach="going" t-as="a">
                                                <t t-set="fresh" t-value="a.state == 'consent' or not a.answered_count"/>
                                                <div class="tsp-rows__text">
                                                    <strong t-out="a.instrument_id.ts_title()"/>
                                                    <span class="ts-hint"><t t-if="a.workspace_id">به دعوت <t t-out="a.workspace_id.ts_public_name()"/><t t-call="ts_website.sep"/></t><t t-if="fresh"><t t-if="tu">هنوز شروع نکرده‌ای</t><t t-else="">هنوز شروع نکرده‌اید</t></t><t t-else=""><t t-set="pline" t-value="a.ts_progress_line(tu)"/><t t-if="pline" t-out="pline"/><t t-else=""><t t-out="fa(a.progress)"/>٪ پاسخ <t t-if="tu">داده‌ای</t><t t-else="">داده‌اید</t></t><t t-call="ts_website.sep"/>آخرین ذخیره <t t-out="a.jalali_long(a.write_date)"/></t></span>
                                                </div>
                                                <a t-attf-href="/take/#{a.access_token}" class="ts-btn ts-btn--primary ts-btn--sm"><t t-if="fresh">شروع</t><t t-else="">ادامه</t><span class="visually-hidden"> «<t t-out="a.instrument_id.ts_title()"/>»</span></a>
                                            </li>
                                        </ul>
                                    </section>
                                    <section t-if="groups" class="ts-card ts-list-card" id="ts-list-results" aria-labelledby="ts-list-results-h">
                                        <h2 id="ts-list-results-h">نتیجه‌ها</h2>
                                        <div t-foreach="groups" t-as="g" class="ts-list-group" t-attf-id="ts-list-inst-#{g['inst'].id}">
                                            <h3 t-out="g['inst'].ts_title()"/>
                                            <p class="ts-hint" t-if="len(g['rows']) > 1"><t t-out="fa(len(g['rows']))"/> بار انجام شده؛ جدیدترین اول.</p>
                                            <ul class="tsp-list tsp-rows">
                                                <li t-foreach="g['rows']" t-as="a">
                                                    <div class="tsp-rows__text">
                                                        <strong><t t-out="a.jalali_long(a.submitted_at or a.create_date)"/><t t-if="a.subject_label"><t t-call="ts_website.sep"/>دربارهٔ <t t-out="a.subject_label"/></t></strong>
                                                        <span class="ts-hint">
                                                            <t t-if="a.state == 'done' and a.released">نتیجه آماده<t t-if="a.workspace_id"><t t-call="ts_website.sep"/>به دعوت <t t-out="a.workspace_id.ts_public_name()"/></t></t>
                                                            <t t-elif="a.state == 'done'">نتیجه در دسترس نیست</t>
                                                            <t t-else="">محاسبه انجام نشد</t>
                                                            <t t-if="g['mixed'] and a.version_id != g['rows'][0].version_id"><t t-call="ts_website.sep"/><t t-if="tu">نسخهٔ دیگر؛ با هم مقایسه نکن</t><t t-else="">نسخهٔ دیگر؛ با هم مقایسه نکنید</t></t>
                                                        </span>
                                                        <span class="ts-hint ts-list-share" t-if="a.state == 'done' and a.released">
                                                            <a href="/my/sharing"><t t-if="shares.get(a.id)">با «<t t-out="shares[a.id]"/>» به اشتراک گذاشته شده</t><t t-elif="tu">فقط تو می‌بینی</t><t t-else="">فقط شما می‌بینید</t></a>
                                                        </span>
                                                    </div>
                                                    <a t-if="a.state == 'done' and a.released" t-attf-href="/my/assessments/#{a.id}" class="ts-btn ts-btn--outline ts-btn--sm">گزارش<span class="visually-hidden"> <t t-out="a.jalali_long(a.submitted_at or a.create_date)"/></span></a>
                                                    <a t-elif="a.state == 'done'" t-attf-href="/my/assessments/#{a.id}" class="ts-btn ts-btn--quiet ts-btn--sm">چرا؟</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </section>
                                </t>
                                <!-- only next to a history: an empty list already has «دیدن سنجه‌ها» as its one action (UX T7 P19-1) -->
                                <p t-if="attempts" id="ts-list-catalog"><a href="/assessments?all=1"><t t-if="tu">سنجه‌های دیگری که می‌توانی انجام بدهی</t><t t-else="">سنجه‌های دیگری که می‌توانید انجام دهید</t></a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_report" model="ir.ui.view">
        <field name="name">TS: result report</field>
        <field name="type">qweb</field>
        <field name="key">ts_assessment.report</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_assessment.report">
                <t t-call="website.layout" additional_title="'گزارش ' + inst.ts_title()">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section ts-report-page">
                            <div class="ts-container ts-report-wrap">
                                <div class="ts-report-actions ts-noprint">
                                    <a href="/my/assessments" class="ts-back">سنجه‌ها و نتیجه‌ها</a>
                                    <button type="button" class="ts-btn ts-btn--quiet ts-js-print">چاپ همین صفحه</button>
                                </div>
                                <p t-if="submitted" class="ts-notice ts-noprint" role="status">پاسخ‌های شما ثبت شد و گزارش آماده است.</p>
                                <article class="ts-doc">
                                    <header class="ts-doc__head">
                                        <div class="ts-doc__brand">
                                            <img src="/ts_website/static/img/talentsearch-logo.webp" width="40" height="40" alt=""/>
                                            <div><strong>استعدادیاب</strong><small>از خانوادهٔ هیجان اندیشه</small></div>
                                        </div>
                                        <div class="ts-doc__kind">گزارش نتیجهٔ سنجه</div>
                                    </header>
                                    <h1 class="ts-doc__title" t-out="inst.ts_title()"/>
                                    <t t-set="ts_who" t-value="attempt.partner_id.ts_known_name()"/>
                                    <p class="ts-doc__lead">نتیجهٔ <t t-if="ts_who" t-out="ts_who"/><t t-else="">شما</t> در <t t-out="attempt.jalali_long(attempt.submitted_at)"/>.</p>
                                    <!-- the result itself on the first screen (R10, B15-1): highest and lowest factors, from the summary rows -->
                                    <t t-set="ts_top" t-value="results.filtered(lambda r: r.band == 'high')"/>
                                    <t t-set="ts_low" t-value="results.filtered(lambda r: r.band == 'low')"/>
                                    <div t-if="results" class="ts-glance" id="ts-glance">
                                        <p t-if="ts_top"><strong>سطح زیاد:</strong> <t t-out="'، '.join(ts_top.mapped('factor_id.name'))"/></p>
                                        <p t-if="ts_low"><strong>سطح کم:</strong> <t t-out="'، '.join(ts_low.mapped('factor_id.name'))"/></p>
                                        <p t-if="not ts_top and not ts_low">همهٔ عامل‌ها در سطح متوسط‌اند.</p>
                                        <p class="ts-glance__more"><a href="#ts-summary">جدول همهٔ عامل‌ها</a></p>
                                    </div>
                                    <div class="ts-doc__details tsp-collapse" data-tsp-collapse="1">
                                    <h2 class="h5">جزئیات گزارش</h2>
                                    <p class="ts-doc__use" t-out="inst.ts_intended_use()"/>
                                    <dl class="ts-meta ts-doc__meta">
                                        <t t-if="ts_who"><dt>شرکت‌کننده</dt><dd t-out="ts_who"/></t>
                                        <t t-if="attempt.subject_label"><dt>دربارهٔ</dt><dd t-out="attempt.subject_label"/></t>
                                        <dt>پاسخ‌دهنده</dt><dd t-out="dict(attempt._fields['respondent_role'].selection).get(attempt.respondent_role)"/>
                                        <dt>تاریخ تکمیل</dt><dd t-out="attempt.jalali(attempt.submitted_at)"/>
                                        <dt>شناسهٔ گزارش</dt><dd><bdi dir="ltr" class="ts-bdi" t-out="attempt.name"/></dd>
                                        <dt>نسخهٔ نمره‌گذاری</dt><dd><span t-att-title="'%s / %s' % (version.contract_version, attempt.engine_version)" t-out="version.ts_version_label()"/></dd>
                                        <dt>وضعیت</dt><dd>منتشرشده برای شرکت‌کننده؛ محتوای تفسیر تأییدشده</dd>
                                    </dl>
                                    </div>

                                    <t t-call="ts_assessment.report_blocks"/>

                                    <section t-if="history" class="ts-doc__sec ts-noprint" id="ts-history">
                                        <h2>نتیجه‌های قبلی همین سنجه</h2>
                                        <p class="ts-hint">هر نتیجه توصیف همان روز است. فقط نتیجه‌های همین نسخهٔ نمره‌گذاری (<span t-att-title="version.contract_version" t-out="version.ts_version_label()"/>) کنار هم خوانده می‌شوند؛ تغییر عدد به‌تنهایی به معنای بهتر یا بدتر شدن نیست.</p>
                                        <ul class="tsp-list tsp-rows">
                                            <li t-foreach="history" t-as="h">
                                                <div class="tsp-rows__text">
                                                    <strong t-out="h.jalali_long(h.submitted_at)"/>
                                                    <span class="ts-hint"><t t-if="h.version_id == version">همین نسخهٔ نمره‌گذاری</t><t t-else="">نسخهٔ دیگر (<span t-att-title="h.version_id.contract_version" t-out="h.version_id.ts_version_label()"/>)؛ مقایسهٔ مستقیم معتبر نیست</t></span>
                                                </div>
                                                <a t-attf-href="/my/assessments/#{h.id}" class="ts-btn ts-btn--outline ts-btn--sm">گزارش</a>
                                            </li>
                                        </ul>
                                    </section>

                                    <section class="ts-doc__sec ts-doc__foot">
                                        <h2>محدودیت‌ها و گام بعدی</h2>
                                        <p t-out="inst.limitations"/>
                                        <p t-if="tu">اگر نتیجه برایت پرسشی پیش آورده یا نگرانت کرده است، با یک مشاور گفت‌وگو کن. استعدادیاب خدمت اورژانسی نیست؛ اگر حالت خوب نیست، منتظر نمان: اورژانس اجتماعی ۱۲۳ یا صدای مشاور ۱۴۸۰.</p>
                                        <p t-else="">اگر نتیجه برایتان پرسشی پیش آورده یا نگرانتان کرده است، با یک مشاور گفت‌وگو کنید. استعدادیاب خدمت اورژانسی نیست؛ اگر حالتان خوب نیست، منتظر نمانید: اورژانس اجتماعی ۱۲۳ یا صدای مشاور ۱۴۸۰.</p>
                                        <p class="ts-hint">این گزارش متعلق به شماست. شناسهٔ گزارش <bdi dir="ltr" t-out="attempt.name"/><t t-call="ts_website.sep"/>کد اصالت گزارش <bdi dir="ltr" t-out="(attempt.output_hash or '')[:12]"/></p>
                                    </section>
                                </article>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- The per-attempt result blocks (summary table + one section per factor with the participant texts). Called by the
         report page and by ts_battery's battery page (one call per instrument). Optional params: blk_sum_id (id of the
         summary section, default ts-summary), blk_sub (True: headings one level lower, inside a battery section). -->
    <record id="tpl_report_blocks" model="ir.ui.view">
        <field name="name">TS: result report blocks</field>
        <field name="type">qweb</field>
        <field name="key">ts_assessment.report_blocks</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_assessment.report_blocks">
                                    <section class="ts-doc__sec" t-att-id="blk_sum_id or 'ts-summary'">
                                        <h3 t-if="blk_sub">خلاصهٔ نتیجه‌ها</h3>
                                        <h2 t-else="">خلاصهٔ نتیجه‌ها</h2>
                                        <p class="ts-hint">نمرهٔ هر عامل میانگین پاسخ‌های <t t-if="tu">تو</t><t t-else="">شما</t> از ۱ تا ۵ است. سطح‌ها: کم، متوسط و زیاد.<span class="ts-barnote"> نوار، جایگاه نمره را روی مقیاس نشان می‌دهد: ۱ در راست، ۵ در چپ؛ سه رنگ نوار همان سه سطح است.</span> <a t-if="results" t-att-href="'/assessments/%s#ts-how-scored' % results[:1].attempt_id.instrument_id.slug" class="ts-noprint">نمره چگونه حساب می‌شود</a></p>
                                        <table class="ts-table ts-summary">
                                            <thead><tr><th scope="col">عامل</th><th scope="col" class="ts-nowrap">نمره (۱ تا ۵)</th><th scope="col">سطح</th><th scope="col" class="ts-summary__bar">جایگاه روی مقیاس ۱ تا ۵</th></tr></thead>
                                            <tbody>
                                                <t t-foreach="results" t-as="r">
                                                    <tr>
                                                        <td><a t-attf-href="#f-#{r.factor_id.id}" t-out="r.factor_id.name"/></td>
                                                        <td class="ts-num" t-out="r.score_fa()"/>
                                                        <td><span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></td>
                                                        <td class="ts-summary__bar">
                                                            <div class="ts-meterbox" aria-hidden="true">
                                                                <span class="ts-meter__end">۱</span>
                                                                <div class="ts-meter">
                                                                    <t t-foreach="r.factor_id.band_ids" t-as="b">
                                                                        <span t-attf-class="ts-meter__seg ts-meter__seg--#{b.band}" t-attf-style="width: #{round(100.0 * (min(b.max_score, 5) - max(b.min_score, 1) + (0.01 if b.band != 'high' else 0)) / 4, 2)}%"/>
                                                                    </t>
                                                                    <span class="ts-meter__mark" t-attf-style="inset-inline-start: #{r.position_pct()}%"/>
                                                                </div>
                                                                <span class="ts-meter__end">۵</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </section>

                                    <t t-foreach="results" t-as="r">
                                        <section class="ts-doc__sec ts-factor" t-attf-id="f-#{r.factor_id.id}">
                                            <div class="ts-factor__head">
                                                <h3 t-if="blk_sub" t-out="r.factor_id.name"/>
                                                <h2 t-else="" t-out="r.factor_id.name"/>
                                                <div class="ts-factor__score"><span class="ts-num" t-out="r.score_fa()"/> <span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></div>
                                            </div>
                                            <!-- verify T7 (B15-3, B16-2): on a phone each factor's texts fold behind one button (ts_player.js;
                                                 open without JS, in print and when reached from the summary table's link) -->
                                            <button type="button" class="ts-factor__tog ts-noprint" aria-expanded="true" t-attf-aria-controls="f-#{r.factor_id.id}-b" hidden="hidden"
                                                    data-open="بستن توضیح‌ها" data-closed="خواندن توضیح‌ها">بستن توضیح‌ها<span class="ts-sr"> «<t t-out="r.factor_id.name"/>»</span></button>
                                            <div class="ts-factor__body" t-attf-id="f-#{r.factor_id.id}-b">
                                                <t t-foreach="r.client_sections()" t-as="sec">
                                                    <t t-if="sec[0]">
                                                        <h4 t-if="blk_sub" t-out="sec[0]"/>
                                                        <h3 t-else="" t-out="sec[0]"/>
                                                    </t>
                                                    <div class="ts-doc__text" t-out="sec[1]"/>
                                                </t>
                                            </div>
                                        </section>
                                    </t>
            </t>
        </field>
    </record>

    <!-- portal v3 (P2): a finished result that is not available to the participant -->
    <record id="tpl_unavailable" model="ir.ui.view">
        <field name="name">TS: result not available</field>
        <field name="type">qweb</field>
        <field name="key">ts_assessment.unavailable</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_assessment.unavailable">
                <t t-call="website.layout" additional_title.f="نتیجه در دسترس نیست">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container ts-narrow">
                                <a href="/my/assessments" class="ts-back">سنجه‌ها و نتیجه‌ها</a>
                                <h1 t-out="inst.ts_title()"/>
                                <div class="ts-card ts-card--soft">
                                    <h2 class="h4">این نتیجه در دسترس شما نیست</h2>
                                    <p t-if="attempt.source == 'import'">این نتیجه از سامانهٔ قبلی وارد شده و هنوز برای نمایش به شما آزاد نشده است. مرکزی که سنجش را اجرا کرده می‌تواند آن را آزاد کند.</p>
                                    <p t-else="">این نتیجه به درخواست شما یا طبق الزام قانونی از دسترس خارج شده است. اگر فکر می‌کنید اشتباهی رخ داده، با پشتیبانی تماس بگیرید.</p>
                                    <p class="ts-hint">شناسهٔ پیگیری: <bdi dir="ltr" t-out="attempt.name"/></p>
                                    <p><a href="/contact?topic=support" class="ts-btn ts-btn--outline">تماس با پشتیبانی</a></p>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
