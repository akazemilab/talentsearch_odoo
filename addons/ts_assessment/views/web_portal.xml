<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_entry_assessments" model="portal.entry">
        <field name="name">سنجه‌های من</field>
        <field name="description">پاسخ‌دهی، ادامهٔ سنجه‌های نیمه‌تمام و گزارش نتایج</field>
        <field name="url">/my/assessments</field>
        <field name="sequence">1</field>
        <field name="website_id" ref="ts_website.website_ts"/>
    </record>

    <record id="tpl_my_list" model="ir.ui.view">
        <field name="name">TS: my assessments</field>
        <field name="type">qweb</field>
        <field name="key">ts_assessment.my_list</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_assessment.my_list">
                <t t-call="website.layout" additional_title.f="سنجه‌های من">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section">
                            <div class="ts-container">
                                <div class="ts-section__head">
                                    <h1>سنجه‌های من</h1>
                                    <p>سنجه‌های نیمه‌تمام را ادامه دهید و گزارش نتایج را ببینید. این صفحه فقط برای شما قابل مشاهده است.</p>
                                </div>
                                <t t-if="not attempts">
                                    <div class="ts-card ts-card--soft">
                                        <h3>هنوز سنجه‌ای انجام نداده‌اید</h3>
                                        <p>از فهرست سنجه‌ها یکی را انتخاب کنید.</p>
                                        <a href="/assessments" class="ts-btn ts-btn--primary">مشاهدهٔ سنجه‌ها</a>
                                    </div>
                                </t>
                                <div t-else="" class="ts-table-wrap">
                                    <table class="ts-table">
                                        <thead><tr><th scope="col">سنجه</th><th scope="col">وضعیت</th><th scope="col">تاریخ</th><th scope="col"><span class="visually-hidden">اقدام</span></th></tr></thead>
                                        <tbody>
                                            <t t-foreach="attempts" t-as="a">
                                                <tr>
                                                    <td><strong t-out="a.instrument_id.title"/><div class="ts-hint" t-if="a.subject_label">دربارهٔ <t t-out="a.subject_label"/></div></td>
                                                    <td>
                                                        <span t-if="a.state == 'done'" class="ts-pill ts-pill--ok">تکمیل‌شده</span>
                                                        <span t-elif="a.state == 'in_progress'" class="ts-pill">در حال پاسخ · <t t-out="fa(a.progress)"/>٪</span>
                                                        <span t-elif="a.state == 'consent'" class="ts-pill">شروع نشده</span>
                                                        <span t-else="" class="ts-pill ts-pill--warn">در حال بررسی</span>
                                                    </td>
                                                    <td t-out="a.jalali(a.submitted_at or a.started_at or a.create_date, False)"/>
                                                    <td>
                                                        <a t-if="a.state == 'done'" t-attf-href="/my/assessments/#{a.id}" class="ts-btn ts-btn--outline ts-btn--sm">مشاهدهٔ گزارش</a>
                                                        <a t-elif="a.state in ('consent', 'in_progress')" t-attf-href="/take/#{a.access_token}" class="ts-btn ts-btn--primary ts-btn--sm">ادامه</a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                                <p><a href="/assessments">مشاهدهٔ همهٔ سنجه‌ها</a></p>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="tpl_report" model="ir.ui.view">
        <field name="name">TS: result report</field>
        <field name="type">qweb</field>
        <field name="key">ts_assessment.report</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_assessment.report">
                <t t-call="website.layout" additional_title="'گزارش ' + inst.title">
                    <div id="wrap" class="ts-page">
                        <section class="ts-section ts-report-page">
                            <div class="ts-container ts-report-wrap">
                                <div class="ts-report-actions ts-noprint">
                                    <a href="/my/assessments" class="ts-back">سنجه‌های من</a>
                                    <button type="button" class="ts-btn ts-btn--outline ts-js-print">چاپ یا ذخیره به‌صورت PDF</button>
                                </div>
                                <p t-if="submitted" class="ts-notice ts-noprint" role="status">پاسخ‌های شما ثبت شد و گزارش آماده است.</p>
                                <article class="ts-doc">
                                    <header class="ts-doc__head">
                                        <div class="ts-doc__brand">
                                            <img src="/ts_website/static/img/talentsearch-logo.webp" width="40" height="40" alt=""/>
                                            <div><strong>تلنت سرچ</strong><small>از خانوادهٔ <bdi dir="ltr">EOT</bdi></small></div>
                                        </div>
                                        <div class="ts-doc__kind">گزارش نتیجهٔ سنجه</div>
                                    </header>
                                    <h1 class="ts-doc__title" t-out="inst.title"/>
                                    <dl class="ts-meta ts-doc__meta">
                                        <dt>شرکت‌کننده</dt><dd t-out="attempt.partner_id.name"/>
                                        <t t-if="attempt.subject_label"><dt>دربارهٔ</dt><dd t-out="attempt.subject_label"/></t>
                                        <dt>پاسخ‌دهنده</dt><dd t-out="dict(attempt._fields['respondent_role'].selection).get(attempt.respondent_role)"/>
                                        <dt>تاریخ تکمیل</dt><dd t-out="attempt.jalali(attempt.submitted_at)"/>
                                        <dt>شناسهٔ گزارش</dt><dd><bdi dir="ltr" t-out="attempt.name"/></dd>
                                        <dt>نسخه</dt><dd><bdi dir="ltr"><t t-out="version.contract_version"/> · <t t-out="attempt.engine_version"/></bdi></dd>
                                        <dt>وضعیت</dt><dd>منتشرشده برای شرکت‌کننده؛ محتوای تفسیر تأییدشده</dd>
                                    </dl>

                                    <section class="ts-doc__sec">
                                        <h2>خلاصهٔ نتایج</h2>
                                        <p class="ts-hint">نمرهٔ هر بُعد میانگین پاسخ‌های شما روی مقیاس ۱ تا ۵ است (عبارت‌های معکوس پیش از میانگین‌گیری برگردانده می‌شوند). بازه‌ها: کم، متوسط و زیاد.</p>
                                        <table class="ts-table ts-summary">
                                            <thead><tr><th scope="col">بُعد</th><th scope="col">نمره (۱ تا ۵)</th><th scope="col">بازه</th><th scope="col" class="ts-summary__bar">جایگاه روی مقیاس</th></tr></thead>
                                            <tbody>
                                                <t t-foreach="results" t-as="r">
                                                    <tr>
                                                        <td><a t-attf-href="#f-#{r.factor_id.id}" t-out="r.factor_id.name"/></td>
                                                        <td class="ts-num" t-out="r.score_fa()"/>
                                                        <td><span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></td>
                                                        <td class="ts-summary__bar">
                                                            <div class="ts-meter" role="img" t-att-aria-label="'نمره ' + r.score_fa() + ' از ۵، بازهٔ ' + r.band_fa()">
                                                                <t t-foreach="r.factor_id.band_ids" t-as="b">
                                                                    <span t-attf-class="ts-meter__seg ts-meter__seg--#{b.band}" t-attf-style="width: #{round(100.0 * (min(b.max_score, 5) - max(b.min_score, 1) + (0.01 if b.band != 'high' else 0)) / 4, 2)}%"/>
                                                                </t>
                                                                <span class="ts-meter__mark" t-attf-style="inset-inline-start: #{r.position_pct()}%"/>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </section>

                                    <t t-foreach="results" t-as="r">
                                        <section class="ts-doc__sec ts-factor" t-attf-id="f-#{r.factor_id.id}">
                                            <div class="ts-factor__head">
                                                <h2 t-out="r.factor_id.name"/>
                                                <div class="ts-factor__score"><span class="ts-num" t-out="r.score_fa()"/> <span t-attf-class="ts-band ts-band--#{r.band}" t-out="r.band_fa()"/></div>
                                            </div>
                                            <t t-foreach="r.client_sections()" t-as="sec">
                                                <h3 t-if="sec[0]" t-out="sec[0]"/>
                                                <div class="ts-doc__text" t-out="sec[1]"/>
                                            </t>
                                        </section>
                                    </t>

                                    <section class="ts-doc__sec ts-doc__foot">
                                        <h2>محدودیت‌ها و گام بعدی</h2>
                                        <p t-out="inst.limitations"/>
                                        <p>اگر نتیجه برایتان پرسش ایجاد کرده یا نگران‌تان کرده است، با یک متخصص مشورت کنید. تلنت سرچ خدمت اورژانسی نیست؛ در شرایط اضطراری با اورژانس <bdi dir="ltr">115</bdi> تماس بگیرید.</p>
                                        <p class="ts-hint">این گزارش فقط برای شرکت‌کننده است. شناسهٔ گزارش <bdi dir="ltr" t-out="attempt.name"/> · اثر نتیجه <bdi dir="ltr" t-out="(attempt.output_hash or '')[:12]"/></p>
                                    </section>
                                </article>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
