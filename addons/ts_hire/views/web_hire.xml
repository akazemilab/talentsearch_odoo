<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR positions inside the employment panel (website 2 only). Copy: «شما» to staff, decision-support wording
         («فقط یکی از ورودی‌های تصمیم»), bands never numbers, no cut-off language. -->

    <!-- ================================================================ list -->
    <record id="tpl_positions" model="ir.ui.view">
        <field name="name">TS hire: positions</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.positions</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.positions">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">موقعیت‌های شغلی</h1>
                                    <p class="tsp-head__help">برای هر شغلی که استخدام می‌کنید یک موقعیت بسازید، نیازهای آن را مرور کنید و داوطلبان را دعوت کنید. استعدادیاب تناسب هر داوطلب را با نیازهای همان شغل نشان می‌دهد؛ تصمیم با شماست.</p>
                                </div>
                                <div class="tsp-head__actions" t-if="can_create">
                                    <a t-attf-href="/my/workspaces/#{ws.id}/positions/new" class="ts-btn ts-btn--primary">موقعیت تازه</a>
                                </div>
                            </header>
                            <div t-if="not rows" class="ts-card tsh-empty">
                                <h2 class="h5">هنوز موقعیتی نساخته‌اید</h2>
                                <ol class="tsh-steps">
                                    <li>شغل را از فهرست ۹۲۳ شغل انتخاب کنید (مثلاً «کارشناس خدمات مشتریان»).</li>
                                    <li>نیازهای شغل را مرور کنید و حداکثر سه نیاز کلیدی را علامت بزنید.</li>
                                    <li>داوطلبان را با پیامک یا ایمیل دعوت کنید و نتیجه را همین‌جا ببینید.</li>
                                </ol>
                                <a t-if="can_create" t-attf-href="/my/workspaces/#{ws.id}/positions/new" class="ts-btn ts-btn--primary">ساخت نخستین موقعیت</a>
                            </div>
                            <div t-if="rows" class="ts-table-wrap">
                                <table class="ts-table tsp-table tsp-table--cards">
                                    <caption class="tsp-sr">فهرست موقعیت‌های شغلی</caption>
                                    <thead><tr><th scope="col">موقعیت</th><th scope="col">شغل مرجع</th><th scope="col">ارزیابی</th><th scope="col">داوطلبان</th><th scope="col">وضعیت</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="p">
                                            <t t-set="c" t-value="counts[p.id]"/>
                                            <th scope="row" data-label="موقعیت"><a t-attf-href="/my/workspaces/#{ws.id}/positions/#{p.id}"><bdi t-out="p.name"/></a></th>
                                            <td data-label="شغل مرجع" t-out="p.occupation_id.title_fa"/>
                                            <td data-label="ارزیابی" t-out="dict(p._fields['battery_choice'].selection)[p.battery_choice]"/>
                                            <td data-label="داوطلبان"><t t-out="fa(c['done'])"/> از <t t-out="fa(c['invited'])"/> تکمیل<t t-if="c['strong']"> · <t t-out="fa(c['strong'])"/> تناسب زیاد</t></td>
                                            <td data-label="وضعیت"><span t-attf-class="ts-pill #{'ts-pill--info' if p.state == 'open' else ''}" t-out="dict(p._fields['state'].selection)[p.state]"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ================================================================ new -->
    <record id="tpl_position_new" model="ir.ui.view">
        <field name="name">TS hire: new position</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.position_new</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.position_new">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">موقعیت شغلی تازه</h1>
                                    <p class="tsp-head__help">گام ۱ از ۲: شغل مرجع را پیدا کنید. در گام بعد نیازهای آن را مرور می‌کنید.</p>
                                </div>
                            </header>
                            <form t-attf-action="/my/workspaces/#{ws.id}/positions/new" method="get" class="ts-card tsp-form tsh-search" role="search">
                                <label class="tsp-field tsp-field--wide">
                                    <span class="tsp-field__label">نام شغل را جست‌وجو کنید</span>
                                    <span class="tsh-search__row">
                                        <input type="search" name="q" t-att-value="q" minlength="2" class="form-control" placeholder="مثلاً حسابدار، فروشنده، برنامه‌نویس" autocomplete="off"/>
                                        <button type="submit" class="ts-btn ts-btn--outline">جست‌وجو</button>
                                    </span>
                                    <span class="tsp-field__hint">فارسی یا انگلیسی؛ چند واژه هم می‌شود. فهرست از پایگاه دادهٔ مشاغل O*NET است.</span>
                                </label>
                            </form>
                            <p t-if="q and not found" class="tsp-empty">شغلی با «<bdi t-out="q"/>» پیدا نشد. واژهٔ کوتاه‌تر یا هم‌معنی را امتحان کنید (مثلاً «فروش» به‌جای «فروشندگی»).</p>
                            <form t-if="found" t-attf-action="/my/workspaces/#{ws.id}/positions/new" method="post" class="ts-card tsp-form" data-tsp-once="1">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="q" t-att-value="q"/>
                                <fieldset class="tsp-field">
                                    <legend class="tsp-field__label">شغل مرجع</legend>
                                    <label t-foreach="found" t-as="o" class="tsp-radio tsh-occ">
                                        <input type="radio" name="occupation_id" t-att-value="o.id" required="required" t-att-checked="'checked' if o_index == 0 else None"/>
                                        <span><strong t-out="o.title_fa"/> <span class="ts-hint"><bdi dir="ltr" t-out="o.title_en"/></span><br/><span class="ts-hint" t-out="o.desc_fa"/></span>
                                    </label>
                                </fieldset>
                                <label class="tsp-field"><span class="tsp-field__label">عنوان موقعیت در سازمان شما</span>
                                    <input type="text" name="name" maxlength="100" required="required" class="form-control" placeholder="مثلاً کارشناس فروش شعبهٔ مرکزی"/>
                                    <span class="tsp-field__hint">داوطلبان این عنوان را در دعوت می‌بینند.</span></label>
                                <fieldset class="tsp-field">
                                    <legend class="tsp-field__label">نوع ارزیابی</legend>
                                    <label class="tsp-radio"><input type="radio" name="battery_choice" value="short" checked="checked"/><span><strong>غربالگری کوتاه</strong> (حدود ۳۰ دقیقه): پرسش‌نامهٔ سبک‌های کاری و آزمون استدلال. با گوشی هم انجام می‌شود.</span></label>
                                    <label class="tsp-radio"><input type="radio" name="battery_choice" value="full"/><span><strong>ارزیابی کامل</strong> (حدود ۵۵ دقیقه): به‌اضافهٔ آزمون عددی، تجسم فضایی و سرعت و توجه. بخش سرعت با رایانه.</span></label>
                                </fieldset>
                                <label class="tsp-field"><span class="tsp-field__label">مهلت پاسخ داوطلبان</span>
                                    <input type="date" name="deadline" t-att-value="default_deadline" class="form-control"/></label>
                                <div class="tsp-actions"><button type="submit" class="ts-btn ts-btn--primary">ادامه: مرور نیازهای شغل</button></div>
                            </form>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ================================================================ requirement profile -->
    <record id="tpl_position_profile" model="ir.ui.view">
        <field name="name">TS hire: position profile</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.position_profile</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.position_profile">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">نیازهای «<bdi t-out="p.name"/>»</h1>
                                    <p class="tsp-head__help">این نیازها از دادهٔ شغل «<t t-out="p.occupation_id.title_fa"/>» آمده است. حداکثر <t t-out="fa(max_critical)"/> مورد را «کلیدی» کنید تا وزن دوبرابر بگیرد، و موردی را که در سازمان شما واقعاً لازم نیست کنار بگذارید. همهٔ تغییرها ثبت می‌شود.</p>
                                </div>
                            </header>
                            <form t-attf-action="/my/workspaces/#{ws.id}/positions/#{p.id}/profile" method="post" class="tsh-profile" data-tsh-critical-max="3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <section class="ts-card">
                                    <h2 class="h5">سبک‌های کاری <span class="ts-hint">(از پرسش‌نامهٔ شخصیت)</span></h2>
                                    <p t-if="not styles" class="ts-hint">برای این شغل دادهٔ سبک کاری در دسترس نیست؛ تناسب فقط از آزمون‌های توانایی می‌آید.</p>
                                    <div t-if="styles" class="ts-table-wrap">
                                        <table class="ts-table tsp-table tsh-req">
                                            <thead><tr><th scope="col">سبک کاری</th><th scope="col">اهمیت برای این شغل</th><th scope="col">کلیدی</th><th scope="col">کنار گذاشتن</th></tr></thead>
                                            <tbody>
                                                <tr t-foreach="styles" t-as="r">
                                                    <th scope="row"><t t-out="r['fa']"/><span t-if="r['sign'] &lt; 0" class="ts-hint"> (این شغل به آن نیازی ندارد)</span><span t-if="r['low_conf']" class="ts-hint"> · سنجش تقریبی</span></th>
                                                    <td t-out="r['importance_fa']"/>
                                                    <td><label class="tsp-check"><input type="checkbox" name="critical" t-att-value="r['name']" t-att-checked="'checked' if r['name'] in critical else None" t-att-disabled="None if can_edit else 'disabled'"/><span class="tsp-sr">کلیدی</span></label></td>
                                                    <td><label class="tsp-check"><input type="checkbox" name="dropped" t-att-value="r['name']" t-att-checked="'checked' if r['name'] in dropped else None" t-att-disabled="None if can_edit else 'disabled'"/><span class="tsp-sr">کنار گذاشتن</span></label></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                                <section class="ts-card">
                                    <h2 class="h5">توانایی‌ها <span class="ts-hint">(از آزمون‌های زمان‌دار)</span></h2>
                                    <div t-if="abilities" class="ts-table-wrap">
                                        <table class="ts-table tsp-table tsh-req">
                                            <thead><tr><th scope="col">توانایی</th><th scope="col">اهمیت</th><th scope="col">در ارزیابی <t t-out="dict(p._fields['battery_choice'].selection)[p.battery_choice]"/></th><th scope="col">کلیدی</th><th scope="col">کنار گذاشتن</th></tr></thead>
                                            <tbody>
                                                <tr t-foreach="abilities" t-as="r">
                                                    <t t-set="measured" t-value="r['name'] in (('Inductive Reasoning', 'Information Ordering', 'Deductive Reasoning') if p.battery_choice == 'short' else ('Inductive Reasoning', 'Information Ordering', 'Deductive Reasoning', 'Visualization', 'Spatial Orientation', 'Mathematical Reasoning', 'Number Facility', 'Perceptual Speed', 'Memorization', 'Selective Attention', 'Reaction Time', 'Response Orientation'))"/>
                                                    <th scope="row" t-out="r['fa']"/>
                                                    <td t-out="r['importance_fa']"/>
                                                    <td><span t-if="measured" class="ts-pill ts-pill--info">سنجیده می‌شود</span><span t-else="" class="ts-hint">سنجیده نمی‌شود</span></td>
                                                    <td><label class="tsp-check"><input type="checkbox" name="critical" t-att-value="r['name']" t-att-checked="'checked' if r['name'] in critical else None" t-att-disabled="None if can_edit else 'disabled'"/><span class="tsp-sr">کلیدی</span></label></td>
                                                    <td><label class="tsp-check"><input type="checkbox" name="dropped" t-att-value="r['name']" t-att-checked="'checked' if r['name'] in dropped else None" t-att-disabled="None if can_edit else 'disabled'"/><span class="tsp-sr">کنار گذاشتن</span></label></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                                <section t-if="clinic" class="ts-card ts-card--soft">
                                    <h2 class="h5">نیازهای جسمی و حسی (سنجیده نمی‌شود)</h2>
                                    <p>این نیازها در استعدادیاب آزموده نمی‌شود. اگر برای این شغل مهم است، داوطلب نهایی را به مرکز طب کار معرفی کنید:</p>
                                    <ul class="tsh-chips"><li t-foreach="clinic" t-as="c" class="ts-pill" t-out="ab_fa.get(c[0], c[0])"/></ul>
                                </section>
                                <p class="tsh-live ts-hint" aria-live="polite"/>
                                <div class="tsp-actions" t-if="can_edit">
                                    <button type="submit" class="ts-btn ts-btn--primary">ذخیره و رفتن به داوطلبان</button>
                                </div>
                                <p class="ts-hint tsh-credit" t-out="credit"/>
                            </form>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ================================================================ one position: candidates -->
    <record id="tpl_position" model="ir.ui.view">
        <field name="name">TS hire: position</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.position</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.position">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title"><bdi t-out="p.name"/></h1>
                                    <p class="tsp-head__help">شغل مرجع: <t t-out="p.occupation_id.title_fa"/> · <t t-out="dict(p._fields['battery_choice'].selection)[p.battery_choice]"/><t t-if="deadline_fa"> · مهلت <t t-out="deadline_fa"/></t></p>
                                </div>
                                <div class="tsp-head__actions">
                                    <a t-attf-href="#{base}/profile" class="ts-btn ts-btn--outline">نیازهای شغل</a>
                                    <a t-if="can_fair" t-attf-href="#{base}/fairness" class="ts-btn ts-btn--quiet">بررسی منصفانه بودن</a>
                                </div>
                            </header>
                            <ul class="tsh-stats" aria-label="خلاصهٔ داوطلبان">
                                <li><strong t-out="fa(counts['invited'])"/> دعوت</li>
                                <li><strong t-out="fa(counts['going'])"/> در حال پاسخ</li>
                                <li><strong t-out="fa(counts['done'])"/> تکمیل</li>
                                <li><strong t-out="fa(counts['strong'])"/> تناسب زیاد</li>
                            </ul>
                            <p class="ts-notice tsh-note">نتیجه فقط یکی از ورودی‌های تصمیم است، در کنار مصاحبه، سوابق و نمونه‌کار. استعدادیاب هیچ داوطلبی را خودکار رد نمی‌کند و نمرهٔ برش ندارد.</p>

                            <section t-if="can_invite" class="ts-card" id="tsh-invite">
                                <h2 class="h5">دعوت داوطلب</h2>
                                <form t-attf-action="#{base}/invite" method="post" class="tsp-form" data-tsp-once="1">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <label class="tsp-field tsp-field--wide"><span class="tsp-field__label">داوطلبان (هر نفر در یک سطر)</span>
                                        <textarea name="people" rows="4" required="required" class="form-control" placeholder="مریم احمدی، ۰۹۱۲۱۲۳۴۵۶۷، maryam@example.com"/>
                                        <span class="tsp-field__hint">در هر سطر: نام، موبایل و ایمیل (هر کدام که دارید، با ویرگول جدا). تا ۵۰ نفر در هر بار.</span></label>
                                    <fieldset class="tsp-field">
                                        <legend class="tsp-field__label">ارسال دعوت</legend>
                                        <label class="tsp-check"><input type="checkbox" name="send_sms" value="1" checked="checked"/><span>پیامک (اگر موبایل وارد شده و داوطلب با دریافت پیامک موافق است)</span></label>
                                        <label class="tsp-check" t-if="email_on"><input type="checkbox" name="send_email" value="1" checked="checked"/><span>ایمیل (اگر ایمیل وارد شده است)</span></label>
                                    </fieldset>
                                    <label class="tsp-field"><span class="tsp-field__label">زمان آزمون‌ها</span>
                                        <select name="extra_time" class="form-select">
                                            <option value="1.0">عادی</option>
                                            <option value="1.25">۲۵٪ بیشتر (برای نیاز ویژه)</option>
                                            <option value="1.5">۵۰٪ بیشتر (برای نیاز ویژه)</option>
                                        </select>
                                        <span class="tsp-field__hint">زمان بیشتر را فقط برای داوطلبی بدهید که نیاز ویژهٔ تأییدشده دارد؛ در گزارش ثبت می‌شود.</span></label>
                                    <div class="tsp-actions"><button type="submit" class="ts-btn ts-btn--primary">ساخت و ارسال دعوت‌ها</button></div>
                                </form>
                            </section>
                            <p t-elif="p.state == 'closed'" class="tsp-empty">این موقعیت بسته است.</p>

                            <section class="tsh-cands" aria-labelledby="tsh-cands-h">
                                <h2 class="h5" id="tsh-cands-h">داوطلبان</h2>
                                <p t-if="not rows" class="tsp-empty">هنوز داوطلبی دعوت نشده است.</p>
                                <form t-if="rows" t-attf-action="#{base}/compare" method="get" class="tsh-compare-form">
                                    <div class="ts-table-wrap">
                                        <table class="ts-table tsp-table tsp-table--cards tsh-table">
                                            <caption class="tsp-sr">داوطلبان به ترتیب تناسب؛ داوطلبانی که هنوز تمام نکرده‌اند پایین‌تر</caption>
                                            <thead><tr><th scope="col"><span class="tsp-sr">انتخاب برای مقایسه</span></th><th scope="col">داوطلب</th><th scope="col">تناسب شغلی</th><th scope="col">سبک کاری</th><th scope="col">توانایی</th><th scope="col">وضعیت</th><th scope="col">تصمیم</th></tr></thead>
                                            <tbody>
                                                <tr t-foreach="rows" t-as="r">
                                                    <td data-label="مقایسه"><input t-if="r['res']" type="checkbox" name="ids" t-att-value="r['a'].id" class="tsh-cmp" t-att-aria-label="'انتخاب %s برای مقایسه' % r['a'].invitee_name"/></td>
                                                    <th scope="row" data-label="داوطلب"><a t-attf-href="#{base}/c/#{r['a'].id}"><bdi t-out="r['a'].invitee_name"/></a>
                                                        <span t-if="r['flags']" class="ts-pill ts-pill--warn tsh-flag" title="نشانه‌های دقت پاسخ‌دهی؛ در صفحهٔ داوطلب">نیاز به دقت</span></th>
                                                    <td data-label="تناسب شغلی"><span t-if="r['band']" t-attf-class="tsh-band tsh-band--#{r['band']}" t-out="r['band_fa']"/><span t-elif="r['level'] == 'summary'" class="ts-hint">شواهد کافی نیست</span><span t-else="" class="ts-hint">—</span></td>
                                                    <td data-label="سبک کاری"><span t-if="r['ws_band']" t-attf-class="tsh-dot tsh-dot--#{r['ws_band']}" t-out="{'strong': 'زیاد', 'moderate': 'متوسط', 'limited': 'کم'}[r['ws_band']]"/></td>
                                                    <td data-label="توانایی"><span t-if="r['ab_band']" t-attf-class="tsh-dot tsh-dot--#{r['ab_band']}" t-out="{'strong': 'زیاد', 'moderate': 'متوسط', 'limited': 'کم'}[r['ab_band']]"/><span t-elif="r['res']" class="ts-hint">سنجیده نشده</span></td>
                                                    <td data-label="وضعیت"><t t-out="r['state']"/><t t-if="r['progress'] and not r['complete'] and r['progress'][1]"> · <t t-out="fa(r['progress'][0])"/> از <t t-out="fa(r['progress'][1])"/></t><t t-if="r['level'] == 'status' and r['a'].state == 'done'"><br/><span class="ts-hint">نتیجه به اشتراک گذاشته نشده</span></t></td>
                                                    <td data-label="تصمیم" t-out="r['decision']"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="tsp-actions"><button type="submit" class="ts-btn ts-btn--outline tsh-compare-btn">مقایسهٔ داوطلبان انتخاب‌شده (۲ یا ۳ نفر)</button></div>
                                </form>
                            </section>
                            <form t-attf-action="#{base}/state" method="post" class="tsh-state">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button t-if="p.state == 'open'" type="submit" name="state" value="closed" class="ts-btn ts-btn--quiet">بستن موقعیت</button>
                                <button t-elif="p.state == 'closed'" type="submit" name="state" value="open" class="ts-btn ts-btn--quiet">باز کردن دوبارهٔ موقعیت</button>
                            </form>
                            <p class="ts-hint tsh-credit" t-out="credit"/>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ================================================================ one candidate -->
    <record id="tpl_candidate" model="ir.ui.view">
        <field name="name">TS hire: candidate</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.candidate</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.candidate">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <t t-set="res" t-value="r['res']"/>
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title"><bdi t-out="a.invitee_name"/></h1>
                                    <p class="tsp-head__help">برای «<bdi t-out="p.name"/>» · شغل مرجع: <t t-out="p.occupation_id.title_fa"/> · <t t-out="r['state']"/></p>
                                </div>
                                <div class="tsh-verdict" t-if="res">
                                    <span t-if="res['band']" t-attf-class="tsh-band tsh-band--#{res['band']} tsh-band--lg" t-out="r['band_fa']"/>
                                    <span t-else="" class="ts-hint">شواهد کافی نیست</span>
                                    <span t-if="res['personality_only']" class="ts-hint">فقط از پرسش‌نامهٔ شخصیت</span>
                                </div>
                            </header>
                            <p class="ts-notice tsh-note">این خلاصه فقط یکی از ورودی‌های تصمیم است. پاسخ‌ها، نمره‌ها و متن‌های شخصی داوطلب به شما نمایش داده نمی‌شود.</p>

                            <t t-if="r['level'] != 'summary'">
                                <section class="ts-card">
                                    <p t-if="a.state == 'done'">داوطلب ارزیابی را تمام کرده، اما اشتراک نتیجه را نپذیرفته یا لغو کرده است.</p>
                                    <p t-elif="r['progress'] and r['progress'][1]">داوطلب <t t-out="fa(r['progress'][0])"/> بخش از <t t-out="fa(r['progress'][1])"/> بخش را تمام کرده است.</p>
                                    <p t-else="">داوطلب هنوز ارزیابی را شروع نکرده است.</p>
                                    <div t-if="url" class="tsh-link">
                                        <span class="tsp-field__label">پیوند دعوت</span>
                                        <input type="text" readonly="readonly" class="form-control" dir="ltr" t-att-value="url" aria-label="پیوند دعوت" id="tsh-link"/>
                                        <button type="button" class="ts-btn ts-btn--outline ts-btn--sm" data-tsp-copy="tsh-link">کپی پیوند</button>
                                    </div>
                                    <form t-if="can_decide and a.state not in ('done', 'withdrawn', 'declined')" t-attf-action="#{base}/c/#{a.id}/remind" method="post" class="tsp-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="ts-btn ts-btn--quiet">فرستادن یادآوری</button>
                                    </form>
                                </section>
                            </t>
                            <t t-else="">
                                <t t-set="ex" t-value="r['explain']"/>
                                <div class="tsh-grid">
                                    <section class="ts-card" t-if="ex['why']">
                                        <h2 class="h5 tsh-h--ok">آنچه با نیازهای شغل جور است</h2>
                                        <ul class="tsh-list"><li t-foreach="ex['why']" t-as="x" t-out="x"/></ul>
                                    </section>
                                    <section class="ts-card" t-if="ex['watch']">
                                        <h2 class="h5 tsh-h--warn">آنچه در مصاحبه بپرسید</h2>
                                        <ul class="tsh-list"><li t-foreach="ex['watch']" t-as="x" t-out="x"/></ul>
                                    </section>
                                </div>
                                <section t-if="r['flags']" class="ts-notice ts-notice--warn" role="status">
                                    <p><strong>نشانه‌های دقت پاسخ‌دهی:</strong> نتیجه را با احتیاط بیشتری بخوانید و در مصاحبه بررسی کنید. این نشانه‌ها به‌تنهایی دلیل رد نیست.</p>
                                    <ul><li t-foreach="r['flags']" t-as="f" t-out="f"/></ul>
                                </section>
                                <section class="ts-card" t-if="res['ws']">
                                    <h2 class="h5">سبک‌های کاری <span t-attf-class="tsh-dot tsh-dot--#{res['ws']['band']}" t-out="{'strong': 'زیاد', 'moderate': 'متوسط', 'limited': 'کم'}[res['ws']['band']]"/></h2>
                                    <p class="ts-hint">«نقطهٔ قوت نسبی» یعنی این ویژگی در داوطلب از دیگر ویژگی‌هایش پررنگ‌تر است؛ مقایسه با دیگر داوطلبان نیست.</p>
                                    <div class="ts-table-wrap"><table class="ts-table tsp-table tsh-req">
                                        <thead><tr><th scope="col">نیاز شغل</th><th scope="col">اهمیت</th><th scope="col">در داوطلب</th></tr></thead>
                                        <tbody><tr t-foreach="res['ws']['rows']" t-as="x">
                                            <th scope="row"><t t-out="x['fa']"/><span t-if="x['critical']" class="ts-pill ts-pill--info tsh-crit">کلیدی</span></th>
                                            <td t-out="x['importance_fa']"/>
                                            <td><span t-attf-class="tsh-st tsh-st--#{x['status']}" t-out="st_labels[x['status']]"/></td>
                                        </tr></tbody>
                                    </table></div>
                                </section>
                                <section class="ts-card">
                                    <h2 class="h5">توانایی‌ها <span t-if="res['ab']['band']" t-attf-class="tsh-dot tsh-dot--#{res['ab']['band']}" t-out="{'strong': 'زیاد', 'moderate': 'متوسط', 'limited': 'کم'}[res['ab']['band']]"/></h2>
                                    <p t-if="not res['ab']['rows']" class="ts-hint">آزمون‌های توانایی هنوز تمام نشده یا برای این شغل سنجیده نمی‌شود.</p>
                                    <div t-if="res['ab']['rows']" class="ts-table-wrap"><table class="ts-table tsp-table tsh-req">
                                        <thead><tr><th scope="col">نیاز شغل</th><th scope="col">اهمیت</th><th scope="col">در داوطلب</th></tr></thead>
                                        <tbody><tr t-foreach="res['ab']['rows']" t-as="x">
                                            <th scope="row"><t t-out="x['fa']"/><span t-if="x['critical']" class="ts-pill ts-pill--info tsh-crit">کلیدی</span></th>
                                            <td t-out="x['importance_fa']"/>
                                            <td><span t-attf-class="tsh-st tsh-st--#{x['status']}" t-out="st_labels[x['status']]"/></td>
                                        </tr></tbody>
                                    </table></div>
                                    <p t-if="ex['unmeasured']" class="ts-hint">توانایی‌های مهمِ سنجیده‌نشده: <t t-out="'، '.join(ex['unmeasured'])"/>. این‌ها را در مصاحبه یا کار نمونه ببینید.</p>
                                    <p class="ts-hint">مقایسهٔ توانایی‌ها برآورد موقت است و با جمع شدن داده‌های داوطلبان ایرانی دقیق‌تر می‌شود.</p>
                                </section>
                                <section t-if="res['clinic']" class="ts-card ts-card--soft">
                                    <h2 class="h5">معرفی به طب کار</h2>
                                    <p>این نیازهای جسمی و حسی در استعدادیاب سنجیده نمی‌شود. اگر داوطلب را برای این شغل جدی می‌گیرید، فهرست را همراه معرفی‌نامه به مرکز طب کار بدهید:</p>
                                    <ul class="tsh-chips"><li t-foreach="res['clinic']" t-as="c" class="ts-pill" t-out="c['fa']"/></ul>
                                </section>
                                <p t-if="a.ts_extra_time and a.ts_extra_time != '1.0'" class="ts-hint">این داوطلب آزمون‌ها را با زمان بیشتر (<t t-out="dict(a._fields['ts_extra_time'].selection)[a.ts_extra_time]"/>) انجام داده است.</p>
                            </t>

                            <section class="ts-card" t-if="can_invite and a.user_id and a.ts_hire_complete">
                                <h2 class="h5">آزمون تأیید حضوری</h2>
                                <p class="ts-hint">پیش از تصمیم نهایی، داوطلب یک آزمون استدلال کوتاه با پرسش‌های تازه را در سازمان شما و زیر نظر شما انجام می‌دهد. افت زیاد نسبت به آزمون اول نشانه‌ای برای بررسی است.</p>
                                <t t-if="ver">
                                    <p>وضعیت: <t t-out="dict(ver._fields['state'].selection).get(ver.state)"/></p>
                                    <div t-if="ver.state in ('invited', 'opened')" class="tsh-link">
                                        <input type="text" readonly="readonly" class="form-control" dir="ltr" t-att-value="ver.invite_url()" aria-label="پیوند آزمون تأیید" id="tsh-vlink"/>
                                        <button type="button" class="ts-btn ts-btn--outline ts-btn--sm" data-tsp-copy="tsh-vlink">کپی پیوند</button>
                                    </div>
                                </t>
                                <form t-else="" t-attf-action="#{base}/c/#{a.id}/verify" method="post" class="tsp-inline">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="ts-btn ts-btn--outline">ساخت آزمون تأیید</button>
                                </form>
                            </section>

                            <section class="ts-card" t-if="can_decide">
                                <h2 class="h5">تصمیم شما</h2>
                                <form t-attf-action="#{base}/c/#{a.id}/decision" method="post" class="tsp-form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <fieldset class="tsp-field tsh-decisions">
                                        <legend class="tsp-sr">تصمیم</legend>
                                        <label t-foreach="decisions" t-as="d" class="tsp-radio"><input type="radio" name="decision" t-att-value="d[0]" t-att-checked="'checked' if (a.hire_decision or 'none') == d[0] else None"/><span t-out="d[1]"/></label>
                                    </fieldset>
                                    <label class="tsp-field tsp-field--wide"><span class="tsp-field__label">یادداشت (اختیاری، برای همکاران)</span>
                                        <input type="text" name="note" maxlength="200" class="form-control" t-att-value="a.decision_note"/></label>
                                    <div class="tsp-actions"><button type="submit" class="ts-btn ts-btn--primary">ثبت تصمیم</button></div>
                                    <p t-if="a.decision_at" class="ts-hint">آخرین تصمیم: <t t-out="jalali(a.decision_at)"/> · <t t-out="a.decision_by_id.name"/></p>
                                </form>
                            </section>
                            <section class="tsh-method" aria-labelledby="tsh-method-h">
                                <h2 class="h6" id="tsh-method-h">روش و محدودیت‌ها</h2>
                                <p class="ts-hint">تناسب از دو بخش می‌آید: سبک‌های کاری (پرسش‌نامهٔ شخصیت، مقایسهٔ ویژگی‌های هر داوطلب با خودش) و توانایی‌ها (آزمون‌های زمان‌دار، مقایسه با سطح لازم برای این شغل در میان مشاغل). بازه‌ها هنوز با عملکرد شغلی در ایران اعتبارسنجی نشده‌اند و نمرهٔ برش نیستند.</p>
                                <p class="ts-hint">مدل <bdi dir="ltr" t-out="model"/>. <t t-out="credit"/></p>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ================================================================ compare -->
    <record id="tpl_compare" model="ir.ui.view">
        <field name="name">TS hire: compare</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.compare</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.compare">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">مقایسهٔ داوطلبان</h1>
                                    <p class="tsp-head__help">برای «<bdi t-out="p.name"/>». هر ستون یک داوطلب؛ هر سطر یک نیاز شغل.</p>
                                </div>
                            </header>
                            <div class="ts-table-wrap">
                                <table class="ts-table tsp-table tsh-cmp-table">
                                    <thead><tr><th scope="col">نیاز شغل</th><th t-foreach="rows" t-as="r" scope="col"><a t-attf-href="/my/workspaces/#{ws.id}/positions/#{p.id}/c/#{r['a'].id}"><bdi t-out="r['a'].invitee_name"/></a></th></tr></thead>
                                    <tbody>
                                        <tr class="tsh-cmp-total"><th scope="row">تناسب شغلی</th><td t-foreach="rows" t-as="r"><span t-if="r['band']" t-attf-class="tsh-band tsh-band--#{r['band']}" t-out="r['band_fa']"/><span t-if="r['flags']" class="ts-pill ts-pill--warn tsh-flag">نیاز به دقت</span></td></tr>
                                        <t t-foreach="reqs" t-as="q">
                                            <tr>
                                                <th scope="row"><t t-out="q['fa']"/><span class="ts-hint"> · <t t-out="q['importance_fa']"/></span><span t-if="q['critical']" class="ts-pill ts-pill--info tsh-crit">کلیدی</span></th>
                                                <td t-foreach="rows" t-as="r">
                                                    <t t-set="part" t-value="(r['res']['ws'] or {}) if q['kind'] == 'WS' else r['res']['ab']"/>
                                                    <t t-set="hit" t-value="[x for x in part.get('rows', []) if x['name'] == q['name']]"/>
                                                    <span t-if="hit" t-attf-class="tsh-st tsh-st--#{hit[0]['status']}" t-out="st_labels[hit[0]['status']]"/>
                                                    <span t-else="" class="ts-hint">سنجیده نشده</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <p class="ts-hint">مقایسه فقط برای کمک به برنامه‌ریزی مصاحبه است. تفاوت‌های کوچک معنادار نیست.</p>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- ================================================================ fairness -->
    <record id="tpl_fairness" model="ir.ui.view">
        <field name="name">TS hire: fairness</field>
        <field name="type">qweb</field>
        <field name="key">ts_hire.fairness</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_hire.fairness">
                <t t-call="website.layout" additional_title="title">
                    <div id="wrap" class="ts-page">
                        <t t-call="ts_panel.shell_frame">
                            <header class="tsp-head">
                                <div>
                                    <h1 class="tsp-head__title">بررسی منصفانه بودن</h1>
                                    <p class="tsp-head__help">نرخ انتخاب (فهرست کوتاه، مصاحبه یا استخدام) در گروه‌های جنسیت و سن، بر پایهٔ تصمیم‌های ثبت‌شده برای «<bdi t-out="p.name"/>». پاسخ داوطلبان به این دو پرسش اختیاری است و هیچ‌وقت برای یک فرد نمایش داده نمی‌شود.</p>
                                </div>
                            </header>
                            <t t-foreach="[('ts_gender', 'جنسیت'), ('ts_age_band', 'گروه سنی')]" t-as="g">
                                <t t-set="f" t-value="fair[g[0]]"/>
                                <section class="ts-card">
                                    <h2 class="h5" t-out="g[1]"/>
                                    <p t-if="not f['rows']" class="ts-hint">هنوز داده کافی نیست: دست‌کم دو گروه با پنج نفر یا بیشتر که برایشان تصمیم ثبت شده باشد. (<t t-out="fa(f['decided'])"/> تصمیم ثبت شده.)</p>
                                    <div t-if="f['rows']" class="ts-table-wrap"><table class="ts-table tsp-table">
                                        <thead><tr><th scope="col">گروه</th><th scope="col">تعداد</th><th scope="col">نرخ انتخاب</th><th scope="col">نسبت به بالاترین گروه</th></tr></thead>
                                        <tbody><tr t-foreach="f['rows']" t-as="x">
                                            <th scope="row" t-out="x['label']"/>
                                            <td class="ts-num" t-out="fa(x['n'])"/>
                                            <td class="ts-num" t-out="fa(int(round(100 * x['rate'])))+'٪'"/>
                                            <td><span class="ts-num" t-out="fa(int(round(100 * x['ratio'])))+'٪'"/><span t-if="x['flag']" class="ts-pill ts-pill--warn"> کمتر از ۸۰٪</span></td>
                                        </tr></tbody>
                                    </table></div>
                                    <p t-if="f['hidden']" class="ts-hint"><t t-out="fa(f['hidden'])"/> گروه به دلیل تعداد کم نمایش داده نشد.</p>
                                </section>
                            </t>
                            <p class="ts-hint">قاعدهٔ چهارپنجم: اگر نرخ انتخاب گروهی کمتر از ۸۰٪ نرخ بالاترین گروه باشد، شیوهٔ تصمیم‌گیری را بازبینی کنید. این نشانه است، نه حکم؛ در گروه‌های کوچک تفاوت‌ها ممکن است تصادفی باشد.</p>
                        </t>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
