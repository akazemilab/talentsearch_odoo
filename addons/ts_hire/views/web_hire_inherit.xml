<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invitation page of a position (UX T7, audit P26). ONE description of what the employer sees, taken from the code:
         ts_org result_level() gives an employment member with results:summary the level 'summary' only when the candidate
         shared; at that level the position pages (controllers/positions.py _row) show the job-fit summary (overall
         band, each job need as a relative strength / meets the need / lower) and the integrity signals
         (ts_validity_labels), and the panel's battery result page shows the band of each factor (no scores, answers or
         texts). Without the tick the employer sees the state and progress only. The tick, the «what is seen» list and
         the card below say exactly that. onb2: the full list is ts_hire.position_terms (also the «بیشتر» of the welcome
         screen); the optional fairness questions are asked once after the last part (ts_hire.fair), not here. -->
    <record id="invite_position" model="ir.ui.view">
        <field name="name">ts_hire.invite</field>
        <field name="inherit_id" ref="ts_org.tpl_invite"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='ts_org.share_box']" position="after">
                <section t-if="a.position_id" class="ts-card tsh-invite" aria-labelledby="tsh-inv-h">
                    <h2 class="h5" id="tsh-inv-h">ارزیابی برای موقعیت «<bdi t-out="a.position_id.name"/>»</h2>
                    <t t-call="ts_hire.position_terms"/>
                </section>
            </xpath>
        </field>
    </record>

    <!-- The tick of a job application (ts_org.share_tick, shared by /invite and the open link /c; share_pos = the position) -->
    <record id="share_tick_position" model="ir.ui.view">
        <field name="name">ts_hire.share_tick</field>
        <field name="inherit_id" ref="ts_org.tpl_share_tick"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//label[hasclass('ts-check')]/span[@t-elif=&quot;share_ws.purpose == 'employment'&quot;]" position="before">
                <span t-elif="share_ws.purpose == 'employment' and share_pos">اجازه می‌دهم «<bdi t-out="share_ws.ts_public_name()"/>» سطح هر عامل، خلاصهٔ تناسبم با این شغل و نشانه‌های دقت پاسخ‌دهی را ببیند.</span>
            </xpath>
        </field>
    </record>

    <!-- «What is seen» of a job application: the same facts as the tick and the code (see invite_position above). -->
    <record id="share_box_position" model="ir.ui.view">
        <field name="name">ts_hire.share_box</field>
        <field name="inherit_id" ref="ts_org.tpl_share_box"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//ul[@t-elif=&quot;share_ws.purpose == 'employment'&quot;]" position="before">
                <ul class="ts-list-check" t-elif="share_ws.purpose == 'employment' and share_pos">
                    <li>سازمان وضعیت ارزیابی را می‌بیند: شروع‌شده، چند بخش تمام‌شده یا تمام‌شده.</li>
                    <li>اگر اجازه دهید، این‌ها را هم می‌بیند: سطح هر عامل (کم، متوسط یا زیاد)؛ خلاصهٔ تناسب شما با نیازهای این شغل (سطح تناسب کلی، و اینکه هر نیاز شغل در شما پررنگ است یا کم‌رنگ‌تر)؛ و نشانه‌های دقت پاسخ‌دهی (مثلاً پاسخ‌های بسیار سریع).</li>
                    <li>پاسخ‌ها، نمره‌ها و متن‌های گزارش شما را نمی‌بیند.</li>
                    <li>هر زمان بخواهید می‌توانید اشتراک‌گذاری را از صفحهٔ گزارش قطع کنید.</li>
                </ul>
            </xpath>
        </field>
    </record>

    <!-- Consent/review «who sees» line of a job application (T7 integrator, A handoff W2): the same facts as the tick and
         the share list above (code: positions.py _row + the battery panel page at level 'summary'). A factual
         correction of what the page says; the consent version is unchanged. -->
    <record id="who_sees_position" model="ir.ui.view">
        <field name="name">ts_hire.who_sees</field>
        <field name="inherit_id" ref="ts_panel.who_sees_line"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!-- CONSENT v5 (2026-10-13, plain language, as ts_panel.who_sees_line): the object first, one subject per verb -->
            <xpath expr="//t[@t-elif=&quot;asg.workspace_id.purpose == 'clinical'&quot;]" position="after">
                <t t-elif="asg.position_id">گزارش کامل را خودتان می‌بینید؛ <strong t-out="org"/> سطح هر عامل (کم، متوسط یا زیاد)، خلاصهٔ تناسب شما با این شغل و نشانه‌های دقت پاسخ‌دهی را می‌بیند، نه پاسخ‌ها، نمره‌ها یا متن گزارش.</t>
            </xpath>
        </field>
    </record>

    <!-- Battery result page of a position: candidate feedback card -->
    <record id="my_battery_feedback" model="ir.ui.view">
        <field name="name">ts_hire.my_battery</field>
        <field name="inherit_id" ref="ts_battery.tpl_my_battery"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//p[hasclass('tsb-note')]" position="after">
                <section t-if="hire_feedback" class="ts-card tsh-feedback" aria-labelledby="tsh-fb-h">
                    <h2 class="h5" id="tsh-fb-h">بازخورد شما</h2>
                    <t t-if="hire_feedback['strengths']">
                        <p>پررنگ‌ترین سبک‌های کاری شما در این پرسش‌نامه:</p>
                        <ul class="tsh-list">
                            <li t-foreach="hire_feedback['strengths']" t-as="s"><strong t-out="s['name']"/>: <t t-out="s['text']"/></li>
                        </ul>
                    </t>
                    <t t-if="hire_feedback['abilities']">
                        <p>جایگاه شما در آزمون‌های زمان‌دار، در مقایسه با دیگر شرکت‌کنندگان:</p>
                        <ul class="tsh-chips">
                            <li t-foreach="hire_feedback['abilities']" t-as="b" t-attf-class="ts-pill tsh-ab tsh-ab--#{b['band']}"><t t-out="b['name']"/>: <t t-out="b['band_fa']"/></li>
                        </ul>
                    </t>
                    <p class="ts-hint">یک ارزیابی کوتاه همهٔ توانایی‌ها و ویژگی‌های شما را نشان نمی‌دهد. اگر دربارهٔ نتیجه پرسشی دارید، از سازمان دعوت‌کننده توضیح بخواهید.</p>
                </section>
            </xpath>
        </field>
    </record>

    <!-- Panel menu icon for positions -->
    <record id="nav_icon_positions" model="ir.ui.view">
        <field name="name">ts_hire.nav_icon</field>
        <field name="inherit_id" ref="ts_panel.tpl_nav_icon"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-elif=&quot;key == 'invites'&quot;]" position="after">
                <t t-elif="key == 'positions'"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></t>
            </xpath>
        </field>
    </record>
</odoo>
