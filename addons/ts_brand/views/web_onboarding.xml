<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- What stays of the clinic phase 6 set-up guide after onb3 (models/onboarding.py): the counselor's first-run card and
         the help section. The six-step list «راه‌اندازی مرکز» gave way to ts_onboard's «شروع کار» and «پنل را کامل کنید»
         cards. Website 4 only; each xpath names an anchor of its parent's own arch. -->

    <!-- First-run card of a counselor whose report identity is empty (no title). Context: member, ws; optional tsob_card. -->
    <record id="tpl_onboarding_card" model="ir.ui.view">
        <field name="name">TS brand: counselor first-run card</field>
        <field name="type">qweb</field>
        <field name="key">ts_brand.onboarding_card</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_brand.onboarding_card">
                <t t-if="tsob_card is None"><t t-set="tsob_card" t-value="member.ts_onb_card()"/></t>
                <section t-if="tsob_card" class="ts-card tsob-card" id="tsob-card" aria-labelledby="tsob-card-h">
                    <h2 id="tsob-card-h" class="h5">هویت شما در گزارش‌ها را کامل کنید</h2>
                    <p>عنوان حرفه‌ای و عکس شما بالای گزارش مراجعانی می‌آید که مشاورشان هستید و معرفی کوتاهتان در پایان آن. شماره یا نشانی تماس شما در گزارش نمی‌آید.</p>
                    <div class="tsob-step__actions">
                        <a t-attf-href="/my/workspaces/#{ws.id}/members/#{member.id}#tsbr-member" class="ts-btn ts-btn--primary tsob-btn">تکمیل هویت</a>
                        <form t-attf-action="/my/workspaces/#{ws.id}/onboarding/card-hide" method="post" data-tsp-once="1">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="ts-btn ts-btn--quiet tsob-btn">بعداً نشانم نده</button>
                        </form>
                    </div>
                </section>
            </t>
        </field>
    </record>

    <!-- ===================================================== dashboard: the counselor's card above the empty state. It is
         computed before the page header, so the header can drop its primary «دعوت تازه» while it is shown (first_run: one
         primary button on the page, UX audit G8-P8-3). -->
    <record id="dashboard_onboarding" model="ir.ui.view">
        <field name="name">ts_brand.dashboard.onboarding</field>
        <field name="inherit_id" ref="ts_panel.tpl_dashboard"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//header[hasclass('tsp-head')]" position="before">
                <t t-set="tsob_card" t-value="member.ts_onb_card()"/>
                <t t-set="first_run" t-value="bool(tsob_card)"/>
            </xpath>
            <xpath expr="//div[hasclass('tsp-dash-empty')]" position="before">
                <t t-call="ts_brand.onboarding_card"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== state page: a counselor waiting for verification sees the card -->
    <record id="state_page_onboarding" model="ir.ui.view">
        <field name="name">ts_brand.state_page.onboarding</field>
        <field name="inherit_id" ref="ts_panel.tpl_state_page"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('tsp-empty')]" position="after">
                <t t-call="ts_brand.onboarding_card"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== help center: «پنل مرکز مشاوره را کامل کنید» (#center-setup; the
         anchor keeps older links working). Place names are the panel navigation labels, verbatim. -->
    <record id="help_center_setup" model="ir.ui.view">
        <field name="name">ts_brand.help.center_setup</field>
        <field name="inherit_id" ref="ts_panel.tpl_help_panel"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//a[@href='#credits']/.." position="after">
                <li><a href="#center-setup">کامل کردن پنل مرکز مشاوره</a></li>
            </xpath>
            <xpath expr="//article[@id='credits']" position="after">
                <article class="ts-card tsob-help" id="center-setup">
                    <!-- hb: the reader's own counseling-center panel (signed-in member of exactly one), so each place name
                         is a link; otherwise plain text. -->
                    <t t-set="hb" t-value="('/my/workspaces/%s' % tsob_ws.id) if tsob_ws else ''"/>
                    <h2>کامل کردن پنل مرکز مشاوره</h2>
                    <p>پنل مرکز مشاوره همان لحظهٔ ساخت فعال است. پس از نخستین نتیجه‌ای که در پنل باز می‌کنید، کارت «پنل را کامل کنید» در «پیشخوان» دیده می‌شود. همهٔ کارهای آن اختیاری است و هر کدام از روی اطلاعات خود پنل تیک می‌خورد، نه با تیک دستی. با «بعداً» کارت فقط برای شما پنهان می‌شود.</p>
                    <h3 id="center-setup-identity">نام و لوگو روی گزارش</h3>
                    <p>در <a t-if="hb" t-att-href="hb + '/settings#tsbr-org'">«تنظیمات»</a><t t-else="">«تنظیمات»</t>، بخش «هویت مرکز در گزارش‌ها»، نام مرکز و لوگو را ثبت کنید. این دو بالای گزارش هر مراجع، در صفحه و در فایل PDF، می‌آیند.</p>
                    <h3 id="center-setup-counselors">دعوت همکاران</h3>
                    <p>در <a t-if="hb" t-att-href="hb + '/members#tsp-invite'">«اعضا و نقش‌ها»</a><t t-else="">«اعضا و نقش‌ها»</t>، بخش «دعوت همکار»، مشاوران مرکز را با شمارهٔ موبایلشان دعوت کنید. استعدادیاب پیامک دعوت را برای همکار می‌فرستد؛ همکار با همان شماره وارد می‌شود و می‌پیوندد. شمارهٔ پروانه هنگام پیوستن لازم نیست.</p>
                    <h3 id="center-setup-sms">نام پیامکی</h3>
                    <p>در همان بخش «هویت مرکز در گزارش‌ها»، «نام کوتاه در پیامک» را بنویسید (تا ۱۸ نویسه). سطر اول پیامک‌های دعوت همین نام است.</p>
                    <h3 id="center-setup-credit">اعتبار و قیمت‌ها (پنل پیش‌پرداخت)</h3>
                    <p>در پنل پیش‌پرداخت، هر دعوت هزینهٔ سنجه یا مجموعه را از اعتبار پنل رزرو می‌کند و با تکمیل آن کسر می‌شود؛ اگر دعوت منقضی، لغو یا رد شود، رزرو آزاد می‌شود. شارژ اعتبار با فاکتوری است که تیم استعدادیاب صادر می‌کند؛ از <a t-if="tsob_ws" t-att-href="tsob_ws.ts_topup_request_url()">همین پیوند</a><a t-else="" href="/contact?topic=credit">همین پیوند</a> درخواست بدهید. موجودی، قیمت‌ها و فاکتورها در <a t-if="hb" t-att-href="hb + '/credits'">«اعتبار و مصرف»</a><t t-else="">«اعتبار و مصرف»</t> است.</p>
                    <h3 id="center-setup-caps">سقف‌ها (پنل پیش‌پرداخت)</h3>
                    <p>در <a t-if="hb" t-att-href="hb + '/credits#tsb-caps'">«اعتبار و مصرف»</a><t t-else="">«اعتبار و مصرف»</t> برای هر مشاور سقفی به تومان می‌گذارید؛ دعوتی که از سقفِ ماه شمسی بگذرد فرستاده نمی‌شود. اگر سقف نمی‌خواهید، در کارت «بدون سقف بماند» را بزنید.</p>
                    <h3 id="center-setup-licence">پروانه</h3>
                    <p>هر مشاور، و مالکی که خودش مشاوره می‌دهد، شمارهٔ پروانه یا نظام روان‌شناسی و مشاورهٔ خود را در صفحهٔ خودش، بخش «هویت شما در گزارش‌ها»، می‌نویسد. تیم استعدادیاب شماره را بررسی می‌کند و پس از آن نشان «پروانهٔ تأییدشده» کنار نام و در سربرگ گزارش‌ها می‌آید. این بررسی فقط یک نشان است، نه شرط کار.</p>
                    <p t-if="tsob_public" class="tsob-help__start">برای شروع، <a href="/my/workspaces/new?kind=clinic">پنل مرکز مشاوره بسازید</a>؛ در دورهٔ آزمایشی رایگان است و همان لحظه فعال می‌شود.</p>
                </article>
            </xpath>
        </field>
    </record>
</odoo>
