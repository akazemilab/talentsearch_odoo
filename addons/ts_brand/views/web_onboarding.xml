<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clinic phase 6: the set-up guide of a counseling-center panel (models/onboarding.py). Website 4 only. Values come
         from member.ts_onb_checklist() / member.ts_onb_card(); every button points at an existing page that keeps its own
         permission check. Each xpath names an anchor of its parent's own arch. -->

    <!-- «راه‌اندازی مرکز»: owner / admin / clinic director of a counseling-center panel. Context: member, ws, fa. -->
    <record id="tpl_onboarding_checklist" model="ir.ui.view">
        <field name="name">TS brand: center set-up checklist</field>
        <field name="type">qweb</field>
        <field name="key">ts_brand.onboarding_checklist</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_brand.onboarding_checklist">
                <t t-set="tsob" t-value="member.ts_onb_checklist()"/>
                <section t-if="tsob" class="ts-card tsob" id="tsob" aria-labelledby="tsob-h" data-tsob="1">
                    <div class="tsob__head">
                        <h2 id="tsob-h" class="h5">راه‌اندازی مرکز</h2>
                        <a t-att-href="tsob['help_url']" class="tsob__help">راهنمای راه‌اندازی مرکز مشاوره</a>
                    </div>
                    <p class="tsob__progress" id="tsob-progress"><strong><t t-out="fa(tsob['done_n'])"/> از <t t-out="fa(tsob['total'])"/> انجام شده</strong></p>
                    <span class="tsob__bar" aria-hidden="true"><span class="tsob__fill" t-attf-style="inline-size: #{round(100.0 * tsob['done_n'] / tsob['total'])}%"></span></span>
                    <button type="button" class="tsob__toggle" aria-expanded="true" aria-controls="tsob-list" data-tsob-toggle="1" hidden="hidden">گام‌ها (<t t-out="fa(tsob['open_n'])"/> گام مانده)</button>
                    <ol class="tsob__list" id="tsob-list" aria-describedby="tsob-progress">
                        <li t-foreach="tsob['steps']" t-as="s" t-attf-class="tsob-step tsob-step--#{s['state']}" t-att-data-tsob-step="s['key']">
                            <span class="tsob-step__ico" aria-hidden="true"></span>
                            <div class="tsob-step__body">
                                <p class="tsob-step__title">
                                    <strong t-out="s['label']"/>
                                    <span t-if="s['optional']" class="tsob-tag">اختیاری</span>
                                    <span t-if="s['state'] == 'done'" class="tsob-tag tsob-tag--ok">انجام شد</span>
                                    <span t-elif="s['state'] == 'way'" class="tsob-tag tsob-tag--way">در راه</span>
                                    <span t-else="" class="tsp-sr">مانده</span>
                                </p>
                                <p t-if="not s['done']" class="tsob-step__why" t-out="s['why']"/>
                                <p t-if="s['note']" class="tsob-step__note" t-out="s['note']"/>
                                <div t-if="s['url'] or s['nocap']" class="tsob-step__actions">
                                    <a t-if="s['url']" t-att-href="s['url']" class="ts-btn ts-btn--outline tsob-btn" t-out="s['btn']"/>
                                    <form t-if="s['nocap']" t-attf-action="/my/workspaces/#{ws.id}/onboarding/nocap" method="post" data-tsp-once="1">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="ts-btn ts-btn--quiet tsob-btn">بدون سقف بماند</button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    </ol>
                    <form t-attf-action="/my/workspaces/#{ws.id}/onboarding/hide" method="post" class="tsob__hide" data-tsp-once="1">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="ts-btn ts-btn--quiet tsob-btn" aria-describedby="tsob-hide-h">بعداً نشانم نده</button>
                        <span class="ts-hint" id="tsob-hide-h">فقط برای شما پنهان می‌شود؛ از راهنمای پنل دوباره نمایانش کنید.</span>
                    </form>
                </section>
            </t>
        </field>
    </record>

    <!-- First-run card of a counselor whose report identity is empty (no title). Context: member, ws. -->
    <record id="tpl_onboarding_card" model="ir.ui.view">
        <field name="name">TS brand: counselor first-run card</field>
        <field name="type">qweb</field>
        <field name="key">ts_brand.onboarding_card</field>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <t t-name="ts_brand.onboarding_card">
                <section t-if="member.ts_onb_card()" class="ts-card tsob-card" id="tsob-card" aria-labelledby="tsob-card-h">
                    <h2 id="tsob-card-h" class="h5">هویت شما در گزارش‌ها را کامل کنید</h2>
                    <p>عنوان حرفه‌ای، عکس و معرفی کوتاه شما بالای گزارش مراجعانی می‌آید که مشاورشان هستید. شماره یا نشانی تماس شما در گزارش نمی‌آید.</p>
                    <div class="tsob-step__actions">
                        <a t-attf-href="/my/workspaces/#{ws.id}/members/#{member.id}#tsbr-member" class="ts-btn ts-btn--primary tsob-btn">تکمیل هویت من</a>
                        <form t-attf-action="/my/workspaces/#{ws.id}/onboarding/card-hide" method="post" data-tsp-once="1">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="ts-btn ts-btn--quiet tsob-btn">بعداً نشانم نده</button>
                        </form>
                    </div>
                </section>
            </t>
        </field>
    </record>

    <!-- ===================================================== dashboard: checklist and card above the empty state -->
    <record id="dashboard_onboarding" model="ir.ui.view">
        <field name="name">ts_brand.dashboard.onboarding</field>
        <field name="inherit_id" ref="ts_panel.tpl_dashboard"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('tsp-dash-empty')]" position="before">
                <t t-call="ts_brand.onboarding_checklist"/>
                <t t-call="ts_brand.onboarding_card"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== state page: a counselor waiting for verification sees the card -->
    <record id="state_page_onboarding" model="ir.ui.view">
        <field name="name">ts_brand.state_page.onboarding</field>
        <field name="inherit_id" ref="ts_panel.tpl_state_page"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('tsp-empty')]" position="after">
                <t t-call="ts_brand.onboarding_card"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================== help center: «راهنمای راه‌اندازی مرکز مشاوره» (#center-setup) -->
    <record id="help_center_setup" model="ir.ui.view">
        <field name="name">ts_brand.help.center_setup</field>
        <field name="inherit_id" ref="ts_panel.tpl_help_panel"/>
        <field name="website_id" ref="ts_website.website_ts"/>
        <field name="arch" type="xml">
            <xpath expr="//nav[@aria-label='فهرست راهنما']/ul/li[a[@href='#credits']]" position="after">
                <li><a href="#center-setup">راهنمای راه‌اندازی مرکز مشاوره</a></li>
            </xpath>
            <xpath expr="//article[@id='credits']" position="after">
                <article class="ts-card tsob-help" id="center-setup">
                    <h2>راهنمای راه‌اندازی مرکز مشاوره</h2>
                    <p>پنل مرکز مشاوره را خود مرکز اداره می‌کند. مالک پنل، هماهنگ‌کننده و مدیر مرکز مشاوره در «داشبورد» فهرست «راه‌اندازی مرکز» را می‌بینند. هر گام از روی اطلاعات خود پنل سنجیده می‌شود، نه با تیک دستی، و وقتی همهٔ گام‌ها انجام شود فهرست کنار می‌رود.</p>
                    <h3 id="center-setup-identity">۱. هویت مرکز در گزارش‌ها</h3>
                    <p>در «تنظیمات»، بخش «هویت مرکز در گزارش‌ها»، نام مرکز را بنویسید و در بخش «مشخصات» لوگوی مرکز را بارگذاری کنید. این دو بالای گزارش هر مراجع، در صفحه و در فایل PDF، می‌آیند. گام وقتی انجام شده است که نام و لوگو هر دو ثبت شده باشند.</p>
                    <h3 id="center-setup-counselors">۲. دعوت مشاوران</h3>
                    <p>در «اعضا»، بخش «دعوت همکار»، مشاوران مرکز را با شمارهٔ موبایلشان دعوت کنید و پیوند دعوت را برایشان بفرستید. دعوتی که هنوز پذیرفته نشده «در راه» است. گام وقتی انجام شده است که دست‌کم یک مشاور مرکز یا مدیر مرکز مشاوره عضو فعال پنل باشد. هر مشاور گزارش ویژهٔ مشاور را پس از تأیید شمارهٔ پروانه‌اش می‌بیند.</p>
                    <h3 id="center-setup-catalog">۳. سنجه‌های هر مشاور</h3>
                    <p>در صفحهٔ هر مشاور، بخش «سنجه‌ها و مجموعه‌های مجاز»، تعیین می‌کنید او به کدام موارد دعوت کند؛ پیش‌فرض، همهٔ موارد پنل است. اگر پنل یک مشاور دارد، این گام خودبه‌خود انجام شده است. اگر چند مشاور دارد، گام وقتی انجام می‌شود که برای هر مشاور یا فهرست محدودی ثبت شده باشد یا فرم او دست‌کم یک بار ذخیره شده باشد، حتی با همان «همهٔ موارد پنل».</p>
                    <h3 id="center-setup-caps">۴. سقف ماهانهٔ مشاوران (اختیاری)</h3>
                    <p>در «اعتبار و مصرف» برای هر مشاور سقفی به تومان می‌گذارید؛ دعوتی که از سقفِ ماه شمسی بگذرد فرستاده نمی‌شود. برای مالک، هماهنگ‌کننده و مدیر مرکز مشاوره سقفی نیست. اگر سقف نمی‌خواهید، در فهرست راه‌اندازی «بدون سقف بماند» را بزنید. این گام فقط در پنل پیش‌پرداخت دیده می‌شود.</p>
                    <h3 id="center-setup-credit">۵. اعتبار پنل</h3>
                    <p>در پنل پیش‌پرداخت، دعوت فقط وقتی فرستاده می‌شود که اعتبار پنل به اندازهٔ هزینهٔ آن باشد. گام با موجودی بیشتر از صفر انجام می‌شود و موجودی همیشه در «اعتبار و مصرف» دیده می‌شود.</p>
                    <h3 id="center-setup-invite">۶. نخستین دعوت</h3>
                    <p>با «دعوت تازه» مراجع و سنجه یا مجموعه را انتخاب می‌کنید و پیوند دعوت را برای مراجع می‌فرستید. تا تیم استعدادیاب پنل را تأیید نکرده است، دعوت فرستاده نمی‌شود.</p>
                    <h3 id="center-setup-prepaid">اعتبار پیش‌پرداخت چطور کار می‌کند</h3>
                    <p>با فرستادن هر دعوت، هزینهٔ سنجه یا مجموعه از اعتبار پنل رزرو می‌شود. وقتی مراجع کار را تکمیل کند، همان مبلغ کسر می‌شود؛ هزینهٔ یک مجموعه با تکمیل نخستین سنجهٔ آن کسر می‌شود. اگر مهلت دعوت تمام شود یا دعوت لغو یا رد شود، رزرو آزاد می‌شود و به موجودی برمی‌گردد. پیش از فرستادن هر دعوت، سقف ماهانهٔ مشاوری که آن را می‌فرستد هم بررسی می‌شود.</p>
                    <h3 id="center-setup-invoices">فاکتورها</h3>
                    <p>شارژ اعتبار با فاکتوری انجام می‌شود که تیم استعدادیاب به نام مرکز صادر می‌کند. مالک، هماهنگ‌کننده و مدیر مرکز مشاوره فاکتورها را با تاریخ، مبلغ و وضعیت پرداخت در «اعتبار و مصرف»، بخش «فاکتورهای شارژ اعتبار»، می‌بینند و نسخهٔ قابل چاپ هر فاکتور از همان‌جا باز می‌شود. مبلغ فاکتور پس از ثبت پرداخت به اعتبار پنل افزوده می‌شود.</p>
                    <div t-if="tsob_hidden" class="tsob-help__restore">
                        <p>فهرست «راه‌اندازی مرکز» را در «داشبورد» پنهان کرده‌اید. هر وقت بخواهید، دوباره نمایانش کنید:</p>
                        <form t-foreach="tsob_hidden" t-as="hm" t-attf-action="/my/workspaces/#{hm.workspace_id.id}/onboarding/show" method="post" data-tsp-once="1">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="ts-btn ts-btn--outline tsob-btn">نمایش دوبارهٔ فهرست در پنل «<t t-out="hm.workspace_id.name"/>»</button>
                        </form>
                    </div>
                </article>
            </xpath>
        </field>
    </record>
</odoo>
